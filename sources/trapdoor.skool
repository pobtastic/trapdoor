 $E8C9 ADD A,A       ; entries.}
 $E8CA ADD A,$02     ; #REGa+=#N$02.
 $E8CC LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $E8CD ADD IX,DE     ; #REGix+=#REGde.
 $E8CF LD A,(IX+$01) ; Load #REGa with the current entity's flags byte 1.
 $E8D2 CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $E8D5 INC A         ; Step the graphic-set / attribute index on by one.
 $E8D6 LD (IX+$00),A ; Set the current entity's entity type.
 $E8D9 JR $E8DC      ; Jump to #R$E8DC to continue this routine.
