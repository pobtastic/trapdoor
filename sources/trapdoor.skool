 $FC0C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC14 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC1C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC24 DEFB $00,$00,$00,$00,$00,$00,$00,$00
