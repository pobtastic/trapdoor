                                            ; message-font-#N((#PC-$E42A)/$10)) } UDGTABLE#
                                            ; }
 $E6DA DEFB $00                             ; Pad byte (#N$00) before #R$E6DB.

; Populate Display Buffer For Visible Entities
;
; Used by the routine at #R$AAB3.
; .
; Walk the simple entity table at #R$8B69 and process graphic layout data
; for each visible entity into the current display buffer.
;
; .
;
; Walk rooms #N$00–#N$05 and draw every on-camera entity into the current
; display buffer.
@label=PopulateDisplayBuffer_VisibleEntities
c$E6DB LD C,$00      ; Clear the room-pass index in #REGc to #N$00.
; Start a room-pass over the simple entity table at #R$8B69.
@label=PopulateVisible_StartRoomPass
*$E6DD LD IX,$8B69   ; Point #REGix at the simple entity table (#R$8B69).
 $E6E1 LD DE,$000E   ; Load #REGde with #N($000E,$04,$04).
; Draw each visible entity whose room and camera-window x-band match this
; pass.
@label=PopulateDisplayBuffer_VisibleEntitiesContinue
*$E6E4 LD A,(IX+$00) ; Fetch the current entity's type for the type test.
 $E6E7 CP $FF        ; {Is #REGa equal to #N$FF? If so, jump to #R$E716.
 $E6E9 JR Z,$E716    ; }
 $E6EB OR A          ; {Is #REGa zero? If so, jump to #R$E712.
 $E6EC JR Z,$E712    ; }
 $E6EE BIT 7,A       ; {Is bit #N$07 of #REGa set? If so, jump to #R$E712.
 $E6F0 JR NZ,$E712   ; }
 $E6F2 LD A,C        ; Copy the saved count/flag from #REGc into #REGa.
 $E6F3 CP (IX+$04)   ; {Does the candidate share this entity's room? If not, jump to
 $E6F6 JR NZ,$E712   ; #R$E712.}
 $E6F8 LD HL,($72FB) ; Load #REGhl with the camera room-origin pointer
                     ; (#R$72FB).
 $E6FB LD A,H        ; Copy #REGh into #REGa.
 $E6FC CP (IX+$07)   ; {Is the camera origin's high byte left of this entity's x? If so,
 $E6FF JR C,$E712    ; jump to #R$E712.}
 $E701 LD A,(IX+$08) ; Load #REGa with the current entity's x-extent.
 $E704 CP L          ; {Is this entity's x-extent left of the camera origin's low byte in
 $E705 JR C,$E712    ; #REGl? If so, jump to #R$E712.}
 $E707 PUSH DE       ; {Stash #REGde, #REGbc and #REGix on the stack.
 $E708 PUSH BC       ;
 $E709 PUSH IX       ; }
 $E70B CALL $E71D    ; Call #R$E71D to draw the entity's graphic layout.
 $E70E POP IX        ; {Restore #REGix, #REGbc and #REGde from the stack.
 $E710 POP BC        ;
 $E711 POP DE        ; }
; Advance to the next simple-entity record and keep scanning this room
; pass.
@label=PopulateDisplayBuffer_VisibleEntitiesContinueB
*$E712 ADD IX,DE     ; #REGix+=#REGde.
 $E714 JR $E6E4      ; Jump to #R$E6E4 to continue this routine.
; Bump the room-pass index; return when it passes #N($05), otherwise
; restart at #R$E6DD.
@label=PopulateDisplayBuffer_VisibleEntitiesContinueB2
*$E716 LD A,$05      ; Load #REGa with #N$05 (last room index).
 $E718 INC C         ; Advance the room-pass index in #REGc by one.
 $E719 CP C          ; {Return if the room-pass index is now greater than
 $E71A RET C         ; #N$05.}
 $E71B JR $E6DD      ; Jump to #R$E6DD to continue the loop.

; Process Graphic Layout Data For Entity
;
; Used by the routine at #R$E6DB.
; .
; Load the graphic layout address from the entity at #REGix, set drawing
; coordinates relative to the camera, then jump to #R$E73F.
;
; IX Address of entity state data
@label=Process_GraphicLayoutData_Entity
c$E71D LD E,(IX+$0A) ; {Fetch the current entity's graphic-layout address into
 $E720 LD D,(IX+$0B) ; #REGde.}
 $E723 LD A,(IX+$05) ; Load #REGa with the current entity's y-coordinate.
 $E726 SUB $14       ; #REGa-=#N$14.
 $E728 LD L,A        ; Copy #REGa into #REGl.
 $E729 LD A,($72FB)  ; Load #REGa with the camera room-origin pointer
                     ; (#R$72FB).
 $E72C LD C,A        ; Keep the camera origin X in #REGc.
 $E72D LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $E730 SUB C         ; Subtract #REGc from #REGa.
 $E731 LD C,A        ; Keep the delta in #REGc.
 $E732 LD H,C        ; Copy #REGc into #REGh.
 $E733 LD ($72F7),HL ; Store #REGhl in the stored drawing coordinates
                     ; (#R$72F7).
 $E736 PUSH DE       ; {Copy #REGde into #REGix (using the stack).
 $E737 POP IX        ; }
 $E739 JR $E73F      ; Jump to #R$E73F to process graphic layout data.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9878 }
; LIST#

; Advance Graphic Layout Pointer By Two Bytes And Process
;
; Used by the routines at #R$E73F, #R$E86E, #R$E87B, #R$E88B and #R$E959.
; .
; Advance #REGix by two bytes and process the graphic layout data there.
@label=Advance_GraphicLayoutPointerByTwo
c$E73B INC IX        ; Advance #REGix past the first graphic-layout operand
                     ; byte.
; This entry point is used by the routines at #R$E82C, #R$E835 and #R$E83E.
; .
; Skip one graphic-layout operand and resume decoding at #R$E73F.
@label=Advance_GraphicLayoutPointerByOne
*$E73D INC IX        ; Advance #REGix past one graphic-layout operand byte.
; View the equivalent code in;
; #LIST
; { #FLUNKY$989A }
; LIST#

; Process Graphic Layout Data
;
; Used by the routines at #R$E71D, #R$E7F9, #R$E808, #R$E819, #R$E847, #R$E88B,
; #R$E89E, #R$E8AA, #R$E8E8 and #R$E909.
; .
; Read the current graphic layout instruction at #REGix. Values below
; #N$EE are graphic tiles drawn into the display buffer; #N$EE–#N$FF
; dispatch via #R$E7BB.
;
; IX Current position in graphic layout data
; HL Drawing coordinates (#REGh = x, #REGl = y)
;
; Ordinary tile: if it sits inside the #N$20×#N$14 window, plot it into
; the display buffer.
@label=Process_GraphicLayoutData
c$E73F LD A,(IX+$00)  ; Fetch the next graphic-layout byte (tile index /
                      ; opcode) into #REGa.
 $E742 CP $EE         ; {Is #REGa less than #N$EE? If not, jump to #R$E7BB.
 $E744 JP NC,$E7BB    ; }
 $E747 LD A,H         ; Copy #REGh into #REGa.
 $E748 CP $20         ; {Is #REGa less than #N$20? If not, jump to #R$E7B1.
 $E74A JP NC,$E7B1    ; }
 $E74D LD A,L         ; Copy #REGl into #REGa.
 $E74E CP $14         ; {Is #REGa less than #N$14? If not, jump to #R$E7B1.
 $E750 JP NC,$E7B1    ; }
 $E753 PUSH HL        ; Stash #REGhl on the stack.
 $E754 LD A,H         ; Copy #REGh into #REGa.
 $E755 ADD A,A        ; Double #REGa to form a word index into the table.
 $E756 ADD A,H        ; #REGa+=#REGh.
 $E757 LD C,A         ; Keep the summed coordinate in #REGc.
 $E758 LD A,L         ; Copy #REGl into #REGa.
 $E759 ADD A,A        ; Double #REGa to form a word index into the table.
 $E75A LD E,A         ; Copy #REGa into #REGe as a saved coordinate / value.
 $E75B LD D,$00       ; Clear #REGd (high byte of a pointer/offset).
 $E75D LD B,D         ; Copy #REGd into #REGb.
 $E75E LD HL,$E967    ; Point #REGhl at Table: Display Buffer Row Offsets
                      ; (#R$E967).
 $E761 ADD HL,DE      ; #REGhl+=#REGde.
 $E762 LD E,(HL)      ; {Fetch the word at #REGhl into #REGde.
 $E763 INC HL         ;
 $E764 LD D,(HL)      ; }
 $E765 LD HL,($72F5)  ; Load #REGhl with the current display-buffer pointer
                      ; (#R$72F5).
 $E768 ADD HL,DE      ; #REGhl+=#REGde.
 $E769 ADD HL,BC      ; #REGhl+=#REGbc.
 $E76A EX DE,HL       ; Exchange #REGde and #REGhl.
; Write the current graphic-set index into the buffer cell and advance the
; layout cursor.
 $E76B LD A,($7306)   ; Load #REGa with the current graphic-set index
                      ; (#R$7306).
 $E76E LD (DE),A      ; Set the byte at #REGde.
 $E76F INC DE         ; Advance the destination drawing coordinate by one.
 $E770 LD A,(IX+$00)  ; Fetch the current entity's type into #REGa.
 $E773 LD (DE),A      ; Set the byte at #REGde.
 $E774 INC DE         ; Advance the destination drawing coordinate by one.
 $E775 LD A,($7308)   ; Load #REGa with the current attribute (#R$7308).
 $E778 OR A           ; {Is the current attribute (#R$7308) zero? If not, jump
 $E779 JR NZ,$E780    ; to #R$E780.}
 $E77B INC IX         ; Advance #REGix past the graphic-layout operand byte.
 $E77D LD A,(IX+$00)  ; Fetch the current entity's type for the layout path.
; Compose the tile's attribute from #R$7308 / entity flags and write it
; into the display buffer.
@label=ProcessLayout_DrawTile
*$E780 LD L,A         ; Copy #REGa into #REGl.
 $E781 AND %11000000  ; #REGa&=#N$C0.
 $E783 LD B,A         ; Keep a copy of #REGa in #REGb.
 $E784 LD A,L         ; Copy #REGl into #REGa.
 $E785 AND %00111111  ; #REGa&=#N$3F.
 $E787 LD C,A         ; Keep the masked attribute bits in #REGc.
 $E788 AND %00111000  ; #REGa&=#N$38.
 $E78A JR NZ,$E79C    ; Jump to #R$E79C to continue if the comparison did not
                      ; match.
 $E78C BIT 7,(IX+$01) ; {Is bit #N$07 of the layout step byte at #REGix+#N$01 set? If so,
 $E790 JR NZ,$E79C    ; jump to #R$E79C.}
 $E792 LD A,(DE)      ; Load #REGa from the byte at #REGde.
 $E793 BIT 6,A        ; {Is bit #N$06 of #REGa set? If not, jump to #R$E79A.
 $E795 JR Z,$E79A     ; }
 $E797 ADD A,A        ; {Multiply #REGa by #N$08.
 $E798 ADD A,A        ;
 $E799 ADD A,A        ; }
; Mask the ink/paper bits of the composed attribute before merging.
@label=Process_GraphicLayoutDataContinue
*$E79A AND $38        ; #REGa&=#N$38.
; Merge the masked attribute halves and store the tile triple in the
; display buffer.
@label=Process_GraphicLayoutDataContinueB
*$E79C OR B           ; Set in #REGa every bit that is set in #REGb.
 $E79D OR C           ; Set in #REGa every bit that is set in #REGc.
 $E79E LD (DE),A      ; Set the byte at #REGde.
 $E79F POP HL         ; Restore #REGhl from the stack.
; Apply the layout delta/flags byte to step the drawing coordinates for
; the next tile.
@label=Process_GraphicLayoutDataContinueB2
*$E7A0 LD A,(IX+$01)  ; Fetch the layout delta/flags byte at #REGix+#N$01 into
                      ; #REGa.
 $E7A3 AND %01111111  ; #REGa&=#N$7F.
 $E7A5 SUB $20        ; #REGa-=#N$20.
 $E7A7 JR Z,$E7AB     ; Jump to #R$E7AB to continue if the comparison matched.
 $E7A9 JR NC,$E7AC    ; Jump to #R$E7AC if the result did not underflow.
; Step the drawing Y down one character when the signed delta underflows.
@label=Process_GraphicLayoutDataContinueB3
*$E7AB INC L          ; Advance the low drawing coordinate by one.
; Add the signed X delta into #REGh and continue via #R$E73B.
@label=Process_GraphicLayoutDataContinueB4
*$E7AC ADD A,H        ; #REGa+=#REGh.
 $E7AD LD H,A         ; Copy #REGa into #REGh.
 $E7AE JP $E73B       ; Jump to #R$E73B to advance the graphic layout pointer
                      ; and continue.
; Skip drawing an off-screen tile, but still consume its layout operand
; and delta.
@label=Process_GraphicLayoutDataContinueB5
*$E7B1 LD A,($7308)   ; Load #REGa with the current attribute (#R$7308).
 $E7B4 OR A           ; {Is the current attribute (#R$7308) zero? If not, jump
 $E7B5 JR NZ,$E7A0    ; to #R$E7A0.}
 $E7B7 INC IX         ; Advance #REGix past the graphic-layout operand byte.
 $E7B9 JR $E7A0       ; Jump to #R$E7A0 to continue this routine.
; View the equivalent code in;
; #LIST
; { #FLUNKY$98A3 }
; LIST#

; Jump Graphic Layout Routine
;
; Used by the routine at #R$E73F.
; .
; Dispatch graphic layout opcode #N$EE–#N$FF via #R$E7D5. The target
; address is patched into the #HTML(<code>JP</code>) at #R$E7D2.
;
; A Graphic layout opcode
; IX Address of the opcode byte
@label=Jump_GraphicLayoutRoutine
c$E7BB INC IX        ; Advance #REGix past the graphic-layout operand byte.
 $E7BD SUB $EE       ; #REGa-=#N$EE.
 $E7BF ADD A,A       ; Double #REGa to form a word index into the table.
 $E7C0 LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $E7C1 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $E7C3 PUSH HL       ; Stash #REGhl on the stack.
 $E7C4 LD HL,$E7D5   ; Point #REGhl at Table of Addresses of Graphic Layout Handling
                     ; Routines (#R$E7D5).
 $E7C7 ADD HL,DE     ; #REGhl+=#REGde.
 $E7C8 LD A,(HL)     ; Fetch the next script byte.
 $E7C9 LD ($E7D3),A  ; Set #R$E7BB(#N$E7D3).
 $E7CC INC HL        ; Advance the graphic-layout pointer in #REGhl by one
                     ; byte.
 $E7CD LD A,(HL)     ; Fetch the next script byte.
 $E7CE LD ($E7D4),A  ; Set #R$E7BB(#N$E7D4).
 $E7D1 POP HL        ; Restore #REGhl from the stack.
 $E7D2 JP $0000      ; Jump to #N($0000,$04,$04).
; View the equivalent code in;
; #LIST
; { #FLUNKY$9945 }
; LIST#

