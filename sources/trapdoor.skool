; random pick.
@label=GraphicLayoutRoutine_JumpTimeWeightedRandom
c$E8AA PUSH IX       ; Stash #REGix on the stack.
 $E8AC LD A,(IX+$01) ; Load #REGa with the current entity's flags byte 1.
 $E8AF ADD A,A       ; {Multiply #REGa by #N$04 to index the four-byte table
 $E8B0 ADD A,A       ; entries.}
 $E8B1 ADD A,$02     ; #REGa+=#N$02.
 $E8B3 LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $E8B4 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $E8B6 ADD IX,DE     ; #REGix+=#REGde.
 $E8B8 DEC (IX+$00)  ; Decrease the current entity's entity type.
