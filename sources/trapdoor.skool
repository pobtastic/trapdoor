 $FC34 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC3C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC44 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FC4C DEFB $00,$00,$00,$00,$00,$00,$00,$00
