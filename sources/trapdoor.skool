@label=GraphicLayoutRoutine_AdjustCoordsAndStore
c$E87B LD A,(IX+$00) ; Fetch the current entity's type into #REGa.
 $E87E ADD A,L       ; #REGa+=#REGl.
 $E87F LD L,A        ; Copy #REGa into #REGl.
 $E880 LD A,(IX+$01) ; Load #REGa with the current entity's flags byte 1.
 $E883 ADD A,H       ; #REGa+=#REGh.
