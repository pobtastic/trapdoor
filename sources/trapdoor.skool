 $E6CA DEFB $00,$00,$00,$7E,$7E,$06,$0E,$1C ; {Character #N((#PC-$E42A)/$10)
 $E6D2 DEFB $38,$70,$60,$7E,$7E,$00,$00,$00 ; (#MAP((#PC-$E42A)/$10)(#CHR($30+(#PC-$E42A)/$10),$0A:#CHR$2E,$0B:#CHR$2C,
