 $BDC5 DEFB $F3,$00,$03,$E8,$BD,$03,$BE,$E8,$BD         ; Increment the index and jump to one of #R$BDE8, #R$BE03,
                                                        ; #R$BDE8.
 $BDCE DEFB $03,$BE
