; Data: Bird Scripts
;
; Bird scripts that drive the bird laying an egg. #R$BF38 starts here.
; Other readers enter at #R$BE79, #R$BE81, #R$BE89, #R$BE91, #R$BEB9 and
; #R$BEC1. #R$BF68 pokes the wander loop count at #R$BE9B. Ends immediately
; before #R$BECD.
;
; .
;
; Start script published by #R$BF2B and #R$BF38.
; .
; #UDGTABLE
; { #SCRIPTANIM$BE6D(script-be6d) }
; UDGTABLE#
@label=Data_BirdScripts
b$BE6D DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BE6F DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BE71 DEFB $09,$00  ; Loop count #N$09 (#R$EC53 reads only the low byte).
 $BE73 DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BE75 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BE77 DEFW $0028    ; Script opcode #N$28 (arm the bird script-active flags).
; Rise and vertical-walk loop entered from #R$BFE4.
@label=BirdScript_RiseLoop
 $BE79 DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BE7B DEFW $0024    ; Script opcode #N$24 (walk the bird vertically).
 $BE7D DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BE7F DEFW $BE79    ; Jump to script address #R$BE79.
; Idle and horizontal-walk loop entered from #R$BFB9 and #R$BFFA.
@label=BirdScript_IdleLoop
 $BE81 DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BE83 DEFW $0026    ; Script opcode #N$26 (walk the bird horizontally).
 $BE85 DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BE87 DEFW $BE81    ; Jump to script address #R$BE81.
; Turn-around and walk-right loop entered from #R$C021.
@label=BirdScript_TurnLoop
 $BE89 DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BE8B DEFW $0025    ; Script opcode #N$25 (walk the bird right).
 $BE8D DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BE8F DEFW $BE89    ; Jump to script address #R$BE89.
; Wander script entered from #R$BF6B. #R$BF68 rewrites #R$BE9B.
@label=BirdScript_Wander
 $BE91 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BE93 DEFB $14,$00  ; Loop count #N$14 (#R$EC53 reads only the low byte).
 $BE95 DEFB $2F,$C1  ; Graphic-layout pointer #R$C12F.
 $BE97 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BE99 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BE9B DEFB $12,$00  ; Loop count #N$12 (rewritten by #R$BF68). #R$EC53 reads the low
                     ; byte.
 $BE9D DEFB $2F,$C1  ; Graphic-layout pointer #R$C12F.
 $BE9F DEFW $0025    ; Script opcode #N$25 (walk the bird right).
 $BEA1 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BEA3 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BEA5 DEFB $28,$00  ; Loop count #N$28 (#R$EC53 reads only the low byte).
 $BEA7 DEFB $19,$C1  ; Graphic-layout pointer #R$C119.
 $BEA9 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BEAB DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BEAD DEFB $0A,$00  ; Loop count #N$0A (#R$EC53 reads only the low byte).
 $BEAF DEFB $24,$C1  ; Graphic-layout pointer #R$C124.
 $BEB1 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BEB3 DEFW $0027    ; Script opcode #N$27 (spawn or refresh the bird helper).
 $BEB5 DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BEB7 DEFW $BE81    ; Jump to script address #R$BE81.
; Bound and rise-on-event loop entered from #R$BFB3 and #R$C01B.
@label=BirdScript_BoundLoop
 $BEB9 DEFB $02,$C1  ; Graphic-layout pointer #R$C102.
 $BEBB DEFW $0029    ; Script opcode #N$29 (raise the bird on its event bit).
 $BEBD DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BEBF DEFW $BEB9    ; Jump to script address #R$BEB9.
; Alternate wander script entered from #R$BF71.
@label=BirdScript_AltWander
 $BEC1 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $BEC3 DEFB $10,$00  ; Loop count #N$10 (#R$EC53 reads only the low byte).
 $BEC5 DEFB $2F,$C1  ; Graphic-layout pointer #R$C12F.
 $BEC7 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $BEC9 DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $BECB DEFW $BE89    ; Jump to script address #R$BE89.

; Update Task Two Entities
;
; Used by the routine at #R$AAB3.
; .
; Once per frame for the "Thing Upstairs" task: refresh helpers, and
; when the task phase is #N$02 advance the task-two script at #R$72D5.
@label=Update_Task_Two_Entities
c$BECD CALL $C095    ; Call #R$C095 to update the task helper entities.
 $BED0 LD A,($72AF)  ; Fetch the current task phase (#R$72AF).
 $BED3 CP $02        ; {Is the phase "run task-two scripts" (#N$02)? If not,
 $BED5 RET NZ        ; return.}
 $BED6 LD HL,($72D5) ; Load the task-two script position (#R$72D5).
 $BED9 LD ($72CF),HL ; Copy it into the active script cursor (#R$72CF).
 $BEDC CALL $BEE6    ; Call #R$BEE6 to advance that script / entity state.
 $BEDF LD HL,($72CF) ; Reload the (possibly updated) temporary script pointer.
 $BEE2 LD ($72D5),HL ; Write it back to the task-two script position (#R$72D5).
 $BEE5 RET           ; Return.

; Update Task Two Entity State
;
; Used by the routine at #R$BECD.
; .
; Restore the upstairs helper if needed, then either start/stop its
; script from the game event flags or pick the next wandering script.
@label=Update_TaskTwoEntityState
c$BEE6 LD HL,$72B5    ; Point #REGhl at the task-two flags (#R$72B5).
 $BEE9 LD A,($72AE)   ; Fetch the current task index (#R$72AE).
 $BEEC CP $02         ; {Is task two itself active (index #N$02)? If so, skip the spawn latch
 $BEEE JR Z,$BEF6     ; at #R$BEF6.}
 $BEF0 BIT 1,(HL)     ; {Is the task-two "advance script" bit already set (bit #N$01)? If so,
 $BEF2 JR Z,$BEF6     ; skip the spawn latch.}
 $BEF4 SET 2,(HL)     ; Otherwise arm the spawn / random-walk latch (set bit
                      ; #N$02).
; Handle helper restore: rewrite the upstairs helper layout when bit #N$03
; is set.
@label=Update_TaskTwo_CheckHelperRestore
*$BEF6 BIT 3,(HL)     ; {Does the helper need its layout restoring (bit #N$03)? If not,
 $BEF8 JR Z,$BF07     ; select the entity at #R$BF07.}
 $BEFA RES 3,(HL)     ; Clear the restore latch.
 $BEFC LD HL,$9DB3    ; Point #REGhl at spawned-helper layout #R$9DB3.
 $BEFF LD ($8FE1),HL  ; Write that layout into the helper's record
                      ; (#R$8EF3(#N$8FE1)).
 $BF02 LD HL,$8FD7    ; Point #REGhl at the spawned-helper entity (#R$8FD7).
 $BF05 SET 7,(HL)     ; Mark that helper active (set bit #N$07 of its
                      ; type/flags byte).
; Handle start/stop: use game event flags to run or halt the upstairs
; helper script.
@label=Update_TaskTwo_SelectEntity
*$BF07 LD IX,$8FE5    ; Point #REGix at the upstairs helper entity (#R$8FE5).
 $BF0B LD HL,($72CF)  ; Keep the temporary script pointer in #REGhl (#R$72CF).
 $BF0E LD A,($72B3)   ; Fetch the game event flags (#R$72B3).
 $BF11 BIT 7,A        ; {Is a task entity script marked active (bit #N$07)? If not, take the
 $BF13 JR NZ,$BF50    ; wander branch at #R$BF50.}
 $BF15 BIT 7,(IX+$00) ; {Is this helper already running (bit #N$07 of its type)? If not,
 $BF19 JR NZ,$BF21    ; decide whether to stop it at #R$BF21.}
 $BF1B BIT 1,A        ; {Is the trap door open (game event bit #N$01)? If so, (re)start the
 $BF1D JR Z,$BF2B     ; helper at #R$BF2B.}
 $BF1F JR $BF50       ; Otherwise wander at #R$BF50.
; Stop the upstairs helper when the trap is open but the helper was not
; running.
@label=Update_TaskTwo_StopEntity
*$BF21 BIT 1,A        ; {Is the trap door open? If not, leave the helper alone
 $BF23 RET Z          ; and return.}
 $BF24 RES 7,(IX+$00) ; Clear the helper's "running" type bit.
 $BF28 JP $EC2E       ; Advance its current script at #R$EC2E.
; Start the upstairs helper: clear the task latch and publish script
; #R$BE6D.
@label=Update_TaskTwo_StartEntity
*$BF2B SET 7,(IX+$00) ; Mark the helper running (set bit #N$07 of its type).
 $BF2F LD HL,$72B3    ; Point #REGhl at the game event flags (#R$72B3).
 $BF32 RES 7,(HL)     ; Clear "task entity script active" (bit #N$07).
 $BF34 XOR A          ; Clear #REGa so the task phase can reset.
 $BF35 LD ($72AF),A   ; Clear the current task phase (#R$72AF).
 $BF38 LD HL,$BE6D    ; Point #REGhl at the bird scripts (#R$BE6D).
 $BF3B LD ($72CF),HL  ; Publish it through the active script cursor (#R$72CF).
 $BF3E RET            ; Return.
; This entry point is used by the routine at #R$BFBF.
; .
; Shared entry used by script routine #R$BFBF when the helper reaches
; column #N$27: clear the upstairs event latch and restart.
@label=Update_TaskTwo_ClearTrapFlags
*$BF3F LD HL,$72B3    ; Point #REGhl at the game event flags (#R$72B3).
 $BF42 RES 4,(HL)     ; Clear the task-two / upstairs event latch (bit #N$04).
 $BF44 LD A,$28       ; Load a fresh game-tick delay of #N$28 frames.
 $BF46 LD ($72F2),A   ; Store it in the game tick counter (#R$72F2).
 $BF49 LD HL,$72B5    ; Point #REGhl at the task-two flags (#R$72B5).
 $BF4C RES 2,(HL)     ; Clear the spawn / random-walk latch (bit #N$02).
 $BF4E JR $BF2B       ; Restart the helper at #R$BF2B.
; Handle wander: pick the next bird script when no start/stop event is
; pending.
@label=Update_TaskTwo_ScriptBranch
*$BF50 LD A,($72B5)   ; Fetch the task-two flags (#R$72B5).
 $BF53 BIT 1,A        ; {Is "advance script" still set (bit #N$01)? If so, just step the
 $BF55 JP Z,$EC2E     ; current script at #R$EC2E.}
 $BF58 RES 1,A        ; Clear that advance bit.
 $BF5A LD ($72B5),A   ; Write the updated task-two flags back.
 $BF5D BIT 2,A        ; {Is the spawn / random-walk latch set (bit #N$02)? If not, use the
 $BF5F JR NZ,$BF71    ; alternate script at #R$BF71.}
 $BF61 LD A,$18       ; Load random range base #N$18 for a wander destination.
 $BF63 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $BF66 ADD A,$16      ; Bias it into the bird script table (#N$16+#REGa).
 $BF68 LD ($BE9B),A   ; Poke that index into task-two storage at #R$BE9B.
 $BF6B LD HL,$BE91    ; Point #REGhl at the wander script (#R$BE91).
 $BF6E JP $EC30       ; Run it via #R$EC30.
; Wander without the spawn latch: run the alternate bird script
; (#R$BEC1).
@label=Update_TaskTwo_AltScript
*$BF71 LD HL,$BEC1    ; Point #REGhl at the alternate bird script (#R$BEC1).
 $BF74 JP $EC30       ; Run it via #R$EC30.

; Script Routine: (#N$28) Task-two entity action
;
; Mark the bird script as active so later task-two steps can run.
@label=ScriptRoutine_TaskTwoArmScriptFlags
c$BF77 PUSH HL       ; Stash #REGhl on the stack.
 $BF78 LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $BF7B SET 7,(HL)    ; Set "task entity script is active" (bit #N$07 of
                     ; #R$72B3).
 $BF7D SET 4,(HL)    ; Set "task-two / upstairs event latch" (bit #N$04 of
                     ; #R$72B3).
 $BF7F LD A,($72C0)  ; Load #REGa with the entity spawn timer (#R$72C0).
 $BF82 CP $04        ; {Is entity spawn timer equal to #N$04? If not, jump to
 $BF84 JR NZ,$BF8B   ; #R$BF8B.}
 $BF86 LD HL,$72B5   ; Point #REGhl at the task-two flags (#R$72B5).
 $BF89 SET 2,(HL)    ; Set "spawn / random-walk latch" (bit #N$02 of #R$72B5).
; Flags armed: restore #REGhl and continue at the next script instruction.
@label=ScriptRoutine_TaskTwoArmScriptFlags_NextInstruction
*$BF8B POP HL        ; Restore #REGhl from the stack.
 $BF8C JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$24) Task-two entity action
;
; Step the task-two entity one character vertically along its walk.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskTwoWalkVertical
c$BF8F LD A,(IX+$05) ; Load #REGa with the current entity's y-coordinate.
 $BF92 DEC A         ; Step the current entity's y-coordinate back by one.
 $BF93 CP $15        ; {Is the current entity's y-coordinate equal to #N$15? If so, jump to
 $BF95 JR Z,$BFAC    ; #R$BFAC.}
 $BF97 CP $1B        ; {Is the current entity's y-coordinate equal to #N$1B? If not, jump to
 $BF99 JR NZ,$BFA3   ; #R$BFA3.}
 $BF9B LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $BF9E RES 4,A       ; Clear bit #N$04 of the flag byte in #REGa.
 $BFA0 LD ($72B3),A  ; Set the game event flags (#R$72B3).
; Keep walking the task-two entity one row up, then continue the script.
@label=ScriptRoutine_TaskTwoWalkVertical_DecY
*$BFA3 DEC (IX+$05)  ; {Move this entity one character up.
 $BFA6 DEC (IX+$06)  ; }
 $BFA9 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; At y #N$15: run bound script #R$BEB9 if the spawn latch is set, else
; idle.
@label=ScriptRoutine_TaskTwoWalkVertical_AtY15
*$BFAC LD A,($72B5)  ; Load #REGa with the task-two flags (#R$72B5).
 $BFAF BIT 2,A       ; {Is bit #N$02 of task-two flags set? If not, jump to
 $BFB1 JR Z,$BFB9    ; #R$BFB9.}
 $BFB3 LD HL,$BEB9   ; Point #REGhl at bird script data #R$BEB9.
 $BFB6 JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.
; Vertical walk finished: run the task-two idle script (#R$BE81).
@label=ScriptRoutine_TaskTwoWalkVertical_RunIdleScript
*$BFB9 LD HL,$BE81   ; Point #REGhl at bird script data #R$BE81.
 $BFBC JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$29) Task-two entity action
;
; Lift the task-two entity when its matching game-event bit is set.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskTwoRiseOnEvent
c$BFBF LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $BFC2 BIT 1,A       ; {Is bit #N$01 of game event flags set? If not, jump to
 $BFC4 JR Z,$BFE4    ; #R$BFE4.}
 $BFC6 LD A,(IX+$05) ; Load #REGa with the current entity's y-coordinate.
 $BFC9 INC A         ; Advance the current entity's y-coordinate by one.
 $BFCA CP $27        ; {Is the current entity's y-coordinate equal to #N$27? If so, jump to
 $BFCC JP Z,$BF3F    ; #R$BF3F.}
 $BFCF CP $1B        ; {Is the current entity's y-coordinate equal to #N$1B? If not, jump to
 $BFD1 JR NZ,$BFDB   ; #R$BFDB.}
 $BFD3 LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $BFD6 SET 4,A       ; Set bit #N$04 of game event flags.
 $BFD8 LD ($72B3),A  ; Set the game event flags (#R$72B3).
; Keep lowering the rising helper one row, then continue the script.
@label=ScriptRoutine_TaskTwoRiseOnEvent_IncY
*$BFDB INC (IX+$05)  ; {Move this entity one character down.
 $BFDE INC (IX+$06)  ; }
 $BFE1 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Trap closed: restart the rise routine from script #R$BE79.
@label=ScriptRoutine_TaskTwoRiseOnEvent_RunStartScript
*$BFE4 LD HL,$BE79   ; Point #REGhl at bird script data #R$BE79.
 $BFE7 JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$25) Task-two entity action
;
; Walk the task-two entity right while its x-extent stays inside the
; allowed band.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskTwoWalkRight
c$BFEA LD A,(IX+$08) ; Load #REGa with the current entity's x-extent.
 $BFED CP $98        ; {Is the current entity's x-extent less than #N$98? If not, jump to
 $BFEF JR NC,$BFFA   ; #R$BFFA.}
 $BFF1 INC (IX+$07)  ; {Move this entity one character right.
 $BFF4 INC (IX+$08)  ; }
 $BFF7 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Right-walk finished at X-extent #N$98: run idle script #R$BE81.
@label=ScriptRoutine_TaskTwoWalkRight_RunIdleScript
*$BFFA LD HL,$BE81   ; Point #REGhl at bird script data #R$BE81.
 $BFFD JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$26) Task-two entity action
;
; Walk the task-two entity left or right according to the task-two flags.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskTwoWalkHorizontal
c$C000 LD A,($72B5)  ; Load #REGa with the task-two flags (#R$72B5).
 $C003 BIT 2,A       ; Test bit #N$02 of task-two flags.
 $C005 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $C008 JR Z,$C00E    ; Jump to #R$C00E to continue if the comparison matched.
 $C00A CP $6E        ; {Is the current entity's x-coordinate equal to #N$6E? If so, jump to
 $C00C JR Z,$C01B    ; #R$C01B.}
; Walk left while above X #N$63; otherwise turn via #R$C021.
@label=ScriptRoutine_TaskTwoWalkHorizontal_WalkLeftOrBound
*$C00E CP $63        ; {Is the current entity's x-coordinate less than #N$63? If so, jump to
 $C010 JR C,$C021    ; #R$C021.}
 $C012 DEC (IX+$07)  ; {Move this entity one character left.
 $C015 DEC (IX+$08)  ; }
 $C018 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Hit the right bound (X #N$6E): run bound script #R$BEB9.
@label=ScriptRoutine_TaskTwoWalkHorizontal_RunBoundScript
*$C01B LD HL,$BEB9   ; Point #REGhl at bird script data #R$BEB9.
 $C01E JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.
; Hit the left bound: run the turn-around script (#R$BE89).
@label=ScriptRoutine_TaskTwoWalkHorizontal_RunTurnScript
*$C021 LD HL,$BE89   ; Point #REGhl at bird script data #R$BE89.
 $C024 JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$27) Task-two entity action
;
; Spawn or refresh a helper entity from the current task-two state.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskTwoSpawnHelper
c$C027 LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $C02A LD B,(IX+$06)   ; Load #REGb with the current entity's y-extent.
 $C02D LD C,(IX+$07)   ; Load #REGc with the current entity's x-coordinate.
 $C030 LD IY,$8FD7     ; Point #REGiy at the spawned-helper entity (#R$8FD7).
 $C034 LD (IY+$00),$06 ; Write #N$06 to the referenced entity's entity type.
 $C038 LD (IY+$04),A   ; Set the referenced entity's room index.
 $C03B INC C           ; Advance the helper's x-coordinate in #REGc by one.
 $C03C LD (IY+$07),C   ; Store #REGc in the referenced entity's x-coordinate.
 $C03F INC C           ; Advance the helper's x-extent base in #REGc by one.
 $C040 LD (IY+$08),C   ; Store #REGc in the referenced entity's x-extent.
 $C043 INC B           ; Step the Y value in #REGb on by one.
 $C044 LD (IY+$05),B   ; Store #REGb in the referenced entity's y-coordinate.
 $C047 INC B           ; Step the Y value in #REGb on by one.
 $C048 LD (IY+$06),B   ; Store #REGb in the referenced entity's y-extent.
 $C04B SET 7,(IY+$01)  ; Set bit #N$07 of the referenced entity's flags byte 1.
 $C04F LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $C052 SET 0,A         ; Set bit #N$00 of game event flags.
 $C054 LD ($72B3),A    ; Set the game event flags (#R$72B3).
 $C057 LD A,($72C0)    ; Load #REGa with the entity spawn timer (#R$72C0).
 $C05A INC A           ; Advance entity spawn timer by one.
 $C05B LD ($72C0),A    ; Set the entity spawn timer (#R$72C0).
 $C05E CP $04          ; {Is entity spawn timer equal to #N$04? If not, jump to
 $C060 JP NZ,$EC2E     ; #R$EC2E.}
 $C063 LD A,($72B5)    ; Load #REGa with the task-two flags (#R$72B5).
 $C066 SET 2,A         ; Set bit #N$02 of task-two flags.
 $C068 LD ($72B5),A    ; Set the task-two flags (#R$72B5).
 $C06B JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Spawn Task Entity
;
; Used by the routine at #R$B2AA.
; .
; Spawn Task Entity for the current Thing Upstairs task.
;
; .
;
; Spawns a pan into a free complex-entity slot.
@label=Spawn_Task_Entity
c$C06E PUSH HL        ; Stash #REGhl on the stack.
 $C06F LD IY,$9055    ; Point #REGiy at the pan entity (#R$9055).
 $C073 SET 7,(IY+$02) ; Set bit #N$07 of the referenced entity's flags byte 2.
 $C077 LD HL,$72B5    ; Point #REGhl at the task-two flags (#R$72B5).
 $C07A RES 4,(HL)     ; Clear bit #N$04 of #R$72B5 (also set at #R$C0D2. no BIT reader
                      ; found).
 $C07C RES 5,(HL)     ; Clear bit #N$05 of #R$72B5 (also set at #R$C0D4 / cleared at
                      ; #R$C0F1. no BIT reader found).
 $C07E SET 7,(HL)     ; Set bit #N$07 of #R$72B5.
 $C080 LD A,($72BF)   ; Load #REGa with the room-transition flag (#R$72BF).
 $C083 INC A          ; Advance room-transition flag by one.
 $C084 LD ($72BF),A   ; Set the room-transition flag (#R$72BF).
 $C087 CP $04         ; {Is room-transition flag equal to #N$04? If not, jump
 $C089 JR NZ,$C08D    ; to #R$C08D.}
 $C08B SET 6,(HL)     ; Set bit #N$06 of #R$72B5 (written here when #R$72BF reaches #N$04 no
                      ; BIT reader found).
; Point the helper entity at layout #R$9E07 after arming spawn flags.
@label=Spawn_Task_Entity_PanLayout
*$C08D LD HL,$9E07    ; Point #REGhl at the pan layout #R$9E07.
 $C090 LD ($905F),HL  ; Write the layout pointer into the helper entity's layout field
                      ; (#R$8EF3(#N$905F)).
 $C093 POP HL         ; Restore #REGhl from the stack.
 $C094 RET            ; Return.

; Update Task Helper Entities
;
; Used by the routine at #R$BECD.
; .
; Update Task Helper Entities for the current Thing Upstairs task.
@label=Update_Task_Helper_Entities
c$C095 LD A,($9055)   ; Load #REGa with the pan entity's type (#R$9055).
 $C098 OR A           ; {Is #REGa zero? If so, return.
 $C099 RET Z          ; }
 $C09A LD A,($72BF)   ; Load #REGa with the room-transition flag (#R$72BF).
 $C09D OR A           ; {Is room-transition flag zero? If so, return.
 $C09E RET Z          ; }
 $C09F LD E,A         ; Keep room-transition flag in #REGe for later.
 $C0A0 LD IX,$9055    ; Point #REGix at the pan entity (#R$9055).
 $C0A4 LD HL,$72B5    ; Point #REGhl at the task-two flags (#R$72B5).
 $C0A7 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C0AA CP $84         ; {Is the current entity's x-coordinate equal to #N$84? If not, jump to
 $C0AC JR NZ,$C0DD    ; #R$C0DD.}
 $C0AE LD A,(IX+$05)  ; Load #REGa with the current entity's y-coordinate.
 $C0B1 CP $20         ; {Is the current entity's y-coordinate equal to #N$20? If not, jump to
 $C0B3 JR NZ,$C0DD    ; #R$C0DD.}
 $C0B5 LD A,($72C4)   ; Load #REGa with the stove / heater state (#R$72C4).
 $C0B8 CP $FF         ; {Is stove / heater state equal to #N$FF? If so, return.
 $C0BA RET Z          ; }
 $C0BB INC A          ; Advance stove / heater state by one.
 $C0BC LD ($72C4),A   ; Set the stove / heater state (#R$72C4).
 $C0BF CP $32         ; {Is stove / heater state equal to #N$32? If so, jump to
 $C0C1 JR Z,$C0CF     ; #R$C0CF.}
 $C0C3 CP $C8         ; {Is stove / heater state less than #N$C8? If so,
 $C0C5 RET C          ; return.}
 $C0C6 SET 3,(IX+$02) ; Set bit #N$03 of the current entity's flags byte 2.
 $C0CA LD HL,$9DD8    ; Point #REGhl at the hot pan layout (#R$9DD8).
 $C0CD JR $C0D9       ; Jump to #R$C0D9 to write the pan layout pointer.
; Heater reached #N$32: set task-two layout bits #N$04/#N$05 on #R$72B5.
@label=Update_Task_Helper_Entities_SetLayoutBit
*$C0CF LD A,E         ; Copy the saved low byte from #REGe into #REGa.
 $C0D0 OR A           ; {Is the saved room-transition flag in #REGa zero? If
 $C0D1 RET Z          ; so, return.}
 $C0D2 SET 4,(HL)     ; Set bit #N$04 of #R$72B5.
 $C0D4 SET 5,(HL)     ; Set bit #N$05 of #R$72B5 (cleared by #R$C07C / #R$C0F1. no BIT
                      ; reader found).
; Select the pan cooking layout #R$9DE3.
@label=Update_Task_Helper_Entities_PanCookingLayout
*$C0D6 LD HL,$9DE3    ; Point #REGhl at the pan cooking layout (#R$9DE3).
; Write the chosen pan layout pointer into the pan entity at
; #R$8EF3(#N$905F).
@label=Update_Task_Helper_Entities_WritePanLayout
*$C0D9 LD ($905F),HL  ; Write the layout pointer into the pan entity's layout field
                      ; (#R$8EF3(#N$905F)).
 $C0DC RET            ; Return.
; Countdown the stove/heater state (#R$72C4) and refresh pan layouts on
; thresholds.
@label=Update_Task_Helper_Entities_Countdown
*$C0DD LD A,($72C4)   ; Load #REGa with the stove / heater state (#R$72C4).
 $C0E0 OR A           ; {Is stove / heater state zero? If so, return.
 $C0E1 RET Z          ; }
 $C0E2 DEC A          ; Step stove / heater state back by one.
 $C0E3 LD ($72C4),A   ; Set the stove / heater state (#R$72C4).
 $C0E6 CP $C8         ; {Is stove / heater state equal to #N$C8? If so, jump to
 $C0E8 JR Z,$C0F5     ; #R$C0F5.}
 $C0EA CP $32         ; {Is stove / heater state equal to #N$32? If not,
 $C0EC RET NZ         ; return.}
 $C0ED LD A,E         ; Copy the saved low byte from #REGe into #REGa.
 $C0EE OR A           ; {Is the saved room-transition flag zero? If so, jump to
 $C0EF JR Z,$C0FD     ; #R$C0FD.}
 $C0F1 RES 5,(HL)     ; Clear bit #N$05 of #R$72B5.
 $C0F3 JR $C0FD       ; Jump to #R$C0FD to finish the pan update.
; Clear the pan entity's bit #N($03), then restore layout #R$9DE3 or
; #R$9E07.
@label=Update_Task_Helper_Entities_ClearFlagBit3
*$C0F5 RES 3,(IX+$02) ; Reset bit #N$03 of the current entity's flags byte 2.
 $C0F9 LD A,E         ; Copy the saved low byte from #REGe into #REGa.
 $C0FA OR A           ; {Is the saved room-transition flag zero? If not, jump
 $C0FB JR NZ,$C0D6    ; to #R$C0D6.}
; Default pan layout: point at #R$9E07 and write it through #R$C0D9.
@label=Update_Task_Helper_Entities_PanLayout
*$C0FD LD HL,$9E07    ; Point #REGhl at the pan layout #R$9E07.
 $C100 JR $C0D9       ; Jump to #R$C0D9 to write the pan layout pointer.

; Data: Task Helper Layouts
;
; Graphic layout data for task helpers (#R$C102 layout for #R$8FE5).
@label=Data_TaskHelperLayouts
b$C102 DEFB $F4,$04                                                     ; Set the
                                                                        ; graphic
                                                                        ; set to
                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C104 DEFB $FB,$3A,$C1                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C107 DEFB $FB,$8E,$C2                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C10A DEFB $F9,$03,$01,$0F,$0F,$45,$C1,$05,$05,$75,$C1,$05,$05,$97,$C1 ; Jump to a time-weighted random layout address (#R$C145,
                                                                        ; #R$C175, #R$C197).
 $C119 DEFB $F4,$04                                                     ; Set the
                                                                        ; graphic
                                                                        ; set to
                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C11B DEFB $FB,$3A,$C1                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C11E DEFB $FB,$69,$C2                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C121 DEFB $F8,$8E,$C2                                                 ; Jump to
                                                                        ; the layout
                                                                        ; at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C124 DEFB $F4,$04                                                     ; Set the
                                                                        ; graphic
                                                                        ; set to
                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C126 DEFB $FB,$3A,$C1                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C129 DEFB $FB,$69,$C2                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C12C DEFB $F8,$BC,$C2                                                 ; Jump to
                                                                        ; the layout
                                                                        ; at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C12F DEFB $F4,$04                                                     ; Set the
                                                                        ; graphic
                                                                        ; set to
                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C131 DEFB $FB,$3A,$C1                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C134 DEFB $FB,$8E,$C2                                                 ; Process the nested layout at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C137 DEFB $F8,$44,$C2                                                 ; Jump to
                                                                        ; the layout
                                                                        ; at
                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
; #UDGTABLE
; { #LAYOUT$3A,$C1,$00,$04(layout-c13a) }
; UDGTABLE#
 $C13A DEFB $F3,$00,$04,$B9,$C1,$D8,$C1,$FD,$C1,$22,$C2                 ; Increment the index and jump to one of #R$C1B9, #R$C1D8,
                                                                        ; #R$C1FD, #R$C222.
; #UDGTABLE
; { #LAYOUT$45,$C1,$00,$04(layout-c145) }
; UDGTABLE#
 $C145 DEFB $FA,$00,$01                                                 ; Move the cursor by
                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                        ; horizontally and
                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                        ; vertically.
 $C148 DEFB $01,$03,$21                                                 ; Draw tile #N(#PEEK(#PC)) with
                                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $C14B DEFB $01,$83,$1F                                                 ; Draw tile #N(#PEEK(#PC)) with
