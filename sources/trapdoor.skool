; Update Ghosts
;
; Used by the routine at #R$CAA7.
; .
; Update the ghost entities: clear their interaction latch, walk their
; scripts and queue a moan if one is active.
@label=Update_Ghosts
c$CE4B LD HL,$72B9    ; Point #REGhl at the entity interaction flag (#R$72B9).
 $CE4E BIT 3,(HL)     ; {Is bit #N$03 of #R$72B9 set? If not, return.
 $CE50 RET Z          ; }
 $CE51 RES 3,(HL)     ; Clear bit #N$03 of #R$72B9.
 $CE53 LD IX,$8F75    ; Point #REGix at the plant-pot complex entity (#R$8F75).
 $CE57 LD B,$03       ; Load #REGb with #N$03 as a loop counter.
; Scan each ghost slot: idle ones skip; active ones tick their delay or
; advance a moan frame.
@label=Update_Ghosts_Scan
*$CE59 LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $CE5C OR A           ; {Is the current entity's direction / state zero? If so, jump to
 $CE5D JR Z,$CEBF     ; #R$CEBF.}
 $CE5F CP $0B         ; {Is the current entity's direction / state less than #N$0B? If not,
 $CE61 JR NC,$CEBF    ; jump to #R$CEBF.}
 $CE63 LD A,(IX+$0C)  ; Load #REGa with the current entity's extra state.
 $CE66 OR A           ; {Is the current entity's extra state zero? If so, jump
 $CE67 JR Z,$CE6E     ; to #R$CE6E.}
 $CE69 DEC (IX+$0C)   ; Decrease the current entity's extra state.
 $CE6C JR $CEBD       ; Jump to #R$CEBD to mark this ghost slot done.
; Advance the ghost frame; at the end spawn a plant shoot via #R$CEE1 and
; raise game-event bit #N$00.
@label=Update_Ghosts_AdvanceFrame
*$CE6E LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $CE71 CP $0A         ; {Is the current entity's direction / state less than #N$0A? If so,
 $CE73 JR C,$CE8B     ; jump to #R$CE8B.}
 $CE75 LD C,$0C       ; Load #REGc with #N$0C (vertical offset passed to
                      ; #R$CEE1).
 $CE77 CALL $CEE1     ; Call #R$CEE1 to update Plant Pots.
 $CE7A SET 7,(IY+$01) ; Set bit #N$07 of the referenced entity's flags byte 1.
 $CE7E INC (IY+$04)   ; Increment the referenced entity's room index.
 $CE81 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $CE84 SET 0,A        ; Set bit #N$00 of game event flags.
 $CE86 LD ($72B3),A   ; Set the game event flags (#R$72B3).
 $CE89 LD A,$0A       ; Load #REGa with #N$0A.
; Install the next ghost layout from table #R$CEC9; frame #N$07 uses a
; fixed moan delay.
@label=Update_Ghosts_WriteLayoutFromTable
*$CE8B INC A          ; Advance the ghost frame index in #REGa by one.
 $CE8C LD (IX+$09),A  ; Set the current entity's direction / state.
 $CE8F ADD A,A        ; Double #N$0A (word index).
 $CE90 LD E,A         ; Keep #N$0A in #REGe for later.
 $CE91 LD D,$00       ; Clear #REGd (high byte of a pointer/offset).
 $CE93 PUSH HL        ; Stash #REGhl on the stack.
 $CE94 LD HL,$CEC9    ; Point #REGhl at ghost script/table data (#R$CEC9).
 $CE97 ADD HL,DE      ; Add the offset in #REGde to the pointer in #REGhl.
 $CE98 LD A,(HL)      ; Fetch the next byte from #R$CEC9.
 $CE99 LD (IX+$0A),A  ; Set the current entity's graphic layout address (low).
 $CE9C INC HL         ; Advance #R$CEC9 by one byte.
 $CE9D LD A,(HL)      ; Fetch the next byte from #R$CEC9.
 $CE9E LD (IX+$0B),A  ; Set the current entity's graphic layout address (high).
 $CEA1 POP HL         ; Restore #REGhl from the stack.
 $CEA2 LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $CEA5 CP $07         ; {Is the current entity's direction / state equal to #N$07? If not,
 $CEA7 JR NZ,$CEAD    ; jump to #R$CEAD.}
 $CEA9 LD A,$05       ; Load #REGa with #N$05.
 $CEAB JR $CEB5       ; Jump to #R$CEB5 to store the ghost's extra state.
; Pick a random extra-state delay from the current frame index.
@label=Update_Ghosts_RandomExtraState
*$CEAD ADD A,A        ; Double the frame index in #REGa.
 $CEAE ADD A,A        ; {Multiply #REGa by #N$04 to form a table index.
 $CEAF ADD A,A        ; }
 $CEB0 LD C,A         ; Keep #N$05 in #REGc for later.
 $CEB1 CALL $EAE5     ; {Call #R$EAE5 to pick a pseudo-random value and add the saved count
 $CEB4 ADD A,C        ; in #REGc.}
; Arm the ghost's moan delay and queue sound #N$0F via #R$F8F9.
@label=Update_Ghosts_StoreExtraAndMoan
*$CEB5 LD (IX+$0C),A  ; Set the current entity's extra state.
; #HTML(#AUDIO0(ghost.wav)(#INCLUDE(Ghost)))
 $CEB8 LD A,$0F       ; Load #REGa with #N$0F.
 $CEBA CALL $F8F9     ; Call #R$F8F9 to queue a sound effect.
; Retrigger interaction bit #N$03 of #R$72B9 so #R$CE4B will scan again.
@label=Update_Ghosts_RetriggerBit3
*$CEBD SET 3,(HL)     ; Set bit #N$03 of #R$72B9.
; Advance to the next ghost slot and loop until all #N$03 are done.
@label=Update_Ghosts_AdvanceSlot
*$CEBF LD DE,$000E    ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                      ; length into #REGde.
 $CEC2 ADD IX,DE      ; Advance #REGix to the next entity record.
 $CEC4 DEC B          ; Step the loop counter in #REGb back by one.
 $CEC5 JP NZ,$CE59    ; If the result was non-zero, jump to #R$CE59.
 $CEC8 RET            ; Return.
 $CEC9 ADD A,D        ; Add #REGd into #REGa while building a 16-bit
                      ; entity/screen address.
 $CECA AND B          ; Mask #N$0F with #REGb.
 $CECB ADD A,D        ; Add #REGd into #REGa while building a 16-bit
                      ; entity/screen address.
 $CECC AND B          ; {Mask #REGa with #REGb.
 $CECD AND B          ;
 $CECE AND B          ; }
 $CECF XOR C          ; Toggle bits of the flag byte in #REGa using #REGc.
 $CED0 AND B          ; Mask #N$0F with #REGb.
 $CED1 XOR A          ; Clear #REGa.
 $CED2 AND B          ; Mask #N$0F with #REGb.
 $CED3 OR L           ; Merge another flag byte into #N$0F.
 $CED4 AND B          ; Mask #N$0F with #REGb.
 $CED5 CP E           ; Compare #N$0F with #REGe.
 $CED6 AND B          ; Mask #N$0F with #REGb.
 $CED7 ADC A,$A0      ; Add #N$A0 into #REGa (with carry) for an attribute
                      ; address.
 $CED9 JP C,$E3A0     ; If a hit/borrow was signaled, jump to #R$E376(#N$E3A0).
 $CEDC AND B          ; Mask #N$0F with #REGb.
 $CEDD JP P,$F8A0     ; Jump to #R$F8A0 if the sign flag is reset.
 $CEE0 AND B          ; Mask #N$0F with #REGb.

; Update Plant Pots
;
; Used by the routines at #R$B440 and #R$CE4B.
; .
; Spawn a plant shoot into the first free collectible-eye slot when a pot
; germinates. #REGix addresses the pot; free slots are sought from #R$8F4B
; onwards.
;
; IX Address of the plant-pot complex state data
; C Vertical offset applied when placing the shoot above the pot
;
; Stash #REGde (caller-preserved) while the free eye slot is found.
@label=Update_Plant_Pots
c$CEE1 PUSH DE         ; Stash #REGde on the stack.
 $CEE2 LD IY,$8F4B     ; Point #REGiy at the first collectible-eye slot
                       ; (#R$8F4B).
 $CEE6 LD DE,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGde.
; Find the first free collectible-eye slot.
@label=Update_Plant_Pots_FindFreeSlot
*$CEE9 LD A,(IY+$00)   ; {Fetch this eye slot's entity type, then is the slot empty (type
 $CEEC OR A            ; #N$00)?.}
 $CEED JR Z,$CEF3      ; If so, plant the shoot here at #R$CEF3.
 $CEEF ADD IY,DE       ; Otherwise advance #REGiy to the next entity record.
 $CEF1 JR $CEE9        ; Keep scanning at #R$CEE9.
; Place the shoot in that slot, matching the pot's room and position.
@label=Update_Plant_Pots_PlaceShoot
*$CEF3 LD (IY+$00),$0E ; Mark the free slot as a plant shoot (type #N$0E).
 $CEF7 LD A,(IX+$05)   ; Load the pot's y-coordinate.
 $CEFA SUB C           ; Raise the shoot by the caller's offset in #REGc.
 $CEFB LD (IY+$05),A   ; Write that as the shoot's y-coordinate.
 $CEFE ADD A,$02       ; Make the shoot two characters tall.
 $CF00 LD (IY+$06),A   ; Write the shoot's y-extent.
 $CF03 LD A,(IX+$07)   ; Fetch the pot's x-coordinate.
 $CF06 LD (IY+$07),A   ; Place the shoot on the same x.
 $CF09 ADD A,$02       ; Make the shoot two characters wide.
 $CF0B LD (IY+$08),A   ; Write the shoot's x-extent.
 $CF0E LD A,(IX+$04)   ; Fetch the pot's room index.
 $CF11 LD (IY+$04),A   ; Keep the shoot in the same room as the pot.
 $CF14 LD (IY+$0A),$1B ; {Set the shoot's graphic layout to #R$A11B.
 $CF18 LD (IY+$0B),$A1 ; }
 $CF1C POP DE          ; Restore #REGde from the stack.
 $CF1D RET             ; Return.

; Update Crusher
;
; Used by the routine at #R$B2AA.
; .
; Called from #R$B2AA on the crusher entity path: set bit #N$04 of
; #R$72B9, advance the shared tick at #R$72C2, and once that tick reaches
; #N$03 also set bit #N$06. Bit #N$07 is set on every call.
;
; .
;
; Mark Berk crushed and advance the shared tick.
@label=Update_Crusher
c$CF1E PUSH HL       ; Stash #REGhl on the stack.
 $CF1F LD HL,$72B9   ; Point #REGhl at the entity interaction flag (#R$72B9).
 $CF22 SET 4,(HL)    ; Set bit #N$04 of #R$72B9.
 $CF24 LD A,($72C2)  ; Load the shared tick (#R$72C2) into #REGa.
 $CF27 INC A         ; Advance the shared tick by one.
 $CF28 LD ($72C2),A  ; Store the shared tick (#R$72C2).
 $CF2B CP $03        ; {Is the shared tick still under #N$03? If so, skip bit #N$06 at
 $CF2D JR C,$CF31    ; #R$CF31.}
 $CF2F SET 6,(HL)    ; Set bit #N$06 of #R$72B9.
; Raise bit #N$07 of #R$72B9 and return.
@label=Update_Crusher_Active
*$CF31 SET 7,(HL)    ; Set bit #N$07 of #R$72B9.
 $CF33 POP HL        ; Restore #REGhl from the stack.
 $CF34 RET           ; Return.

; Temporary Entity Pointer
;
; Pointer used while updating miscellaneous entities.
@label=TemporaryEntityPointer_Misc
g$CF35 DEFW $0000

; Update Miscellaneous Entities
;
; Used by the routine at #R$AAB3.
; .
; Per-frame hook for non-task entities: refresh collectibles and the vat,
; then snapshot the script cursor so the next vat pass can reload it.
@label=Update_Miscellaneous_Entities
c$CF37 CALL $D45B    ; Call #R$D45B to update Collectibles.
 $CF3A CALL $D012    ; Call #R$D012 to update Vat.
; Copy the script position from #R$72CF to #R$72D3 so #R$D012 can reload
; that cursor into #R$72CF on its next entry.
 $CF3D LD HL,($72CF) ; Load #REGhl with the active script cursor (#R$72CF).
 $CF40 LD ($72D3),HL ; Store #REGhl in the Drutt script-position pointer
                     ; (#R$72D3).
 $CF43 RET           ; Return.

; Data: Drutt Scripts
;
; Drutt animation scripts. The type-#N$0C entity in the crusher slot
; at #R$8FC9 uses Drutt's layout #R$D234. #R$D030 runs #R$CF44 when that
; entity is active. #R$D057 enters #R$CF88, #R$D0E0 enters #R$CFFE, and
; #R$D22E enters #R$CFF4.
;
; .
;
; Idle and bubble script entered from #R$D030.
; .
; #UDGTABLE
; { #SCRIPTANIM$CF44(script-cf44) }
; UDGTABLE#
@label=Data_DruttScripts
b$CF44 DEFB $5C,$D2,$34,$D2 ; Graphic-layout pointer #R$D25C; Graphic-layout pointer
                            ; #R$D234.
 $CF48 DEFB $43,$D2         ; Graphic-layout pointer #R$D243.
 $CF4A DEFB $43,$D2         ; Graphic-layout pointer #R$D243.
 $CF4C DEFB $34,$D2         ; Graphic-layout pointer #R$D234.
 $CF4E DEFB $43,$D2         ; Graphic-layout pointer #R$D243.
 $CF50 DEFB $43,$D2         ; Graphic-layout pointer #R$D243.
 $CF52 DEFW $003E           ; Script opcode #N$3E (Drutt action).
; Near-range Drutt script.
@label=DruttScript_Near
 $CF54 DEFB $B1,$D2         ; Graphic-layout pointer #R$D2B1.
 $CF56 DEFW $0040           ; Script opcode #N$40 (Drutt action).
 $CF58 DEFB $C5,$D2         ; Graphic-layout pointer #R$D2C5.
 $CF5A DEFW $0040           ; Script opcode #N$40 (Drutt action).
 $CF5C DEFB $D2,$D2         ; Graphic-layout pointer #R$D2D2.
 $CF5E DEFW $0043           ; Script opcode #N$43 (Drutt action).
 $CF60 DEFW $0042           ; Script opcode #N$42 (Drutt action).
 $CF62 DEFB $DC,$D2         ; Graphic-layout pointer #R$D2DC.
 $CF64 DEFW $0042           ; Script opcode #N$42 (Drutt action).
 $CF66 DEFW $003E           ; Script opcode #N$3E (Drutt action).
 $CF68 DEFW $0042           ; Script opcode #N$42 (Drutt action).
 $CF6A DEFB $DC,$D2         ; Graphic-layout pointer #R$D2DC.
 $CF6C DEFW $0042           ; Script opcode #N$42 (Drutt action).
 $CF6E DEFB $DC,$D2         ; Graphic-layout pointer #R$D2DC.
 $CF70 DEFW $0044           ; Script opcode #N$44 (Drutt action).
 $CF72 DEFB $B1,$D2         ; Graphic-layout pointer #R$D2B1.
 $CF74 DEFW $003E           ; Script opcode #N$3E (Drutt action).
; Alternate Drutt script.
@label=DruttScript_Alt
 $CF76 DEFB $B1,$D2         ; Graphic-layout pointer #R$D2B1.
 $CF78 DEFW $0040           ; Script opcode #N$40 (Drutt action).
 $CF7A DEFB $C5,$D2         ; Graphic-layout pointer #R$D2C5.
 $CF7C DEFW $0040           ; Script opcode #N$40 (Drutt action).
 $CF7E DEFB $D2,$D2         ; Graphic-layout pointer #R$D2D2.
 $CF80 DEFW $0042           ; Script opcode #N$42 (Drutt action).
 $CF82 DEFB $DC,$D2         ; Graphic-layout pointer #R$D2DC.
 $CF84 DEFW $0044           ; Script opcode #N$44 (Drutt action).
 $CF86 DEFW $003E           ; Script opcode #N$3E (Drutt action).
; Drutt script launched after copying the template.
@label=DruttScript_Copy
 $CF88 DEFB $FB,$D2         ; Graphic-layout pointer #R$D2FB.
 $CF8A DEFW $003F           ; Script opcode #N$3F (Drutt action).
 $CF8C DEFB $0F,$D3         ; Graphic-layout pointer #R$D30F.
 $CF8E DEFW $003F           ; Script opcode #N$3F (Drutt action).
 $CF90 DEFB $1C,$D3         ; Graphic-layout pointer #R$D31C.
 $CF92 DEFW $0043           ; Script opcode #N$43 (Drutt action).
 $CF94 DEFW $0041           ; Script opcode #N$41 (Drutt action).
 $CF96 DEFB $26,$D3         ; Graphic-layout pointer #R$D326.
 $CF98 DEFW $0041           ; Script opcode #N$41 (Drutt action).
 $CF9A DEFW $003E           ; Script opcode #N$3E (Drutt action).
 $CF9C DEFW $0041           ; Script opcode #N$41 (Drutt action).
 $CF9E DEFB $26,$D3         ; Graphic-layout pointer #R$D326.
 $CFA0 DEFW $0041           ; Script opcode #N$41 (Drutt action).
 $CFA2 DEFB $26,$D3         ; Graphic-layout pointer #R$D326.
 $CFA4 DEFW $0044           ; Script opcode #N$44 (Drutt action).
 $CFA6 DEFB $FB,$D2         ; Graphic-layout pointer #R$D2FB.
 $CFA8 DEFW $003E           ; Script opcode #N$3E (Drutt action).
; Drutt script used when the scan picks a candidate.
@label=DruttScript_Scan
 $CFAA DEFB $FB,$D2         ; Graphic-layout pointer #R$D2FB.
 $CFAC DEFW $003F           ; Script opcode #N$3F (Drutt action).
 $CFAE DEFB $0F,$D3         ; Graphic-layout pointer #R$D30F.
