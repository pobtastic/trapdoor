; Data: Task Four Script
;
; Task-four script words for #R$EC30. #R$CADF loads this address into
; #REGhl and #R$CAE2 stores it in the active script cursor (#R$72CF).
; #R$CAC0 later copies that cursor to #R$72D7. #R$CAFE enters at #R$CA79.
; #R$CB44 enters at #R$CA9B.
;
; .
;
; Script entry loaded by #R$CADF.
@label=Data_TaskFourScript
b$CA23 DEFW $CCBA    ; Graphic-layout pointer #R$CCBA.
 $CA25 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $CA27 DEFB $06,$00  ; Loop count #N$06 (#R$EC53 reads only the low byte).
 $CA29 DEFW $CCBA    ; Graphic-layout pointer #R$CCBA.
 $CA2B DEFW $0022    ; Script opcode #N$22 (end script loop).
 $CA2D DEFW $004E    ; Script opcode #N$4E (arm the task-four script-active
                     ; flags).
 $CA2F DEFW $0049    ; Script opcode #N$49 (raise the task-four creature).
 $CA31 DEFW $CCE6    ; Graphic-layout pointer #R$CCE6.
 $CA33 DEFW $0049    ; Script opcode #N$49 (raise the task-four creature).
 $CA35 DEFW $004F    ; Script opcode #N$4F (randomise the creature's extra
                     ; state).
 $CA37 DEFW $0001    ; Script opcode #N$01 (jump to script address).
 $CA39 DEFW $CA43    ; Jump to script address #R$CA43.
; Script fragment reached from #R$CA77.
 $CA3B DEFW $CCC8    ; Graphic-layout pointer #R$CCC8.
 $CA3D DEFW $CCCE    ; Graphic-layout pointer #R$CCCE.
 $CA3F DEFW $CCD4    ; Graphic-layout pointer #R$CCD4.
 $CA41 DEFW $CCDA    ; Graphic-layout pointer #R$CCDA.
; Script fragment reached from #R$CA39.
 $CA43 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $CA45 DEFB $04,$00  ; Loop count #N$04 (#R$EC53 reads only the low byte).
 $CA47 DEFW $CCE6    ; Graphic-layout pointer #R$CCE6.
 $CA49 DEFW $0049    ; Script opcode #N$49 (raise the task-four creature).
 $CA4B DEFW $0022    ; Script opcode #N$22 (end script loop).
; Script fragment reached from #R$CA99.
 $CA4D DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $CA4F DEFB $05,$00  ; Loop count #N$05 (#R$EC53 reads only the low byte).
 $CA51 DEFW $CCB9    ; Graphic-layout pointer #R$CCB9.
 $CA53 DEFW $0022    ; Script opcode #N$22 (end script loop).
 $CA55 DEFW $004B    ; Script opcode #N$4B (nudge the creature toward its
                     ; target).
 $CA57 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $CA59 DEFB $02,$00  ; Loop count #N$02 (#R$EC53 reads only the low byte).
 $CA5B DEFW $CCE6    ; Graphic-layout pointer #R$CCE6.
