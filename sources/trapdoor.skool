 $73E9 DEFB %00001011,%10001011,%01001011,%11001011,%00101011,%10101011,%01101011,%11101011
 $73F1 DEFB %00011011,%10011011,%01011011,%11011011,%00111011,%10111011,%01111011,%11111011
 $73F9 DEFB %00000111,%10000111,%01000111,%11000111,%00100111,%10100111,%01100111,%11100111
 $7401 DEFB %00010111,%10010111,%01010111,%11010111,%00110111,%10110111,%01110111,%11110111
