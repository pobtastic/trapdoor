; LIST#

; Graphic Layout Routine: (#N$F5) Set Next Graphic Index From Random List
;
; Pick the next graphic-set index from the layout's random list.
@label=GraphicLayoutRoutine_SetGraphicFromRandomList
c$E847 PUSH IX       ; Stash #REGix on the stack.
 $E849 LD A,(IX+$00) ; Fetch the current entity's type into #REGa.
 $E84C CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $E84F INC A         ; Step the random-list index on by one.
 $E850 LD B,$00      ; Load #REGb with #N$00.
 $E852 LD C,A        ; Keep the table index in #REGc.
 $E853 ADD IX,BC     ; #REGix+=#REGbc.
 $E855 LD A,(IX+$00) ; Fetch the current entity's type into #REGa.
 $E858 POP IX        ; Restore #REGix from the stack.
 $E85A LD C,(IX+$00) ; Load #REGc with the current entity's entity type.
 $E85D INC C         ; Advance the saved count in #REGc by one.
 $E85E ADD IX,BC     ; #REGix+=#REGbc.
 $E860 LD (IX+$00),A ; Set the current entity's entity type.
 $E863 JP $E73F      ; Jump to #R$E73F to process graphic layout data.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9A8B }
; LIST#

; Graphic Layout Routine: (#N$FF) Load Stored Coordinates And Return
