 $CFFE DEFB $89,$D3         ; Graphic-layout pointer #R$D389.
 $D000 DEFW $0047           ; Script opcode #N$47 (Drutt action).
 $D002 DEFB $89,$D3         ; Graphic-layout pointer #R$D389.
 $D004 DEFB $89,$D3         ; Graphic-layout pointer #R$D389.
 $D006 DEFB $89,$D3         ; Graphic-layout pointer #R$D389.
 $D008 DEFB $71,$D3         ; Graphic-layout pointer #R$D371.
 $D00A DEFB $71,$D3         ; Graphic-layout pointer #R$D371.
 $D00C DEFB $71,$D3         ; Graphic-layout pointer #R$D371.
 $D00E DEFB $71,$D3         ; Graphic-layout pointer #R$D371.
