; Game Restart
;
; Used by the routines at #R$AAB3 and #R$AB95.
; .
; Re-enter the main loop after a completed game cycle: refresh the high
; score, re-initialise entity data, then join #R$AAB3 at #R$AAC2.
@label=GameRestart
c$AAAB CALL $F6A6    ; Call #R$F6A6 to update the high-score display.
 $AAAE CALL $AB31    ; Call #R$AB31 to initialise entity data.
 $AAB1 JR $AAC2      ; Jump to #R$AAC2 to re-enter the main loop.

; Game Start
;
; Used by the routine at #R$72A0.
; .
; Relocate the menu-music code, show the main menu, set up a new game,
; then enter the main loop.
@label=GameStart
c$AAB3 DI            ; Disable interrupts.
 $AAB4 LD HL,$6F04   ; Point #REGhl at #R$6F04.
 $AAB7 LD DE,$FC6C   ; #REGde=#R$FC6C.
 $AABA LD BC,$0393   ; Load #REGbc with #N$0393 (menu-music source copy
                     ; length).
 $AABD LDIR          ; Copy the menu-music source to #R$FC6C.
 $AABF CALL $FC6C    ; Call #R$FC6C to seed the menu music and wait for a key.
; This entry point is used by the routine at #R$AAAB.
; .
; Seed RNG from #SKOOLKID$5C78(FRAMES), run the main menu, initialise a
; new game, then tick the world.
@label=GameStart_MainLoopEntry
*$AAC2 LD A,($5C78)  ; {Fetch #SKOOLKID$5C78(FRAMES), then seed the random scratch byte
 $AAC5 LD ($EAE2),A  ; (#R$EAE2).}
 $AAC8 CALL $F3EF    ; Call #R$F3EF to display and handle the main menu.
 $AACB CALL $AF3C    ; Call #R$AF3C to initialise a new game.
; Per-frame update: controls, camera, Berk, task entities, Drutt, physics,
; messaging, blit.
@label=GameStart_FrameLoop
*$AACE CALL $F603    ; Call #R$F603 to read the player controls into #R$F5F8.
 $AAD1 CALL $F1F3    ; Call #R$F1F3 to update the camera follow.
; Update Berk's task/idle state and drive him from the control bitmap.
 $AAD4 CALL $AB95    ; Call #R$AB95 to update Berk's state.
 $AAD7 CALL $B41A    ; Call #R$B41A to update Berk's controller.
; Tick the current Thing Upstairs task entities (tasks two–four) plus the
; Thing Upstairs entity.
 $AADA CALL $BECD    ; Call #R$BECD to update task-two entities.
 $AADD CALL $C378    ; Call #R$C378 to update task-three entities.
 $AAE0 CALL $CAA7    ; Call #R$CAA7 to update task-four entities.
 $AAE3 CALL $BC12    ; Call #R$BC12 to update the Thing Upstairs entity.
 $AAE6 CALL $CF37    ; Call #R$CF37 to update miscellaneous entities.
; Advance timed events, Drutt, falling/rising physics and Bad Tempered
; Thing dialogue.
 $AAE9 CALL $ADA1    ; Call #R$ADA1 to update timed events.
 $AAEC CALL $B034    ; Call #R$B034 to update Drutt.
 $AAEF CALL $B258    ; Call #R$B258 to process special entity flags.
 $AAF2 CALL $B1A9    ; Call #R$B1A9 to process falling entities.
 $AAF5 CALL $B21E    ; Call #R$B21E to process rising entities.
 $AAF8 CALL $D7D3    ; Call #R$D7D3 to update Bad Tempered Thing dialogue.
 $AAFB CALL $AF7F    ; Call #R$AF7F to check task completion.
; Clear, populate and blit the display buffers, then play any queued
; sound.
 $AAFE CALL $EA44    ; Call #R$EA44 to clear the display buffer.
 $AB01 CALL $E6DB    ; Call #R$E6DB to populate the display buffer for visible
                     ; entities.
 $AB04 CALL $E991    ; Call #R$E991 to blit the display buffer to the screen.
 $AB07 CALL $F9AF    ; Call #R$F9AF to play any queued sound.
; Flip the double-buffer select and continue unless the camera-follow
; entity has been cleared (death).
 $AB0A LD HL,$63A0   ; Point #REGhl at display buffer A (#R$63A0).
 $AB0D LD DE,$6B20   ; Point #REGde at display buffer B (#R$6B20).
 $AB10 LD A,($72EA)  ; Fetch the display-buffer select flag (#R$72EA).
 $AB13 XOR %00000001 ; Toggle bit #N$00 of #REGa.
 $AB15 LD ($72EA),A  ; Store it back at #R$72EA.
 $AB18 JR Z,$AB1B    ; If it is now zero, keep #REGhl = buffer A at #R$AB1B.
 $AB1A EX DE,HL      ; Otherwise swap so #REGhl = buffer B.
; Remember the active display buffer, then loop another frame while the
; camera-follow entity is still alive.
@label=GameStart_StoreBufferPointer
*$AB1B LD ($72F5),HL ; Store the active display-buffer pointer at #R$72F5.
 $AB1E LD A,($909B)  ; {Fetch the camera-follow entity type (#R$909B). Is the camera-follow
 $AB21 OR A          ; entity still active? If so, jump to #R$AACE for another frame.
 $AB22 JP NZ,$AACE   ; }
; Death / end-of-life: print the death line, blit, show ratings, restart.
 $AB25 CALL $DFB5    ; Call #R$DFB5 to print the death message.
 $AB28 CALL $E991    ; Call #R$E991 to blit the display buffer to the screen.
 $AB2B CALL $DE19    ; Call #R$DE19 to print status / rating messages.
 $AB2E JP $AAAB      ; Jump to #R$AAAB to restart the game.

; Initialise Entity Data
;
; Used by the routine at #R$AAAB.
; .
; Initialise Entity Data walking the entity tables at #R$8B69 / #R$8EE9.
@label=Initialise_Entity_Data
c$AB31 LD HL,$FA0E     ; Point #REGhl at the entity-state backup buffer
                       ; (#R$FA0E).
 $AB34 LD DE,$8EE9     ; Point #REGde at Boney's complex entity state
                       ; (#R$8EE9).
 $AB37 LD BC,($72A3)   ; Load #REGbc with the entity-state copy length
                       ; (#R$72A3).
 $AB3B LDIR            ; Copy the block at #REGhl to #REGde.
; Reset the dumb waiter's y-band and prepare to stamp closed-trap types.
 $AB3D LD IX,$8D7D     ; Point #REGix at the dumb-waiter entity (#R$8D7D).
 $AB41 LD (IX+$05),$1D ; Write #N$1D to the current entity's y-coordinate.
 $AB45 LD (IX+$06),$23 ; Write #N$23 to the current entity's y-extent.
 $AB49 LD HL,$EDC9     ; Point #REGhl at the closed-trap type list (#R$EDC9).
 $AB4C LD IX,$8E87     ; Point #REGix at the simple-entity slot at #R$8E87.
 $AB50 LD DE,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGde.
 $AB53 LD B,$06        ; Load #REGb with #N$06 as a loop counter.
; Walk the simple-entity slots and apply each closed-trap type from
; #R$EDC9, then restore the closed-trap lever.
@label=Initialise_Entity_Data_ApplyType
*$AB55 LD A,(HL)       ; Fetch the next byte from #R$EDC9.
 $AB56 LD (IX+$00),A   ; Set the current entity's entity type.
 $AB59 INC HL          ; Advance #R$EDC9 by one byte.
 $AB5A ADD IX,DE       ; Advance #REGix to the next entity record.
 $AB5C DJNZ $AB55      ; Decrease the loop counter in #REGb and jump to #R$AB55 if more
                       ; iterations remain.
; Point the lever at closed facing right, then restore task/game state
; from the backup.
 $AB5E LD HL,$A809     ; Point #REGhl at the lever closed, facing right
                       ; (#R$A809).
 $AB61 LD ($9177),HL   ; Write the lever layout pointer to #R$9177.
 $AB64 LD HL,($72A7)   ; Load #REGhl with the entity-state backup end pointer
                       ; (#R$72A7).
 $AB67 LD DE,$72AE     ; Point #REGde at the current task index (#R$72AE).
 $AB6A LD BC,($72A5)   ; Load #REGbc with the game-state copy length (#R$72A5).
 $AB6E LDIR            ; Copy the block at #REGhl to #REGde.
 $AB70 RET             ; Return.

; Data: Berk Idle Script Selectors
;
; Short selector table passed to #R$ACE4 when Berk is idle and a task is
; active (#R$ABB5).
@label=Data_BerkIdleScriptSelectors
b$AB71 DEFB $00,$02,$03,$04,$40

; Initialise Entity Defaults
;
; Used by the routine at #R$AB95.
; .
; Initialise Entity Defaults walking the entity tables at #R$8B69 /
; #R$8EE9.
@label=Initialise_Entity_Defaults
c$AB76 LD IX,$8F75     ; Point #REGix at the plant-pot complex entity
                       ; (#R$8F75).
 $AB7A LD DE,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGde.
 $AB7D LD HL,$A082     ; Point #REGhl at Graphic Layout Data: Entity Type #N$0F
                       ; (#R$A082).
 $AB80 LD B,$03        ; Load #REGb with #N$03 as a loop counter.
; Stamp default type/flags/layout onto each plant-pot entity slot and walk
; to the next.
@label=Initialise_Entity_Defaults_WriteType
*$AB82 LD (IX+$00),$12 ; Write #N$12 to the current entity's entity type.
 $AB86 LD (IX+$01),$1B ; Write #N$1B to the current entity's flags byte 1.
 $AB8A LD (IX+$0A),L   ; Set the low byte of the current entity's graphic layout address from
                       ; #REGl.
 $AB8D LD (IX+$0B),H   ; Set the high byte of the current entity's graphic layout address
                       ; from #REGh.
 $AB90 ADD IX,DE       ; Advance #REGix to the next entity record.
 $AB92 DJNZ $AB82      ; Decrease the loop counter in #REGb and jump to #R$AB82 if more
                       ; iterations remain.
 $AB94 RET             ; Return.

; Update Berk State
;
; Used by the routine at #R$AAB3.
; .
; Update Berk State for the player character using complex state at
; #R$8EE9.
;
; .
;
; Checks the current task phase/index, Berk action lock and timed events
; before driving Berk scripts.
@label=Update_Berk_State
c$AB95 LD A,($72AF)  ; {Load #REGa with the current task phase (#R$72AF). Is the current
 $AB98 OR A          ; task phase inactive (zero)? If not, skip to the timed-event checks at #R$ABC0.
 $AB99 JR NZ,$ABC0   ; }
 $AB9B LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $AB9E BIT 1,A       ; {Is bit #N$01 of the game event flags set? If so, jump
 $ABA0 JR NZ,$ABC0   ; to #R$ABC0.}
 $ABA2 LD A,($72C8)  ; Load #REGa with Berk's action lock (#R$72C8).
 $ABA5 OR A          ; {Is Berk's action lock zero? If not, jump to #R$ABAB.
 $ABA6 JR NZ,$ABAB   ; }
 $ABA8 INC A         ; Set #REGa to #N$01 ready to store as the task phase.
 $ABA9 JR $ABBD      ; Jump to #R$ABBD to store the task phase.
; Branch on the current task index: finish phase #N($05), tick when idle,
; or start an idle Berk script.
@label=Update_Berk_State_ByTaskIndex
*$ABAB LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $ABAE CP $05        ; {Is the current task index equal to #N$05? If so, jump
 $ABB0 JR Z,$ABBD    ; to #R$ABBD.}
 $ABB2 OR A          ; {Is the current task index zero? If so, jump to #R$ABC0.
 $ABB3 JR Z,$ABC0    ; }
 $ABB5 LD HL,$AB71   ; Point #REGhl at Berk's idle script selectors (#R$AB71).
 $ABB8 LD A,$04      ; Load #REGa with #N$04 as the candidate-row count.
 $ABBA CALL $ACE4    ; Call #R$ACE4 to start Berk's script.
; Store the chosen task phase into #R$72AF.
@label=Update_Berk_State_SetTaskPhase
*$ABBD LD ($72AF),A  ; Set the current task phase (#R$72AF).
; Count down the game tick; when it hits zero, continue into the idle/task
; branch.
@label=Update_Berk_State_TickCounter
*$ABC0 LD HL,$72F2   ; Point #REGhl at the game tick counter (#R$72F2).
 $ABC3 LD A,(HL)     ; Fetch the game tick counter into #REGa.
 $ABC4 OR A          ; {Is the game tick counter zero? If so, jump to #R$ABC9.
 $ABC5 JR Z,$ABC9    ; }
 $ABC7 DEC (HL)      ; Decrease the game tick counter.
 $ABC8 RET           ; Return.
; With no active task, either run Berk's action path or pick a random
; idle-script selector.
@label=Update_Berk_State_Branch
*$ABC9 LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $ABCC OR A          ; {Is the current task index zero? If not, jump to
 $ABCD JR NZ,$AC48   ; #R$AC48.}
 $ABCF LD A,($72B4)  ; Load #REGa with the task status flags (#R$72B4).
 $ABD2 BIT 0,A       ; {Is bit #N$00 of the task status flags set? If so, jump
 $ABD4 JR NZ,$AC29   ; to #R$AC29.}
 $ABD6 LD HL,$72C9   ; Point #REGhl at #R$72C9.
 $ABD9 LD A,($72C8)  ; Load #REGa with Berk's action lock (#R$72C8).
 $ABDC OR A          ; {Is Berk's action lock zero? If not, jump to #R$ABE5.
 $ABDD JR NZ,$ABE5   ; }
 $ABDF INC A         ; {Advance Berk's action lock by one.
 $ABE0 LD ($72C8),A  ; }
 $ABE3 JR $AC15      ; Jump to #R$AC15 with task #N$01 in #REGa.
; Pick a random task-selection slot and prepare to try up to #N$04
; candidates.
@label=Update_Berk_State_RandomActionPick
*$ABE5 LD A,$04      ; Load #REGa with #N$04.
 $ABE7 CALL $EAE5    ; {Call #R$EAE5 to pick a pseudo-random offset and keep it
 $ABEA LD C,A        ; in #REGc.}
 $ABEB LD B,$00      ; Clear #REGb so #REGbc is the random offset alone.
 $ABED ADD HL,BC     ; Advance #REGhl by the random offset in #REGbc.
 $ABEE LD A,$04      ; Load #REGa with #N$04 as the try counter.
; Skip used task slots; free slots fall through, used ones try the next
; candidate.
@label=Update_Berk_State_TrySelectorRow
*$ABF0 BIT 7,(HL)    ; {Is this task slot already used (bit #N$07)? If not,
 $ABF2 JR Z,$AC14    ; jump to #R$AC14.}
 $ABF4 INC HL        ; Advance the pointer in #REGhl by one byte.
 $ABF5 BIT 6,(HL)    ; {Is the wrap marker (bit #N$06) clear? If so, jump to
 $ABF7 JR Z,$ABFC    ; #R$ABFC.}
 $ABF9 LD HL,$72C9   ; Point #REGhl at #R$72C9.
; Exhaust selector tries, then either run Berk's action or force task
; index #N$05 after resetting defaults.
@label=Update_Berk_State_DecTryCounter
*$ABFC DEC A         ; Decrease the try counter in #REGa.
 $ABFD JR NZ,$ABF0   ; Jump to #R$ABF0 while tries remain.
 $ABFF LD A,($72B0)  ; Load #REGa with the dialogue line index (#R$72B0).
 $AC02 CP $04        ; {Is the dialogue line index less than #N$04? If so, jump
 $AC04 JP C,$AC29    ; to #R$AC29.}
 $AC07 LD A,($72A9)  ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $AC0A OR A          ; {Is the Learner Berk mode flag zero? If not, jump to
 $AC0B JR NZ,$AC29   ; #R$AC29.}
 $AC0D CALL $AB76    ; Call #R$AB76 to initialise entity defaults.
 $AC10 LD A,$05      ; Load #REGa with #N$05.
 $AC12 JR $AC17      ; Jump to #R$AC17 to store task index #N$05.
; Take the free selector byte as the new task index.
@label=Update_Berk_State_TakeSelectorByte
*$AC14 LD A,(HL)     ; Fetch the selected byte through #REGhl into #REGa.
; Mark the selected task slot as used with bit #N$07.
@label=Update_Berk_State_MarkTaskSlotUsed
*$AC15 SET 7,(HL)    ; Mark the selected task slot as used (bit #N$07).
; Announce the new task, reset the text cursor, seed the held-entity
; countdown and refresh the room display.
@label=Update_Berk_State_SetTaskIndexAndAnnounce
*$AC17 LD ($72AE),A  ; Set the current task index (#R$72AE).
 $AC1A CALL $DE51    ; Call #R$DE51 to print a message by index.
 $AC1D CALL $AD47    ; Call #R$AD47 to reset the text position.
 $AC20 LD A,$A0      ; Load #REGa with #N$A0.
 $AC22 LD ($72DB),A  ; Set the held-entity pointer (#R$72DB).
 $AC25 CALL $AF01    ; Call #R$AF01 to initialise the room display.
 $AC28 RET           ; Return.
; Run Berk's action handler; if task status bit #N$05 is set, refresh the
; room display and act again before restart.
@label=Update_Berk_State_ActionAndMaybeRestart
*$AC29 CALL $AECC    ; Call #R$AECC to handle Berk's action.
 $AC2C CALL $AD98    ; Call #R$AD98 to clear messaging attributes.
 $AC2F LD A,($72B4)  ; Load #REGa with the task status flags (#R$72B4).
 $AC32 BIT 5,A       ; {Is bit #N$05 of the task status flags set? If not, jump
 $AC34 JR Z,$AC41    ; to #R$AC41.}
 $AC36 LD A,$C8      ; Load #REGa with #N$C8.
 $AC38 LD ($72DB),A  ; Set the held-entity pointer (#R$72DB).
 $AC3B CALL $AF01    ; Call #R$AF01 to initialise the room display.
 $AC3E CALL $AECC    ; Call #R$AECC to handle Berk's action.
; Print status/rating messages and restart the game at #R$AAAB.
@label=Update_Berk_State_PrintStatusAndRestart
*$AC41 CALL $DE19    ; Call #R$DE19 to print status messages.
 $AC44 POP BC        ; Restore #REGbc from the stack.
 $AC45 JP $AAAB      ; Jump to #R$AAAB to restart the game.
; While a timed event is quiet, tick the frame counter and fall through
; when it expires.
@label=Update_Berk_State_ActiveTaskFrameTick
*$AC48 LD A,($72CE)  ; Load #REGa with the timed event latch (#R$72CE).
 $AC4B OR A          ; {Is the timed event latch zero? If not, return.
 $AC4C RET NZ        ; }
 $AC4D LD A,($72C6)  ; Load #REGa with the frame counter (#R$72C6).
 $AC50 DEC A         ; {Step the frame counter back by one.
 $AC51 LD ($72C6),A  ; }
 $AC54 RET NZ        ; Return unless the frame counter is now zero.
 $AC55 LD A,($72A9)  ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $AC58 OR A          ; {Is the Learner Berk mode flag zero? If so, jump to
 $AC59 JR Z,$AC5D    ; #R$AC5D.}
 $AC5B LD A,$05      ; Load #REGa with #N$05.
; Reload the frame counter, advance the task timer, and either paint the
; attr strip or play the task-fanfare path.
@label=Update_Berk_State_ReloadFrameCounter
*$AC5D ADD A,$0F     ; Add #N$0F to #REGa.
 $AC5F LD ($72C6),A  ; Set the frame counter (#R$72C6).
 $AC62 LD A,($72F0)  ; Load #REGa with the task timer (#R$72F0).
 $AC65 INC A         ; {Advance the task timer by one.
 $AC66 LD ($72F0),A  ; }
 $AC69 CP $A0        ; {Is the task timer less than #N$A0? If so, jump to
 $AC6B JR C,$ACA2    ; #R$ACA2.}
; #HTML(#AUDIO0(task-fanfare.wav)(#INCLUDE(TaskFanfare)))
 $AC6D LD A,$0B      ; Load #REGa with sound index #N$0B.
 $AC6F CALL $F8F9    ; Call #R$F8F9 to queue a sound.
 $AC72 CALL $F9AF    ; Call #R$F9AF to play the queued sound.
 $AC75 LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $AC78 CP $05        ; {Is the current task index equal to #N$05? If so, jump
 $AC7A JP Z,$AC41    ; to #R$AC41.}
 $AC7D LD A,($72A9)  ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $AC80 OR A          ; {Is the Learner Berk mode flag zero? If so, jump to
 $AC81 JP Z,$AC41    ; #R$AC41.}
 $AC84 XOR A         ; Clear #REGa.
 $AC85 LD ($72AE),A  ; Set the current task index (#R$72AE).
 $AC88 LD A,($72AF)  ; Load #REGa with the current task phase (#R$72AF).
 $AC8B CP $01        ; {Is the current task phase equal to #N$01? If not, jump
 $AC8D JR NZ,$AC93   ; to #R$AC93.}
 $AC8F DEC A         ; {Step the current task phase back by one.
 $AC90 LD ($72AF),A  ; }
; Print too-late feedback, handle Berk's action, and reload the game tick
; counter.
@label=Update_Berk_State_TooLateFeedback
*$AC93 CALL $DDA3    ; Call #R$DDA3 to print too-late task feedback.
 $AC96 CALL $AD47    ; Call #R$AD47 to reset the text position.
 $AC99 CALL $AECC    ; Call #R$AECC to handle Berk's action.
 $AC9C LD A,$46      ; Load #REGa with #N$46 as the game tick reload value.
 $AC9E LD ($72F2),A  ; Set the game tick counter (#R$72F2).
 $ACA1 RET           ; Return.
; Choose an attribute value from the task timer (bright white, or divide
; to map into the ink range).
@label=Update_Berk_State_AttrStripFromSeed
*$ACA2 LD A,($72F0)  ; Load #REGa with the task timer (#R$72F0).
 $ACA5 CP $9C        ; {Is the task timer less than #N$9C? If so, jump to
 $ACA7 JR C,$ACAD    ; #R$ACAD.}
 $ACA9 LD A,$C7      ; Load #REGa with #N$C7.
 $ACAB JR $ACB7      ; Jump to #R$ACB7 to paint the attribute strip.
; Set up divisor #N$17 to map the task timer into an attribute ink.
@label=Update_Berk_State_DivModSetup
*$ACAD LD BC,$0017   ; Load #REGbc with #N($0017,$04,$04).
; Divide the task timer by #N$17 and bias the quotient into the attribute
; ink range.
@label=Update_Berk_State_DivModLoop
*$ACB0 INC B         ; Increment the quotient counter in #REGb.
 $ACB1 SUB C         ; Subtract #REGc from #REGa.
 $ACB2 JR NC,$ACB0   ; Jump to #R$ACB0 while #REGa remains at least #REGc.
 $ACB4 LD A,B        ; Copy the quotient from #REGb into #REGa.
 $ACB5 ADD A,$40     ; Add #N$40 to #REGa.
; Point at the status attribute strip
; (#N$5AA4 (attribute buffer)) ready to paint.
@label=Update_Berk_State_Hit
*$ACB7 LD HL,$5AA4   ; Point #REGhl at attribute-file address #N$5AA4
                     ; (attribute buffer).
 $ACBA LD B,$14      ; Load #REGb with #N$14 as a loop counter.
; Fill the status attribute strip, then prepare to scan the matching
; screen row.
@label=Update_Berk_State_Exit
*$ACBC LD (HL),A     ; Store #REGa at the address in #REGhl.
 $ACBD INC HL        ; Advance #REGhl by one byte.
 $ACBE DJNZ $ACBC    ; Decrease the loop counter in #REGb and jump to #R$ACBC while bytes
                     ; remain.
 $ACC0 LD HL,$51A4   ; Point #REGhl at screen address #N$51A4 (screen buffer).
 $ACC3 LD B,$13      ; Load #REGb with #N$13 as a loop counter.
; Scan the status screen row for a non-#N$FF cell to rotate.
@label=Update_Berk_State_PartA
*$ACC5 LD A,(HL)     ; Fetch the next byte through #REGhl into #REGa.
 $ACC6 CP $FF        ; {Is the fetched byte equal to #N$FF? If not, jump to
 $ACC8 JR NZ,$ACCD   ; #R$ACCD.}
 $ACCA INC HL        ; Advance #REGhl by one byte.
 $ACCB DJNZ $ACC5    ; Decrease the loop counter in #REGb and jump to #R$ACC5 while bytes
                     ; remain.
; Prepare to rotate six pixel rows of the found status glyph.
@label=Update_Berk_State_PartB
*$ACCD LD B,$06      ; Load #REGb with #N$06 as a loop counter.
; Rotate the status glyph down the screen rows, then count down the
; held-entity pointer if set.
@label=Update_Berk_State_PartC
*$ACCF SCF           ; Signal success.
 $ACD0 RR (HL)       ; Rotate right the byte at #REGhl.
 $ACD2 INC H         ; Advance the high byte of the pointer in #REGhl.
 $ACD3 DJNZ $ACCF    ; Decrease the loop counter in #REGb and jump to #R$ACCF while rows
                     ; remain.
 $ACD5 LD HL,($72DB) ; Load #REGhl with the held-entity pointer (#R$72DB).
 $ACD8 LD A,H        ; Copy the high byte of the pointer into #REGa.
 $ACD9 OR L          ; Merge the low byte of the pointer into #REGa.
 $ACDA RET Z         ; Return if the held-entity pointer is zero.
 $ACDB DEC HL        ; Step the held-entity pointer back by one.
 $ACDC LD ($72DB),HL ; Store #REGhl in the held-entity pointer (#R$72DB).
 $ACDF JP $AF1E      ; Jump to #R$AF1E to reprint the bonus.

; Pointer: Berk Script Table Base
;
; Saved base address of the Berk script table while #R$ACE4 walks a random
; entry. Written on entry to #R$ACE4 and reloaded when a candidate row is
; rejected.
@label=Pointer_BerkScriptTableBase
g$ACE2 DEFW $0000

; Start Berk Script
;
; Used by the routine at #R$AB95.
; .
; Pick a Berk script row from the table at #REGhl and enter #R$EC30.
;
; HL Base of the Berk script table to sample
; A Number of candidate rows to skip / try
@label=Start_Berk_Script
c$ACE4 LD ($ACE2),HL ; Save the script-table base at #R$ACE2.
 $ACE7 LD ($AD03),A  ; Remember the original row count at #R$ACE4(#N$AD03).
; Pick a random Berk script-table row from the candidate base.
@label=Start_Berk_Script_PickRandom
*$ACEA PUSH AF       ; Stash #REGaf on the stack.
 $ACEB CALL $EAE5    ; {Call #R$EAE5 to pick a pseudo-random offset and keep it
 $ACEE LD C,A        ; in #REGc.}
 $ACEF LD B,$00      ; Clear #REGb so #REGbc is the random offset alone.
 $ACF1 ADD HL,BC     ; Advance #REGhl to the randomly chosen table row.
 $ACF2 POP AF        ; Restore #REGaf from the stack.
; Claim a free script row, or step on / reload the table when the
; candidate is busy.
@label=Start_Berk_Script_TestRowInUse
*$ACF3 BIT 7,(HL)    ; {Is this script row already marked in-use (bit #N$07)? If not, take
 $ACF5 JR Z,$AD13    ; it at #R$AD13.}
 $ACF7 INC HL        ; Step to the flags byte of the next candidate.
 $ACF8 BIT 6,(HL)    ; {Is this candidate free (bit #N$06 clear)? If so, restart from the
 $ACFA JR Z,$ACFF    ; saved base at #R$ACFF.}
 $ACFC LD HL,($ACE2) ; Reload the script-table base from #R$ACE2.
; Count down remaining script-row tries; when exhausted, clear in-use bits
; and retry.
@label=Start_Berk_Script_CountTries
*$ACFF DEC A         ; {Count down the remaining tries, then loop to #R$ACF3 while tries
 $AD00 JR NZ,$ACF3   ; remain.}
 $AD02 LD B,$01      ; Only one clear-pass remains, then continue into the in-use-bit reset
                     ; at #R$AD08.
 $AD04 LD HL,($ACE2) ; Reload the script-table base from #R$ACE2.
 $AD07 PUSH HL       ; Stash #REGhl on the stack.
; Clear every script-row in-use flag, then retry a fresh random pick.
@label=Start_Berk_Script_Branch
*$AD08 RES 7,(HL)    ; Clear the script-row in-use flag (bit #N$07 of the Berk script table
                     ; entry).
 $AD0A INC HL        ; Advance the current pointer by one byte.
 $AD0B DJNZ $AD08    ; Decrease the loop counter in #REGb and jump to #R$AD08 if more
                     ; iterations remain.
 $AD0D POP HL        ; Restore #REGhl from the stack.
 $AD0E LD A,($AD03)  ; Reload the original row-count from the self-modifying byte at
                     ; #R$ACE4(#N$AD03).
 $AD11 JR $ACEA      ; Jump to #R$ACEA to try another Berk script row.
; Claim this script row by setting its in-use flag and return the selected
; byte.
@label=Start_Berk_Script_ClaimRow
*$AD13 LD A,(HL)     ; Fetch the next byte from the current pointer.
 $AD14 SET 7,(HL)    ; Set the script-row in-use flag (bit #N$07 of the Berk script table
                     ; entry).
 $AD16 RET           ; Return.

; Data: Menu Glyph Bitmaps
;
; Soft-character bitmaps for status/menu text. #R$AD47 / #R$AF56 point
; #R$72F9 here; #R$EB67 reads each glyph as #N($0008,$04,$04) pixel rows via
; #R$EB7A / #R$EB82.
; #UDGTABLE { #UDGARRAY$06,scale=$04($AD17-$AD3F-$08-$08)(menu-glyph-bitmaps) }
; UDGTABLE#
@label=Data_MenuGlyphBitmaps
b$AD17 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $AD1F DEFB $00,$60,$3F,$33,$3E,$1C,$01,$00
 $AD27 DEFB $00,$24,$A5,$E7,$00,$FF,$81,$00
 $AD2F DEFB $00,$06,$FC,$CC,$7C,$38,$80,$00
 $AD37 DEFB $FF,$81,$B1,$B1,$BD,$BD,$81,$FF
 $AD3F DEFB $FF,$81,$BD,$B1,$8D,$BD,$81,$FF

; Reset Text Position
;
; Used by the routines at #R$AB95 and #R$ADA1.
; .
; Reset the status/menu text cursor to the glyph bitmap at #R$AD17.
@label=Reset_Text_Position
c$AD47 XOR A         ; Clear #REGa ready to reset the task timer.
 $AD48 LD ($72F0),A  ; Set the task timer (#R$72F0).
 $AD4B LD HL,$AD17   ; Point #REGhl at the menu glyph bitmaps (#R$AD17).
 $AD4E LD ($72F9),HL ; Write the pointer in #REGhl to the temporary screen pointer
                     ; (#R$72F9).
 $AD51 CALL $AD6F    ; Call #R$AD6F to print Menu Strings.
 $AD54 AND C         ; Mask #REGa with #REGb.
 $AD55 LD E,D        ; Copy #REGd into #REGe (build a pointer/offset).
 $AD56 LD (HL),B     ; Write the loop counter through the pointer in #REGhl.
 $AD57 LD BC,$0302   ; Load #REGbc with #N$0302 as a room/position constant.
 $AD5A LD E,L        ; Copy #REGl into #REGe (build a pointer/offset).
 $AD5B LD A,$02      ; Load #REGa with #N$02.
 $AD5D LD ($7307),A  ; Set the temporary room/state byte (#R$7307).
 $AD60 LD HL,$5AA4   ; Point #REGhl at attribute-file address #N$5AA4
                     ; (attribute buffer).
 $AD63 LD B,$14      ; Load #REGb with #N$14 as a loop counter.
 $AD65 LD DE,$0000   ; Clear #REGde (zero offset).
; Print the status/menu glyph run across the attribute strip at
; #N$5AA4 (attribute buffer).
@label=Reset_Text_Position_PrintLoop
*$AD68 CALL $EB67    ; Call #R$EB67 to print Character.
 $AD6B INC HL        ; Advance #N$5AA4 (attribute buffer) by one byte.
 $AD6C DJNZ $AD68    ; Decrease the loop counter in #REGb and jump to #R$AD68 if more
                     ; iterations remain.
 $AD6E RET           ; Return.

; Print Menu Strings
;
; Used by the routines at #R$AD47, #R$AF01, #R$F3EF and #R$F46B.
; .
; Print a menu printer stream from #REGbc. Fragment headers are three
; bytes (address low/high, attribute); #CHR$26 (#N$26) starts a new fragment;
; #CHR$5D (#N$5D) ends the stream. Uses the character set at #R$72F9.
;
; .
;
; Entry: pop the CALL return address into #REGbc as the printer-stream
; pointer.
@label=Print_Menu_Strings
c$AD6F POP BC        ; Pop the stream pointer into #REGbc.
; Read the next menu-string fragment header: screen address and attribute
; into #R$7307.
@label=Print_Menu_Strings_FetchByte
*$AD70 LD A,(BC)     ; Fetch a byte through the pointer in #REGbc.
 $AD71 LD L,A        ; Keep the screen-address low byte in #REGl.
 $AD72 INC BC        ; Advance the stream pointer in #REGbc by one.
 $AD73 LD A,(BC)     ; Fetch a byte through the pointer in #REGbc.
 $AD74 LD H,A        ; Keep the screen-address high byte in #REGh.
 $AD75 INC BC        ; Advance the counter/pointer in #REGbc by one.
 $AD76 LD A,(BC)     ; Fetch a byte through the pointer in #REGbc.
 $AD77 LD ($7307),A  ; Set the temporary room/state byte (#R$7307).
 $AD7A INC BC        ; Advance the counter/pointer in #REGbc by one.
 $AD7B LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
; Fetch the next glyph: #N$26 starts a new fragment, #N$5D ends the
; stream, else print it.
@label=Print_Menu_Strings_FetchGlyph
*$AD7D LD A,(BC)     ; Fetch a byte through the pointer in #REGbc.
 $AD7E INC BC        ; Advance the counter/pointer in #REGbc by one.
 $AD7F CP $26        ; {Is #REGa equal to #N$26? If so, jump to #R$AD70.
 $AD81 JR Z,$AD70    ; }
 $AD83 CP $5D        ; {Is #REGa equal to #N$5D? If not, jump to #R$AD89.
 $AD85 JR NZ,$AD89   ; }
 $AD87 PUSH BC       ; Stash #REGbc on the stack.
 $AD88 RET           ; Return.
; Print one menu glyph and loop for the next, then clear the display
; buffers on the fall-through path.
@label=Print_Menu_Strings_PrintGlyph
*$AD89 LD E,A        ; Keep the glyph code in #REGe for #R$EB67.
 $AD8A CALL $EB67    ; Call #R$EB67 to print Character.
 $AD8D INC HL        ; Advance the current pointer by one byte.
 $AD8E JR $AD7D      ; Jump to #R$AD7D to print the next menu glyph.
 $AD90 CALL $EA3C    ; Call #R$EA3C to clear both display buffers.
 $AD93 LD A,$12      ; Load #REGa with #N$12.
 $AD95 CALL $EA52    ; Call #R$EA52 to clear Attribute File.

; Clear Messaging Attributes
;
; Used by the routines at #R$AB95 and #R$AECC.
; .
; Blank the attribute cells behind the status / menu message area so the
; next printed line starts on a clean strip.
@label=Clear_Messaging_Attributes
c$AD98 LD BC,$0000   ; Clear #REGbc (zero length/offset).
; Busy-wait the messaging-attribute clear countdown down to zero.
@label=Clear_Messaging_Attributes_Countdown
*$AD9B DEC BC        ; Step the length/counter in #REGbc back by one.
 $AD9C LD A,B        ; Copy the loop counter from #REGb into #REGa.
 $AD9D OR C          ; OR #REGc into #REGa to test whether #REGbc has reached
                     ; zero.
 $AD9E JR NZ,$AD9B   ; If the result was non-zero, jump to #R$AD9B.
 $ADA0 RET           ; Return.

; Update Timed Events
;
; Used by the routine at #R$AAB3.
; .
; Once per frame: run timed room events, fanfares and the script-temporary
; countdown while a task is active.
@label=Update_Timed_Events
c$ADA1 LD A,($72CE)    ; Load #REGa with the timed event latch (#R$72CE).
 $ADA4 OR A            ; {Is timed event latch zero? If so, return.
 $ADA5 RET Z           ; }
 $ADA6 LD IX,$8D7D     ; Point #REGix at the dumb-waiter entity (#R$8D7D).
 $ADAA CP $1C          ; {Is timed event latch equal to #N$1C? If not, jump to
 $ADAC JR NZ,$ADEC     ; #R$ADEC.}
 $ADAE XOR A           ; Clear the timed event latch.
 $ADAF LD ($72CE),A    ; Set the timed event latch.
 $ADB2 LD IX,($8D89)   ; Load #REGix from the trap door entity pointer
                       ; (#R$8D89).
 $ADB6 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $ADB9 CP $14          ; {Is the current entity's entity type less than #N$14? If so, jump to
 $ADBB JR C,$ADDE      ; #R$ADDE.}
 $ADBD BIT 6,(IX+$01)  ; {Is bit #N$06 of the current entity's flags byte 1 set? If not,
 $ADC1 JR Z,$ADDE      ; jump to #R$ADDE.}
 $ADC3 RES 6,(IX+$01)  ; Reset bit #N$06 of the current entity's flags byte 1.
 $ADC7 INC (IX+$04)    ; Advance this entity into the next room.
 $ADCA INC (IX+$05)    ; {Move this entity one character down.
 $ADCD INC (IX+$06)    ; }
 $ADD0 INC (IX+$04)    ; Advance this entity into the next room.
 $ADD3 INC (IX+$05)    ; {Move this entity one character down.
 $ADD6 INC (IX+$06)    ; }
 $ADD9 LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $ADDC RES 3,(HL)      ; Clear "object has been offered to the trap" (bit #N$03
                       ; of #R$72B3).
; Force the lever scenery slot onto closed facing left at #R$A827.
@label=Update_Timed_Events_TrapDoorLayout
*$ADDE LD IX,$8D8B     ; Point #REGix at the lever scenery entity (#R$8D8B).
 $ADE2 LD BC,$A827     ; Load #REGbc with the lever closed, facing left
                       ; (#R$A827).
 $ADE5 LD (IX+$0A),C   ; Set the low byte of the current entity's graphic layout address from
                       ; #REGc.
 $ADE8 LD (IX+$0B),B   ; Set the high byte of the current entity's graphic layout address
                       ; from #REGb.
 $ADEB RET             ; Return.
; Advance the timed-event entity type, queue a cue, and either raise or
; lower it toward the trap.
@label=Update_Timed_Events_AdvanceTypeAndSound
*$ADEC INC A           ; Advance the current entity's entity type by one.
 $ADED LD ($72CE),A    ; Set the timed event latch.
 $ADF0 CP $0F          ; {Is the current entity's entity type equal to #N$0F? If so, jump to
 $ADF2 JP Z,$AE2A      ; #R$AE2A.}
 $ADF5 PUSH AF         ; Stash #REGaf on the stack.
; #HTML(#AUDIO0(timed-event.wav)(#INCLUDE(TimedEvent)))
 $ADF6 LD A,$0C        ; Load #REGa with sound index #N$0C.
 $ADF8 CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
 $ADFB POP AF          ; Restore #REGaf from the stack.
 $ADFC JR NC,$AE14     ; If no borrow/miss was signaled, jump to #R$AE14.
 $ADFE DEC (IX+$05)    ; {Move this entity one character up.
 $AE01 DEC (IX+$06)    ; }
 $AE04 LD IX,($8D89)   ; Load #REGix from the trap door entity pointer
                       ; (#R$8D89).
 $AE08 BIT 6,(IX+$01)  ; {Is bit #N$06 of the current entity's flags byte 1 set? If not,
 $AE0C RET Z           ; return.}
 $AE0D DEC (IX+$05)    ; {Move this entity one character up.
 $AE10 DEC (IX+$06)    ; }
 $AE13 RET             ; Return.
; Lower the timed-event entity (and the offered trap entity if flagged)
; one character.
@label=Update_Timed_Events_RaiseEntityY
*$AE14 INC (IX+$05)    ; {Move this entity one character down.
 $AE17 INC (IX+$06)    ; }
 $AE1A LD IX,($8D89)   ; Load #REGix from the trap door entity pointer
                       ; (#R$8D89).
 $AE1E BIT 6,(IX+$01)  ; {Is bit #N$06 of the current entity's flags byte 1 set? If not,
 $AE22 RET Z           ; return.}
 $AE23 INC (IX+$05)    ; {Move this entity one character down.
 $AE26 INC (IX+$06)    ; }
 $AE29 RET             ; Return.
; When the timed event finishes on task #N($05), latch Berk's eat/action
; path or run the fanfare branch.
@label=Update_Timed_Events_Branch
*$AE2A LD A,($72AE)    ; Load #REGa with the current task index (#R$72AE).
 $AE2D OR A            ; {Is current task index zero? If so, return.
 $AE2E RET Z           ; }
 $AE2F CP $05          ; {Is current task index equal to #N$05? If not, jump to
 $AE31 JR NZ,$AE54     ; #R$AE54.}
 $AE33 LD A,($72B4)    ; Load #REGa with the task status flags (#R$72B4).
 $AE36 BIT 6,A         ; {Is bit #N$06 of task status flags set? If so, return.
 $AE38 RET NZ          ; }
 $AE39 BIT 7,A         ; {Is bit #N$07 of task status flags set? If not, jump
 $AE3B JR Z,$AE63      ; to #R$AE63.}
 $AE3D SET 6,A         ; Set "Berk action / eat latch" (bit #N$06 of #R$72B4).
 $AE3F LD ($72B4),A    ; Set the task status flags (#R$72B4).
 $AE42 LD IY,$907F     ; Point #REGiy at the inactive complex-entity slot
                       ; (#R$907F).
 $AE46 LD (IY+$00),$17 ; Write #N$17 to the referenced entity's entity type.
 $AE4A SET 6,(IY+$01)  ; Set bit #N$06 of the referenced entity's flags byte 1.
 $AE4E LD ($8D89),IY   ; Store #REGiy in the trap door entity pointer
                       ; (#R$8D89).
 $AE52 JR $AE63        ; Jump to #R$AE63 to finish the timed-event pass.
; If an entity was offered to the trap, copy its type into the message
; trigger.
@label=Update_Timed_Events_TrapEntityMessage
*$AE54 LD IX,($8D89)   ; Load #REGix from the trap door entity pointer
                       ; (#R$8D89).
 $AE58 BIT 6,(IX+$01)  ; {Is bit #N$06 of the current entity's flags byte 1 set? If not,
 $AE5C RET Z           ; return.}
 $AE5D LD A,(IX+$00)   ; Fetch the current entity's type into #REGa.
 $AE60 LD ($72C5),A    ; Set the message trigger (#R$72C5).
; Select the task-progress message, clear the offered-to-trap flag, and
; tidy helper slots on task #N$01.
@label=Update_Timed_Events_TaskProgressFanfare
*$AE63 PUSH IX         ; Stash #REGix on the stack.
 $AE65 CALL $E25E      ; Call #R$E25E to select Task Progress Message.
 $AE68 POP IX          ; Restore #REGix from the stack.
 $AE6A LD A,($72F1)    ; Load #REGa with the task progress repeat count
                       ; (#R$72F1).
 $AE6D OR A            ; {Return if the task progress repeat count is zero.
 $AE6E RET Z           ; }
 $AE6F LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $AE72 RES 3,A         ; Clear "object has been offered to the trap" (bit #N$03
                       ; of #R$72B3).
 $AE74 LD ($72B3),A    ; Set the game event flags (#R$72B3).
 $AE77 LD A,($72AE)    ; Load #REGa with the current task index (#R$72AE).
 $AE7A CP $01          ; {Is current task index equal to #N$01? If not, jump to
 $AE7C JR NZ,$AE96     ; #R$AE96.}
 $AE7E XOR A           ; Clear the current task phase (idle).
 $AE7F LD ($72AF),A    ; Set the current task phase (#R$72AF).
 $AE82 LD IY,$8F9F     ; Point #REGiy at the inactive complex-entity slot
                       ; (#R$8F9F).
 $AE86 LD DE,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGde.
 $AE89 LD B,$03        ; Load #REGb with #N$03 as a loop counter.
; Clear helper entity types/flags across the upstairs helper slots.
@label=Update_Timed_Events_ClearHelperTypes
*$AE8B LD (IY+$00),A   ; Set the referenced entity's entity type.
 $AE8E RES 5,(IY+$01)  ; Reset bit #N$05 of the referenced entity's flags byte
                       ; 1.
 $AE92 ADD IY,DE       ; Advance #REGiy to the next entity record.
 $AE94 DJNZ $AE8B      ; Decrease the loop counter in #REGb and jump to #R$AE8B if more
                       ; iterations remain.
; Deactivate the timed-event entity, advance dialogue, handle Berk's
; action and reload the tick counter.
@label=Update_Timed_Events_AdvanceDialogue
*$AE96 XOR A           ; Clear the current entity type (deactivate the slot).
 $AE97 LD (IX+$00),A   ; Set the current entity's entity type.
 $AE9A LD ($72AE),A    ; Set the current task index (#R$72AE).
 $AE9D LD A,($72B0)    ; Load #REGa with the dialogue line index (#R$72B0).
 $AEA0 INC A           ; Advance dialogue line index by one.
 $AEA1 LD ($72B0),A    ; Set the dialogue line index (#R$72B0).
 $AEA4 CALL $AECC      ; Call #R$AECC to handle Berk's action.
 $AEA7 CALL $AD47      ; Call #R$AD47 to reset the text position.
 $AEAA LD A,$50        ; Load #REGa with #N$50 as the game tick reload value.
 $AEAC LD ($72F2),A    ; Set the game tick counter (#R$72F2).
; Choose the held-entity countdown length (#N($0019), doubled outside
; Learner Berk mode).
@label=Update_Timed_Events_HeldCountdownStep
*$AEAF LD HL,$0019     ; Load #REGhl with #N($0019,$04,$04) as a delay/count
                       ; constant.
 $AEB2 LD A,($72A9)    ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $AEB5 OR A            ; {Is Learner Berk mode flag zero? If not, jump to
 $AEB6 JR NZ,$AEB9     ; #R$AEB9.}
 $AEB8 ADD HL,HL       ; Double the pointer/offset in #REGhl.
; Store the bonus, refresh the room display/action, and repeat until the
; task progress repeat count hits zero.
@label=Update_Timed_Events_StoreHeldAndRefresh
*$AEB9 LD ($72DB),HL   ; Store #REGhl in the pointer to the entity Berk is
                       ; holding (#R$72DB).
 $AEBC CALL $AF01      ; Call #R$AF01 to initialise the room display.
 $AEBF CALL $AECC      ; Call #R$AECC to handle Berk's action.
 $AEC2 LD A,($72F1)    ; Load #REGa with the task progress repeat count
                       ; (#R$72F1).
 $AEC5 DEC A           ; Decrease the task progress repeat count in #REGa by
                       ; one.
 $AEC6 LD ($72F1),A    ; Set the task progress repeat count (#R$72F1).
 $AEC9 JR NZ,$AEAF     ; If the result was non-zero, jump to #R$AEAF.
 $AECB RET             ; Return.

; Handle Berk Action
;
; Used by the routines at #R$AB95 and #R$ADA1.
; .
; Flash the status attribute strip, play a stinger, clear messaging attrs,
; then count down #R$72DB / score.
@label=Handle_Berk_Action
c$AECC LD HL,$5AB9   ; Point #REGhl at attribute-file address #N$5AB9
                     ; (attribute buffer).
 $AECF LD B,$06      ; Load #REGb with #N$06 as a loop counter.
; Paint the status attribute strip bright, play Berk's action stinger,
; then clear messaging attrs.
@label=Handle_Berk_Action_FillAttributes
*$AED1 LD (HL),$78   ; Write attribute/value #N$78 through the pointer in
                     ; #REGhl.
 $AED3 INC HL        ; Advance #N$5AB9 (attribute buffer) by one byte.
 $AED4 DJNZ $AED1    ; Decrease the loop counter in #REGb and jump to #R$AED1 if more
                     ; iterations remain.
; #HTML(#AUDIO0(berk-action.wav)(#INCLUDE(BerkAction)))
 $AED6 LD A,$02      ; Load #REGa with sound index #N$02.
 $AED8 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $AEDB CALL $F9AF    ; Call #R$F9AF to play a fanfare / stinger.
 $AEDE CALL $AD98    ; Call #R$AD98 to clear messaging attributes.
; Count down the held-entity pointer and bump the score while #R$72DB is
; non-zero.
@label=Handle_Berk_Action_ScoreHeldCountdown
*$AEE1 LD HL,($72DB) ; Load #REGhl with the pointer to the entity Berk is holding
                     ; (#R$72DB).
 $AEE4 LD A,H        ; Copy the high byte of the pointer into #REGa.
 $AEE5 OR L          ; OR #REGl into #REGa to test whether #R$72DB is zero.
 $AEE6 JP Z,$AF01    ; If the result was zero, jump to #R$AF01.
 $AEE9 DEC HL        ; Step pointer to the entity Berk is holding back by one
                     ; byte.
 $AEEA LD ($72DB),HL ; Store #REGhl in the pointer to the entity Berk is
                     ; holding (#R$72DB).
 $AEED LD HL,($72DD) ; Load #REGhl with the score (#R$72DD).
 $AEF0 INC HL        ; Advance score by one byte.
 $AEF1 LD ($72DD),HL ; Store #REGhl in the score (#R$72DD).
 $AEF4 CALL $AF01    ; Call #R$AF01 to initialise the room display.
; #HTML(#AUDIO0(score.wav)(#INCLUDE(Score)))
 $AEF7 LD A,$01      ; Load #REGa with sound index #N$01.
 $AEF9 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $AEFC CALL $F9AF    ; Call #R$F9AF to play a fanfare / stinger.
 $AEFF JR $AEE1      ; Jump to #R$AEE1 to keep scanning held-entity slots.

; Initialise Room Display
;
; Used by the routines at #R$AB95, #R$ADA1, #R$AECC and #R$AF3C.
; .
; Print the score and a short attr-file label stream via #R$AD6F, then the
; held-countdown stream.
@label=Initialise_Room_Display
c$AF01 LD HL,($72DD) ; Load #REGhl with the score (#R$72DD).
 $AF04 LD IX,$AF17   ; Point #REGix at room-display data (#R$AF17).
 $AF08 CALL $EB20    ; Call #R$EB20 to print Score Digits.
 $AF0B LD HL,$3C00   ; Point #REGhl at #SKOOLKID$3D00(CHARSET)-#N$0100.
 $AF0E LD ($72F9),HL ; Write the pointer in #REGhl to the temporary screen pointer
                     ; (#R$72F9).
 $AF11 CALL $AD6F    ; Call #R$AD6F to print Menu Strings.
 $AF14 EXX           ; Swap the main register pairs with their alternates.
 $AF15 LD E,D        ; Copy #REGd into #REGe (build a pointer/offset).
 $AF16 LD B,A        ; Keep #REGa in #REGb for later.
 $AF17 JR NZ,$AF39   ; If the result was non-zero, jump to #R$AF01(#N$AF39).
 $AF19 JR NZ,$AF4B   ; If the result was non-zero, jump to #R$AF4B.
 $AF1B JR NC,$AF4D   ; If no borrow/miss was signaled, jump to
                     ; #R$AF3C(#N$AF4D).
 $AF1D LD E,L        ; Copy #REGl into #REGe (build a pointer/offset).
; This entry point is used by the routine at #R$AB95.
; .
; Print the held-entity countdown digits and its trailing menu-string
; stream.
@label=Initialise_Room_Display_HeldEntity
*$AF1E LD HL,($72DB) ; Load #REGhl with the pointer to the entity Berk is holding
                     ; (#R$72DB).
 $AF21 LD IX,$AF34   ; Point #REGix at room-display data (#R$AF34).
 $AF25 CALL $EB20    ; Call #R$EB20 to print Score Digits.
 $AF28 LD HL,$3C00   ; Point #REGhl at #SKOOLKID$3D00(CHARSET)-#N$0100.
 $AF2B LD ($72F9),HL ; Write the pointer in #REGhl to the temporary screen pointer
                     ; (#R$72F9).
 $AF2E CALL $AD6F    ; Call #R$AD6F to print Menu Strings.
 $AF31 CP C          ; Compare #REGa with #REGc (menu-string scan marker).
 $AF32 LD E,D        ; Copy #REGd into #REGe (build a pointer/offset).
 $AF33 LD B,(HL)     ; Load #REGb from the byte at #REGhl.
 $AF34 JR NZ,$AF56   ; If the result was non-zero, jump to #R$AF56.
 $AF36 JR NZ,$AF68   ; If the result was non-zero, jump to #R$AF68.
 $AF38 JR NC,$AF6A   ; If no borrow/miss was signaled, jump to #R$AF6A.
 $AF3A LD E,L        ; Copy #REGl into #REGe (build a pointer/offset).
 $AF3B RET           ; Return.

; Initialise New Game
;
; Used by the routine at #R$AAB3.
; .
; Start a new game: reset display buffers, tick counter, menu glyphs and
; room state for Learner or Super Berk.
@label=Initialise_New_Game
c$AF3C CALL $AFA9    ; Call #R$AFA9 to backup Entity And Game State.
 $AF3F LD HL,$63A0   ; Point #REGhl at Primary Display Buffer (#R$63A0).
 $AF42 LD ($72F5),HL ; Store #REGhl in Pointer: Current Display Buffer
                     ; (#R$72F5).
 $AF45 XOR A         ; Clear the display-buffer select flag.
 $AF46 LD ($72EA),A  ; Set Display Buffer Select Flag (#R$72EA).
 $AF49 LD A,$64      ; Load #REGa with #N$64 as the initial game tick counter.
; This entry point is used by the routine at #R$AF01.
; .
; Set the game tick counter, clear both display buffers, and set the
; border/speaker state.
@label=Initialise_New_Game_SetTickCounter
*$AF4B LD ($72F2),A  ; Set the game tick counter (#R$72F2).
 $AF4E CALL $EA3C    ; Call #R$EA3C to clear both display buffers.
 $AF51 LD A,$02      ; Load #REGa with #N$02.
 $AF53 CALL $EA6D    ; Call #R$EA6D to set Border And Speaker State.
; This entry point is used by the routine at #R$AF01.
; .
; Point the glyph printer at #R$AD17 and choose the Learner (#N$7A) vs
; Super Berk (#N$68) room byte.
@label=Initialise_New_Game_SetGlyphPointer
*$AF56 LD HL,$AD17   ; Point #REGhl at the menu/glyph bitmap data (#R$AD17).
 $AF59 LD ($72F9),HL ; Write the pointer in #REGhl to the temporary screen pointer
                     ; (#R$72F9).
 $AF5C LD E,$04      ; Load #REGe with #N$04 as a small loop/position count.
 $AF5E LD A,($72A9)  ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $AF61 OR A          ; {Is Learner Berk mode flag zero? If so, jump to #R$AF68.
 $AF62 JR Z,$AF68    ; }
 $AF64 LD A,$7A      ; Load #REGa with #N$7A.
 $AF66 JR $AF6B      ; Jump to #R$AF6B to set the temporary room/state byte.
; This entry point is used by the routine at #R$AF01.
; .
; Super Berk path: use room/state byte #N$68.
@label=Initialise_New_Game_SuperBerkRoomByte
*$AF68 LD A,$68      ; Load #REGa with #N$68.
; This entry point is used by the routine at #R$AF01.
; .
; Advance the small position count before writing the room/state byte.
@label=Initialise_New_Game_Branch
*$AF6A INC E         ; Advance the low byte of the pointer/offset in #REGde.
; Write the room/state byte and prepare to fill the attribute-file base
; row.
@label=Initialise_New_Game_WriteRoomByte
*$AF6B LD ($7307),A  ; Set the temporary room/state byte (#R$7307).
 $AF6E LD B,$80      ; Load #REGb with #N$80 as a loop counter.
 $AF70 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $AF72 LD HL,$5A80   ; Point #REGhl at the attribute-file base
                     ; (#N$5A80 (attribute buffer)).
; Print a full attribute-file row of glyphs, then initialise the room
; display.
@label=Initialise_New_Game_PrintAttrRow
*$AF75 CALL $EB67    ; Call #R$EB67 to print Character.
 $AF78 INC HL        ; Advance #N$5A80 (attribute buffer) by one byte.
 $AF79 DJNZ $AF75    ; Decrease the loop counter in #REGb and jump to #R$AF75 if more
                     ; iterations remain.
 $AF7B CALL $AF01    ; Call #R$AF01 to initialise the room display.
 $AF7E RET           ; Return.

; Check Task Completion
;
; Used by the routine at #R$AAB3.
; .
; Check Task Completion for the current Thing Upstairs task.
@label=Check_Task_Completion
c$AF7F LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $AF82 CP $05        ; {Is current task index equal to #N$05? If not, return.
 $AF84 RET NZ        ; }
 $AF85 LD A,($72B4)  ; Load #REGa with the task status flags (#R$72B4).
 $AF88 BIT 7,A       ; {Is bit #N$07 of task status flags set? If so, return.
 $AF8A RET NZ        ; }
 $AF8B LD HL,$8EE9   ; Point #REGhl at Boney's complex entity state (#R$8EE9).
 $AF8E LD DE,$000E   ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                     ; length into #REGde.
; Scan Boney's complex state for the #N$37 busy pattern that marks task
; completion.
@label=Check_Task_Completion_ScanBerk
*$AF91 LD A,(HL)     ; Fetch the next byte from Boney's complex entity state.
 $AF92 CP $37        ; {Is task status flags equal to #N$37? If so, jump to
 $AF94 JR Z,$AFA3    ; #R$AFA3.}
 $AF96 CP $01        ; {Is task status flags equal to #N$01? If so, jump to
 $AF98 JR Z,$AFA0    ; #R$AFA0.}
 $AF9A BIT 7,A       ; {Is bit #N$07 of task status flags set? If so, jump to
 $AF9C JR NZ,$AFA0   ; #R$AFA0.}
 $AF9E OR A          ; {Is task status flags zero? If not, return.
 $AF9F RET NZ        ; }
; Advance to the next Berk state record and keep scanning for completion.
@label=Check_Task_Completion_NextBerkRecord
*$AFA0 ADD HL,DE     ; Add the offset in #REGde to the pointer in #REGhl.
 $AFA1 JR $AF91      ; Jump to #R$AF91 to keep testing task-status
                     ; combinations.
; Mark task status bit #N$07 so Berk's script/dialogue is busy.
@label=Check_Task_Completion_SetBusyBit7
*$AFA3 LD HL,$72B4   ; Point #REGhl at the task status flags (#R$72B4).
 $AFA6 SET 7,(HL)    ; Set "Berk script / dialogue busy" (bit #N$07 of
                     ; #R$72B4).
 $AFA8 RET           ; Return.

; Backup Entity And Game State
;
; Used by the routine at #R$AF3C.
; .
; Backup entity and game state walking the entity tables at #R$8B69 /
; #R$8EE9.
;
; .
;
; Measure and copy Boney's complex entity state into the backup buffer at
; #R$FA0E.
@label=Backup_Entity_And_Game_State
c$AFA9 LD HL,$90B7   ; Point #REGhl at State Data: Scenery Entities (#R$90B7).
 $AFAC LD DE,$8EE9   ; Point #REGde at Boney's complex entity state (#R$8EE9).
 $AFAF AND A         ; Clear the success marker and test whether #REGa is zero.
 $AFB0 SBC HL,DE     ; Subtract #REGde from #REGhl with carry.
 $AFB2 LD ($72A3),HL ; Store #REGhl in the entity-state copy length (#R$72A3).
 $AFB5 LD B,H        ; Copy the high byte of the pointer into #REGb.
 $AFB6 LD C,L        ; Copy the low byte of the pointer into #REGc.
 $AFB7 LD HL,$8EE9   ; Point #REGhl at Boney's complex entity state (#R$8EE9).
 $AFBA LD DE,$FA0E   ; Point #REGde at the entity-state backup buffer
                     ; (#R$FA0E).
 $AFBD LDIR          ; Copy the block at #REGhl to #REGde.
 $AFBF INC DE        ; Advance the pointer in #REGde by one.
 $AFC0 LD ($72A7),DE ; Store #REGde in Pointer: Entity State Backup End
                     ; (#R$72A7).
 $AFC4 PUSH DE       ; Stash #REGde on the stack.
; Measure and copy the task/game-status block that follows the entity
; backup.
 $AFC5 LD HL,$72E8   ; Point #REGhl at saved room index (#R$72E8).
 $AFC8 LD DE,$72AE   ; Point #REGde at the current task index (#R$72AE).
 $AFCB SBC HL,DE     ; Subtract #REGde from #REGhl with carry.
 $AFCD LD ($72A5),HL ; Store #REGhl in the game-state copy length (#R$72A5).
 $AFD0 LD B,H        ; Copy the high byte of the pointer into #REGb.
 $AFD1 LD C,L        ; Copy the low byte of the pointer into #REGc.
 $AFD2 LD HL,$72AE   ; Point #REGhl at the current task index (#R$72AE).
 $AFD5 POP DE        ; Restore #REGde from the stack.
 $AFD6 LDIR          ; Copy the block at #REGhl to #REGde.
 $AFD8 RET           ; Return.

; Temporary Entity Pointer
;
; Pointer used by Drutt / trap door animation routines.
@label=TemporaryEntityPointer_Drutt
g$AFD9 DEFW $0000

; Drutt: Saved Entity Type
;
; Entity type remembered while Drutt's trap door animation runs (#R$B034).
@label=Drutt_SavedEntityType
g$AFDB DEFB $00

; Script Routine: (#N$1B) Animate trap door / update Berk interaction
;
; Animate the trap door for Drutt's current action and refresh Berk's
; interaction with it.
@label=ScriptRoutine_AnimateTrapDoorBerk
c$AFDC LD A,($72BB)  ; Load #REGa with Drutt's animation counter (#R$72BB).
 $AFDF OR A          ; {Is Drutt's animation counter (#R$72BB) zero? If not, jump to #R$EC2E
 $AFE0 JP NZ,$EC2E   ; to run the next script instruction.}
; #HTML(#AUDIO0(timed-event.wav)(#INCLUDE(TimedEvent)))
 $AFE3 LD A,$0C      ; Load #REGa with sound index #N$0C.
 $AFE5 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $AFE8 LD IY,$908D   ; Point #REGiy at complex entity state #R$908D.
 $AFEC DEC (IY+$05)  ; {Move the referenced entity one character up.
 $AFEF DEC (IY+$06)  ; }
 $AFF2 LD A,(IY+$06) ; Load #REGa with the referenced entity's y-extent.
 $AFF5 CP $16        ; {Is the y-extent still below the trap door open threshold #N$16? If
 $AFF7 JR NZ,$B002   ; not, jump to #R$B002.}
 $AFF9 CALL $B01E    ; Call #R$B01E to reset trap door animation state.
 $AFFC XOR A         ; Clear the trap door flags.
 $AFFD LD ($72BA),A  ; Set the trap door flags (#R$72BA).
 $B000 JR $B013      ; Jump to #R$B013 to handle the trap door.
; Toggle the lever animation phase and choose open facing left
; (#R$A818) or closed facing left (#R$A827).
@label=AnimateTrapDoor_ToggleFrame
*$B002 LD A,($72BA)  ; Load #REGa with the trap door flags (#R$72BA).
 $B005 XOR %00000001 ; Toggle the trap door animation phase bit in #REGa.
 $B007 LD ($72BA),A  ; Set the trap door flags (#R$72BA).
 $B00A SRL A         ; Shift the trap door animation phase bit into the success
                     ; marker.
 $B00C JR NC,$B013   ; Jump to #R$B013 to handle the trap door if the result did not
                     ; underflow.
 $B00E LD BC,$A818   ; Point #REGbc at the lever open, facing left (#R$A818).
 $B011 JR $B016      ; Jump to #R$B016 to handle the trap door.
; Use the lever closed, facing left at #R$A827.
@label=AnimateTrapDoor_SetLayoutB
*$B013 LD BC,$A827   ; Point #REGbc at the lever closed, facing left (#R$A827).
; Install the chosen lever layout into #R$91AF and continue the
; script.
@label=AnimateTrapDoor_WriteLayout
*$B016 LD ($91AF),BC ; Store #REGbc in the animating scenery layout pointer
                     ; (#R$91AF).
 $B01A JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Drutt: Saved Animation State
;
; Secondary state byte for Drutt's trap door animation (#R$B01E /
; #R$B034).
@label=Drutt_SavedAnimationState
g$B01D DEFB $00

; Reset Trap Door Animation State
;
; Used by the routines at #R$AFDC and #R$B034.
; .
; Reset Trap Door Animation State used when opening or closing the trap
; door.
@label=Reset_Trap_Door_Animation_State
c$B01E LD A,(IX+$06) ; Load #REGa with the current entity's y-extent.
 $B021 LD ($B01D),A  ; Set Drutt's saved animation state (#R$B01D).
 $B024 XOR A         ; Clear the trap door flags.
 $B025 LD ($72BA),A  ; Set the trap door flags (#R$72BA).
 $B028 INC A         ; Advance the current entity's y-extent by one.
 $B029 LD ($72BB),A  ; Set Drutt's animation counter (#R$72BB).
 $B02C LD BC,$A827   ; Load #REGbc with the lever closed, facing left
                     ; (#R$A827).
 $B02F LD ($91AF),BC ; Store #REGbc in the lever layout slot at #R$91AF.
 $B033 RET           ; Return.

; Update Drutt
;
; Used by the routine at #R$AAB3.
; .
; Advance Drutt's trap door animation and collection logic using the
; weight-chain slot at #R$908D and Drutt's state at #R$8EF7.
;
; .
;
; Finish a pending weight-chain layout swap, then either tick the
; animation counter or watch for Berk near the trap.
@label=Update_Drutt
c$B034 LD IX,$908D     ; Point #REGix at the weight-chain entity (#R$908D).
 $B038 LD HL,$72BA     ; Point #REGhl at the trap door flags (#R$72BA).
 $B03B BIT 1,(HL)      ; {Is a weight-chain layout swap pending (bit #N$01)? If not,
 $B03D JR Z,$B049      ; continue at #R$B049.}
 $B03F RES 1,(HL)      ; Clear the layout-swap latch.
 $B041 LD BC,$9E61     ; Load the resting weight-chain layout address
                       ; (#R$9E61).
 $B044 LD ($9097),BC   ; Write that layout into the creature's layout field
                       ; (#R$8EF3(#N$9097)).
 $B048 RET             ; Return, then the swap is done for this frame.
; If Drutt's animation counter is idle, watch for Berk; otherwise tick it
; and animate.
@label=Update_Drutt_CheckCounter
*$B049 LD A,($72BB)    ; Fetch Drutt's animation counter (#R$72BB).
 $B04C OR A            ; {Is the counter idle (zero)? If so, watch for Berk at
 $B04D JP Z,$B14F      ; #R$B14F.}
 $B050 LD B,A          ; Keep the remaining tick count in #REGb.
 $B051 INC A           ; Advance the animation counter by one.
 $B052 LD ($72BB),A    ; Store the updated counter at #R$72BB.
; Handle animation: move the creature down a row and finish or keep going.
@label=Update_Drutt_AnimateFrame
*$B055 INC (IX+$05)    ; Move the creature down one character (raise y).
 $B058 INC (IX+$06)    ; Grow its y-extent to match.
 $B05B LD A,(IX+$06)   ; Load the new y-extent.
 $B05E CP $25          ; {Has it reached the open-trap row (y-extent #N$25)? If not, keep
 $B060 JR NZ,$B0A3     ; animating at #R$B0A3.}
; #HTML(#AUDIO0(thump.wav)(#INCLUDE(Thump)))
 $B062 LD A,$8E        ; Queue sound effect #N$8E (trap door thump).
 $B064 CALL $F8F9      ; Call #R$F8F9 to play that effect.
 $B067 XOR A           ; Clear #REGa so the animation counter can stop.
 $B068 LD ($72BB),A    ; Clear Drutt's animation counter (#R$72BB).
 $B06B LD BC,$A827     ; Load the closed-trap graphic layout (#R$A827).
 $B06E LD ($91AF),BC   ; Write it into the lever layout slot (#R$91AF).
 $B072 BIT 2,(HL)      ; {Is Drutt mid trap door animation (bit #N$02)? If not, nothing more
 $B074 RET Z           ; to do.}
 $B075 RES 2,(HL)      ; Clear the mid-animation latch.
 $B077 SET 1,(HL)      ; Request a weight-chain layout swap next frame (set bit
                       ; #N$01).
 $B079 LD A,($AFDB)    ; Fetch the entity type Drutt saved at #R$AFDB.
 $B07C CP $20          ; {Was it type #N$20? If so, boil the cauldron at
 $B07E JR Z,$B085      ; #R$B085.}
 $B080 LD HL,$9E48     ; Point #REGhl at #R$9E48.
 $B083 JR $B08B        ; Skip the pot update and install that layout at
                       ; #R$B08B.
; Update the cauldron after a type-#N$20 catch and use the weight
; chain layout.
@label=Update_Drutt_CaughtPot
*$B085 CALL $C60D      ; Call #R$C60D to update the cauldron after Drutt's
                       ; catch.
 $B088 LD HL,$9E40     ; Point #REGhl at #R$9E40.
; Install the chosen post-catch layout into the weight-chain slot.
@label=Update_Drutt_InstallLayout
*$B08B LD ($9097),HL   ; Write the chosen layout into the weight-chain layout field
                       ; (#R$8EF3(#N$9097)).
; Step Drutt's chew animation; special type #N$1F gets #R$EA73, else clear
; the chewed slot.
@label=Update_Drutt_EatLoop
*$B08E CALL $B16E      ; Call #R$B16E to step Drutt's eat / chew animation.
 $B091 RET Z           ; Return if that animation has finished.
 $B092 LD A,(IY+$00)   ; Load the type of the entity Drutt is chewing.
 $B095 CP $1F          ; {Is it type #N$1F (inedible / special)? If not, clear the slot at
 $B097 JR NZ,$B09D     ; #R$B09D.}
 $B099 CALL $EA73      ; Call #R$EA73 to handle the special chew.
 $B09C RET             ; Return.
; Clear the chewed entity type and keep looping the eat animation.
@label=Update_Drutt_ClearChewed
*$B09D LD (IY+$00),$00 ; Clear the chewed entity's type (deactivate the slot).
 $B0A1 JR $B08E        ; Keep chewing via #R$B08E.
; While mid trap door animation, wait until the mouth reaches the grabbed
; entity's centre, then swallow it.
@label=Update_Drutt_MidAnimation
*$B0A3 BIT 2,(HL)      ; {Still mid trap door animation (bit #N$02)? If not, look for a new
 $B0A5 JR Z,$B0C4      ; catch at #R$B0C4.}
 $B0A7 LD IY,($AFD9)   ; Load the entity Drutt is currently grabbing (#R$AFD9).
 $B0AB LD A,(IY+$06)   ; Load that entity's y-extent.
 $B0AE SUB (IY+$05)    ; Subtract its y-coordinate to get its height.
 $B0B1 SRL A           ; Halve the height.
 $B0B3 ADD A,(IY+$05)  ; Add the y-coordinate back to get the vertical centre.
 $B0B6 LD C,A          ; Keep the grabbed entity's vertical centre in #REGc.
 $B0B7 LD A,(IX+$06)   ; Load the creature's y-extent.
 $B0BA CP C            ; {Has the creature's mouth reached that centre yet? If not, keep
 $B0BB JR C,$B0C1      ; animating at #R$B0C1.}
 $B0BD LD (IY+$00),$00 ; Clear the grabbed entity's type (Drutt swallowed it).
; Consume the remaining animation ticks by looping back to #R$B055.
@label=Update_Drutt_NextAnimTick
*$B0C1 DJNZ $B055      ; Decrease the remaining tick count and loop to #R$B055 while ticks
                       ; remain.
 $B0C3 RET             ; Return when the animation ticks are exhausted.
; Handle catch: find a candidate entity under the mouth and classify it.
@label=Update_Drutt_SeekCatch
*$B0C4 CALL $B16E      ; Call #R$B16E to see whether Drutt can start a catch
                       ; this frame.
 $B0C7 JR Z,$B0C1      ; If not, just consume an animation tick at #R$B0C1.
 $B0C9 LD A,(IX+$06)   ; Load the creature's y-extent.
 $B0CC INC A           ; Peek one row below the mouth.
 $B0CD CP (IY+$05)     ; {Does that row meet the candidate entity's y? If not, keep waiting at
 $B0D0 JR NZ,$B0C1     ; #R$B0C1.}
 $B0D2 LD ($AFD9),IY   ; Remember this candidate at #R$AFD9.
 $B0D6 LD A,(IY+$05)   ; Load the candidate's y-coordinate.
 $B0D9 CP (IY+$06)     ; {Is the candidate a flat / already-swallowed slot (y == y-extent)? If
 $B0DC JR NZ,$B0E4     ; not, classify it at #R$B0E4.}
 $B0DE LD (IY+$00),$00 ; Clear that empty slot's type.
 $B0E2 JR $B13A        ; Treat it as a failed catch at #R$B13A.
; Handle collectible types: worms, eyes and special catches.
@label=Update_Drutt_ClassifyCatch
*$B0E4 LD A,(IY+$00)   ; Load the candidate's entity type.
 $B0E7 LD ($AFDB),A    ; Save it at #R$AFDB for the layout chooser.
 $B0EA CP $16          ; {Type #N$16 (worm)?, then play the catch sound at
 $B0EC JR Z,$B130      ; #R$B130.}
 $B0EE CP $18          ; {Type #N$18 (collectible eyeball variant)?, then same catch sound at
 $B0F0 JR Z,$B130      ; #R$B130.}
 $B0F2 CP $17          ; {Type #N$17? If not, mark a failed catch at #R$B13A.
 $B0F4 JR NZ,$B13A     ; }
 $B0F6 LD A,($B01D)    ; Fetch Drutt's saved animation state (#R$B01D).
 $B0F9 CP $1C          ; {Is that saved state #N$1C? If so, take the type-#N$1C collect path
 $B0FB JR Z,$B11E      ; at #R$B11E.}
 $B0FD JR NC,$B130     ; If the saved state is above #N($1C), just play the catch sound at
                       ; #R$B130.
 $B0FF LD B,$03        ; Lift the catch three rows (loop counter #N$03).
; Lift the caught entity with the creature, retype it as a collected eye,
; and mark task progress.
@label=Update_Drutt_LiftCatch
*$B101 INC (IX+$05)    ; Raise the creature's y.
 $B104 INC (IX+$06)    ; Grow its y-extent.
 $B107 INC (IY+$05)    ; Raise the caught entity's y with it.
 $B10A DJNZ $B101      ; Loop to #R$B101 for each remaining row.
 $B10C LD (IY+$00),$18 ; Retype the catch as #N$18 (collected eye).
 $B110 LD DE,$9F55     ; Point #REGde at the collected-eye layout (#R$9F55).
 $B113 LD ($9089),DE   ; Write that layout into entity state at
                       ; #R$8EF3(#N$9089).
 $B117 LD HL,$72B4     ; Point #REGhl at the task status flags (#R$72B4).
 $B11A SET 4,(HL)      ; Mark "Drutt collected a type-#N$18 object" (bit
                       ; #N$04).
 $B11C JR $B12A        ; Finish the collect at #R$B12A.
; Install the type-#N$1C collect layout and mark that collection on the
; task status flags.
@label=Update_Drutt_CollectSafeLoot
*$B11E LD DE,$9F06     ; Point #REGde at the type-#N$1C collect layout
                       ; (#R$9F06).
 $B121 LD ($9089),DE   ; Write that layout into entity state at
                       ; #R$8EF3(#N$9089).
 $B125 LD HL,$72B4     ; Point #REGhl at the task status flags (#R$72B4).
 $B128 SET 5,(HL)      ; Mark "Drutt collected a type-#N$1C object" (bit
                       ; #N$05).
; Gate task progress and clear the current task index after a successful
; collect.
@label=Update_Drutt_CollectDone
*$B12A SET 0,(HL)      ; Set the task-progress gate (bit #N$00 of #R$72B4).
 $B12C XOR A           ; Clear #REGa so the current task index can reset.
 $B12D LD ($72AE),A    ; Clear the current task index (#R$72AE).
; #HTML(#AUDIO0(thump.wav)(#INCLUDE(Thump)))
@label=Update_Drutt_CatchSound
*$B130 LD A,$8E        ; Queue sound effect #N$8E (catch thump).
 $B132 CALL $F8F9      ; Call #R$F8F9 to play it.
 $B135 XOR A           ; Clear #REGa to stop further animation ticks.
 $B136 LD ($72BB),A    ; Clear Drutt's animation counter (#R$72BB).
 $B139 RET             ; Return.
; Failed catch: special-case type #N($1F), clear the mid-animation latch,
; then consume a tick.
@label=Update_Drutt_CatchFailed
*$B13A CP $1F          ; {Was the saved type #N$1F? If not, stay mid-animation
 $B13C JR NZ,$B14A     ; at #R$B14A.}
 $B13E CALL $EA73      ; Call #R$EA73 for the special failure case.
 $B141 XOR A           ; Clear #REGa so the saved entity type can be wiped.
 $B142 LD ($AFDB),A    ; Clear Drutt's saved entity type (#R$AFDB).
 $B145 RES 2,(HL)      ; Clear the mid-animation latch (bit #N$02 of #R$72BA).
 $B147 JP $B0C1        ; Consume an animation tick at #R$B0C1.
; Keep the mid-animation latch set and consume an animation tick.
@label=Update_Drutt_StayMidAnimation
*$B14A SET 2,(HL)      ; Keep the mid-animation latch set (bit #N$02 of
                       ; #R$72BA).
 $B14C JP $B0C1        ; Consume an animation tick at #R$B0C1.
; Handle idle watch: start a trap door animation only when Berk is in the
; mouth band.
@label=Update_Drutt_WatchBerk
*$B14F LD A,(IX+$06)   ; Load the creature's y-extent.
 $B152 CP $1E          ; {Is the mouth still above the trigger row (y-extent < #N$1E)? If not,
 $B154 RET NC          ; return.}
 $B155 LD A,($7303)    ; Fetch Berk's X-coordinate copy (#R$7303).
 $B158 CP $A0          ; {Is Berk left of the trap mouth (x < #N$A0)? If so,
 $B15A RET C           ; return.}
 $B15B CP $E0          ; {Is Berk right of the trap mouth (x >= #N$E0)? If so,
 $B15D RET NC          ; return.}
 $B15E CALL $B16E      ; Call #R$B16E to see whether a catchable entity is
                       ; present.
 $B161 RET Z           ; Return if nothing is ready.
 $B162 LD A,(IY+$05)   ; Load that entity's y-coordinate.
 $B165 DEC A           ; Step one row up from the candidate entity's
                       ; y-coordinate.
 $B166 DEC A           ; Step a second row up.
 $B167 CP (IX+$06)     ; {Has the creature's mouth reached that row yet? If
 $B16A RET C           ; not, return.}
 $B16B JP $B01E        ; Jump to #R$B01E to reset the trap door animation state
                       ; and begin.

; Update Drutt Animation
;
; Used by the routine at #R$B034.
; .
; Update Drutt Animation for Drutt using complex state at #R$8EF7.
@label=Update_Drutt_Animation
c$B16E LD IY,$8EE9    ; Point #REGiy at Boney's complex entity state (#R$8EE9).
 $B172 LD DE,$000E    ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                      ; length into #REGde.
; Accept only a live room-#N$03 entity under Drutt's mouth band; otherwise
; scan on.
@label=Update_Drutt_Animation_CheckType
*$B175 LD A,(IY+$00)  ; Load #REGa with the referenced entity's entity type.
 $B178 CP $32         ; {Is referenced entity's entity type equal to #N$32? If so, return? If
 $B17A RET Z          ; not, jump to #R$B1A5.
 $B17B JR NC,$B1A5    ; }
 $B17D OR A           ; {Is referenced entity's entity type zero? If so, jump
 $B17E JR Z,$B1A5     ; to #R$B1A5.}
 $B180 BIT 7,A        ; {Is bit #N$07 of referenced entity's entity type set? If so, jump to
 $B182 JR NZ,$B1A5    ; #R$B1A5.}
 $B184 LD A,(IY+$04)  ; Load #REGa with the referenced entity's room index.
 $B187 CP $03         ; {Is referenced entity's room index equal to #N$03? If not, jump to
 $B189 JR NZ,$B1A5    ; #R$B1A5.}
 $B18B LD A,(IY+$07)  ; Load #REGa with the referenced entity's x-coordinate.
 $B18E CP $AB         ; {Is referenced entity's x-coordinate less than #N$AB? If so, jump to
 $B190 JR C,$B1A5     ; #R$B1A5.}
 $B192 LD A,$B1       ; Load #REGa with #N$B1.
 $B194 CP (IY+$08)    ; {Is #N$B1 less than the referenced entity's x-extent? If so, jump to
 $B197 JR C,$B1A5     ; #R$B1A5.}
 $B199 BIT 5,(IY+$01) ; {Is bit #N$05 of the referenced entity's flags byte 1 set? If so,
 $B19D JR NZ,$B1A5    ; jump to #R$B1A5.}
 $B19F CP $AB         ; Compare #N$B1 with #N$AB.
 $B1A1 LD A,(IY+$00)  ; Load #REGa with the referenced entity's entity type.
 $B1A4 RET            ; Return.
; Advance to the next entity and continue the Drutt catchability scan.
@label=Update_Drutt_Animation_NextEntity
*$B1A5 ADD IY,DE      ; Advance #REGiy to the next entity record.
 $B1A7 JR $B175       ; Jump to #R$B175 to continue the Drutt animation scan.

; Process Falling Entities
;
; Used by the routine at #R$AAB3.
; .
; Walk entities marked as falling, apply gravity to their Y fields and
; clear the fall latch when they land.
@label=Process_Falling_Entities
c$B1A9 LD HL,$72B3    ; Point #REGhl at the game event flags (#R$72B3).
 $B1AC BIT 2,(HL)     ; {Is the falling-entity latch (bit #N$02 of #R$72B3. set at #R$B203)
 $B1AE RET Z          ; set? If not, return.}
 $B1AF RES 2,(HL)     ; Clear the falling-entity latch (bit #N$02 of #R$72B3).
 $B1B1 LD DE,$000E    ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                      ; length into #REGde.
 $B1B4 LD IX,$8B69    ; Point #REGix at the simple entity table (#R$8B69).
; Scan for falling entities and advance each marked one up to three steps
; before clearing the latch.
@label=Process_Falling_Entities_Scan
*$B1B8 LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $B1BB CP $FF         ; {Is the current entity's entity type equal to #N$FF? If
 $B1BD RET Z          ; so, return.}
 $B1BE BIT 0,(IX+$02) ; {Is bit #N$00 of the current entity's flags byte 2 set? If not,
 $B1C2 JR Z,$B1D3     ; jump to #R$B1D3.}
 $B1C4 CALL $B1E3     ; {Call #R$B1E3 to advance Falling Entity? If not, jump
 $B1C7 JR NC,$B1D7    ; to #R$B1D7.}
 $B1C9 CALL $B1E3     ; {Call #R$B1E3 again to advance Falling Entity? If not, jump to
 $B1CC JR NC,$B1D7    ; #R$B1D7.}
 $B1CE CALL $B1E3     ; {Call #R$B1E3 a third time to advance Falling Entity? If not, jump to
 $B1D1 JR NC,$B1D7    ; #R$B1D7.}
; Advance to the next entity in the falling-entity walk.
@label=Process_Falling_Entities_NextEntity
*$B1D3 ADD IX,DE      ; Advance #REGix to the next entity record.
 $B1D5 JR $B1B8       ; Jump to #R$B1B8 to advance to the next falling entity.
; This entry point is used by the routine at #R$B1E3.
; .
; Clear the falling flag, set the landed flag, raise a room/script event,
; and continue the scan.
@label=Process_Falling_Entities_ClearFallBits
*$B1D7 RES 0,(IX+$02) ; Reset bit #N$00 of the current entity's flags byte 2.
 $B1DB SET 7,(IX+$01) ; Set bit #N$07 of the current entity's flags byte 1.
 $B1DF SET 0,(HL)     ; Set "room / script event raised" (bit #N$00 of
                      ; #R$72B3).
 $B1E1 JR $B1D3       ; Jump to #R$B1D3 to skip this falling entity.

; Advance Falling Entity
;
; Used by the routine at #R$B1A9.
; .
; Advance Falling Entity walking the entity tables at #R$8B69 / #R$8EE9.
;
; IX Address of complex state data for an entity
@label=Advance_Falling_Entity
c$B1E3 CALL $F2C2      ; {Call #R$F2C2 to test Entity Overlap? If so, jump to
 $B1E6 JR C,$B1F6      ; #R$B1F6.}
 $B1E8 CP $21          ; {Is #REGa equal to #N$21? If not, jump to #R$B1F6.
 $B1EA JR NZ,$B1F6     ; }
 $B1EC LD A,($72B5)    ; Load #REGa with the task-two flags (#R$72B5).
 $B1EF SET 1,A         ; Set "task-two script should advance" (bit #N$01 of
                       ; #R$72B5).
 $B1F1 LD ($72B5),A    ; Set the task-two flags (#R$72B5).
 $B1F4 XOR A           ; Clear #REGa as a false / no-match result.
 $B1F5 RET             ; Return.
; Lower the falling entity one character; keep falling, or relocate it
; when it reaches the floor band.
@label=Advance_Falling_Entity_LowerY
*$B1F6 DEC (IX+$05)    ; {Move this entity one character up.
 $B1F9 DEC (IX+$06)    ; }
 $B1FC LD A,(IX+$06)   ; Load #REGa with the current entity's y-extent.
 $B1FF CP $0C          ; {Is the current entity's y-extent less than #N$0C? If so, jump to
 $B201 JR C,$B207      ; #R$B207.}
 $B203 SET 2,(HL)      ; Set the falling-entity latch (bit #N$02 of #R$72B3).
 $B205 SCF             ; Signal success.
 $B206 RET             ; Return.
; Snap the fallen entity into room #N$03 at floor x #N$6D and finish the
; fall.
@label=Advance_Falling_Entity_RelocateAtFloor
*$B207 LD (IX+$04),$03 ; Write #N$03 to the current entity's room index.
 $B20B LD A,(IX+$08)   ; Load #REGa with the current entity's x-extent.
 $B20E SUB (IX+$07)    ; Subtract the current entity's x-coordinate from #REGa.
 $B211 LD C,A          ; Keep the current entity's x-extent in #REGc for later.
 $B212 LD A,$6D        ; Load #REGa with floor x-coordinate #N$6D.
 $B214 LD (IX+$07),A   ; Set the current entity's x-coordinate.
 $B217 ADD A,C         ; Add the saved count in #REGc to #REGa.
 $B218 LD (IX+$08),A   ; Set the current entity's x-extent.
 $B21B POP BC          ; Restore #REGbc from the stack.
 $B21C JR $B1D7        ; Jump to #R$B1D7 to finish the falling-entity pass.

; Process Rising Entities
;
; Used by the routine at #R$AAB3.
; .
; Walk entities marked as rising (lifts / bubblers), nudge their Y fields
; up and clear the rise latch at the top.
@label=Process_Rising_Entities
c$B21E LD HL,$72B3    ; Point #REGhl at the game event flags (#R$72B3).
 $B221 BIT 6,(HL)     ; {Is "special put-down / room-transition event" (bit #N$06 of #R$72B3)
 $B223 RET Z          ; set? If not, return.}
 $B224 RES 6,(HL)     ; Clear "special put-down / room-transition event" (bit #N$06 of
                      ; #R$72B3).
 $B226 LD DE,$000E    ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                      ; length into #REGde.
 $B229 LD IX,$8B69    ; Point #REGix at the simple entity table (#R$8B69).
; Scan for rising entities: nudge right while x < #N($6D), else clear the
; rise latch.
@label=Process_Rising_Entities_Scan
*$B22D LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $B230 CP $FF         ; {Is the current entity's entity type equal to #N$FF? If
 $B232 RET Z          ; so, return.}
 $B233 BIT 4,(IX+$02) ; {Is bit #N$04 of the current entity's flags byte 2 set? If not,
 $B237 JR Z,$B249     ; jump to #R$B249.}
 $B239 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $B23C CP $6D         ; {Is the current entity's x-coordinate less than #N$6D? If not, jump
 $B23E JR NC,$B24D    ; to #R$B24D.}
 $B240 INC (IX+$07)   ; {Move this entity one character right.
 $B243 INC (IX+$08)   ; }
 $B246 SET 6,(HL)     ; Set "special put-down / room-transition event" (bit #N$06 of
                      ; #R$72B3).
 $B248 RET            ; Return.
; Advance to the next entity in the rising-entity walk.
@label=Process_Rising_Entities_NextEntity
*$B249 ADD IX,DE      ; Advance #REGix to the next entity record.
 $B24B JR $B22D       ; Jump to #R$B22D to advance to the next rising entity.
; Clear the rising flag, set the risen flag, and raise a room/script
; event.
@label=Process_Rising_Entities_ClearRiseBits
*$B24D RES 4,(IX+$02) ; Reset bit #N$04 of the current entity's flags byte 2.
 $B251 SET 5,(IX+$02) ; Set bit #N$05 of the current entity's flags byte 2.
 $B255 SET 0,(HL)     ; Set "room / script event raised" (bit #N$00 of
                      ; #R$72B3).
 $B257 RET            ; Return.

; Process Special Entity Flags
;
; Used by the routine at #R$AAB3.
; .
; Process Special Entity Flags walking the entity tables at #R$8B69 /
; #R$8EE9.
@label=Process_Special_Entity_Flags
c$B258 LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $B25B BIT 0,(HL)      ; {Is "room / script event raised" (bit #N$00 of #R$72B3) set? If not,
 $B25D RET Z           ; return.}
 $B25E RES 0,(HL)      ; Clear "room / script event raised" (bit #N$00 of
                       ; #R$72B3).
 $B260 LD DE,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGde.
 $B263 LD IX,$8EE9     ; Point #REGix at Boney's complex entity state
                       ; (#R$8EE9).
; Scan special-flag entities: raise them while y < #N($28), else
; deactivate, or try an entity-slot update.
@label=Process_Special_Entity_Flags_Scan
*$B267 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B26A CP $32          ; {Is the current entity's entity type equal to #N$32?
 $B26C RET Z           ; If so, return.}
 $B26D BIT 5,(IX+$02)  ; {Is bit #N$05 of the current entity's flags byte 2 set? If not,
 $B271 JR Z,$B298      ; jump to #R$B298.}
 $B273 LD A,(IX+$05)   ; Load #REGa with the current entity's y-coordinate.
 $B276 CP $28          ; {Is the current entity's y-coordinate less than #N$28? If so, jump to
 $B278 JR C,$B288      ; #R$B288.}
 $B27A LD (IX+$00),$00 ; Write #N$00 to the current entity's entity type.
 $B27E RES 7,(IX+$01)  ; Reset bit #N$07 of the current entity's flags byte 1.
 $B282 RES 5,(IX+$02)  ; Reset bit #N$05 of the current entity's flags byte 2.
 $B286 JR $B2A6        ; Jump to #R$B2A6 to finish this special-flag entity.
; Raise the special-flag entity two characters and keep the room/script
; event latched.
@label=Process_Special_Entity_Flags_RaiseY
*$B288 INC (IX+$05)    ; {Move this entity two characters down.
 $B28B INC (IX+$06)    ;
 $B28E INC (IX+$05)    ;
 $B291 INC (IX+$06)    ; }
 $B294 SET 0,(HL)      ; Set "room / script event raised" (bit #N$00 of
                       ; #R$72B3).
 $B296 JR $B2A6        ; Jump to #R$B2A6 to finish this special-flag entity.
; When bit #N$07 is set, call #R$B2AA to update the entity slot (once or
; twice).
@label=Process_Special_Entity_Flags_TryUpdateSlot
*$B298 BIT 7,(IX+$01)  ; {Is bit #N$07 of the current entity's flags byte 1 set? If not,
 $B29C JR Z,$B2A6      ; jump to #R$B2A6.}
 $B29E CALL $B2AA      ; {Call #R$B2AA to update Entity Slot? If so, jump to
 $B2A1 JR C,$B2A6      ; #R$B2A6.}
 $B2A3 CALL $B2AA      ; Call #R$B2AA to update Entity Slot.
; Advance to the next entity and continue the special-flag scan.
@label=Process_Special_Entity_Flags_Branch
*$B2A6 ADD IX,DE       ; Advance #REGix to the next entity record.
 $B2A8 JR $B267        ; Jump to #R$B267 to advance to the next special-flag
                       ; entity.

; Update Entity Slot
;
; Used by the routine at #R$B258.
; .
; Update Entity Slot walking the entity tables at #R$8B69 / #R$8EE9.
;
; IX Address of complex state data for an entity
@label=Update_Entity_Slot
c$B2AA CALL $F2BD      ; {Call #R$F2BD to test Entity Overlap (Allow Special)? If so, jump to
 $B2AD JP C,$B3BE      ; #R$B3BE.}
 $B2B0 CP $41          ; {Is #REGa equal to #N$41? If not, jump to #R$B2E4.
 $B2B2 JR NZ,$B2E4     ; }
 $B2B4 LD A,(IX+$08)   ; Load #REGa with the current entity's x-extent.
 $B2B7 CP $73          ; {Is the current entity's x-extent less than #N$73? If so, jump to
 $B2B9 JR C,$B2BD      ; #R$B2BD.}
 $B2BB JR $B2E4        ; Jump to #R$B2E4 to continue the entity-slot update.
; At column #N($6B), nudge the entity up and right before latching the
; rise path.
@label=Update_Entity_Slot_AtColumn6B
*$B2BD LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $B2C0 CP $6B          ; {Is the current entity's x-coordinate equal to #N$6B? If not, jump to
 $B2C2 JR NZ,$B2D0     ; #R$B2D0.}
 $B2C4 DEC (IX+$05)    ; {Move this entity one character up.
 $B2C7 DEC (IX+$06)    ; }
 $B2CA INC (IX+$07)    ; {Move this entity one character right.
 $B2CD INC (IX+$08)    ; }
; Set the risen flag, raise a room/script event, and maybe poke Bad
; Tempered Thing state #N$06.
@label=Update_Entity_Slot_SetRiseAndEvent
*$B2D0 SET 5,(IX+$02)  ; Set bit #N$05 of the current entity's flags byte 2.
 $B2D4 SET 0,(HL)      ; Set "room / script event raised" (bit #N$00 of
                       ; #R$72B3).
 $B2D6 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B2D9 CP $01          ; {Is the current entity's entity type equal to #N$01? If not, jump to
 $B2DB JR NZ,$B2E2     ; #R$B2E2.}
 $B2DD LD A,$06        ; Load #REGa with Bad Tempered Thing state #N$06 for
                       ; #R$72C7.
 $B2DF LD ($72C7),A    ; Set the Bad Tempered Thing state (#R$72C7).
; Signal success and return from the entity-slot update.
@label=Update_Entity_Slot_ReturnSuccess
*$B2E2 SCF             ; Signal success.
 $B2E3 RET             ; Return.
; Test overlap with the last-collided entity; type #N$04/#N$06 spawns a
; task entity, else compare heights.
@label=Update_Entity_Slot_Branch
*$B2E4 LD IY,($72AA)   ; Load #REGiy with the last-collided entity pointer
                       ; (#R$72AA).
 $B2E8 BIT 1,(IY+$02)  ; {Is bit #N$01 of the referenced entity's flags byte 2 set? If not,
 $B2EC JP Z,$B3BE      ; jump to #R$B3BE.}
 $B2EF LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $B2F2 CP (IY+$07)     ; {Is this entity's x left of the referenced entity's x? If so, no
 $B2F5 JP C,$B3BE      ; horizontal overlap, so jump to #R$B3BE.}
 $B2F8 LD A,(IY+$08)   ; Load #REGa with the referenced entity's x-extent.
 $B2FB CP (IX+$08)     ; {Is the referenced entity's x-extent left of this entity's x-extent?
 $B2FE JP C,$B3BE      ; If so, no horizontal overlap, so jump to #R$B3BE.}
 $B301 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $B304 CP $04          ; {Is referenced entity's entity type equal to #N$04? If not, jump to
 $B306 JR NZ,$B31A     ; #R$B31A.}
 $B308 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B30B CP $06          ; {Is the current entity's entity type equal to #N$06? If not, jump to
 $B30D JP NZ,$B3BE     ; #R$B3BE.}
 $B310 CALL $C06E      ; Call #R$C06E to spawn Task Entity.
 $B313 LD (IX+$00),$00 ; Write #N$00 to the current entity's entity type.
 $B317 JP $B3B3        ; Jump to #R$B3B3 to finish the entity-slot update.
; Require vertical overlap with the collided entity before dispatching by
; type.
@label=Update_Entity_Slot_CompareHeights
*$B31A LD A,(IX+$06)   ; Load #REGa with the current entity's y-extent.
 $B31D SUB (IX+$05)    ; Subtract the current entity's y-coordinate from #REGa.
 $B320 JR Z,$B32D      ; If the result was zero, jump to #R$B32D.
 $B322 LD C,A          ; Keep the current entity's y-extent in #REGc for later.
 $B323 LD A,(IY+$06)   ; Load #REGa with the referenced entity's y-extent.
 $B326 SUB (IY+$05)    ; Subtract the referenced entity's y-coordinate from
                       ; #REGa.
 $B329 CP C            ; {Is the referenced entity's y-extent less than #REGc? If so, no
 $B32A JP C,$B3BE      ; vertical overlap, jump to #R$B3BE.}
; Type-#N$0F path: clear a type-#N$0D offer, bump the plant state, and set
; interaction flags.
@label=Update_Entity_Slot_PlantOfferPath
*$B32D LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $B330 CP $0F          ; {Is referenced entity's entity type equal to #N$0F? If not, jump to
 $B332 JR NZ,$B357     ; #R$B357.}
 $B334 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B337 CP $0D          ; {Is the current entity's entity type equal to #N$0D? If not, jump to
 $B339 JP NZ,$B3BE     ; #R$B3BE.}
 $B33C LD (IX+$00),$00 ; Write #N$00 to the current entity's entity type.
 $B340 RES 1,(IY+$02)  ; Reset bit #N$01 of the referenced entity's flags byte
                       ; 2.
 $B344 INC (IY+$09)    ; Increment the referenced entity's direction / state.
 $B347 LD (IY+$0C),$32 ; Write #N$32 to the referenced entity's extra state.
 $B34B LD A,($72B9)    ; Load #REGa with the entity interaction flag (#R$72B9).
 $B34E SET 1,A         ; Set bit #N$01 of #R$72B9.
 $B350 SET 3,A         ; Set bit #N$03 of #R$72B9.
 $B352 LD ($72B9),A    ; Set the entity interaction flag (#R$72B9).
 $B355 JR $B3B3        ; Jump to #R$B3B3 to finish the entity-slot update.
; Stove path: when type #N$09 meets type #N($14), update the stove and
; mark the slot complete.
@label=Update_Entity_Slot_StoveCollision
*$B357 CP $14          ; {Is the referenced entity's entity type equal to #N$14? If not, jump
 $B359 JR NZ,$B367     ; to #R$B367.}
 $B35B LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B35E CP $09          ; {Is the current entity's entity type equal to #N$09? If not, jump to
 $B360 JR NZ,$B367     ; #R$B367.}
 $B362 CALL $C63B      ; Call #R$C63B to update Stove.
 $B365 JR $B3A2        ; Jump to #R$B3A2 to mark the entity slot complete.
; Gate past type #N$05 / reject type #N$09 before testing type-#N$08
; collisions.
@label=Update_Entity_Slot_YellowCupCollision
*$B367 CP $05          ; {Is the current entity's entity type equal to #N$05? If so, jump to
 $B369 JR Z,$B375      ; #R$B375.}
 $B36B LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B36E CP $09          ; {Is the current entity's entity type equal to #N$09? If so, jump to
 $B370 JR Z,$B3BE      ; #R$B3BE.}
 $B372 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
; Type-#N$08/#N$0B collision path: check entity collision then mark the
; slot complete.
@label=Update_Entity_Slot_BasketCollision
*$B375 CP $08          ; {Is referenced entity's entity type equal to #N$08? If not, jump to
 $B377 JR NZ,$B385     ; #R$B385.}
 $B379 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B37C CP $0B          ; {Is the current entity's entity type equal to #N$0B? If not, jump to
 $B37E JR NZ,$B385     ; #R$B385.}
 $B380 CALL $D446      ; Call #R$D446 to check Entity Collision.
 $B383 JR $B3A2        ; Jump to #R$B3A2 to mark the entity slot complete.
; Crusher path: type #N$16 meeting type #N$0E updates the crusher and
; completes the slot.
@label=Update_Entity_Slot_CrusherCollision
*$B385 CP $16          ; {Is the current entity's entity type equal to #N$16? If not, jump to
 $B387 JR NZ,$B396     ; #R$B396.}
 $B389 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B38C CP $0E          ; {Is the current entity's entity type equal to #N$0E? If not, jump to
 $B38E JP NZ,$B3BE     ; #R$B3BE.}
 $B391 CALL $CF1E      ; Call #R$CF1E to update Crusher.
 $B394 JR $B3A2        ; Jump to #R$B3A2 to mark the entity slot complete.
; If this slot is type #N($01), set Bad Tempered Thing state #N$03 before
; completing.
@label=Update_Entity_Slot_BadTemperedThing
*$B396 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B399 CP $01          ; {Is the current entity's entity type equal to #N$01? If not, jump to
 $B39B JR NZ,$B3A2     ; #R$B3A2.}
 $B39D LD A,$03        ; Load #REGa with Bad Tempered Thing state #N$03 for
                       ; #R$72C7.
 $B39F LD ($72C7),A    ; Set the Bad Tempered Thing state (#R$72C7).
; Mark the entity slot complete: set risen/extra-state bits and type bit
; #N$07.
@label=Update_Entity_Slot_MarkComplete
*$B3A2 SET 5,(IX+$01)  ; Set bit #N$05 of the current entity's flags byte 1.
 $B3A6 PUSH IY         ; Stash #REGiy on the stack.
 $B3A8 POP BC          ; Restore #REGbc from the stack.
 $B3A9 LD (IX+$0C),C   ; Store #REGc in the current entity's extra state.
 $B3AC LD (IX+$0D),B   ; Store #REGb in the current entity's extra state.
 $B3AF SET 7,(IX+$00)  ; Set bit #N$07 of the current entity's entity type.
; Clear entity-flags bit #N($07), queue the entity-slot sound, and return
; success.
@label=Update_Entity_Slot_ClearBit7AndSound
*$B3B3 RES 7,(IX+$01)  ; Reset bit #N$07 of the current entity's flags byte 1.
; #HTML(#AUDIO0(entity-slot.wav)(#INCLUDE(EntitySlot)))
 $B3B7 LD A,$84        ; Load #REGa with sound index #N$84.
 $B3B9 CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
 $B3BC SCF             ; Signal success.
 $B3BD RET             ; Return.
; Snap the entity to the room-floor y band, restore helper layout when
; type #N($06), else fall through.
@label=Update_Entity_Slot_SnapToRoomFloor
*$B3BE LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $B3C1 ADD A,$22       ; Add #N$22 to #REGa (adjust an entity coordinate).
 $B3C3 LD B,A          ; Keep the current entity's room index in #REGb for
                       ; later.
 $B3C4 CP (IX+$06)     ; {Does room+#N$22 match this entity's y-extent? If not, jump to
 $B3C7 JR NC,$B410     ; #R$B410.}
 $B3C9 LD A,(IX+$06)   ; Load #REGa with the current entity's y-extent.
 $B3CC SUB (IX+$05)    ; Subtract the current entity's y-coordinate from #REGa.
 $B3CF LD C,A          ; Keep the current entity's y-extent in #REGc for later.
 $B3D0 LD (IX+$06),B   ; Store #REGb in the current entity's y-extent.
 $B3D3 LD A,B          ; Copy the loop counter from #REGb into #REGa.
 $B3D4 SUB C           ; Subtract #REGc from the current entity's y-extent.
 $B3D5 LD (IX+$05),A   ; Set the current entity's y-coordinate.
 $B3D8 RES 7,(IX+$01)  ; Reset bit #N$07 of the current entity's flags byte 1.
 $B3DC LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $B3DF CP $06          ; {Is the current entity's entity type equal to #N$06? If not, jump to
 $B3E1 JR NZ,$B3F4     ; #R$B3F4.}
 $B3E3 LD A,($72B5)    ; Load #REGa with the task-two flags (#R$72B5).
 $B3E6 SET 3,A         ; Set "helper entity needs its layout restoring" (bit #N$03 of
                       ; #R$72B5).
 $B3E8 LD ($72B5),A    ; Set the task-two flags (#R$72B5).
 $B3EB LD BC,$9DC0     ; Load #REGbc with helper graphic layout address
                       ; #R$9DC0.
 $B3EE LD ($8FE1),BC   ; Write the layout address into the spawned helper's layout field
                       ; (#R$8EF3(#N$8FE1)).
 $B3F2 JR $B409        ; Jump to #R$B409 to queue the entity-slot wait sound.
; When task-two flags are #N($01), set Bad Tempered Thing state #N$02.
@label=Update_Entity_Slot_MaybeSetBTT
*$B3F4 CP $01          ; {Is task-two flags equal to #N$01? If not, jump to
 $B3F6 JR NZ,$B3FD     ; #R$B3FD.}
 $B3F8 LD A,$02        ; Load #REGa with Bad Tempered Thing state #N$02 for
                       ; #R$72C7.
 $B3FA LD ($72C7),A    ; Set the Bad Tempered Thing state (#R$72C7).
; Maybe set SlimyLoose on the task-three flags before queuing the land
; sound.
@label=Update_Entity_Slot_MaybeTaskThreeBit
*$B3FD CP $09          ; {Is #N$02 equal to #N$09? If not, jump to #R$B409.
 $B3FF JR NZ,$B409     ; }
 $B401 LD A,($72B6)    ; Load #REGa with the task-three flags (#R$72B6).
 $B404 SET 2,A         ; Set SlimyLoose (bit #N$02 of #R$72B6. #R$D907 skips that line while
                       ; set).
 $B406 LD ($72B6),A    ; Set the task-three flags (#R$72B6).
; #HTML(#AUDIO0(entity-slot-wait.wav)(#INCLUDE(EntitySlotWait)))
@label=Update_Entity_Slot_QueueLandSound
*$B409 LD A,$87        ; Load #REGa with sound index #N$87.
 $B40B CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
 $B40E SCF             ; Signal success.
 $B40F RET             ; Return.
; Land-step: drop the entity one row and raise a room/script event on
; #R$72B3.
@label=Update_Entity_Slot_RaiseYAndEvent
*$B410 INC (IX+$05)    ; {Move this entity one character down.
 $B413 INC (IX+$06)    ; }
 $B416 SET 0,(HL)      ; Set "room / script event raised" (bit #N$00 of
                       ; #R$72B3).
 $B418 XOR A           ; Clear #REGa as a false / no-match result.
 $B419 RET             ; Return.

; Update Berk Controller
;
; Used by the routine at #R$AAB3.
; .
; Copy room/x/x-extent from the camera-follow entity (#R$909B) into
; #R$7305/#R$7303/#R$7304, then call #R$B440 with that IX.
@label=Update_Berk_Controller
c$B41A LD IX,$909B   ; Point #REGix at the camera-follow entity (#R$909B).
 $B41E LD A,(IX+$04) ; Load #REGa with the current entity's room index.
 $B421 LD ($7305),A  ; Set Berk's room-index copy (#R$7305).
 $B424 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $B427 LD ($7303),A  ; Set Berk's X-coordinate copy (#R$7303).
 $B42A LD A,(IX+$08) ; Load #REGa with the current entity's x-extent.
 $B42D LD ($7304),A  ; Set Berk's X-extent copy (#R$7304).
 $B430 LD HL,($72B1) ; Load #REGhl with Berk's script position pointer
                     ; (#R$72B1).
 $B433 LD ($72CF),HL ; Store #REGhl in the active script cursor (#R$72CF).
 $B436 CALL $B440    ; Call #R$B440 to read Berk's controls and choose a
                     ; script.
 $B439 LD HL,($72CF) ; Load #REGhl with the active script cursor (#R$72CF).
 $B43C LD ($72B1),HL ; Store #REGhl in Berk's script position pointer
                     ; (#R$72B1).
 $B43F RET           ; Return.

; Update Berk: Read Controls
;
; Used by the routine at #R$B41A.
; .
; Drive Berk from the control input bitmap at #R$F5F8: walk, turn,
; fire (pick up / put down / trap door offer) or idle scripts.
;
; IX Address of the camera-follow entity (#R$909B) (loaded by #R$B41A)
;
; Script lock and held-entity gate: ignore controls while a script is
; already running.
@label=Update_Berk_ReadControls
c$B440 BIT 0,(IX+$03)  ; {Is Berk script-locked (bit #N$00 of #REGix+#N$03)? If so,
 $B444 JP NZ,$EC2E     ; advance the current script at #R$EC2E.}
 $B447 BIT 4,(IX+$03)  ; {Is Berk carrying / mid put-down (bit #N$04)? If not, read the
 $B44B JR Z,$B45D      ; controls at #R$B45D.}
 $B44D LD IY,($72AC)   ; Point #REGiy at the held entity (#R$72AC).
 $B451 BIT 3,(IY+$02)  ; {Is that held entity still marked "held" (bit #N$03)? If not, read
 $B455 JR Z,$B45D      ; the controls at #R$B45D.}
 $B457 LD HL,$BA31     ; Point #REGhl at Berk's "still holding" interaction script
                       ; (#R$B9A5(#N$BA31)).
 $B45A JP $EC30        ; Run that script via #R$EC30.
; Read the control input bitmap (#R$F5F8) and branch on direction / fire.
@label=Berk_ReadControls_Dispatch
*$B45D LD A,($F5F8)    ; Fetch the control input bitmap from #R$F5F8.
 $B460 BIT 0,A         ; {Has right been pressed? If so, jump to #R$B8C6 to
 $B462 JP NZ,$B8C6     ; walk Berk right.}
 $B465 BIT 1,A         ; {Has left been pressed? If so, jump to #R$B810 to walk
 $B467 JP NZ,$B810     ; Berk left.}
 $B46A BIT 2,A         ; {Has down (forward) been pressed? If so, jump to #R$B6F9 to move Berk
 $B46C JP NZ,$B6F9     ; forward.}
 $B46F BIT 3,A         ; {Has up (back) been pressed? If so, jump to #R$B560 to move Berk back
 $B471 JP NZ,$B560     ; / up.}
 $B474 BIT 4,A         ; {Has fire been pressed? If so, jump to #R$B4A5 to pick up, put down
 $B476 JP NZ,$B4A5     ; or offer to the trap.}
 $B479 BIT 5,A         ; {Has the secondary action key been pressed? If so, jump to #R$B52E
 $B47B JP NZ,$B52E     ; for the alternate fire path.}
; This entry point is used by the routines at #R$B7F3, #R$B87C and #R$B92C.
; .
; Handle idle: clear the holding lock and pick a facing script.
@label=Berk_ReadControls_Idle
*$B47E RES 3,(IX+$03)  ; Reset bit #N$03 of flags byte 3 (#REGix+#N$03).
 $B482 BIT 1,(IX+$03)  ; {Is Berk facing left (bit #N$01)? If not, use the right-facing idle
 $B486 JR Z,$B49F      ; script at #R$B49F.}
 $B488 BIT 2,(IX+$03)  ; {Test the mid-interaction latch (bit #N$02). Clear that latch. If
 $B48C RES 2,(IX+$03)  ; it was set, still use the right-facing idle script at #R$B49F.
 $B490 JR NZ,$B49F     ; }
 $B492 BIT 3,(IX+$09)  ; {Is Berk's direction byte already "face left" bit #N$03? If not,
 $B496 JP Z,$EC2E      ; continue the current script at #R$EC2E.}
 $B499 LD HL,$B9CD     ; Point #REGhl at Berk's left-facing idle script
                       ; (#R$B9A5(#N$B9CD)).
 $B49C JP $EC30        ; Run that script via #R$EC30.
; Idle facing right: run Berk's right-facing idle script at
; #R$B9AD via #R$EC30.
@label=Berk_ReadControls_IdleFaceRight
*$B49F LD HL,$B9AD     ; Point #REGhl at Berk's right-facing idle script
                       ; (#R$B9AD).
 $B4A2 JP $EC30        ; Run that script via #R$EC30.
; Handle fire: pick up, put down or offer an item to the trap door.
@label=Berk_ReadControls_OfferOrPutDown
*$B4A5 BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, fall
 $B4A9 JP Z,$B47E      ; back to idle at #R$B47E.}
 $B4AC LD A,(IX+$06)   ; Load Berk's y-extent.
 $B4AF CP $1B          ; {Is Berk standing on the trap door row (y-extent #N$1B)? If so,
 $B4B1 JR Z,$B4B8      ; handle the offer at #R$B4B8.}
 $B4B3 CP $23          ; {Is he still below the offer band (y-extent < #N$23)? If so, idle at
 $B4B5 JP C,$B47E      ; #R$B47E.}
; Facing-left trap offer: test the held entity with #R$F25F, then offer or
; put down.
@label=Berk_ReadControls_OfferOrPutDownOfferTrap
*$B4B8 BIT 1,(IX+$03)  ; {Is Berk facing left? If not, try the right-facing offer path at
 $B4BC JR Z,$B4FF      ; #R$B4FF.}
 $B4BE PUSH IX         ; Stash #REGix on the stack.
 $B4C0 LD IX,($72AC)   ; Switch #REGix to the held entity (#R$72AC).
 $B4C4 CALL $F25F      ; Call #R$F25F to test whether that entity can be
                       ; offered to the trap.
 $B4C7 POP IX          ; Restore #REGix from the stack.
 $B4C9 JR C,$B4F3      ; If the offer was rejected, skip ahead to the reject script at
                       ; #R$B4F3.
 $B4CB CP $3D          ; {Is Berk's y-extent exactly the trap mouth (#N$3D)? If not, use the
 $B4CD JR NZ,$B4F9     ; put-down script at #R$B4F9.}
 $B4CF LD A,($72B3)    ; Fetch the game event flags (#R$72B3).
 $B4D2 BIT 3,A         ; {Has an object already been offered to the trap (bit #N$03)? If so,
 $B4D4 JR NZ,$B4F9     ; just put down at #R$B4F9.}
 $B4D6 SET 3,A         ; Mark "object offered to the trap" (set bit #N$03).
 $B4D8 LD ($72B3),A    ; Write the updated game event flags back to #R$72B3.
 $B4DB LD IY,($72AC)   ; Point #REGiy at the held entity (#R$72AC).
 $B4DF SET 6,(IY+$01)  ; Set that entity's can-fall latch (bit #N$06).
 $B4E3 LD ($8D89),IY   ; Remember it as the trap door entity pointer slot
                       ; (#R$8D89).
 $B4E7 LD A,(IY+$00)   ; Load the held entity's type.
 $B4EA CP $01          ; {Is it type #N$01 (Berk's own slot)? If not, run the offer script at
 $B4EC JR NZ,$B4F3     ; #R$B4F3.}
 $B4EE LD A,$08        ; Load the Bad Tempered Thing "object offered" state
                       ; (#N$08).
 $B4F0 LD ($72C7),A    ; Store it at #R$72C7.
; Run Berk's trap-offer script (#R$B9A5(#N$BA3F)) after accepting or
; rejecting the offer.
@label=Berk_ReadControls_OfferOrPutDownOfferScript
*$B4F3 LD HL,$BA3F     ; Point #REGhl at Berk's trap-offer script
                       ; (#R$B9A5(#N$BA3F)).
 $B4F6 JP $EC30        ; Run that script via #R$EC30.
; Put the held item down with Berk's standard put-down script (#R$B9A5).
@label=Berk_ReadControls_OfferOrPutDownPutDown
*$B4F9 LD HL,$B9A5     ; Point #REGhl at Berk's standard put-down script
                       ; (#R$B9A5).
 $B4FC JP $EC30        ; Run that script via #R$EC30.
; Right-facing fire path: test a trap offer or fall back to idle / hold.
@label=Berk_ReadControls_OfferOrPutDownFaceRight
*$B4FF LD A,(IX+$06)   ; Load Berk's y-extent.
 $B502 PUSH IX         ; Stash #REGix on the stack.
 $B504 LD IX,($72AC)   ; Switch #REGix to the held entity (#R$72AC).
 $B508 CP $1B          ; {Is Berk on the trap door row (y-extent #N$1B)? If so, handle that
 $B50A JR Z,$B51E      ; offer at #R$B51E.}
 $B50C CALL $F2C2      ; Call #R$F2C2 to test a right-facing trap offer.
 $B50F POP IX          ; Restore #REGix from the stack.
 $B511 JR C,$B518      ; If the offer was accepted, run the holding script at
                       ; #R$B518.
 $B513 CP $32          ; {Is Berk still below the mid-room band (y-extent < #N$32)? If so,
 $B515 JP C,$B47E      ; idle at #R$B47E.}
; Keep holding: run Berk's "still holding" script (#R$B9A5(#N$BA31)).
@label=Berk_ReadControls_OfferOrPutDownHoldScript
*$B518 LD HL,$BA31     ; Point #REGhl at Berk's "still holding" script
                       ; (#R$B9A5(#N$BA31)).
 $B51B JP $EC30        ; Run that script via #R$EC30.
; On the trap door row facing right: validate the offer, then run the
; trap-row script.
@label=Berk_ReadControls_OfferOrPutDownTrapRow
*$B51E CALL $F2C2      ; Call #R$F2C2 to test the trap-row offer.
 $B521 POP IX          ; Restore #REGix from the stack.
 $B523 CP $35          ; {Is Berk's y-extent exactly #N$35? If so, idle at
 $B525 JP Z,$B47E      ; #R$B47E.}
 $B528 LD HL,$BA67     ; Point #REGhl at Berk's trap-row interaction script
                       ; (#R$B9A5(#N$BA67)).
 $B52B JP $EC30        ; Run that script via #R$EC30.
; Handle secondary fire: put down when carrying, otherwise idle.
@label=Berk_ReadControls_SecondaryFire
*$B52E BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, idle at
 $B532 JP Z,$B47E      ; #R$B47E.}
 $B535 BIT 1,(IX+$03)  ; {Is Berk facing left? If not, try the right-facing secondary path at
 $B539 JR Z,$B541      ; #R$B541.}
 $B53B LD HL,$B9A5     ; Point #REGhl at Berk's standard put-down script
                       ; (#R$B9A5).
 $B53E JP $EC30        ; Run that script via #R$EC30.
; Right-facing secondary fire: validate the held entity with #R$F2C2, then
; put it down.
@label=Berk_ReadControls_SecondaryFireRight
*$B541 PUSH IX         ; Stash #REGix on the stack.
 $B543 LD IX,($72AC)   ; Switch #REGix to the held entity (#R$72AC).
 $B547 LD A,(IX+$02)   ; Load the held entity's flags byte 2.
 $B54A AND %01000010   ; Keep only bits #N$06 and #N$01 (can-fall /
                       ; facing-left).
 $B54C JR Z,$B55B      ; If neither bit is set, abandon the secondary action at
                       ; #R$B55B.
 $B54E CALL $F2C2      ; Call #R$F2C2 to validate the put-down.
 $B551 JR NC,$B55B     ; If validation failed, abandon at #R$B55B.
 $B553 POP IX          ; Restore #REGix from the stack.
 $B555 LD HL,$BBA1     ; Point #REGhl at Berk's alternate put-down script
                       ; (#R$B9A5(#N$BBA1)).
 $B558 JP $EC30        ; Run that script via #R$EC30.
; Abort secondary fire and return Berk to idle at #R$B47E.
@label=Berk_ReadControls_SecondaryFireAbort
*$B55B POP IX          ; Restore #REGix from the stack.
 $B55D JP $B47E        ; Idle at #R$B47E.
; Handle up / back: turn or walk Berk toward the back of the room.
@label=Berk_ReadControls_Up
*$B560 BIT 1,(IX+$03)  ; {Is Berk already facing left? If so, continue the
 $B564 JP NZ,$B56D     ; up-walk at #R$B56D.}
 $B567 LD HL,$B9C5     ; Point #REGhl at Berk's turn-to-face-back script
                       ; (#R$B9A5(#N$B9C5)).
 $B56A JP $EC30        ; Run that script via #R$EC30.
; Walk Berk back/up: probe the row above, clamp the camera, then branch on
; collision height.
@label=Berk_ReadControls_UpWalk
*$B56D DEC (IX+$05)    ; Probe one character above Berk's current y.
 $B570 CALL $F252      ; Call #R$F252 to clamp Camera Position.
 $B573 INC (IX+$05)    ; Restore Berk's y after the camera clamp probe.
 $B576 JP C,$B617      ; If a hit/borrow was signaled, jump to #R$B617.
 $B579 CP $64          ; {Is #REGa less than #N$64? If not, jump to #R$B624.
 $B57B JP NC,$B624     ; }
 $B57E CP $41          ; {Is #REGa equal to #N$41? If so, jump to #R$B6EA.
 $B580 JP Z,$B6EA      ; }
 $B583 CP $32          ; {Is #REGa less than #N$32? If not, jump to #R$B58C.
 $B585 JR NC,$B58C     ; }
 $B587 CP $1E          ; {Is #REGa less than #N$1E? If not, jump to #R$B986.
 $B589 JP NC,$B986     ; }
; Up-path interact: offer to the trap, grab scenery, or hand off to
; #R$B7F3.
@label=Berk_ReadControls_UpInteract
*$B58C BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B590 JP NZ,$B6AC     ; #R$B6AC.}
 $B593 LD IY,($72AA)   ; Load #REGiy with the last-collided entity pointer
                       ; (#R$72AA).
 $B597 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $B59A CP $0F          ; {Is referenced entity's entity type equal to #N$0F? If so, jump to
 $B59C JP Z,$B642      ; #R$B642.}
 $B59F BIT 4,(IY+$01)  ; {Is bit #N$04 of the referenced entity's flags byte 1 set? If so,
 $B5A3 JP NZ,$B642     ; jump to #R$B642.}
 $B5A6 BIT 3,(IY+$01)  ; {Is bit #N$03 of the referenced entity's flags byte 1 set? If not,
 $B5AA JR Z,$B5F8      ; jump to #R$B5F8.}
 $B5AC CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B5AF JP C,$B7A3      ; #R$B7A3? If not, jump to #R$B7B4.
 $B5B2 JP NZ,$B7B4     ; }
 $B5B5 PUSH IX         ; Stash #REGix on the stack.
 $B5B7 LD IX,($72AA)   ; Load #REGix with the last-collided entity pointer
                       ; (#R$72AA).
 $B5BB LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $B5BE OR A            ; {Is the current entity's room index zero? If so, jump
 $B5BF JR Z,$B5F6      ; to #R$B5F6.}
 $B5C1 CP $01          ; {Is the current entity's room index equal to #N$01? If not, jump to
 $B5C3 JR NZ,$B5D4     ; #R$B5D4.}
 $B5C5 LD ($8D89),IX   ; Store #REGix in the trap door entity pointer
                       ; (#R$8D89).
 $B5C9 SET 6,(IX+$01)  ; Set bit #N$06 of the current entity's flags byte 1.
 $B5CD LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $B5D0 SET 3,(HL)      ; Set "object has been offered to the trap" (bit #N$03
                       ; of #R$72B3).
 $B5D2 JR $B5FE        ; Jump to #R$B5FE to store Berk's extra state.
; Room-specific up checks: camera tweak, trap mouth (#N$3D), or special X
; band (#N$68).
@label=Berk_ReadControls_UpRoomCheck
*$B5D4 CALL $F25B      ; {Call #R$F25B to adjust Camera X? If so, jump to
 $B5D7 JR C,$B5FE      ; #R$B5FE.}
 $B5D9 CP $3D          ; {Is the current entity's room index equal to #N$3D? If so, jump to
 $B5DB JR Z,$B5FE      ; #R$B5FE.}
 $B5DD CP $68          ; {Is the current entity's room index equal to #N$68? If not, jump to
 $B5DF JR NZ,$B5F6     ; #R$B5F6.}
 $B5E1 LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $B5E4 BIT 3,A         ; {Is bit #N$03 of game event flags set? If so, jump to
 $B5E6 JR NZ,$B5F6     ; #R$B5F6.}
 $B5E8 LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $B5EB CP $98          ; {Is the current entity's x-coordinate less than #N$98? If so, jump to
 $B5ED JR C,$B5F6      ; #R$B5F6.}
 $B5EF LD A,$9D        ; Load #REGa with #N$9D.
 $B5F1 CP (IX+$08)     ; {Does #REGa match this entity's x-extent? If not, jump
 $B5F4 JR NC,$B5FE     ; to #R$B5FE.}
; Failed up-path grab: restore Berk's entity pointer and fall into the
; put-down script.
@label=Berk_ReadControls_UpRestore
*$B5F6 POP IX          ; Restore #REGix from the stack.
; Run a left-facing idle/put-down fragment (#R$B9A5(#N$B9CD)) when the up
; grab is rejected.
@label=Berk_ReadControls_UpPutDownScript
*$B5F8 LD HL,$B9CD     ; Point #REGhl at a Berk put-down script fragment
                       ; (#R$B9A5(#N$B9CD)).
 $B5FB JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Commit the grabbed entity into Berk's held state and launch script
; #R$BABB.
@label=Berk_ReadControls_UpGrabEntity
*$B5FE PUSH IX         ; Stash #REGix on the stack.
 $B600 POP BC          ; {Restore #REGbc and #REGix from the stack.
 $B601 POP IX          ; }
 $B603 LD (IX+$0C),C   ; Store #REGc in the current entity's extra state.
 $B606 LD (IX+$0D),B   ; Store #REGb in the current entity's extra state.
 $B609 SET 3,(IX+$03)  ; Set bit #N$03 of the current entity's flags byte 3.
 $B60D RES 2,(IX+$03)  ; Reset bit #N$02 of the current entity's flags byte 3.
 $B611 LD HL,$BABB     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BABB).
 $B614 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Camera-clamp hit on up: drop/control put-down via #R$BA8F, or keep the
; current script.
@label=Update_Berk_Movement_And_Script_PartA
*$B617 BIT 3,(IX+$09)  ; {Is bit #N$03 of the current entity's direction / state set? If so,
 $B61B JP NZ,$EC2E     ; jump to #R$EC2E.}
 $B61E LD HL,$BA8F     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BA8F).
 $B621 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Up-path collision: let #R$B7F3 decide interact vs the shared down-branch
; at #R$B7B4.
@label=Update_Berk_Movement_And_Script_PartB
*$B624 CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B627 JR Z,$B62F      ; #R$B62F? If not, jump to #R$B7B4.
 $B629 JP NC,$B7B4     ; }
 $B62C JP $B7A3        ; Jump to #R$B7A3.
; Special room interact: refresh the camera origin from Berk movement data
; and resume.
@label=Update_Berk_Movement_And_Script_PartC
*$B62F LD A,C          ; Copy the saved count/flag from #REGc into #REGa.
 $B630 CP $66          ; {Is #N$9D equal to #N$66? If not, jump to #R$B617.
 $B632 JR NZ,$B617     ; }
 $B634 PUSH HL         ; Stash #REGhl on the stack.
 $B635 LD HL,$B63D     ; Point #REGhl at Berk movement script data (#R$B63D).
 $B638 LD A,$A0        ; Load #REGa with #N$A0.
 $B63A JP $B781        ; Jump to #R$B781 to refresh the camera room origin.
 $B63D INC B           ; Advance the layout-table index in #REGb.
 $B63E LD HL,$A227     ; Point #REGhl at graphic layout/table #R$A1F8(#N$A227).
 $B641 AND A           ; Test whether #N$A0 is zero (clear carry).
; Plant-pot / type-#N$0F up interact: retarget layout #R$A0B5 and
; update plant pots.
@label=Update_Berk_Movement_And_Script_PartD
*$B642 CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B645 JP C,$B7A3      ; #R$B7A3? If not, jump to #R$B7B4.
 $B648 JP NZ,$B7B4     ; }
 $B64B LD B,(IX+$06)   ; Load #REGb with the current entity's y-extent.
 $B64E DEC B           ; Step the loop counter in #REGb back by one.
 $B64F LD IY,($72AA)   ; Load #REGiy with the last-collided entity pointer
                       ; (#R$72AA).
 $B653 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $B656 CP $0F          ; {Is referenced entity's entity type equal to #N$0F? If not, jump to
 $B658 JR NZ,$B67C     ; #R$B67C.}
 $B65A LD A,(IY+$09)   ; Load #REGa with the referenced entity's direction /
                       ; state.
 $B65D CP $07          ; {Is referenced entity's direction / state equal to #N$07? If not,
 $B65F JP NZ,$B5F8     ; jump to #R$B5F8.}
 $B662 LD (IY+$09),$0B ; Write #N$0B to the referenced entity's direction /
                       ; state.
 $B666 LD BC,$A0B5     ; Load #REGbc with graphic layout address #R$A0B5.
 $B669 LD (IY+$0A),C   ; Set the low byte of the referenced entity's graphic layout address
                       ; from #REGc.
 $B66C LD (IY+$0B),B   ; Set the high byte of the referenced entity's graphic layout address
                       ; from #REGb.
 $B66F PUSH IX         ; Stash #REGix on the stack.
 $B671 LD IX,($72AA)   ; Load #REGix with the last-collided entity pointer
                       ; (#R$72AA).
 $B675 LD C,$06        ; Load #REGc with #N$06 as an entity/loop count.
 $B677 CALL $CEE1      ; Call #R$CEE1 to update Plant Pots.
 $B67A POP IX          ; Restore #REGix from the stack.
; Adopt the collided entity as held and clear any pending trap-offer flag.
@label=Update_Berk_Movement_And_Script_PartE
*$B67C LD ($72AC),IY   ; Store #REGiy in the current-entity pointer (#R$72AC).
 $B680 BIT 6,(IY+$01)  ; {Is bit #N$06 of the referenced entity's flags byte 1 set? If not,
 $B684 JR Z,$B68F      ; jump to #R$B68F.}
 $B686 RES 6,(IY+$01)  ; Reset bit #N$06 of the referenced entity's flags byte
                       ; 1.
 $B68A LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $B68D RES 3,(HL)      ; Clear "object has been offered to the trap" (bit #N$03
                       ; of #R$72B3).
; Choose a pick-up/put-down script from the collided entity's y-extent vs
; Berk.
@label=Update_Berk_Movement_And_Script_PartF
*$B68F LD A,(IY+$06)   ; Load #REGa with the referenced entity's y-extent.
 $B692 CP (IX+$05)     ; {Does #REGa match this entity's y-coordinate? If so,
 $B695 JR C,$B6A6      ; jump to #R$B6A6.}
 $B697 CP B            ; {Does the referenced entity's y-extent equal #REGb? If so, jump to
 $B698 JR Z,$B6A0      ; #R$B6A0.}
 $B69A LD HL,$BA07     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BA07).
 $B69D JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run put-down script #R$B9A5(#N$B9EB) when y-extents match the stepped
; collision band.
@label=Update_Berk_Movement_And_Script_PartG
*$B6A0 LD HL,$B9EB     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$B9EB)).
 $B6A3 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run put-down script #R$B9A5(#N$B9F9) when the collided entity sits on
; Berk's own y.
@label=Update_Berk_Movement_And_Script_PartH
*$B6A6 LD HL,$B9F9     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$B9F9)).
 $B6A9 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Carrying-flag up path: require a latch-set collidee, with a type-#N$15
; special case.
@label=Update_Berk_Movement_And_Script_PartI
*$B6AC LD IY,($72AA)   ; Load #REGiy with the last-collided entity pointer
                       ; (#R$72AA).
 $B6B0 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $B6B3 BIT 2,(IY+$02)  ; {Is bit #N$02 of the referenced entity's flags byte 2 set? If not,
 $B6B7 JP Z,$B5F8      ; jump to #R$B5F8.}
 $B6BA CP $15          ; {Is referenced entity's entity type equal to #N$15? If not, jump to
 $B6BC JR NZ,$B6C8     ; #R$B6C8.}
 $B6BE LD BC,($72AC)   ; Load #REGbc with the current-entity pointer (#R$72AC).
 $B6C2 LD A,(BC)       ; Fetch a byte through the pointer in #REGbc.
 $B6C3 CP $04          ; {Is referenced entity's entity type equal to #N$04? If not, jump to
 $B6C5 JP NZ,$B5F8     ; #R$B5F8.}
; Align held-entity y-extent (#R$72E9) and pick script #R$B9A5(#N$BA5B) or
; #R$B9A5(#N$BA4D).
@label=Update_Berk_Movement_And_Script_PartJ
*$B6C8 CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B6CB JP C,$B7A3      ; #R$B7A3? If not, jump to #R$B7B4.
 $B6CE JP NZ,$B7B4     ; }
 $B6D1 LD C,(IX+$05)   ; Load #REGc with the current entity's y-coordinate.
 $B6D4 LD A,(IY+$05)   ; Load #REGa with the referenced entity's y-coordinate.
 $B6D7 DEC A           ; Step referenced entity's y-coordinate back by one.
 $B6D8 LD ($72E9),A    ; Set held-entity y-extent (#R$72E9).
 $B6DB CP C            ; {Does the referenced entity's y equal #REGc? If so,
 $B6DC JR C,$B6E4      ; jump to #R$B6E4.}
 $B6DE LD HL,$BA5B     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$BA5B)).
 $B6E1 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run put-down script #R$B9A5(#N$BA4D) once the held entity's y matches
; Berk.
@label=Update_Berk_Movement_And_Script_PartK
*$B6E4 LD HL,$BA4D     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$BA4D)).
 $B6E7 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Flags-#N$41 up interact: hand off to #R$B7F3, then run script
; #R$B9A5(#N$BB4F).
@label=Update_Berk_Movement_And_Script_PartL
*$B6EA CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B6ED JP C,$B7A3      ; #R$B7A3? If not, jump to #R$B7B4.
 $B6F0 JP NZ,$B7B4     ; }
 $B6F3 LD HL,$BB4F     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$BB4F)).
 $B6F6 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Handle down / forward: turn or walk Berk toward the front of the room.
@label=Berk_ReadControls_Down
*$B6F9 BIT 1,(IX+$03)  ; {Is the current entity facing left (bit #N$01 of #REGix+#N$03)?
 $B6FD JP Z,$B706      ; If not, jump to #R$B706.}
 $B700 LD HL,$B9A5     ; Point #REGhl at Berk put-down script data (#R$B9A5).
 $B703 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Walk Berk forward/down: depth-overlap test, then branch on collidee
; height and flags.
@label=Berk_ReadControls_DownWalk
*$B706 CALL $F2C7      ; {Call #R$F2C7 to test Entity Overlap At Depth? If so, jump to
 $B709 JR C,$B764      ; #R$B764.}
 $B70B CP $64          ; {Is referenced entity's y-coordinate less than #N$64? If not, jump to
 $B70D JP NC,$B771     ; #R$B771.}
 $B710 CP $41          ; {Is referenced entity's y-coordinate equal to #N$41? If so, jump to
 $B712 JP Z,$B7E6      ; #R$B7E6.}
 $B715 CP $32          ; {Is referenced entity's y-coordinate less than #N$32? If not, jump to
 $B717 JP NC,$B47E     ; #R$B47E.}
 $B71A CP $1E          ; {Is referenced entity's y-coordinate less than #N$1E? If not, jump to
 $B71C JP NC,$B986     ; #R$B986.}
 $B71F BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B723 JP NZ,$B47E     ; #R$B47E.}
 $B726 LD BC,($72AA)   ; Load #REGbc with the last-collided entity pointer
                       ; (#R$72AA).
 $B72A INC BC          ; Advance the counter/pointer in #REGbc by one.
 $B72B LD A,(BC)       ; Fetch a byte through the pointer in #REGbc.
 $B72C BIT 4,A         ; {Is bit #N$04 of referenced entity's y-coordinate set? If so, jump to
 $B72E JP NZ,$B7C5     ; #R$B7C5.}
 $B731 BIT 3,A         ; {Is bit #N$03 of referenced entity's y-coordinate set? If not, jump
 $B733 JP Z,$B47E      ; to #R$B47E.}
 $B736 CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If so, jump to
 $B739 JR C,$B7A3      ; #R$B7A3? If not, jump to #R$B7B4.
 $B73B JP NZ,$B7B4     ; }
 $B73E PUSH IX         ; Stash #REGix on the stack.
 $B740 LD IX,($72AA)   ; Load #REGix with the last-collided entity pointer
                       ; (#R$72AA).
 $B744 LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $B747 CP $04          ; {Is the current entity's room index less than #N$04? If not, jump to
 $B749 JR NC,$B750     ; #R$B750.}
 $B74B CALL $F2C7      ; {Call #R$F2C7 to test Entity Overlap At Depth? If so, jump to
 $B74E JR C,$B755      ; #R$B755.}
; Abort the down-path grab and return Berk to idle at #R$B47E.
@label=Berk_ReadControls_DownAbort
*$B750 POP IX          ; Restore #REGix from the stack.
 $B752 JP $B47E        ; Jump to #R$B47E to resume Berk's controller.
; Mark the collided entity held and fall into the down put-down script.
@label=Berk_ReadControls_DownGrab
*$B755 PUSH IX         ; Stash #REGix on the stack.
 $B757 POP BC          ; {Restore #REGbc and #REGix from the stack.
 $B758 POP IX          ; }
 $B75A LD (IX+$0C),C   ; Store #REGc in the current entity's extra state.
 $B75D LD (IX+$0D),B   ; Store #REGb in the current entity's extra state.
 $B760 SET 3,(IX+$03)  ; Set bit #N$03 of the current entity's flags byte 3.
; Down put-down: continue the active script, or launch #R$BAA5.
@label=Berk_ReadControls_DownScript
*$B764 BIT 2,(IX+$09)  ; {Is bit #N$02 of the current entity's direction / state set? If so,
 $B768 JP NZ,$EC2E     ; jump to #R$EC2E.}
 $B76B LD HL,$BAA5     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BAA5).
 $B76E JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Deep down-interact: call #R$B7F3, then maybe retarget the camera room
; origin.
@label=Berk_ReadControls_DownInteract
*$B771 CALL $B7F3      ; {Call #R$B7F3 to let Berk interact with an entity? If not, jump to
 $B774 JR NZ,$B7A1     ; #R$B7A1.}
 $B776 LD A,C          ; Copy the saved count/flag from #REGc into #REGa.
 $B777 CP $65          ; {Is the current entity's room index equal to #N$65? If not, jump to
 $B779 JR NZ,$B764     ; #R$B764.}
 $B77B PUSH HL         ; Stash #REGhl on the stack.
 $B77C LD HL,$B79C     ; Point #REGhl at Berk movement script data (#R$B79C).
 $B77F LD A,$E0        ; Load #REGa with #N$E0.
; Publish a new camera room-origin and copy follow fields, then resume
; idle.
@label=Berk_ReadControls_DownCameraCopy
*$B781 LD E,A          ; Keep #N$E0 in #REGe for later.
 $B782 ADD A,$1F       ; Add #N$1F to #REGa (step down one screen row in the
                       ; attribute map).
 $B784 LD D,A          ; Keep #N$E0 in #REGd for later.
 $B785 LD ($72FB),DE   ; Store #REGde in the camera room-origin pointer
                       ; (#R$72FB).
 $B789 LD DE,$909F     ; Point #REGde at camera-follow entity fields
                       ; (#R$8EF3(#N$909F)).
 $B78C LD BC,$0005     ; Load #REGbc with #N($0005,$04,$04) as a short copy
                       ; length.
 $B78F LDIR            ; Copy the block at #REGhl to #REGde.
 $B791 POP HL          ; Restore #REGhl from the stack.
 $B792 BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, call
 $B796 CALL NZ,$F0E9   ; #R$F0E9.}
 $B799 JP $B47E        ; Jump to #R$B47E to resume Berk's controller.

; Data: Berk Movement Scripts
;
; Short script fragment referenced while Berk walks, turns and interacts.
@label=Data_BerkMovementScripts
b$B79C DEFB $00,$15,$1B,$E2,$E7 ; Bytes: #N($00), #N($15), #N($1B), #N($E2),
                                ; #N$E7.

; Berk Read Controls: Down Branches
;
; Used by the routine at #R$B440.
; .
; Continue the down-control handler: bit tests, interact calls and
; put-down script launches.
;
; .
;
; Skip ahead to #R$B7B4 when the carry flag is clear.
@label=Berk_ReadControls_DownBranch
c$B7A1 JR NC,$B7B4    ; Jump to #R$B7B4 if the previous compare did not take
                      ; carry.
; This entry point is used by the routine at #R$B440.
; .
; Test direction/state bit #N$01; otherwise continue the active script.
@label=Berk_ReadControls_DownBitTest
*$B7A3 BIT 1,(IX+$09) ; Is bit #N$01 of the current entity's direction / state
                      ; set?.
 $B7A7 JP NZ,$EC2E    ; If not, jump to #R$EC2E.
; Face-left put-down when the bit test passed.
 $B7AA SET 2,(IX+$03) ; Set bit #N$02 of the current entity's flags byte 3.
 $B7AE LD HL,$BA83    ; Point #REGhl at #R$BA83.
 $B7B1 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; This entry point is used by the routine at #R$B440.
; .
; Shared down-branch: test direction bit #N$01 again, else run walk-right
; put-down.
@label=Berk_ReadControls_DownPartT
*$B7B4 BIT 0,(IX+$09) ; Is bit #N$01 of the current entity's direction / state
                      ; set?.
 $B7B8 JP NZ,$EC2E    ; If not, jump to #R$EC2E.
 $B7BB SET 2,(IX+$03) ; Set bit #N$02 of the current entity's flags byte 3.
 $B7BF LD HL,$BA77    ; Point #REGhl at #R$BA77.
 $B7C2 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; This entry point is used by the routine at #R$B440.
; .
; Choose interact vs continue from the referenced entity's y-extent.
@label=Berk_ReadControls_DownPartU
*$B7C5 LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $B7C8 CP $1B         ; Is the y-extent equal to #N$1B?.
 $B7CA JR Z,$B7D1     ; If so, jump to #R$B7D1.
 $B7CC CP $23         ; Is the y-extent less than #N$23?.
 $B7CE JP C,$EC2E     ; If so, jump to #R$EC2E.
; Interact, then either abort or copy the collided entity and run a
; put-down.
@label=Berk_ReadControls_DownPartV
*$B7D1 CALL $B7F3     ; Call #R$B7F3 to let Berk interact with an entity.
 $B7D4 JR C,$B7A3     ; If carry is set, jump to #R$B7A3.
 $B7D6 JR NZ,$B7B4    ; If not zero, jump to #R$B7B4.
 $B7D8 LD BC,($72AA)  ; Load #REGbc with the last-collided entity pointer
                      ; (#R$72AA).
 $B7DC LD ($72AC),BC  ; Store #REGbc in the current-entity pointer (#R$72AC).
 $B7E0 LD HL,$BA1F    ; Point #REGhl at #R$BA1F.
 $B7E3 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; This entry point is used by the routine at #R$B440.
; .
; High y-extent interact path leading to the #R$BB5D put-down.
@label=Berk_ReadControls_DownPartW
*$B7E6 CALL $B7F3     ; Call #R$B7F3 to let Berk interact with an entity.
 $B7E9 JR C,$B7A3     ; If carry is set, jump to #R$B7A3.
 $B7EB JR NZ,$B7B4    ; If not zero, jump to #R$B7B4.
 $B7ED LD HL,$BB5D    ; Point #REGhl at #R$BB5D.
 $B7F0 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Berk Interact With Entity
;
; Used by the routines at #R$B440 and #R$B7A1.
; .
; Test horizontal alignment with the last-collided entity (#R$72AA); on
; match clear bit #N$02 of IX+#N$03.
;
; IX Address of complex state data for an entity
;
; Handles Berk colliding with doors, the trap door and interactive
; scenery.
@label=Berk_Interact_With_Entity
c$B7F3 LD IY,($72AA)  ; Load #REGiy with the last-collided entity pointer
                      ; (#R$72AA).
 $B7F7 LD C,(IY+$00)  ; Load #REGc with the referenced entity's entity type.
 $B7FA LD A,(IY+$08)  ; Load #REGa with the referenced entity's x-extent.
 $B7FD SUB (IY+$07)   ; Subtract the referenced entity's x-coordinate from
                      ; #REGa.
 $B800 SRL A          ; Shift the flag/value in #REGa right one bit.
 $B802 ADD A,(IY+$07) ; Add the referenced entity's x-coordinate to #REGa.
 $B805 SUB $02        ; Subtract #N$02 from #REGa.
 $B807 CP (IX+$07)    ; {Does #REGa match this entity's x-coordinate? If not,
 $B80A RET NZ         ; return.}
 $B80B RES 2,(IX+$03) ; Reset bit #N$02 of the current entity's flags byte 3.
 $B80F RET            ; Return.
; This entry point is used by the routine at #R$B440.
; .
; Handle left: clear facing-left, then walk or turn Berk left.
@label=Berk_WalkLeft
*$B810 RES 1,(IX+$03) ; Clear Berk's facing-left flag (bit #N$01 of #REGix+#N$03) so he
                      ; faces right-to-left motion.
 $B814 LD A,(IX+$04)  ; Fetch Berk's room index.
 $B817 CP $00         ; {Is Berk in room #N$00? If not, continue the left-walk
 $B819 JR NZ,$B823    ; at #R$B823.}
 $B81B LD A,(IX+$06)  ; Fetch Berk's y-extent.
 $B81E CP $1B         ; {Is he still on the trap door row (y-extent #N$1B)? If not, continue
 $B820 JP NZ,$EC2E    ; the current script at #R$EC2E.}
; Left walk outside room #N$00: test an entity on the right before turning
; or interacting.
@label=Berk_WalkLeft_TestEntityOnRight
*$B823 CALL $F32E     ; {Call #R$F32E to test Entity On Right? If not, jump to
 $B826 JR NC,$B835    ; #R$B835.}
; Already facing the walk-left way: continue the script or run face-left
; put-down #R$BA83.
@label=Berk_WalkLeft_FacingScript
*$B828 BIT 1,(IX+$09) ; {Is bit #N$01 of the current entity's direction / state set? If so,
 $B82C JP NZ,$EC2E    ; jump to #R$EC2E.}
 $B82F LD HL,$BA83    ; Point #REGhl at Berk control/put-down script data
                      ; (#R$BA83).
 $B832 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Left interact by height: close the trap door at y-extent #N($40), or
; take trap scripts at #N$39.
@label=Berk_Interact_With_Entity_Branch
*$B835 CP $39         ; {Is the current entity's y-extent equal to #N$39? If so, jump to
 $B837 JR Z,$B8AC     ; #R$B8AC.}
 $B839 CP $40         ; {Is the current entity's y-extent equal to #N$40? If not, jump to
 $B83B JR NZ,$B84A    ; #R$B84A.}
 $B83D BIT 1,(IX+$09) ; {Is bit #N$01 of the current entity's direction / state set? If not,
 $B841 JP Z,$B47E     ; jump to #R$B47E.}
 $B844 CALL $EDDB     ; Call #R$EDDB to close the trap door.
 $B847 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Below mid-room on left: either keep walking/turning or attempt a
; pick-up.
@label=Berk_WalkLeft_BelowBand
*$B84A CP $32         ; {Is the current entity's y-extent less than #N$32? If not, jump to
 $B84C JP NC,$B47E    ; #R$B47E.}
 $B84F BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B853 JR NZ,$B828    ; #R$B828.}
 $B855 LD BC,($72AA)  ; Load #REGbc with the last-collided entity pointer
                      ; (#R$72AA).
 $B859 INC BC         ; Advance the counter/pointer in #REGbc by one.
 $B85A LD A,(BC)      ; Fetch a byte through the pointer in #REGbc.
 $B85B AND %00010000  ; Keep only bit #N$04 of the flag byte in #REGa (mask
                      ; #N$10).
 $B85D JR NZ,$B828    ; If the result was non-zero, jump to #R$B828.
 $B85F BIT 3,(IX+$03) ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B863 JR NZ,$B86C    ; #R$B86C.}
 $B865 BIT 1,(IX+$09) ; {Is bit #N$01 of the current entity's direction / state set? If so,
 $B869 JP NZ,$EC2E    ; jump to #R$EC2E.}
; Try #R$B87C to pick up; on success lock held-state and run script
; #R$BB01.
@label=Berk_WalkLeft_TryPickUp
*$B86C CALL $B87C     ; {Call #R$B87C to let Berk pick up an entity? If not,
 $B86F JP NC,$B47E    ; jump to #R$B47E.}
 $B872 SET 3,(IX+$03) ; Set bit #N$03 of the current entity's flags byte 3.
 $B876 LD HL,$BB01    ; Point #REGhl at Berk control/put-down script data
                      ; (#R$BB01).
 $B879 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Berk Pick Up Entity
;
; Used by the routine at #R$B7F3.
; .
; Berk Pick Up Entity for the player character using complex state at
; #R$8EE9.
;
; IX Address of complex state data for an entity
@label=Berk_Pick_Up_Entity
c$B87C LD BC,($72AA)   ; Load #REGbc with the last-collided entity pointer
                       ; (#R$72AA).
 $B880 INC BC          ; Advance the counter/pointer in #REGbc by one.
 $B881 LD A,(BC)       ; Fetch a byte through the pointer in #REGbc.
 $B882 AND %00001000   ; Keep only bit #N$03 of the flag byte in #REGa (mask
                       ; #N$08).
 $B884 JR NZ,$B888     ; If the result was non-zero, jump to #R$B888.
 $B886 XOR A           ; Clear #REGa as a false / no-match result.
 $B887 RET             ; Return.
; Pick-up from the last collision: reject if X is too far left, else test
; on-left.
@label=Berk_Pick_Up_Entity_FromCollision
*$B888 PUSH IX         ; Stash #REGix on the stack.
 $B88A LD IX,($72AA)   ; Load #REGix with the last-collided entity pointer
                       ; (#R$72AA).
 $B88E LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $B891 CP $49          ; {Is the current entity's x-coordinate less than #N$49? If not, jump
 $B893 JR NC,$B898     ; to #R$B898.}
 $B895 XOR A           ; Clear #REGa as a no-entity-found result.
 $B896 JR $B8A1        ; Jump to #R$B8A1 to restore #REGix and return with no
                       ; pick-up.
; Confirm the collidee sits on Berk's left before marking the pick-up.
@label=Berk_Pick_Up_Entity_TestOnLeft
*$B898 CALL $F32A      ; {Call #R$F32A to test Entity On Left? If not, jump to
 $B89B JR NC,$B8A4     ; #R$B8A4.}
; Mark the picked-up entity's direction/state as held (#N$82).
@label=Berk_Pick_Up_Entity_MarkDirection
*$B89D LD (IX+$09),$82 ; Write #N$82 to the current entity's direction / state.
; Exit the pick-up attempt, restoring Berk's entity pointer in #REGix.
@label=Berk_Pick_Up_Entity_RestoreReturn
*$B8A1 POP IX          ; Restore #REGix from the stack.
 $B8A3 RET             ; Return.
; Retry pick-up via #R$B87C after the on-left test failed.
@label=Berk_Pick_Up_Entity_RetryCollision
*$B8A4 CALL $B87C      ; {Call #R$B87C to let Berk pick up an entity? If so,
 $B8A7 JR C,$B89D      ; jump to #R$B89D.}
 $B8A9 POP IX          ; Restore #REGix from the stack.
 $B8AB RET             ; Return.
; This entry point is used by the routine at #R$B7F3.
; .
; Trap door height on left: choose open vs closed trap scripts from bit
; #N$01 of #R$72B3.
@label=Berk_Pick_Up_Entity_TrapDoorScripts
*$B8AC BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B8B0 JP NZ,$B47E     ; #R$B47E.}
 $B8B3 LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $B8B6 BIT 1,(HL)      ; {Is "trap door is open / trap door event armed" (bit #N$01 of
 $B8B8 JR NZ,$B8C0     ; #R$72B3) set? If so, jump to #R$B8C0.}
 $B8BA LD HL,$BB33     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$BB33)).
 $B8BD JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Trap already open: run the open-trap interaction script
; (#R$BB41).
@label=Berk_Pick_Up_Entity_TrapOpenScript
*$B8C0 LD HL,$BB41     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BB41).
 $B8C3 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; This entry point is used by the routine at #R$B440.
; .
; Handle right: clear facing-left, then walk or turn Berk right.
@label=Berk_WalkRight
*$B8C6 RES 1,(IX+$03)  ; Clear Berk's facing-left flag (bit #N$01 of
                       ; #REGix+#N$03).
 $B8CA LD A,(IX+$04)   ; Fetch Berk's room index.
 $B8CD CP $00          ; {Is Berk in room #N$00? If not, continue the
 $B8CF JR NZ,$B8D9     ; right-walk at #R$B8D9.}
 $B8D1 LD A,(IX+$06)   ; Fetch Berk's y-extent.
 $B8D4 CP $1B          ; {Is he still on the trap door row (y-extent #N$1B)? If not, continue
 $B8D6 JP NZ,$EC2E     ; the current script at #R$EC2E.}
; Right walk outside room #N$00: test an entity below before turning or
; interacting.
@label=Berk_WalkRight_TestBelow
*$B8D9 CALL $F391      ; {Call #R$F391 to test Entity Below? If not, jump to
 $B8DC JR NC,$B8EB     ; #R$B8EB.}
; Already facing the walk-right way: continue the script or run face-right
; put-down #R$BA77.
@label=Berk_WalkRight_FaceCheck
*$B8DE BIT 0,(IX+$09)  ; {Is bit #N$00 of the current entity's direction / state set? If so,
 $B8E2 JP NZ,$EC2E     ; jump to #R$EC2E.}
 $B8E5 LD HL,$BA77     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BA77).
 $B8E8 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Right walk by y-extent: high rows put down, mid rows idle, else try a
; put-down.
@label=Berk_WalkRight_ByYExtent
*$B8EB CP $41          ; {Is the current entity's y-extent equal to #N$41? If so, jump to
 $B8ED JP Z,$B980      ; #R$B980.}
 $B8F0 CP $38          ; {Is the current entity's y-extent equal to #N$38? If so, jump to
 $B8F2 JR Z,$B96C      ; #R$B96C.}
 $B8F4 CP $3B          ; {Is the current entity's y-extent equal to #N$3B? If so, jump to
 $B8F6 JP Z,$B990      ; #R$B990.}
 $B8F9 CP $32          ; {Is the current entity's y-extent less than #N$32? If not, jump to
 $B8FB JP NC,$B47E     ; #R$B47E.}
 $B8FE BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B902 JP NZ,$B8DE     ; #R$B8DE.}
 $B905 LD BC,($72AA)   ; Load #REGbc with the last-collided entity pointer
                       ; (#R$72AA).
 $B909 INC BC          ; Advance the counter/pointer in #REGbc by one.
 $B90A LD A,(BC)       ; Fetch a byte through the pointer in #REGbc.
 $B90B AND %00010000   ; Keep only bit #N$04 of the flag byte in #REGa (mask
                       ; #N$10).
 $B90D JR NZ,$B8DE     ; If the result was non-zero, jump to #R$B8DE.
 $B90F BIT 3,(IX+$03)  ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B913 JR NZ,$B91C     ; #R$B91C.}
 $B915 BIT 0,(IX+$09)  ; {Is bit #N$00 of the current entity's direction / state set? If so,
 $B919 JP NZ,$EC2E     ; jump to #R$EC2E.}
; Try #R$B92C to put down; on success lock held-state and run script
; #R$BAF1.
@label=Berk_WalkRight_TryPutDown
*$B91C CALL $B92C      ; {Call #R$B92C to let Berk put down an entity? If not, jump to
 $B91F JP NC,$B47E     ; #R$B47E.}
 $B922 SET 3,(IX+$03)  ; Set bit #N$03 of the current entity's flags byte 3.
 $B926 LD HL,$BAF1     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BAF1).
 $B929 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

; Berk Put Down Entity
;
; Used by the routine at #R$B87C.
; .
; Berk Put Down Entity for the player character using complex state at
; #R$8EE9.
;
; IX Address of complex state data for an entity
@label=Berk_Put_Down_Entity
c$B92C LD BC,($72AA)   ; Load #REGbc with the last-collided entity pointer
                       ; (#R$72AA).
 $B930 INC BC          ; Advance the counter/pointer in #REGbc by one.
 $B931 LD A,(BC)       ; Fetch a byte through the pointer in #REGbc.
 $B932 AND %00001000   ; Keep only bit #N$03 of the flag byte in #REGa (mask
                       ; #N$08).
 $B934 JR NZ,$B938     ; If the result was non-zero, jump to #R$B938.
 $B936 XOR A           ; Clear #REGa as a false / no-match result.
 $B937 RET             ; Return.
; Put-down from the last collision: room-transition special case or
; above-entity test.
@label=Berk_Put_Down_Entity_FromCollision
*$B938 PUSH IX         ; Stash #REGix on the stack.
 $B93A LD IX,($72AA)   ; Load #REGix with the last-collided entity pointer
                       ; (#R$72AA).
 $B93E LD A,(IX+$08)   ; Load #REGa with the current entity's x-extent.
 $B941 CP $B4          ; {Is the current entity's x-extent less than #N$B4? If not, jump to
 $B943 JR NC,$B962     ; #R$B962.}
 $B945 CALL $F38D      ; {Call #R$F38D to test Entity Above? If so, jump to
 $B948 JR C,$B965      ; #R$B965.}
 $B94A CP $41          ; {Is the current entity's x-extent equal to #N$41? If not, jump to
 $B94C JR NZ,$B95D     ; #R$B95D.}
 $B94E LD (IX+$04),$03 ; Write #N$03 to the current entity's room index.
 $B952 SET 4,(IX+$02)  ; Set bit #N$04 of the current entity's flags byte 2.
 $B956 LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $B959 SET 6,(HL)      ; Set "special put-down / room-transition event" (bit #N$06 of
                       ; #R$72B3).
 $B95B JR $B965        ; Jump to #R$B965 to finish putting the entity down.
; Retry put-down via #R$B92C after the first collision path did not
; finish.
@label=Berk_Put_Down_Entity_CollisionRetry
*$B95D CALL $B92C      ; {Call #R$B92C to let Berk put down an entity? If so,
 $B960 JR C,$B965      ; jump to #R$B965.}
; Exit the put-down attempt, restoring Berk's entity pointer in #REGix.
@label=Berk_Put_Down_Entity_RestoreReturn
*$B962 POP IX          ; Restore #REGix from the stack.
 $B964 RET             ; Return.
; Mark the put-down entity's direction/state as released (#N$81).
@label=Berk_Put_Down_Entity_SetDirection
*$B965 LD (IX+$09),$81 ; Write #N$81 to the current entity's direction / state.
 $B969 POP IX          ; Restore #REGix from the stack.
 $B96B RET             ; Return.
; This entry point is used by the routine at #R$B87C.
; .
; Y-extent #N$38 put-down: run script #R$BB11 when no timed event
; is pending.
@label=Berk_Put_Down_Entity_AtYExtent38
*$B96C BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B970 JP NZ,$B47E     ; #R$B47E.}
 $B973 LD A,($72CE)    ; Load #REGa with the timed event latch (#R$72CE).
 $B976 OR A            ; {Is timed event latch zero? If not, jump to #R$B47E.
 $B977 JP NZ,$B47E     ; }
 $B97A LD HL,$BB11     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$BB11).
 $B97D JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; This entry point is used by the routine at #R$B87C.
; .
; Y-extent #N$41 put-down: run script #R$B9A5(#N$BB7B).
@label=Berk_Put_Down_Entity_AtYExtent41
*$B980 LD HL,$BB7B     ; Point #REGhl at Berk control/put-down script data
                       ; (#R$B9A5(#N$BB7B)).
 $B983 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; This entry point is used by the routine at #R$B440.
; .
; Low-band abort: refill attribute rows and republish Berk's script
; cursor.
@label=Berk_Put_Down_Entity_PublishScriptPos
*$B986 CALL $EA73      ; Call #R$EA73 to fill Attribute Rows.
 $B989 LD HL,($72B1)   ; Load #REGhl with Berk's script position pointer
                       ; (#R$72B1).
 $B98C LD ($72CF),HL   ; Store #REGhl in the active script cursor (#R$72CF).
 $B98F RET             ; Return.
; This entry point is used by the routine at #R$B87C.
; .
; Trap door y-extent put-down: run #R$BB21 unless carrying or trap flags
; block it.
@label=Berk_Put_Down_Entity_TrapDoor
*$B990 BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $B994 JP NZ,$B47E     ; #R$B47E.}
 $B997 LD A,($72BA)    ; Load #REGa with the trap door flags (#R$72BA).
 $B99A BIT 3,A         ; {Is bit #N$03 of trap door flags set? If so, jump to
 $B99C JP NZ,$B47E     ; #R$B47E.}
 $B99F LD HL,$BB21     ; Point #REGhl at a Berk put-down script (#R$BB21).
 $B9A2 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

