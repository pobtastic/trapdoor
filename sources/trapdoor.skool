; Table: Task Progress Message Pointers
;
; Four entries for tasks #N$01–#N$04 used by #R$E25E. Each entry is a flag
; address followed by a message address: worms (#R$E010), eggs (#R$E08E),
; slimies (#R$E12D), bottle (#R$E1E6).
@label=Table_TaskProgressMessagePointers
w$E24E DEFW $72B8    ; Flag pointer / message pointer for task #N$01.
 $E250 DEFW $E010
 $E252 DEFW $72B5    ; Flag pointer / message pointer for task #N$01.
 $E254 DEFW $E08E
 $E256 DEFW $72B6    ; Flag pointer / message pointer for task #N$01.
 $E258 DEFW $E12D
 $E25A DEFW $72B9    ; Flag pointer / message pointer for task #N$01.
 $E25C DEFW $E1E6

; Select Task Progress Message
;
; Used by the routine at #R$ADA1.
; .
; Choose which mid-task progress message to show from the current task
; index (#R$72AE), then continue on to #R$E286 to print it. Task #N$05
; branches to #R$DFDD ("NOT TIDY YET") or #R$DFF3 ("HERE ARE YOUR WAGES") from
; bit #N$07 of #R$72B4; tasks #N$01–#N$04 index the pointer pairs at
; #R$E24E (flag byte + message address).
;
; .
;
; Handle the wages / not-tidy task specially.
@label=Select_TaskProgressMessage
c$E25E LD A,($72AE)  ; {Fetch the current task index (#R$72AE). Is it task #N$05? If not,
 $E261 CP $05        ; use the pointer table at #R$E270.
 $E263 JR NZ,$E270   ; }
 $E265 LD A,($72B4)  ; {Fetch the task status flags (#R$72B4). Has the wages bit (bit #N$07)
 $E268 BIT 7,A       ; been set? If not, jump to #R$DFDD to print "NOT TIDY YET". Otherwise jump to
 $E26A JP Z,$DFDD    ; #R$DFF3 to print "HERE ARE YOUR WAGES".
 $E26D JP $DFF3      ; }
; Index #R$E24E by (task−#N$01)×#N($04), load the mask into #R$72EB and
; the message pointer into #REGhl, then continue on to #R$E286.
@label=Select_TaskProgressMessage_FromTable
*$E270 DEC A         ; {Turn (task−#N$01) into a #N($0004,$04,$04)-byte index, point #REGhl
 $E271 ADD A,A       ; at #R$E24E, and keep the table offset in #REGbc.
 $E272 ADD A,A       ;
 $E273 LD B,$00      ;
 $E275 LD C,A        ;
 $E276 LD HL,$E24E   ;
 $E279 ADD HL,BC     ; }
 $E27A LD C,(HL)     ; {Fetch the flag-pointer word and advance onto the message address,
 $E27B INC HL        ; then store the live flag/mask byte as the message colour/mask (#R$72EB).
 $E27C LD B,(HL)     ;
 $E27D INC HL        ;
 $E27E LD A,(BC)     ;
 $E27F LD ($72EB),A  ; }
 $E282 LD E,(HL)     ; {Fetch the message address into #REGhl.
 $E283 INC HL        ;
 $E284 LD D,(HL)     ;
 $E285 EX DE,HL      ; }
; Continue on to #R$E286.

; Print Encoded Message
;
; Used by the routines at #R$DDA3, #R$DE19, #R$DE57, #R$DFB5, #R$DFDD and
; #R$DFF3.
; .
; Print one #CHR$5B…#CHR$5D encoded message at #REGhl. First runs a short
; border/sound flash, then filters control bytes into the display buffer at
; #R$63A0 and jumps to #R$E300 to paint it. Control bytes before #CHR$60 gate
; fragments by #R$72C5 / #R$72EB; #CHR$2B starts a new row; #CHR$24 marks an
; alternate fragment.
;
; HL Address of an encoded message (starts at #CHR$5B)
;
; Flash / click #N$0A times before decoding.
@label=Print_EncodedMessage
c$E286 PUSH HL       ; Stash #REGhl on the stack.
 $E287 LD B,$0A      ; Load #REGb with #N$0A flash iterations.
; Flash the border and click sound #N$0A for each of #N$0A iterations
; before decoding.
@label=Print_EncodedMessage_FlashLoop
*$E289 PUSH BC       ; Stash #REGbc on the stack.
 $E28A LD A,$10      ; {Pick a pseudo-random flash/sound parameter via #R$EAE5 and store it
 $E28C CALL $EAE5    ; at #R$F90F(#N$F958).
 $E28F ADD A,$14     ;
 $E291 LD ($F958),A  ; }
; #HTML(#AUDIO0(message-flash.wav)(#INCLUDE(MessageFlash)))
 $E294 LD A,$0A      ; {Play sound effect #N$0A via #R$F8F9 / #R$F9AF.
 $E296 CALL $F8F9    ;
 $E299 CALL $F9AF    ; }
 $E29C POP BC        ; Restore #REGbc from the stack.
 $E29D DJNZ $E289    ; Loop until the flash sequence is done.
 $E29F POP HL        ; Restore #REGhl from the stack.
; Decode the selected fragment into the buffer at #R$63A0.
 $E2A0 LD IX,$63A0   ; Point #REGix at the display buffer (#R$63A0).
 $E2A4 XOR A         ; {Clear #REGa, then clear the task progress repeat count
 $E2A5 LD ($72F1),A  ; (#R$72F1).}
; Resume after a skipped fragment by stepping onto the next encoded block.
@label=Print_EncodedMessage_NextFrag
*$E2A8 INC HL        ; Advance past the previous message fragment.
; Scan the encoded stream for #CHR$60 text-start, trigger, indirect, or
; mask controls.
@label=Print_EncodedMessage_Scan
*$E2A9 INC HL        ; Advance the message pointer by one.
 $E2AA LD A,(HL)     ; Fetch the next control/text byte.
 $E2AB CP $60        ; {Is it the text-start marker (#CHR$60)? If not, try the other
 $E2AD JR NZ,$E2B2   ; controls at #R$E2B2.}
 $E2AF INC HL        ; Advance past #CHR$60.
 $E2B0 JR $E2DB      ; Jump to #R$E2DB to copy literal text into the buffer.
; Gate this fragment on the message trigger in #R$72C5 matching #CHR$21's
; key.
@label=Print_EncodedMessage_CheckTrigger
*$E2B2 CP $21        ; {Is it a trigger gate (#CHR$21)? If not, try the indirect-load
 $E2B4 JR NZ,$E2C2   ; control at #R$E2C2.}
 $E2B6 INC HL        ; Advance onto the trigger key.
 $E2B7 LD A,($72C5)  ; {Fetch the message trigger (#R$72C5). Does it match this fragment's
 $E2BA CP (HL)       ; key? If not, keep scanning at #R$E2A9.
 $E2BB JR NZ,$E2A9   ; }
 $E2BD CALL $E2F9    ; {Call #R$E2F9 to skip to the next #CHR$5B, then continue with the
 $E2C0 JR $E2A8      ; next fragment at #R$E2A8.}
; Indirect-load one byte into #R$72F1 from the address that follows
; #CHR$29.
@label=Print_EncodedMessage_CheckIndirect
*$E2C2 CP $29        ; {Is it an indirect-load control (#CHR$29)? If not, treat it as a mask
 $E2C4 JR NZ,$E2D0   ; byte at #R$E2D0.}
 $E2C6 INC HL        ; {Fetch the address word, read that byte into #R$72F1, and continue
 $E2C7 LD C,(HL)     ; scanning at #R$E2A9.
 $E2C8 INC HL        ;
 $E2C9 LD B,(HL)     ;
 $E2CA LD A,(BC)     ;
 $E2CB LD ($72F1),A  ;
 $E2CE JR $E2A9      ; }
; Keep the fragment only when its mask ANDs non-zero with the colour mask
; in #R$72EB.
@label=Print_EncodedMessage_CheckMask
*$E2D0 LD A,($72EB)  ; {Fetch the message colour/mask (#R$72EB). AND with this fragment's
 $E2D3 AND (HL)      ; mask byte. If nothing matches, skip to #R$E2A9.
 $E2D4 JR Z,$E2A9    ; }
 $E2D6 CALL $E2F9    ; {Call #R$E2F9 to skip to the next #CHR$5B, then continue with the
 $E2D9 JR $E2A8      ; next fragment at #R$E2A8.}
; Copy literal characters into #R$63A0 until #CHR$5D (or a #CHR$24
; alternate).
@label=Print_EncodedMessage_CopyText
*$E2DB LD A,(HL)     ; {Fetch the next text byte. Store it in the display buffer through
 $E2DC LD (IX+$00),A ; #REGix. Advance the buffer pointer. Advance the message pointer. Is it an
 $E2DF INC IX        ; alternate-fragment marker (#CHR$24)? If so, handle it at #R$E2EC.
 $E2E1 INC HL        ;
 $E2E2 CP $24        ;
 $E2E4 JR Z,$E2EC    ; }
 $E2E6 CP $5D        ; {Is it the message terminator (#CHR$5D)? If so, jump to #R$E300 to
 $E2E8 JR Z,$E300    ; paint the buffer. Otherwise keep copying at #R$E2DB.
 $E2EA JR $E2DB      ; }
; Take the #CHR$24 alternate key and search for the matching #CHR$5B
; fragment.
@label=Print_EncodedMessage_SkipAlternate
*$E2EC LD A,(HL)     ; {Fetch the alternate key byte, then keep it in #REGc.
 $E2ED LD C,A        ; }
; Walk successive #CHR$5B markers until the alternate key matches, then
; resume at #R$E2A9.
@label=Print_EncodedMessage_SkipAlternateLoop
*$E2EE CALL $E2F9    ; {Call #R$E2F9 to find the next #CHR$5B. Step onto the key after that
 $E2F1 INC HL        ; marker. Fetch it. Does it match the alternate key? If not, keep searching at
 $E2F2 LD A,(HL)     ; #R$E2EE.
 $E2F3 CP C          ;
 $E2F4 JR NZ,$E2EE   ; }
 $E2F6 JP $E2A9      ; Jump to #R$E2A9 to resume scanning after the chosen
                     ; alternate.

; Skip To Message Marker
;
; Used by the routines at #R$DE57 and #R$E286.
; .
; Advance #REGhl to the next #CHR$5B message marker (used while skipping
; encoded fragments).
;
; HL Message pointer to advance
@label=Skip_ToMessageMarker
c$E2F9 LD A,(HL)     ; {Fetch the next byte. Is it a message marker (#CHR$5B)? If so, return
 $E2FA CP $5B        ; with #REGhl on that marker.
 $E2FC RET Z         ; }
 $E2FD INC HL        ; Advance the pointer.
 $E2FE JR $E2F9      ; Jump to #R$E2F9 to keep scanning.

; Paint Message Buffer
;
; Used by the routine at #R$E286.
; .
; Paint the decoded buffer at #R$63A0 with the double-height font at
; #R$E42A, pulsing the attribute through #N$96 frames.
;
; .
;
; Point the character set at the message font and paint the buffer until
; the flash counter hits #N$96.
@label=Paint_MessageBuffer
c$E300 XOR A         ; {Clear #REGa, then clear the message-frame counter
 $E301 LD ($DDA2),A  ; (#R$DD94(#N$DDA2)).}
 $E304 LD HL,$E42B   ; {Point #REGhl at the message font + #N$01 (#R$E42A + #N$01), then
 $E307 LD ($72F9),HL ; store it as the current character set.}
; Repaint the decoded buffer at #R$63A0 from attribute row
; #N$58C0 (attribute buffer).
@label=Paint_MessageBuffer_Frame
*$E30A LD HL,$58C0   ; Point #REGhl at the message attribute row
                     ; (#N$58C0 (attribute buffer)).
 $E30D LD IX,$63A0   ; Point #REGix at the decoded message buffer (#R$63A0).
 $E311 LD A,($DDA2)  ; {Fetch the message-frame counter (#R$DD94(#N$DDA2)). Has it reached
 $E314 CP $96        ; #N$96 frames? If not, continue the pulse at #R$E31C.
 $E316 JR NZ,$E31C   ; }
 $E318 CALL $EA3C    ; Call #R$EA3C to clear both display buffers.
 $E31B RET           ; Return.
; Pulse the text attribute from the frame counter at #R$DD94(#N$DDA2)
; after dividing by #N($08), never leaving it at zero.
@label=Paint_MessageBuffer_PulseAttr
*$E31C INC A         ; {Advance the frame counter and store it back at
 $E31D LD ($DDA2),A  ; #R$DD94(#N$DDA2).}
 $E320 SRL A         ; {Divide #REGa by #N$08 to slow the attribute pulse.
 $E322 SRL A         ;
 $E324 SRL A         ; }
 $E326 OR A          ; {Is the pulsed value zero? If not, jump to #R$E32A.
 $E327 JR NZ,$E32A   ; }
 $E329 INC A         ; Force a minimum pulse of #N$01.
; Clamp the pulsed attribute to white (#N$07) when it reaches #N$08 or
; above.
@label=Paint_MessageBuffer_ClampAttr
*$E32A CP $08        ; {Is the pulsed attribute < #N$08? If so, keep it at #R$E330.
 $E32C JR C,$E330    ; Otherwise clamp it to white (#N$07).
 $E32E LD A,$07      ; }
; Store the pulsed ink in #R$7307 and its #N$07−value inverse shift in
; #R$DD94(#N$DDA0).
@label=Paint_MessageBuffer_StoreAttr
*$E330 LD C,A        ; Keep the attribute in #REGc.
 $E331 LD ($7307),A  ; Store it as the current text attribute (#R$7307).
 $E334 LD A,$07      ; Compute #N$07−attribute.
 $E336 SUB C         ; Subtract the centred column from #N$07 to get the left
                     ; pad.
 $E337 LD ($DDA0),A  ; Store that inverse shift at #R$DD94(#N$DDA0) (used while
                     ; plotting).
; Centre and draw one message row via #R$E34A, then step three attribute
; rows for the next.
@label=Paint_MessageBuffer_RowLoop
*$E33A CALL $E34A    ; Call #R$E34A to centre and draw one message row.
 $E33D LD A,($DDA1)  ; {Fetch the row-terminator byte saved by #R$E34A (#R$DD94(#N$DDA1)).
 $E340 CP $5D        ; Was it the message end (#CHR$5D)? If so, restart a new frame at #R$E30A.
 $E342 JR Z,$E30A    ; }
 $E344 LD BC,$0060   ; Step #REGhl down by #N($0060,$04,$04) attribute bytes
                     ; (three rows).
 $E347 ADD HL,BC     ; Advance #REGhl by one message row (#N($0060,$04,$04) attribute
                     ; bytes).
 $E348 JR $E33A      ; Draw the next message row at #R$E33A.

; Centre And Draw Message Row
;
; Used by the routine at #R$E300.
; .
; Count characters in the current message row (until #CHR$24, #CHR$2B or
; #CHR$5D), centre that run within #N$20 columns, then draw it via #R$E376.
;
; HL Attribute-file address for the row
; IX Pointer into the decoded message buffer
;
; Count characters until a row or message end, then centre and draw the
; run.
@label=Centre_AndDrawMessageRow
c$E34A PUSH HL       ; {Stash #REGhl and #REGix on the stack.
 $E34B PUSH IX       ; }
 $E34D LD C,$FF      ; Start the character count at #N$FF (pre-increment).
; Count characters until #CHR$24, #CHR$2B or #CHR$5D to measure the
; current message row.
@label=Centre_AndDrawMessageRow_Count
*$E34F INC C         ; Advance the character count.
 $E350 LD A,(IX+$00) ; Fetch the next buffer byte through #REGix.
 $E353 CP $24        ; {Is it #CHR$24, #CHR$2B or #CHR$5D (row/message end)?, then if
 $E355 JR Z,$E363    ; #CHR$24, stop counting at #R$E363.}
 $E357 CP $2B        ; {Is it a new-row marker (#CHR$2B)? If so, stop counting
 $E359 JR Z,$E363    ; at #R$E363.}
 $E35B CP $5D        ; {Is it the message terminator (#CHR$5D)? If so, stop counting at
 $E35D JR Z,$E363    ; #R$E363.}
 $E35F INC IX        ; Advance #REGix to the next buffer byte.
 $E361 JR $E34F      ; Jump to #R$E34F to keep counting.
; Centre the counted run within #N$20 columns and draw it via #R$E376.
@label=Centre_AndDrawMessageRow_Centre
*$E363 POP IX        ; Restore #REGix from the stack.
 $E365 LD ($DDA1),A  ; Remember the terminator byte in #R$DD94(#N$DDA1).
 $E368 LD A,$20      ; Compute (#N$20−length)/#N$02 as a left-indent.
 $E36A SUB C         ; Subtract the row width from #N$20 to get the left pad.
 $E36B SRL A         ; Halve that pad so the row is centred.
 $E36D LD B,$00      ; Clear #REGb.
 $E36F LD C,A        ; Keep the indent in #REGbc.
 $E370 ADD HL,BC     ; Add it to the row's attribute address.
 $E371 CALL $E376    ; Call #R$E376 to draw the centred row.
 $E374 POP HL        ; Restore #REGhl from the stack.
 $E375 RET           ; Return.

; Draw Message Character
;
; Used by the routine at #R$E34A.
; .
; Draw one double-height message character from the buffer at #REGix into
; the attribute/screen pair at #REGhl, then advance. Maps punctuation to fixed
; glyph indices and ASCII from #CHR$30 onward to even glyph slots (two
; #N($0008,$04,$04)-byte halves per character in #R$E42A).
;
; HL Attribute-file address for this character
; IX Pointer into the decoded message buffer
;
; Stop on row/message terminators; otherwise map the character to a glyph
; index.
@label=Draw_MessageCharacter
c$E376 LD A,(IX+$00) ; {Fetch the next buffer byte through #REGix, then advance the buffer
 $E379 INC IX        ; pointer.}
 $E37B CP $24        ; {Is it #CHR$24? If so, return (end of alternate/row
 $E37D RET Z         ; run).}
 $E37E CP $2B        ; {Is it a new-row marker (#CHR$2B)? If so, return.
 $E380 RET Z         ; }
 $E381 CP $5D        ; {Is it the message terminator (#CHR$5D)? If so, return.
 $E383 RET Z         ; }
 $E384 PUSH HL       ; Stash #REGhl on the stack.
 $E385 CP $2E        ; {Is it a full stop (#CHR$2E)? If so, use glyph index #N$14 at
 $E387 JR Z,$E39F    ; #R$E39F.}
 $E389 CP $2C        ; {Is it a comma (#CHR$2C)? If so, use glyph index #N$16
 $E38B JR Z,$E3A3    ; at #R$E3A3.}
 $E38D CP $21        ; {Is it an exclamation mark (#CHR$21)? If so, use glyph index #N$1A
 $E38F JR Z,$E3A7    ; at #R$E3A7.}
 $E391 CP $27        ; {Is it an apostrophe (#CHR$27)? If so, use glyph index #N$18 at
 $E393 JR Z,$E3AB    ; #R$E3AB.}
 $E395 CP $20        ; {Is it a space (#CHR$20)? If so, keep index #N$20 at
 $E397 JR Z,$E3AD    ; #R$E3AD.}
 $E399 SUB $30       ; Convert ASCII ≥ #CHR$30 into an even glyph index.
 $E39B SLA A         ; Double the glyph index to address the double-height font
                     ; halves.
 $E39D JR $E3AD      ; Jump to #R$E3AD to plot the letter glyph.
; Map a full stop to glyph index #N$14 in the double-height message font.
@label=Draw_MessageCharacter_FullStop
*$E39F LD A,$14      ; Load glyph index #N$14.
 $E3A1 JR $E3AD      ; Jump to #R$E3AD to plot the full-stop glyph.
; Map a comma to glyph index #N$16 in the double-height message font.
@label=Draw_MessageCharacter_Comma
*$E3A3 LD A,$16      ; Load glyph index #N$16.
 $E3A5 JR $E3AD      ; Jump to #R$E3AD to plot the comma glyph.
; Map an exclamation mark to glyph index #N$1A in the double-height
; message font.
@label=Draw_MessageCharacter_Bang
*$E3A7 LD A,$1A      ; Load glyph index #N$1A.
 $E3A9 JR $E3AD      ; Jump to #R$E3AD to plot the exclamation glyph.
; Map an apostrophe to glyph index #N$18 in the double-height message
; font.
@label=Draw_MessageCharacter_Apostrophe
*$E3AB LD A,$18      ; Load glyph index #N$18.
; Plot the top #N$08 rows, step one attribute row down, plot the bottom
; #N$08 rows, then advance.
@label=Draw_MessageCharacter_Plot
*$E3AD LD E,A        ; {Keep the glyph index in #REGe, then clear #REGd.
 $E3AE LD D,$00      ; }
 $E3B0 LD A,$08      ; {Load #REGa with #N($08), then call #R$EAE5 (jitter / roll seed for
 $E3B2 CALL $EAE5    ; #R$DD9F). Store the roll mode at #R$DD9F.
 $E3B5 LD ($DD9F),A  ; }
 $E3B8 CALL $E3C7    ; Call #R$E3C7 to plot the top half of the glyph.
 $E3BB LD BC,$0020   ; Step #REGhl down one attribute row (#N($0020,$04,$04)
                     ; bytes).
 $E3BE ADD HL,BC     ; Step #REGhl down one character row (#N($0020,$04,$04)
                     ; bytes).
 $E3BF INC DE        ; Advance the glyph index onto the bottom half.
 $E3C0 CALL $E3C7    ; Call #R$E3C7 to plot the bottom half.
 $E3C3 POP HL        ; Restore #REGhl from the stack.
 $E3C4 INC HL        ; Advance the attribute address onto the next character
                     ; column.
 $E3C5 JR $E376      ; Jump to #R$E376 to draw the next character.

; Plot Message Glyph Half
;
; Used by the routine at #R$E376.
; .
; Write one #N($0008,$04,$04)-byte half-glyph from the message font into
; the screen bitmap under attribute address #REGhl. Applies the roll/shift
; mode in #R$DD9F and the inverse shift count in #R$DD94(#N$DDA0).
;
; HL Attribute-file address for this character
; DE Glyph half-index (×#N($0008,$04,$04) into #R$72F9)
;
; Paint the attribute and resolve the screen and font addresses.
@label=Plot_MessageGlyphHalf
c$E3C7 PUSH DE       ; {Stash #REGde, #REGhl and #REGbc on the stack.
 $E3C8 PUSH HL       ;
 $E3C9 PUSH BC       ; }
 $E3CA LD A,($7307)  ; Fetch the current text attribute (#R$7307).
 $E3CD OR %01000000  ; Force bright (OR #N$40).
 $E3CF LD (HL),A     ; Write it at #REGhl.
 $E3D0 LD A,H        ; {Multiply the attribute high byte by #N($08).
 $E3D1 ADD A,A       ;
 $E3D2 ADD A,A       ;
 $E3D3 ADD A,A       ; }
 $E3D4 AND %01011011 ; Keep only the screen-bitmap high bits (mask #N$5B).
 $E3D6 LD H,A        ; Write the result back to #REGh.
 $E3D7 PUSH HL       ; Stash #REGhl on the stack.
 $E3D8 EX DE,HL      ; {Swap so #REGhl holds the glyph index, multiply it by #N($08), and
 $E3D9 ADD HL,HL     ; add the character-set base at #R$72F9.
 $E3DA ADD HL,HL     ;
 $E3DB ADD HL,HL     ;
 $E3DC LD DE,($72F9) ;
 $E3E0 ADD HL,DE     ; }
 $E3E1 POP DE        ; Restore #REGde from the stack.
; Nudge the font pointer for roll modes #N$02 / #N$03.
 $E3E2 LD A,($DD9F)  ; {Fetch the roll mode (#R$DD9F). Is it mode #N$02? If not, try mode
 $E3E5 CP $02        ; #N$03 at #R$E3EC.
 $E3E7 JR NZ,$E3EC   ; }
 $E3E9 INC HL        ; Advance the font pointer by one (roll left source).
 $E3EA JR $E3F1      ; Jump to #R$E3F1 to plot.
; For roll mode #N($03), step the font pointer back one before plotting
; the half-glyph.
@label=Plot_MessageGlyphHalf_CheckMode3
*$E3EC CP $03        ; {Is it mode #N$03? If not, plot as-is at #R$E3F1. Otherwise step the
 $E3EE JR NZ,$E3F1   ; font pointer back by one (roll right source).
 $E3F0 DEC HL        ; }
; Plot all #N$08 pixel rows of this half-glyph into the screen bitmap.
@label=Plot_MessageGlyphHalf_Rows
*$E3F1 LD B,$08      ; There are #N$08 pixel rows in a character.
; Build or roll one glyph row using the inverse shift in #R$DD94(#N$DDA0)
; and the mode in #R$DD9F.
@label=Plot_MessageGlyphHalf_RowLoop
*$E3F3 PUSH BC       ; Stash #REGbc on the stack.
 $E3F4 LD A,($DDA0)  ; {Fetch the inverse shift count (#R$DD94(#N$DDA0)). Is it zero (no
 $E3F7 OR A          ; thicken/shift)? If so, take the plain bitmap byte at #R$E3FD.
 $E3F8 JR NZ,$E3FD   ; }
 $E3FA LD A,(HL)     ; Fetch the plain glyph row into #REGa.
 $E3FB JR $E40E      ; Jump to #R$E40E to apply left/right roll.
; Thicken the glyph row by OR-shifting left and right by the count in
; #R$DD94(#N$DDA0).
@label=Plot_MessageGlyphHalf_ShiftBuild
*$E3FD LD B,A        ; Keep the shift count in #REGb.
 $E3FE PUSH HL       ; Stash #REGhl on the stack.
 $E3FF LD A,(HL)     ; {Fetch the glyph row. Copy it into #REGl. Mirror it into #REGh for
 $E400 LD L,A        ; right-shift thickening.
 $E401 LD H,A        ; }
; OR left- and right-shifted copies into the thickened glyph bitmap.
@label=Plot_MessageGlyphHalf_ShiftLoop
*$E402 SLA L         ; Shift left into #REGl and OR.
 $E404 OR L          ; OR in the left-shifted copy.
 $E405 DEC B         ; Decrease the shift count.
 $E406 JR Z,$E40D    ; If done, finish at #R$E40D.
 $E408 SRL H         ; Also shift right into #REGh and OR (thicken both ways).
 $E40A OR H          ; OR in the right-shifted copy.
 $E40B DJNZ $E402    ; Loop at #R$E402.
; Finish the thicken pass and continue into the roll/write path.
@label=Plot_MessageGlyphHalf_ShiftDone
*$E40D POP HL        ; Restore #REGhl from the stack.
; Apply roll mode #N$00 (left) or #N$01 (right) before writing the glyph
; row.
@label=Plot_MessageGlyphHalf_Roll
*$E40E LD C,A        ; Keep the built bitmap in #REGc.
 $E40F LD A,($DD9F)  ; {Fetch the roll mode (#R$DD9F). Is it mode #N$00? If not, try mode
 $E412 OR A          ; #N$01 at #R$E419.
 $E413 JR NZ,$E419   ; }
 $E415 SLA C         ; Shift the bitmap left one (roll mode #N$00).
 $E417 JR $E41F      ; Jump to #R$E41F to store.
; Roll the glyph bitmap one bit right for mode #N$01.
@label=Plot_MessageGlyphHalf_RollRight
*$E419 CP $01        ; {Is it mode #N$01? If not, store as-is at #R$E41F. Shift the bitmap
 $E41B JR NZ,$E41F   ; right one.
 $E41D SRL C         ; }
; Write the finished glyph row to the screen and advance to the next pixel
; row.
@label=Plot_MessageGlyphHalf_WriteRow
*$E41F LD A,C        ; Write the bitmap row to the screen.
 $E420 LD (DE),A     ; Write the thickened glyph row to the screen.
 $E421 INC D         ; Move one pixel-row down.
 $E422 INC HL        ; Advance the font pointer.
 $E423 POP BC        ; Restore #REGbc from the stack.
 $E424 DJNZ $E3F3    ; Loop until all #N$08 rows are plotted.
 $E426 POP BC        ; {Restore #REGbc, #REGhl and #REGde from the stack.
 $E427 POP HL        ;
 $E428 POP DE        ; }
 $E429 RET           ; Return.

; Font: Message Characters
;
; Double-height message font used by #R$E300 and #R$E376. Each glyph is
; #N($0010,$04,$04) bytes: an #N($0008,$04,$04)-byte top half then an
; #N($0008,$04,$04)-byte bottom half, matching the plot order at #R$E3B8 and
; #R$E3C0. #N($002B,$04,$04) glyphs run from #R$E42A through #N$E6D9; #R$E6DA is
; a pad #N$00 before #R$E6DB. #R$E399 maps ASCII codes from #CHR$30 upward to
; glyph slot (ASCII code minus #N$30); #R$E39F through #R$E3AB override full
; stop, comma, apostrophe and exclamation mark onto half-indices #N($14),
; #N($16), #N$18 and #N$1A (slots #N$0A through #N$0D), and space
; (#CHR$20) keeps half-index #N$20 (slot #N$10).
