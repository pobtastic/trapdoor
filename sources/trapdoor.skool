                            ; pointer #R$9742.
 $BBAB DEFW $001F           ; Script opcode #N$1F (berk interact with door
                            ; behind).
 $BBAD DEFB $42,$97         ; Graphic-layout pointer #R$9742.
 $BBAF DEFB $42,$97         ; Graphic-layout pointer #R$9742.
 $BBB1 DEFB $42,$97         ; Graphic-layout pointer #R$9742.
 $BBB3 DEFW $001E           ; Script opcode #N$1E (berk interact with door
                            ; ahead).
 $BBB5 DEFB $42,$97         ; Graphic-layout pointer #R$9742.
 $BBB7 DEFW $0020           ; Script opcode #N$20 (berk open door ahead).
; Release fragment at the end of the put-down sequence.
@label=BerkPutDownScript_Release
 $BBB9 DEFW $0001           ; Script opcode #N$01 (load script address).
 $BBBB DEFB $AD,$B9,$10,$00 ; Graphic-layout pointer #R$B9AD; Script opcode #N$10 (have
                            ; entity face left after putting down).
; Tail of the release put-down fragment.
@label=BerkPutDownScript_ReleaseTail
 $BBBF DEFW $0018           ; Script opcode #N$18 (start loop).
; Continuation of the release put-down fragment.
@label=BerkPutDownScript_ReleaseCont
 $BBC1 DEFB $3B,$96         ; Graphic-layout pointer #R$963B.
 $BBC3 DEFB $26,$92         ; Graphic-layout pointer #R$9226.
 $BBC5 DEFB $3B,$96         ; Graphic-layout pointer #R$963B.
 $BBC7 DEFB $70,$94         ; Graphic-layout pointer #R$9470.
 $BBC9 DEFB $78,$98         ; Graphic-layout pointer #R$9878.
 $BBCB DEFB $26,$92         ; Graphic-layout pointer #R$9226.
 $BBCD DEFB $C1,$9B         ; Graphic-layout pointer #R$9BC1.
 $BBCF DEFB $70,$94         ; Graphic-layout pointer #R$9470.
 $BBD1 DEFB $06,$9C         ; Graphic-layout pointer #R$9C06.
 $BBD3 DEFB $26,$92         ; Graphic-layout pointer #R$9226.
 $BBD5 DEFB $C1,$9B         ; Graphic-layout pointer #R$9BC1.
 $BBD7 DEFB $26,$92         ; Graphic-layout pointer #R$9226.
 $BBD9 DEFB $06,$9C         ; Graphic-layout pointer #R$9C06.
 $BBDB DEFW $0001           ; Script opcode #N$01 (load script address).
 $BBDD DEFW $B9AD           ; Script address #R$B9AD.
 $BBDF DEFB $00             ; Move-delay flag for the Thing Upstairs entity.
 $BBE0 DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBE2 DEFW $0031           ; Script opcode #N$31 (Thing Upstairs chase step).
 $BBE4 DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBE6 DEFW $0031           ; Script opcode #N$31 (Thing Upstairs chase step).
 $BBE8 DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBEA DEFW $0031           ; Script opcode #N$31 (Thing Upstairs chase step).
 $BBEC DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBEE DEFW $0031           ; Script opcode #N$31 (Thing Upstairs chase step).
 $BBF0 DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBF2 DEFW $0032           ; Script opcode #N$32 (Thing Upstairs chase
                            ; variant).
 $BBF4 DEFW $BDC3           ; Graphic-layout pointer #R$BDC3.
 $BBF6 DEFW $0034           ; Script opcode #N$34 (Thing Upstairs chase
                            ; variant).
 $BBF8 DEFW $0001           ; Script opcode #N$01 (load script address).
 $BBFA DEFW $BBF4           ; Script address #R$BBF4.
 $BBFC DEFW $BDD0           ; Graphic-layout pointer #R$BDD0.
 $BBFE DEFW $BDD0           ; Graphic-layout pointer #R$BDD0.

; Data: Thing Upstairs Script Tail
;
; Continuation of the Thing Upstairs script that starts at
; #R$BBE0. #R$BCA9 points #REGhl at #R$BC0E and enters
; #R$EC30; #R$BDBA arms the same script via #R$72D9.
@label=Data_ThingUpstairsScriptTail
b$BC00 DEFW $BDC3    ; Graphic-layout pointer #R$BDC3.
 $BC02 DEFW $0035    ; Script opcode #N$35 (fill attribute rows).
 $BC04 DEFW $BDC3    ; Graphic-layout pointer #R$BDC3.
 $BC06 DEFW $BDC3    ; Graphic-layout pointer #R$BDC3.
 $BC08 DEFW $BDC3    ; Graphic-layout pointer #R$BDC3.
 $BC0A DEFW $0001    ; Script opcode #N$01 (load script address).
 $BC0C DEFW $BBF4    ; Script address #R$BBF4.
 $BC0E DEFW $BDC3    ; Graphic-layout pointer #R$BDC3.
 $BC10 DEFW $0033    ; Script opcode #N$33 (clear attribute file / reset slot).

; Update Thing Upstairs Entity
;
; Used by the routine at #R$AAB3.
; .
; Drive complex entity slot #N$20 when its type is #N$22: copy its script
; cursor through #R$72CF, run the next instruction, then save the cursor back.
@label=Update_ThingUpstairs_Entity
c$BC12 LD A,($72A9)  ; {Return if Learner Berk mode is set.
 $BC15 OR A          ;
 $BC16 RET NZ        ; }
 $BC17 LD A,($9001)  ; {Jump to #R$BDA0 unless complex entity slot #N$20's type (#R$9001) is
 $BC1A CP $22        ; #N$22.
 $BC1C JP NZ,$BDA0   ; }
 $BC1F LD HL,($72D9) ; {Copy #R$72D9 back to the active script cursor.
 $BC22 LD ($72CF),HL ; }
 $BC25 CALL $BC2F    ; Call #R$BC2F to update Thing Upstairs Entity State.
 $BC28 LD HL,($72CF) ; {Copy the active script cursor to #R$72D9.
 $BC2B LD ($72D9),HL ; }
 $BC2E RET           ; Return.

; Update Thing Upstairs Entity State
;
; Used by the routine at #R$BC12.
; .
; Point #REGix at complex entity slot #N$20 (#R$9001) and run its next
; script instruction.
@label=Update_ThingUpstairs_Entity_State
c$BC2F LD IX,$9001   ; Point #REGix at complex entity slot #N$20 (#R$9001).
 $BC33 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$31) Thing Upstairs action
;
; Raise the Thing Upstairs entity two characters as part of its room
; sequence.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_ThingUpstairsRaise
c$BC36 DEC (IX+$05)  ; Decrease the entity's y-coordinate.
 $BC39 DEC (IX+$05)  ; Decrease the entity's y-coordinate again.
 $BC3C DEC (IX+$06)  ; Decrease the entity's y-extent.
 $BC3F DEC (IX+$06)  ; Decrease the entity's y-extent again.
 $BC42 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$32) Thing Upstairs action
;
; Clear the upstairs event latch once the Thing Upstairs room sequence has
; finished.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_ThingUpstairsResetRoom
c$BC45 LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $BC48 RES 4,A         ; Clear bit #N$04 of the flag byte in #REGa.
 $BC4A LD ($72B3),A    ; Set the game event flags (#R$72B3).
 $BC4D LD (IX+$04),$05 ; Write #N$05 to the current entity's room index.
 $BC51 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$35) Thing Upstairs action
;
; Repaint the Thing Upstairs scene's attribute rows before the script
; continues.
@label=ScriptRoutine_ThingUpstairsFillAttributes
c$BC54 CALL $EA73    ; Call #R$EA73 to fill Attribute Rows.
 $BC57 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Data: Thing Upstairs Entity Template
;
; Ten-byte entity template copied over complex entity slot #N$20 by
; #R$BC73 when the Thing Upstairs script clears the slot.
@label=Data_ThingUpstairsEntityTemplate
b$BC5A DEFB $00,$00,$00,$00,$03,$26,$29,$6E
 $BC62 DEFB $70,$00

; Script Routine: (#N$33) Thing Upstairs action
;
; Blank the attribute file for the Thing Upstairs scene and reset slot
; #N$20.
@label=ScriptRoutine_ThingUpstairsClearScreen
c$BC64 LD A,$36      ; Load #REGa with #N$36.
 $BC66 CALL $EA52    ; Call #R$EA52 to clear the attribute file.
 $BC69 LD HL,$BDC3   ; Point #REGhl at #R$BDC3.
 $BC6C LD ($BBF4),HL ; Store #REGhl in Thing Upstairs storage at #R$BBF4.
 $BC6F XOR A         ; Clear complex entity slot #N$20's type (empty the slot).
 $BC70 LD ($9001),A  ; Store #REGa in complex entity slot #N$20's type
                     ; (#R$9001).
 $BC73 LD HL,$BC5A   ; Point #REGhl at #R$BC5A.
 $BC76 PUSH DE       ; Stash #REGde on the stack.
 $BC77 LD DE,$9001   ; Point #REGde at complex entity slot #N$20 (#R$9001).
 $BC7A LD BC,$000A   ; Load #REGbc with #N($000A,$04,$04) as a short table
                     ; length.
 $BC7D LDIR          ; Copy the block pointed to by #REGhl into the destination
                     ; at #REGde.
 $BC7F POP DE        ; Restore #REGde from the stack.
 $BC80 RET           ; Return.

; Script Routine: (#N$34) Thing Upstairs action
;
; Chase Berk with the Thing Upstairs entity when the two overlap;
; otherwise keep the script moving.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_ThingUpstairsChase
c$BC81 CALL $BD72     ; Call #R$BD72 to test whether the Thing Upstairs entity overlaps Berk
                      ; / the camera-follow entity.
 $BC84 OR A           ; {Is #REGa zero? If not, jump to #R$BCB5.
 $BC85 JR NZ,$BCB5    ; }
 $BC87 LD IY,$909B    ; Point #REGiy at the camera-follow entity (#R$909B).
 $BC8B SET 0,(IY+$03) ; Set bit #N$00 of the referenced entity's flags byte 3.
 $BC8F BIT 4,(IY+$03) ; {Is bit #N$04 of flags byte 3 (#REGiy+#N$03) set? If not, jump to
 $BC93 JR Z,$BCAF     ; #R$BCAF.}
 $BC95 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $BC99 BIT 7,(IY+$02) ; {Is bit #N$07 of the referenced entity's flags byte 2 set? If not,
 $BC9D JR Z,$BCAF     ; jump to #R$BCAF.}
 $BC9F XOR A          ; Clear the referenced entity type (deactivate the slot).
 $BCA0 LD (IY+$00),A  ; Set the referenced entity's entity type.
 $BCA3 LD HL,$BA35    ; Point #REGhl at Berk script data #R$BA35.
 $BCA6 LD ($72B1),HL  ; Store #REGhl in Berk's script position pointer
                      ; (#R$72B1).
 $BCA9 LD HL,$BC0E    ; Point #REGhl at the Thing Upstairs script tail
                      ; (#R$BC0E).
 $BCAC JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; No chase overlap: run the Thing Upstairs storage/idle script at
; #R$BBFC.
@label=ScriptRoutine_ThingUpstairsChase_RunStorage
*$BCAF LD HL,$BBFC    ; Point #REGhl at Thing Upstairs storage at #R$BBFC.
 $BCB2 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Chase tick: random skip, honour move-delay #R$BBDF, else
; retarget via #R$BD3C.
@label=ScriptRoutine_ThingUpstairsChase_MoveTick
*$BCB5 LD A,$0A       ; Load #REGa with #N$0A.
 $BCB7 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $BCBA CP $03         ; {Is #N$0A less than #N$03? If so, jump to #R$EC2E.
 $BCBC JP C,$EC2E     ; }
 $BCBF LD A,($BBDF)   ; Load #REGa from #R$BBDF.
 $BCC2 OR A           ; {Is #REGa zero? If not, jump to #R$BCCA.
 $BCC3 JR NZ,$BCCA    ; }
 $BCC5 CALL $BD3C     ; Call #R$BD3C to update Thing Upstairs Movement.
 $BCC8 JR $BCCE       ; Jump to #R$BCCE to continue this routine.
; Count down the Thing Upstairs move-delay byte at #R$BBDF.
@label=ScriptRoutine_ThingUpstairsChase_DecMoveDelay
*$BCCA DEC A          ; Step #N$0A back by one.
 $BCCB LD ($BBDF),A   ; Set Thing Upstairs flag byte #R$BBDF.
; Apply direction bits: step right, left, down or up, then continue the
; script.
@label=ScriptRoutine_ThingUpstairsChase_ApplyDirection
*$BCCE LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $BCD1 BIT 0,A        ; {Is bit #N$00 of the current entity's direction / state set? If so,
 $BCD3 CALL NZ,$BCE8  ; call #R$BCE8.}
 $BCD6 BIT 1,A        ; {Is bit #N$01 of the current entity's direction / state set? If so,
 $BCD8 CALL NZ,$BCFD  ; call #R$BCFD.}
 $BCDB BIT 2,A        ; {Is bit #N$02 of the current entity's direction / state set? If so,
 $BCDD CALL NZ,$BD27  ; call #R$BD27.}
 $BCE0 BIT 3,A        ; {Is bit #N$03 of the current entity's direction / state set? If so,
 $BCE2 CALL NZ,$BD12  ; call #R$BD12.}
 $BCE5 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Try moving the Thing Upstairs entity right, or retarget when X-extent
; hits the right bound.
@label=ScriptRoutine_ThingUpstairsChase_TryMoveRight
*$BCE8 PUSH AF        ; Stash #REGaf on the stack.
 $BCE9 LD A,(IX+$08)  ; Load #REGa with the current entity's x-extent.
 $BCEC CP $FC         ; {Is the current entity's x-extent less than #N$FC? If so, jump to
 $BCEE JR C,$BCF5     ; #R$BCF5.}
 $BCF0 CALL $BD3C     ; Call #R$BD3C to update Thing Upstairs Movement.
 $BCF3 JR $BCFB       ; Jump to #R$BCFB to continue this routine.
; Nudge the Thing Upstairs entity one character right (X and X-extent).
@label=ScriptRoutine_ThingUpstairsChase_IncX
*$BCF5 INC (IX+$07)   ; Increment the entity's x-coordinate.
; Advance the Thing Upstairs entity's X-extent as part of the right-step.
@label=ScriptRoutine_ThingUpstairsChase_IncXExtent
 $BCF8 INC (IX+$08)   ; Increment the entity's x-extent.
; Restore flags and return from the right-step attempt.
@label=ScriptRoutine_ThingUpstairsChase_RestoreReturnRight
*$BCFB POP AF         ; Restore #REGaf from the stack.
 $BCFC RET            ; Return.
; Try moving the Thing Upstairs entity left, or retarget when X hits the
; left bound.
@label=ScriptRoutine_ThingUpstairsChase_TryMoveLeft
*$BCFD PUSH AF        ; Stash #REGaf on the stack.
 $BCFE LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $BD01 CP $22         ; {Is the current entity's x-coordinate less than #N$22? If not, jump
 $BD03 JR NC,$BD0A    ; to #R$BD0A.}
 $BD05 CALL $BD3C     ; Call #R$BD3C to update Thing Upstairs Movement.
 $BD08 JR $BD10       ; Jump to #R$BD10 to continue this routine.
; Nudge the Thing Upstairs entity one character left.
@label=ScriptRoutine_ThingUpstairsChase_DecX
*$BD0A DEC (IX+$07)   ; {Move this entity one character left.
 $BD0D DEC (IX+$08)   ; }
; Restore flags and return from the left-step attempt.
@label=ScriptRoutine_ThingUpstairsChase_RestoreReturnLeft
*$BD10 POP AF         ; Restore #REGaf from the stack.
 $BD11 RET            ; Return.
; Try moving the Thing Upstairs entity up, or retarget when Y hits the top
; bound.
@label=ScriptRoutine_ThingUpstairsChase_TryMoveUp
*$BD12 PUSH AF        ; Stash #REGaf on the stack.
 $BD13 LD A,(IX+$05)  ; Load #REGa with the current entity's y-coordinate.
 $BD16 CP $14         ; {Is the current entity's y-coordinate less than #N$14? If not, jump
 $BD18 JR NC,$BD1F    ; to #R$BD1F.}
 $BD1A CALL $BD3C     ; Call #R$BD3C to update Thing Upstairs Movement.
 $BD1D JR $BD25       ; Jump to #R$BD25 to continue this routine.
; Nudge the Thing Upstairs entity one character up.
@label=ScriptRoutine_ThingUpstairsChase_DecY
*$BD1F DEC (IX+$05)   ; {Move this entity one character up.
 $BD22 DEC (IX+$06)   ; }
; Restore flags and return from the up-step attempt.
@label=ScriptRoutine_ThingUpstairsChase_RestoreReturnUp
*$BD25 POP AF         ; Restore #REGaf from the stack.
 $BD26 RET            ; Return.
; Try moving the Thing Upstairs entity down, or retarget when Y-extent
; hits the bottom bound.
@label=ScriptRoutine_ThingUpstairsChase_TryMoveDown
*$BD27 PUSH AF        ; Stash #REGaf on the stack.
 $BD28 LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $BD2B CP $24         ; {Is the current entity's y-extent less than #N$24? If so, jump to
 $BD2D JR C,$BD34     ; #R$BD34.}
 $BD2F CALL $BD3C     ; Call #R$BD3C to update Thing Upstairs Movement.
 $BD32 JR $BD3A       ; Jump to #R$BD3A to continue this routine.
; Nudge the Thing Upstairs entity one character down.
@label=ScriptRoutine_ThingUpstairsChase_IncY
*$BD34 INC (IX+$05)   ; {Move this entity one character down.
 $BD37 INC (IX+$06)   ; }
; Restore flags and return from the down-step attempt.
@label=ScriptRoutine_ThingUpstairsChase_RestoreReturnDown
*$BD3A POP AF         ; Restore #REGaf from the stack.
 $BD3B RET            ; Return.

; Update Thing Upstairs Movement
;
; Used by the routine at #R$BC81.
; .
; Move the Thing Upstairs entity toward Berk within its room bounds and
; queue a chase sound when it closes in.
;
; IX Address of complex state data for an entity
@label=Update_ThingUpstairs_Movement
c$BD3C LD A,$0A      ; Load #REGa with #N$0A.
 $BD3E CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $BD41 ADD A,$05     ; Add #N$05 to #REGa (adjust an entity/timer value).
 $BD43 LD ($BBDF),A  ; Set Thing Upstairs flag byte (#R$BBDF).
 $BD46 LD A,$02      ; Load #REGa with #N$02.
 $BD48 CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $BD4B INC A         ; Advance #N$02 by one.
 $BD4C ADD A,A       ; {Multiply #REGa by #N$04 to form a table index.
 $BD4D ADD A,A       ; }
 $BD4E LD C,A        ; Keep #N$02 in #REGc for later.
 $BD4F LD A,$04      ; Load #REGa with #N$04.
 $BD51 CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $BD54 INC A         ; Advance #N$04 by one.
 $BD55 CP $03        ; {Is #N$04 less than #N$03? If not, jump to #R$BD5D.
 $BD57 JR NC,$BD5D   ; }
 $BD59 OR C          ; Merge another flag byte into #N$04.
 $BD5A LD A,C        ; Copy the saved count/flag from #REGc into #REGa.
 $BD5B JR $BD6E      ; Jump to #R$BD6E to store the Thing Upstairs direction.
; Steer toward Berk on X: face right if aligned, else face left.
@label=Update_ThingUpstairs_Movement_TrackBerkX
*$BD5D LD A,($7303)  ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $BD60 LD B,A        ; Keep Berk's X-coordinate copy in #REGb for later.
 $BD61 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $BD64 CP B          ; {Does this entity's x equal #REGb? If not, jump to
 $BD65 JR NC,$BD6B   ; #R$BD6B.}
 $BD67 SET 0,C       ; Set bit #N$00 of the saved flags in #REGc.
 $BD69 JR $BD6D      ; Jump to #R$BD6D to keep the Thing Upstairs direction
                     ; flags.
; Face left when the Thing Upstairs entity's X does not match Berk's copy
; at #R$7303.
@label=Update_ThingUpstairs_Movement_FaceRight
*$BD6B SET 1,C       ; Set bit #N$01 of the saved flags in #REGc.
; Commit the chosen chase direction flags into #REGa.
@label=Update_ThingUpstairs_Movement_WriteDirection
*$BD6D LD A,C        ; Copy the saved count/flag from #REGc into #REGa.
; Store the chase direction/state back onto the Thing Upstairs entity.
@label=Update_ThingUpstairs_Movement_StoreState
*$BD6E LD (IX+$09),A ; Set the current entity's direction / state.
 $BD71 RET           ; Return.

; Test Thing Upstairs Overlap
;
; Used by the routine at #R$BC81.
; .
; Return #N$01 in #REGa when the Thing Upstairs entity overlaps Berk on X
; (#R$7303 / #R$7304) and the camera-follow entity (#R$909B) on Y while
; Berk's room copy is #N$00. Otherwise return #N$00.
;
; IX Address of the Thing Upstairs entity's complex state data
;
; Horizontal overlap against Berk's X / X-extent copies.
@label=Test_ThingUpstairs_Overlap
c$BD72 LD A,($7304)  ; Load Berk's X-extent copy (#R$7304) into #REGa.
 $BD75 DEC A         ; Step that right edge back by one.
 $BD76 CP (IX+$07)   ; {Is Berk's right edge left of the Thing Upstairs entity's left edge
 $BD79 RET C         ; (#REGix+#N$07)? If so, no overlap, so return.}
 $BD7A LD A,($7303)  ; Load Berk's X-coordinate copy (#R$7303) into #REGa.
 $BD7D CP (IX+$08)   ; {Is Berk's left edge at or beyond the Thing Upstairs entity's right
 $BD80 RET NC        ; edge (#REGix+#N$08)? If so, no overlap, so return.}
; Vertical overlap against the camera-follow entity.
 $BD81 LD A,(IX+$06) ; Load the Thing Upstairs entity's y-extent (bottom edge)
                     ; into #REGa.
 $BD84 LD IY,$909B   ; Point #REGiy at the camera-follow entity (#R$909B).
 $BD88 LD C,(IY+$06) ; Load the camera-follow entity's y-extent into #REGc.
 $BD8B CP (IY+$05)   ; {Is the Thing Upstairs entity's bottom above the camera-follow
 $BD8E RET C         ; entity's top (#REGiy+#N$05)? If so, no overlap, so return.
                     ; }
 $BD8F LD A,(IX+$05) ; Load the Thing Upstairs entity's y-coordinate (top edge)
                     ; into #REGa.
 $BD92 INC A         ; {Advance that top edge by two.
 $BD93 INC A         ; }
 $BD94 CP C          ; {Is that raised top at or below the camera-follow entity's bottom in
 $BD95 RET NC        ; #REGc? If so, no overlap, so return.}
; Accept only when Berk's room copy is #N$00.
 $BD96 LD A,($7305)  ; Load Berk's room-index copy (#R$7305) into #REGa.
 $BD99 OR A          ; {Is Berk in room #N$00? If not, jump to #R$BD9E.
 $BD9A JR NZ,$BD9E   ; }
 $BD9C INC A         ; Set #REGa to #N$01 as a successful overlap result.
 $BD9D RET           ; Return.
; No Thing Upstairs overlap (wrong room or miss): return #N$00 in #REGa.
@label=Test_ThingUpstairs_Overlap_NoMatch
*$BD9E XOR A         ; Clear #REGa as a false / no-match result.
 $BD9F RET           ; Return.
; This entry point is used by the routine at #R$BC12.
; .
; Entry from #R$BC12 when slot #N$20 is not Thing Upstairs: maybe arm the
; Thing Upstairs script/sound.
@label=Update_ThingUpstairs_Entity_ArmSpawn
*$BDA0 LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $BDA3 BIT 1,A       ; {Is "trap door is open / trap door event armed" (bit #N$01 of
 $BDA5 RET Z         ; #R$72B3) set? If not, return.}
 $BDA6 LD A,$3C      ; Load #REGa with random maximum #N$3C.
 $BDA8 CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $BDAB OR A          ; {Is that random value zero? If not, return.
 $BDAC RET NZ        ; }
; #HTML(#AUDIO0(game-event.wav)(#INCLUDE(GameEvent)))
 $BDAD LD A,$88      ; Load #REGa with #N$88.
 $BDAF CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $BDB2 LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $BDB5 SET 4,(HL)    ; Set "task-two / upstairs event latch" (bit #N$04 of
                     ; #R$72B3).
 $BDB7 LD HL,$BBE0   ; Point #REGhl at the Thing Upstairs script (#R$BBE0).
 $BDBA LD ($72D9),HL ; Store #REGhl in #R$72D9.
 $BDBD LD A,$22      ; Load #REGa with #N$22.
 $BDBF LD ($9001),A  ; Store #REGa in complex entity slot #N$20's type
                     ; (#R$9001).
 $BDC2 RET           ; Return.

; Graphic Layout: Ghost
;
; Ghost. Complex entity slot #N$20 at #R$9001 uses this layout when
; armed. Scripts at #R$BBE0 load #R$BDC3. #R$BBFC loads the BOO layout
; at #R$BDD0. The entry sets graphic set #N$04 then cycles #R$BDE8 and
; #R$BE03.
;
; .
;
