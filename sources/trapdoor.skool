; Graphic Layout Routine: (#N$EE) Start Loop
;
; Begin a counted graphic-layout loop using the operand at #REGix.
@label=GraphicLayoutRoutine_StartLoop
c$E7F9 LD A,(IX+$00) ; Fetch the loop-count parameter from the layout byte at
                     ; #REGix.
 $E7FC LD ($7302),A  ; Store it as the graphic-layout loop counter (#R$7302).
 $E7FF INC IX        ; Advance #REGix past the graphic-layout operand byte.
 $E801 LD ($72FF),IX ; Store #REGix in #R$72FF as the graphic-layout loop
                     ; restart address.
 $E805 JP $E73F      ; Jump to #R$E73F to process graphic layout data.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9BA5 }
; LIST#

; Graphic Layout Routine: (#N$EF) End Loop
;
; Close the current graphic-layout loop and resume after it.
@label=GraphicLayoutRoutine_EndLoop
c$E808 LD A,($7302)  ; Load #REGa with the graphic-layout loop counter
                     ; (#R$7302).
 $E80B DEC A         ; Decrease #REGa by one.
 $E80C LD ($7302),A  ; Set the graphic-layout loop counter (#R$7302).
 $E80F JP Z,$E73F    ; Jump to #R$E73F to process graphic layout data if the comparison
                     ; matched.
 $E812 LD IX,($72FF) ; Load #REGix with the graphic-layout loop-start pointer
                     ; (#R$72FF).
 $E816 JP $E73F      ; Jump to #R$E73F to process graphic layout data.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9BB6 }
; LIST#

; Graphic Layout: Random Address Jump
;
; Choose one of the following graphic-layout addresses at random and
; continue drawing from it.
@label=GraphicLayoutRoutine_JumpRandomFromList
c$E819 LD A,(IX+$00) ; Fetch the random-maximum parameter from the layout byte
                     ; at #REGix.
 $E81C INC IX        ; Advance #REGix past the graphic-layout operand byte.
 $E81E CALL $EAE5    ; {Call #R$EAE5 to pick a pseudo-random value and keep it
 $E821 LD C,A        ; in #REGc.}
 $E822 ADD A,A       ; Double #REGa, then with the next add form a ×#N$03
                     ; index.
 $E823 ADD A,C       ; #REGa+=#REGc.
 $E824 LD C,A        ; Keep #REGa in #REGc for the next calculation.
 $E825 LD B,$00      ; Load #REGb with #N$00.
 $E827 ADD IX,BC     ; #REGix+=#REGbc.
 $E829 JP $E73F      ; Jump to #R$E73F to process graphic layout data.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9B8F }
; LIST#

; Graphic Layout Routine: (#N$F0) Set New Pending Sound
;
; Queue a new pending sound from the layout operand for later playback.
@label=GraphicLayoutRoutine_SetPendingSound
c$E82C LD A,(IX+$00) ; Fetch the sound-index parameter from the layout byte at
                     ; #REGix.
 $E82F CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $E832 JP $E73D      ; Jump to #R$E73D to advance Graphic Layout Pointer By
                     ; One.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9A6A }
; LIST#

; Graphic Layout Routine: (#N$F2) Set Current Attribute
;
; Set the current drawing attribute from the layout operand.
