 $FBAE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FBB6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FBBE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FBC6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FBCE DEFB $00,$00,$00,$00,$00,$00,$00,$00
