; Advance #REGhl To Next Script Instruction And Execute
;
; Used by the routines at #R$AFDC, #R$B440, #R$B7A1, #R$B7F3, #R$B87C, #R$BC2F,
; #R$BC36, #R$BC45, #R$BC54, #R$BC81, #R$BEE6, #R$BF77, #R$BF8F, #R$BFBF,
; #R$BFEA, #R$C000, #R$C027, #R$C3B2, #R$C3D7, #R$C3DF, #R$C443, #R$C582,
; #R$C5F6, #R$C602, #R$CAC4, #R$CAFE, #R$CB1E, #R$CB44, #R$CBC3, #R$CBCE,
; #R$CC53, #R$CC78, #R$CC8B, #R$D012, #R$D06C, #R$D153, #R$D1CC, #R$D1F5,
; #R$D1FE, #R$D48E, #R$D59E, #R$D5ED, #R$D5F4, #R$D601, #R$D61D, #R$D639,
; #R$D65B, #R$EC61, #R$EC72, #R$ECDB, #R$EDCF, #R$EDD5, #R$EF12, #R$EF32,
; #R$EF54, #R$EF5B, #R$EF62, #R$EF69, #R$EF70, #R$EF77, #R$EF8C, #R$EFB1,
; #R$F014, #R$F069, #R$F0C7, #R$F0CE, #R$F0D5, #R$F0DC, #R$F0E3, #R$F13E,
; #R$F166, #R$F173, #R$F1A1, #R$F1B7, #R$F1DF and #R$F24F.
; .
; Advance the script pointer by two bytes and execute the instruction at
; #REGhl. A zero high byte means a script opcode (dispatched via #R$EB8C);
; otherwise the word is a graphic layout address stored into the entity at
; #REGix.
;
;   IX Address of complex state data for an entity
; O:HL Current position in script data
@label=AdvanceScriptInstruction
c$EC2E INC HL        ; {Advance #REGhl to the next script instruction.
 $EC2F INC HL        ; }
; This entry point is used by the routines at #R$B440, #R$B7A1, #R$B7F3,
; #R$B87C, #R$B92C, #R$BC81, #R$BEE6, #R$BF8F, #R$BFBF, #R$BFEA, #R$C000,
; #R$C3DF, #R$C443, #R$CAFE, #R$CB44, #R$D012, #R$D040, #R$D074, #R$D1FE,
; #R$D48E, #R$D56A, #R$D59E, #R$D601, #R$D61D, #R$D639, #R$D65B, #R$EC53,
; #R$EC61, #R$ECDB, #R$EF82, #R$F014 and #R$F069.
; .
; If the high byte of the word at #REGhl is non-zero, store that word as
; the entity's graphic layout pointer and return. Otherwise jump to #R$EC43 to
; dispatch a script opcode.
@label=ScriptInstruction
*$EC30 INC HL        ; Advance #REGhl to the next script byte.
 $EC31 LD A,(HL)     ; Load #REGa from *#REGhl.
 $EC32 DEC HL        ; Step #REGhl back one byte in the current data stream.
 $EC33 OR A          ; {Is #REGa zero? If so, jump to #R$EC43 to dispatch the
 $EC34 JR Z,$EC43    ; script opcode.}
 $EC36 LD ($72CF),HL ; Store #REGhl in the active script cursor (#R$72CF).
 $EC39 LD A,(HL)     ; Load #REGa from *#REGhl.
 $EC3A LD (IX+$0A),A ; Set the current entity's graphic layout address (low).
 $EC3D INC HL        ; Advance #REGhl to the next script byte.
 $EC3E LD A,(HL)     ; Load #REGa from *#REGhl.
 $EC3F LD (IX+$0B),A ; Set the current entity's graphic layout address (high).
 $EC42 RET           ; Return.
; Dispatch the script opcode in the low byte at #REGhl via #R$EB8C.
@label=ExecuteScript
*$EC43 LD A,(HL)     ; Load #REGa from *#REGhl.
 $EC44 PUSH HL       ; Stash #REGhl on the stack.
 $EC45 LD HL,$EB8C   ; Point #REGhl at the script handler table (#R$EB8C).
 $EC48 ADD A,A       ; Double #REGa to form a word index into the
                     ; script/handler table.
 $EC49 LD C,A        ; Keep the index in #REGc.
 $EC4A LD B,$00      ; Load #REGb with #N$00.
 $EC4C ADD HL,BC     ; #REGhl+=#REGbc.
 $EC4D LD C,(HL)     ; {Fetch the word at #REGhl into #REGbc.
 $EC4E INC HL        ;
 $EC4F LD B,(HL)     ; }
 $EC50 POP HL        ; Restore #REGhl from the stack.
 $EC51 PUSH BC       ; Stash #REGbc on the stack.
 $EC52 RET           ; Return.
; View the equivalent code in;
; #LIST
; { #R$EC2E: #FLUNKY$9CCE }
; { #R$EC30: #FLUNKY$9CD0 }
; { #R$EC43: #FLUNKY$9CE3 }
; LIST#

; Script Routine: (#N$21) Start script loop with count
;
; Start a counted script loop for the current entity.
@label=ScriptRoutine_StartScriptLoop
c$EC53 INC HL        ; {Advance #REGhl past the current script instruction.
 $EC54 INC HL        ; }
 $EC55 LD A,(HL)     ; Fetch the next script byte.
 $EC56 LD ($7301),A  ; Set the script loop counter (#R$7301).
 $EC59 INC HL        ; {Advance #REGhl past the loop-count operand onto the
 $EC5A INC HL        ; loop body.}
 $EC5B LD ($72FD),HL ; Store #REGhl in the script loop restart pointer
                     ; (#R$72FD).
 $EC5E JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$22) End script loop
;
; End the current script loop and resume after it.
@label=ScriptRoutine_EndScriptLoop
c$EC61 LD A,($7301)  ; Load #REGa with the script loop counter (#R$7301).
 $EC64 DEC A         ; Decrease #REGa by one.
 $EC65 LD ($7301),A  ; Set the script loop counter (#R$7301).
 $EC68 OR A          ; {Is #REGa zero? If so, jump to #R$EC2E to run the next script
 $EC69 JP Z,$EC2E    ; instruction.}
 $EC6C LD HL,($72FD) ; Load #REGhl with the script loop restart pointer
                     ; (#R$72FD).
 $EC6F JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$1E) Have Berk interact with a door in front of him
;
; Let Berk interact with the door directly in front of him.
@label=ScriptRoutine_BerkDoorInFront
c$EC72 LD BC,($72AC) ; Load #REGbc with the current-entity pointer (#R$72AC).
 $EC76 LD A,(BC)     ; Load #REGa from the byte at #REGbc.
 $EC77 CP $05        ; {Is #REGa equal to #N$05? If so, jump to #R$EC92.
 $EC79 JR Z,$EC92    ; }
 $EC7B CP $08        ; {Is #REGa equal to #N$08? If so, jump to #R$EC9C.
 $EC7D JR Z,$EC9C    ; }
 $EC7F CP $10        ; {Is #REGa equal to #N$10? If so, jump to #R$ECA6.
 $EC81 JR Z,$ECA6    ; }
 $EC83 CP $03        ; {Is #REGa equal to #N$03? If not, jump to #R$EC2E.
 $EC85 JP NZ,$EC2E   ; }
 $EC88 LD BC,$9D2D   ; Point #REGbc at basket rim layout #R$9D2D.
; This entry point is used by the routine at #R$ECB0.
; .
; Install basket rim layout #R$9D2D into slot #R$8EF3(#N$9051) (type
; #N$03 basket ahead).
@label=Script_DoorInteract_Scan
*$EC8B LD ($9051),BC ; Store #REGbc in #R$8EF3(#N$9051).
 $EC8F JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Select yellow cup rim layout #R$9D7E for the type-#N$05 entity ahead.
@label=Script_DoorAhead_Hit
*$EC92 LD BC,$9D7E   ; Point #REGbc at yellow cup rim layout #R$9D7E.
; This entry point is used by the routine at #R$ECB0.
; .
; Install the chosen yellow cup layout into slot #R$8EF3(#N$9043).
@label=Script_DoorInteract_StoreDoorSlot
*$EC95 LD ($9043),BC ; Store #REGbc in #R$8EF3(#N$9043).
 $EC99 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Select yellow cup rim layout #R$9D7E for the type-#N$08 entity ahead.
@label=Script_DoorAhead_YellowCupRim
*$EC9C LD BC,$9D7E   ; Point #REGbc at yellow cup rim layout #R$9D7E.
; This entry point is used by the routine at #R$ECB0.
; .
; Install the chosen layout into slot #R$8EF3(#N$9035).
@label=Script_DoorInteract_Found
*$EC9F LD ($9035),BC ; Store #REGbc in #R$8EF3(#N$9035).
 $ECA3 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Select layout #R$A14E for the type-#N$10 seed box ahead.
@label=Script_DoorAhead_TaskProp
*$ECA6 LD BC,$A14E   ; Load #REGbc with #R$A14E.
; This entry point is used by the routine at #R$ECB0.
; .
; Install the chosen seed-box layout into slot #R$8EF3(#N$9027).
@label=Script_DoorInteract_StoreAltDoorSlot
*$ECA9 LD ($9027),BC ; Store #REGbc in #R$8EF3(#N$9027).
 $ECAD JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$20) Have Berk open a door in front of him
;
; Let Berk open the door directly in front of him.
@label=ScriptRoutine_BerkOpenDoorInFront
c$ECB0 LD IY,($72AC)   ; Load #REGiy with the current-entity pointer (#R$72AC).
 $ECB4 LD (IY+$02),$02 ; Write #N$02 to the referenced entity's flags byte 2.
 $ECB8 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $ECBB CP $05          ; {Is #REGa equal to #N$05? If so, jump to #R$ECCC.
 $ECBD JR Z,$ECCC      ; }
 $ECBF CP $03          ; {Is #REGa equal to #N$03? If so, jump to #R$ECD1.
 $ECC1 JR Z,$ECD1      ; }
 $ECC3 CP $10          ; {Is #REGa equal to #N$10? If so, jump to #R$ECD6.
 $ECC5 JR Z,$ECD6      ; }
 $ECC7 LD BC,$9DA2     ; Point #REGbc at entity-type-#N$08 layout #R$9DA2.
 $ECCA JR $EC9F        ; Jump to #R$EC9F to script Door Interact Found.
; Open the type-#N$05 yellow cup using layout #R$9D69, then store via
; #R$EC95.
@label=Script_OpenDoor_Hit
*$ECCC LD BC,$9D69     ; Point #REGbc at yellow cup layout #R$9D69.
 $ECCF JR $EC95        ; Jump to #R$EC95 to script Door Interact Next.
; Open the type-#N$03 basket using layout #R$9D0F, then store via
; #R$EC8B.
@label=Script_OpenDoor_Basket
*$ECD1 LD BC,$9D0F     ; Point #REGbc at basket layout #R$9D0F.
 $ECD4 JR $EC8B        ; Jump to #R$EC8B to continue scanning.
; Open the type-#N$10 prop using layout #R$A13F, then store via #R$ECA9.
@label=Script_OpenDoor_TaskProp
*$ECD6 LD BC,$A13F     ; Point #REGbc at task-prop layout #R$A13F.
 $ECD9 JR $ECA9        ; Jump to #R$ECA9 to finish this handler.

; Script Routine: (#N$1F) Have Berk interact with a door behind him
;
; Let Berk interact with the door directly behind him.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_BerkDoorBehind
c$ECDB LD IY,($72AC)   ; Load #REGiy with the current-entity pointer (#R$72AC).
 $ECDF LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $ECE2 CP $05          ; {Is #REGa equal to #N$05? If so, jump to #R$ECFC.
 $ECE4 JR Z,$ECFC      ; }
 $ECE6 CP $08          ; {Is #REGa equal to #N$08? If so, jump to #R$ED05.
 $ECE8 JR Z,$ED05      ; }
 $ECEA CP $10          ; {Is #REGa equal to #N$10? If so, jump to #R$ED0E.
 $ECEC JR Z,$ED0E      ; }
 $ECEE CP $03          ; {Is #REGa equal to #N$03? If not, jump to #R$EC2E.
 $ECF0 JP NZ,$EC2E     ; }
 $ECF3 LD BC,$9D4B     ; Point #REGbc at basket upside-down layout #R$9D4B.
 $ECF6 LD ($9051),BC   ; Store #REGbc in #R$8EF3(#N$9051).
 $ECFA JR $ED15        ; Jump to #R$ED15 to continue this routine.
; Install yellow cup upside-down layout #R$9D8D into slot
; #R$8EF3(#N$9043) (type #N$05).
@label=Script_DoorBehind_Scan
*$ECFC LD BC,$9D8D     ; Point #REGbc at yellow cup upside-down layout #R$9D8D.
 $ECFF LD ($9043),BC   ; Store #REGbc in #R$8EF3(#N$9043).
 $ED03 JR $ED15        ; Jump to #R$ED15 to continue this routine.
; Install worm-can layout #R$9DA2 into slot #R$8EF3(#N$9035) (type
; #N$08).
@label=Script_DoorBehind_Type08
*$ED05 LD BC,$9DA2     ; Point #REGbc at the worm-can layout (#R$9DA2).
 $ED08 LD ($9035),BC   ; Store #REGbc in #R$8EF3(#N$9035).
 $ED0C JR $ED15        ; Jump to #R$ED15 to continue this routine.
; Install seed-box layout #R$A15B into slot #R$8EF3(#N$9027)
; (type #N$10).
@label=Script_DoorBehind_TaskProp
*$ED0E LD BC,$A15B     ; Load #REGbc with #R$A15B.
 $ED11 LD ($9027),BC   ; Store #REGbc in #R$8EF3(#N$9027).
; Mark the interactable entity facing-behind (#N$40) and honour the
; interaction delay in #R$72EC.
@label=Script_DoorBehind_FaceAndDelay
*$ED15 LD (IY+$02),$40 ; Write #N$40 to the referenced entity's flags byte 2.
 $ED19 LD A,($72EC)    ; Load #REGa with the door interaction delay (#R$72EC).
 $ED1C OR A            ; {Is the door interaction delay (#R$72EC) zero? If so, jump to
 $ED1D JR Z,$ED26      ; #R$ED26.}
 $ED1F DEC A           ; Decrease #REGa by one.
 $ED20 LD ($72EC),A    ; Set the door interaction delay (#R$72EC).
 $ED23 JP $EDBD        ; Jump to #R$EDBD to continue this routine.
; Snapshot Berk's position/room and scan complex entities for a matching
; type-#N$32 hitch.
@label=Script_DoorBehind_SnapshotScan
*$ED26 PUSH HL         ; {Stash #REGhl and #REGix on the stack.
 $ED27 PUSH IX         ; }
 $ED29 LD IX,($72AC)   ; Load #REGix with the current-entity pointer (#R$72AC).
 $ED2D LD C,(IX+$07)   ; Load #REGc with the current entity's x-coordinate.
 $ED30 LD B,(IX+$05)   ; Load #REGb with the current entity's y-coordinate.
 $ED33 LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $ED36 LD ($72E8),A    ; Set saved room index (#R$72E8).
 $ED39 LD HL,($72AC)   ; Load #REGhl with the current-entity pointer (#R$72AC).
 $ED3C LD IY,$8EE9     ; Point #REGiy at Boney's complex entity state
                       ; (#R$8EE9).
 $ED40 LD DE,$000E     ; Load #REGde with #N($000E,$04,$04).
; Walk complex entities looking for type #N$32; abort the behind-door move
; if found.
@label=Script_DoorBehind_WalkEntities
*$ED43 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $ED46 CP $32          ; {Is #REGa equal to #N$32? If not, jump to #R$ED50.
 $ED48 JR NZ,$ED50     ; }
 $ED4A POP IX          ; {Restore #REGix and #REGhl from the stack.
 $ED4C POP HL          ; }
 $ED4D JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; Skip inactive (bit #N$07) entities while matching Berk's saved
; coordinates.
@label=Script_DoorBehind_SkipInactive
*$ED50 BIT 7,A         ; {Is bit #N$07 of #REGa set? If so, jump to #R$ED58.
 $ED52 JR NZ,$ED58     ; }
; Advance to the next complex entity and keep scanning.
@label=Script_DoorBehind_NextEntity
*$ED54 ADD IY,DE       ; #REGiy+=#REGde.
 $ED56 JR $ED43        ; Jump to #R$ED43 to continue this routine.
; On a coordinate match, reactivate the hitch, copy Berk's position, and
; reseed #R$72EC.
@label=Script_DoorBehind_HitchMatch
*$ED58 LD A,L          ; Copy #REGl into #REGa.
 $ED59 CP (IY+$0C)     ; {Does #REGa match the referenced entity's extra state? If not, jump
 $ED5C JR NZ,$ED54     ; to #R$ED54.}
 $ED5E LD A,H          ; Copy #REGh into #REGa.
 $ED5F CP (IY+$0D)     ; {Does #REGa match the referenced entity's extra state? If not, jump
 $ED62 JR NZ,$ED54     ; to #R$ED54.}
 $ED64 RES 7,(IY+$00)  ; Reset bit #N$07 of the referenced entity's entity
                       ; type.
 $ED68 RES 5,(IY+$01)  ; Reset bit #N$05 of the referenced entity's flags byte
                       ; 1.
 $ED6C SET 7,(IY+$01)  ; Set bit #N$07 of the referenced entity's flags byte 1.
 $ED70 LD A,(IY+$08)   ; Load #REGa with the referenced entity's x-extent.
 $ED73 SUB (IY+$07)    ; Subtract the referenced entity's x-coordinate from
                       ; #REGa.
 $ED76 LD (IY+$07),C   ; Store #REGc in the referenced entity's x-coordinate.
 $ED79 ADD A,C         ; #REGa+=#REGc.
 $ED7A LD (IY+$08),A   ; Set the referenced entity's x-extent.
 $ED7D LD A,(IY+$06)   ; Load #REGa with the referenced entity's y-extent.
 $ED80 SUB (IY+$05)    ; Subtract the referenced entity's y-coordinate from
                       ; #REGa.
 $ED83 LD (IY+$05),B   ; Store #REGb in the referenced entity's y-coordinate.
 $ED86 ADD A,B         ; #REGa+=#REGb.
 $ED87 LD (IY+$06),A   ; Set the referenced entity's y-extent.
 $ED8A LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $ED8D CP $01          ; {Is #REGa equal to #N$01? If not, jump to #R$ED92.
 $ED8F JR NZ,$ED92     ; }
 $ED91 INC A           ; Step the door's room index on by one.
; Write the hitch's new room, arm bit #N$00 of #R$72B3, and clear the
; type-#N$0B/#N$08 special case.
@label=Script_DoorBehind_WriteHitchRoom
*$ED92 LD (IY+$04),A   ; Set the referenced entity's room index.
 $ED95 LD A,$02        ; Load #REGa with #N$02.
 $ED97 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $ED9A INC A           ; Turn the random roll into a #N$01–#N$02 door delay.
 $ED9B LD ($72EC),A    ; Set the door interaction delay (#R$72EC).
 $ED9E LD HL,$72B3     ; Point #REGhl at the game event flags (#R$72B3).
 $EDA1 SET 0,(HL)      ; Set bit #N$00 of the byte at #REGhl.
 $EDA3 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $EDA6 CP $0B          ; {Is #REGa equal to #N$0B? If not, jump to #R$EDBA.
 $EDA8 JR NZ,$EDBA     ; }
 $EDAA LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $EDAD CP $08          ; {Is #REGa equal to #N$08? If not, jump to #R$EDBA.
 $EDAF JR NZ,$EDBA     ; }
 $EDB1 LD HL,$72BD     ; Point #REGhl at the collision scratch byte (#R$72BD).
 $EDB4 DEC (HL)        ; Decrease the byte at #REGhl by one.
 $EDB5 LD HL,$72B8     ; Point #REGhl at task-one / collision flags (#R$72B8).
 $EDB8 RES 6,(HL)      ; Clear bit #N$06 of the byte at #REGhl.
; Finish the behind-door hitch update and fall through to resume
; scripting.
@label=Script_DoorBehind_Finish
*$EDBA POP IX          ; {Restore #REGix and #REGhl from the stack.
 $EDBC POP HL          ; }
; Resume scripting at #R$B9A5(#N$BBA9) via #R$EC30.
@label=Script_DoorBehind_ResumeScript
*$EDBD LD HL,$BBA9     ; Load #REGhl with #R$B9A5(#N$BBA9).
 $EDC0 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

; Data: Entity Type Bytes
;
; Bytes written by #R$EDDB / #R$EDF8 when opening or closing the trap
; door.
@label=Data_TrapDoorOpenTypes
b$EDC3 DEFB $41,$41,$40,$40,$41,$B2 ; Open-trap type bytes applied to the six
                                    ; scenery slots.
@label=Data_TrapDoorClosedTypes
 $EDC9 DEFB $B2,$B2,$B2,$B2,$B2,$3A ; Closed-trap type bytes applied to the six
                                    ; scenery slots.

; Script Routine: (#N$1C) Close Trap Door
;
; Call #R$EDDB (close the trap door) then advance to the next script
; instruction.
@label=ScriptRoutine_CloseTrapDoor
c$EDCF CALL $EDDB    ; Call #R$EDDB to close the trap door.
 $EDD2 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$1A) Open Trap Door
;
; Call #R$EDF8 (open the trap door) then advance to the next script
; instruction.
@label=ScriptRoutine_OpenTrapDoor
c$EDD5 CALL $EDF8    ; Call #R$EDF8 to open the trap door.
 $EDD8 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Close Trap Door
;
; Used by the routines at #R$B7F3 and #R$EDCF.
; .
; Close the trap door: queue a sound, switch the lever graphic layout to
; closed facing right, and update the related scenery entity types.
@label=Close_TrapDoor
c$EDDB PUSH IX       ; {Stash #REGix, #REGhl and #REGde on the stack.
 $EDDD PUSH HL       ;
 $EDDE PUSH DE       ; }
 $EDDF LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $EDE2 BIT 4,(HL)    ; {Is "task-two / upstairs event latch" (bit #N$04 of #R$72B3) set? If
 $EDE4 JR NZ,$EE2B   ; so, jump to #R$EE2B.}
 $EDE6 RES 1,(HL)    ; Clear "trap door is open / trap door event armed" (bit #N$01 of
                     ; #R$72B3).
; #HTML(#AUDIO0(trap-door-close.wav)(#INCLUDE(TrapDoorClose)))
 $EDE8 LD A,$06      ; Load #REGa with sound index #N$06.
 $EDEA CALL $F8F9    ; Call #R$F8F9 to queue sound.
 $EDED LD HL,$A809   ; Point #REGhl at the lever closed, facing right
                     ; (#R$A809).
 $EDF0 LD ($9177),HL ; Store #REGhl in the lever layout pointer (#R$9177).
 $EDF3 LD HL,$EDC9   ; Point #REGhl at the closed-trap type list (#R$EDC9).
 $EDF6 JR $EE19      ; Jump to #R$EE19 to handle the trap door.

; Open Trap Door
;
; Used by the routine at #R$EDD5.
; .
; Open the trap door: queue a sound, switch the lever graphic layout to
; open facing right, and update the related scenery entity types.
@label=Open_TrapDoor
c$EDF8 PUSH IX       ; {Stash #REGix, #REGhl and #REGde on the stack.
 $EDFA PUSH HL       ;
 $EDFB PUSH DE       ; }
 $EDFC CALL $EE30    ; Call #R$EE30 to check whether entities require the trap door to
                     ; open.
 $EDFF JP NC,$EE2B   ; Jump to #R$EE2B to continue if no open is required.
 $EE02 LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $EE05 BIT 4,(HL)    ; {Is "task-two / upstairs event latch" (bit #N$04 of #R$72B3) set? If
 $EE07 JR NZ,$EE2B   ; so, jump to #R$EE2B.}
 $EE09 SET 1,(HL)    ; Set "trap door is open / trap door event armed" (bit #N$01 of
                     ; #R$72B3).
; #HTML(#AUDIO0(trap-door-open.wav)(#INCLUDE(TrapDoorOpen)))
 $EE0B LD A,$05      ; Load #REGa with sound index #N$05.
 $EE0D CALL $F8F9    ; Call #R$F8F9 to queue sound.
 $EE10 LD HL,$A7FA   ; Point #REGhl at the lever open, facing right (#R$A7FA).
 $EE13 LD ($9177),HL ; Store #REGhl in the lever layout pointer (#R$9177).
 $EE16 LD HL,$EDC3   ; Point #REGhl at the open-trap type list (#R$EDC3).
; This entry point is used by the routine at #R$EDDB.
; .
; Rewrite #N$06 scenery entity types from the open/close type list
; starting at #R$8E87.
@label=UpdateTrapDoorEntityTypes
*$EE19 LD IX,$8E87   ; Point #REGix at the simple-entity slot at #R$8E87.
 $EE1D LD DE,$000E   ; Load #REGde with #N($000E,$04,$04).
 $EE20 LD B,$06      ; Load #REGb with loop count #N$06.
; Write one type byte into the current trap door scenery slot and advance.
@label=UpdateTrapDoorEntityTypes_WriteType
*$EE22 LD A,(HL)     ; Load #REGa with the next type byte.
 $EE23 LD (IX+$00),A ; Write it to the entity.
 $EE26 INC HL        ; Advance the trap door script pointer.
 $EE27 ADD IX,DE     ; Advance #REGix to the next entity.
 $EE29 DJNZ $EE22    ; Decrease the loop counter in #REGb and jump to #R$EE22 if more
                     ; iterations remain.
; This entry point is used by the routine at #R$EDDB.
; .
; Exit open/close trap door after updating scenery types (or early abort).
@label=TrapDoor_RestoreAndReturn
*$EE2B POP DE        ; {Restore #REGde, #REGhl and #REGix from the stack.
 $EE2C POP HL        ;
 $EE2D POP IX        ; }
 $EE2F RET           ; Return.

; Check Entities Near Trap Door
;
; Used by the routine at #R$EDF8.
; .
; Scan complex entity state starting at #R$8EE9. Returns with the carry
; flag set when the trap door should open (an entity of type #N$32 is present
; and nearby entities have been adjusted). Called by #R$EDF8.
;
; O:F Success marker set if the trap door should open
@label=Check_EntitiesNearTrapDoor
c$EE30 LD IX,$8EE9    ; Point #REGix at Boney's complex entity state (#R$8EE9).
 $EE34 LD DE,$000E    ; Load #REGde with #N($000E,$04,$04).
 $EE37 LD HL,$72B3    ; Point #REGhl at the game event flags (#R$72B3).
; Scan complex entities for ones standing in the trap door X band of rooms
; #N$02–#N$04.
@label=CheckNearTrapDoor_Scan
*$EE3A LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $EE3D CP $32         ; {Is #REGa equal to #N$32? If so, jump to #R$EEBF.
 $EE3F JP Z,$EEBF     ; }
 $EE42 OR A           ; {Is #REGa zero? If so, jump to #R$EE8E.
 $EE43 JR Z,$EE8E     ; }
 $EE45 CP $21         ; {Is #REGa less than #N$21? If not, jump to #R$EE8E.
 $EE47 JR NC,$EE8E    ; }
 $EE49 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $EE4C CP $05         ; {Is #REGa equal to #N$05? If so, jump to #R$EE8E.
 $EE4E JR Z,$EE8E     ; }
 $EE50 CP $02         ; {Is #REGa less than #N$02? If so, jump to #R$EE8E.
 $EE52 JR C,$EE8E     ; }
 $EE54 BIT 7,(IX+$01) ; {Is bit #N$07 of the current entity's flags byte 1 set? If so, jump
 $EE58 JR NZ,$EE8E    ; to #R$EE8E.}
 $EE5A LD A,(IX+$08)  ; Load #REGa with the current entity's x-extent.
 $EE5D CP $6C         ; {Is #REGa less than #N$6C? If so, jump to #R$EE8E.
 $EE5F JR C,$EE8E     ; }
 $EE61 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $EE64 CP $74         ; {Is #REGa less than #N$74? If not, jump to #R$EE8E.
 $EE66 JR NC,$EE8E    ; }
 $EE68 CP $72         ; {Is #REGa less than #N$72? If so, jump to #R$EE7A.
 $EE6A JR C,$EE7A     ; }
 $EE6C JR NZ,$EE74    ; Jump to #R$EE74 to continue if the comparison did not
                      ; match.
 $EE6E SET 6,(IX+$03) ; Set bit #N$06 of the current entity's flags byte 3.
 $EE72 JR $EE8A       ; Jump to #R$EE8A to handle the trap door.
; Flag this near-trap entity with bit #N$07 (right-of-band side).
@label=CheckNearTrapDoor_SetBit7
*$EE74 SET 7,(IX+$03) ; Set bit #N$07 of the current entity's flags byte 3.
 $EE78 JR $EE8A       ; Jump to #R$EE8A to handle the trap door.
; For X in the inner band: poke Bad Tempered Thing state for Berk, else
; just mark the entity.
@label=CheckNearTrapDoor_CheckEntityType
*$EE7A LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $EE7D CP $14         ; {Is #REGa less than #N$14? If not, jump to #R$EE92.
 $EE7F JR NC,$EE92    ; }
 $EE81 CP $01         ; {Is #REGa equal to #N$01? If not, jump to #R$EE8A.
 $EE83 JR NZ,$EE8A    ; }
 $EE85 LD A,$07       ; Load #REGa with #N$07.
 $EE87 LD ($72C7),A   ; Set the Bad Tempered Thing state (#R$72C7).
; Set bit #N$00 on the near-trap entity, then advance.
@label=CheckNearTrapDoor_MarkEntity
*$EE8A SET 0,(IX+$02) ; Set bit #N$00 of the current entity's flags byte 2.
; Advance to the next complex entity in the near-trap scan.
@label=CheckNearTrapDoor_NextEntity
*$EE8E ADD IX,DE      ; #REGix+=#REGde.
 $EE90 JR $EE3A       ; Jump to #R$EE3A to handle the trap door.
; Restart from #R$8EE9 to clear near-trap marks when no type-#N$32 was
; found.
@label=CheckNearTrapDoor_ClearPass
*$EE92 LD IX,$8EE9    ; Point #REGix at Boney's complex entity state (#R$8EE9).
; Clear pass: wipe bit #N$00/#N$06/#N$07 marks until type #N($32), then
; refuse the open.
@label=CheckNearTrapDoor_ClearScan
*$EE96 LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $EE99 CP $32         ; {Is #REGa equal to #N$32? If so, jump to #R$EEBC.
 $EE9B JR Z,$EEBC     ; }
 $EE9D BIT 0,(IX+$02) ; {Is bit #N$00 of the current entity's flags byte 2 set? If not,
 $EEA1 JR Z,$EEB8     ; jump to #R$EEB8.}
 $EEA3 RES 0,(IX+$02) ; Reset bit #N$00 of the current entity's flags byte 2.
 $EEA7 RES 6,(IX+$03) ; Reset bit #N$06 of the current entity's flags byte 3.
 $EEAB RES 7,(IX+$03) ; Reset bit #N$07 of the current entity's flags byte 3.
 $EEAF CP $01         ; {Is #REGa equal to #N$01? If not, jump to #R$EEB8.
 $EEB1 JR NZ,$EEB8    ; }
 $EEB3 LD A,$05       ; Load #REGa with sound index #N$05.
 $EEB5 LD ($72C7),A   ; Set the Bad Tempered Thing state (#R$72C7).
; Advance during the clear pass.
@label=CheckNearTrapDoor_ClearNext
*$EEB8 ADD IX,DE      ; #REGix+=#REGde.
 $EEBA JR $EE96       ; Jump to #R$EE96 to handle the trap door.
; No open: clear the falling-entity latch (bit #N$02 of #R$72B3) and
; return carry clear.
@label=CheckNearTrapDoor_NoOpen
*$EEBC RES 2,(HL)     ; Clear the falling-entity latch (bit #N$02 of #R$72B3).
 $EEBE RET            ; Return.
; Type #N$32 found: restart from #R$8EE9 to nudge marked entities before
; opening.
@label=CheckNearTrapDoor_FoundSceneryBlock
*$EEBF LD IX,$8EE9    ; Point #REGix at Boney's complex entity state (#R$8EE9).
; Adjust pass: shrink or bump entities that were marked near the trap
; door.
@label=CheckNearTrapDoor_AdjustScan
*$EEC3 LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $EEC6 CP $32         ; {Is #REGa equal to #N$32? If so, jump to #R$EF0E.
 $EEC8 JR Z,$EF0E     ; }
 $EECA BIT 0,(IX+$02) ; {Is bit #N$00 of the current entity's flags byte 2 set? If not,
 $EECE JR Z,$EF0A     ; jump to #R$EF0A.}
 $EED0 LD A,(IX+$03)  ; Load #REGa with the current entity's flags byte 3.
 $EED3 LD C,A         ; Keep the flags byte in #REGc.
 $EED4 AND %00111111  ; #REGa&=#N$3F.
 $EED6 LD (IX+$03),A  ; Set the current entity's flags byte 3.
 $EED9 LD A,C         ; Copy the saved count/flag from #REGc into #REGa.
 $EEDA AND %11000000  ; #REGa&=#N$C0.
 $EEDC JR Z,$EEF4     ; Jump to #R$EEF4 to continue if the comparison matched.
 $EEDE RES 0,(IX+$02) ; Reset bit #N$00 of the current entity's flags byte 2.
 $EEE2 BIT 6,A        ; {Is bit #N$06 of #REGa set? If not, jump to #R$EEEC.
 $EEE4 JR Z,$EEEC     ; }
 $EEE6 INC (IX+$07)   ; {Move this entity one character right.
 $EEE9 INC (IX+$08)   ; }
; Bump a marked entity one character right away from the trap door band.
@label=CheckNearTrapDoor_BumpCoordinates
*$EEEC INC (IX+$07)   ; {Bump this entity one character right.
 $EEEF INC (IX+$08)   ; }
 $EEF2 JR $EF0A       ; Jump to #R$EF0A to handle the trap door.
; Randomly shrink a marked entity's Y/Y-extent by #N$04–#N$07 characters.
@label=CheckNearTrapDoor_ShrinkBounds
*$EEF4 LD A,$04       ; Load #REGa with #N$04.
 $EEF6 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $EEF9 ADD A,$04      ; #REGa+=#N$04.
 $EEFB LD C,A         ; Keep #REGa in #REGc for the next calculation.
 $EEFC LD A,(IX+$05)  ; Load #REGa with the current entity's y-coordinate.
 $EEFF SUB C          ; #REGa-=#REGc.
 $EF00 LD (IX+$05),A  ; Set the current entity's y-coordinate.
 $EF03 LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $EF06 SUB C          ; #REGa-=#REGc.
 $EF07 LD (IX+$06),A  ; Set the current entity's y-extent.
; Advance to the next entity in the adjust pass.
@label=CheckNearTrapDoor_AdjustNext
*$EF0A ADD IX,DE      ; #REGix+=#REGde.
 $EF0C JR $EEC3       ; Jump to #R$EEC3 to handle the trap door.
; Signal that the trap door should open (set bit #N$02 of #R$72B3, carry
; set).
@label=CheckNearTrapDoor_ShouldOpen
*$EF0E SET 2,(HL)     ; Set the falling-entity latch (bit #N$02 of #R$72B3).
 $EF10 SCF            ; Signal success.
 $EF11 RET            ; Return.

; Script Routine: (#N$17) Move held entity up one room row
;
; Via #R$72AC: decrease the held entity's y and y-extent by #N($02), then
; increment its room index, and continue at #R$EC2E.
@label=ScriptRoutine_MoveHeldUpOneRoom
c$EF12 LD IY,($72AC) ; Load #REGiy with the current-entity pointer (#R$72AC).
 $EF16 DEC (IY+$05)  ; {Move the referenced entity two characters up.
 $EF19 DEC (IY+$06)  ;
 $EF1C DEC (IY+$05)  ;
 $EF1F DEC (IY+$06)  ; }
 $EF22 INC (IY+$04)  ; Increment the referenced entity's room index.
 $EF25 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script: Set Entity Latch
;
; Set bit #N$05 of flags byte 2 (#REGix+#N$02). If bit #N$04 of
; flags byte 3 (#REGix+#N$03) is clear, continue at #R$EF49 to set bit #N$00
; of #R$72B3.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_SetLatchRaiseEvent
c$EF28 SET 5,(IX+$02) ; Set bit #N$05 of the current entity's flags byte 2.
 $EF2C BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $EF30 JR Z,$EF49     ; #R$EF49.}

; Script Routine: (#N$18) Start loop
;
; Start a simple script loop for the current entity.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_StartLoop
c$EF32 RES 4,(IX+$03) ; Reset bit #N$04 of the current entity's flags byte 3.
 $EF36 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $EF3A RES 5,(IY+$01) ; Reset bit #N$05 of the referenced entity's flags byte
                      ; 1.
 $EF3E LD A,(IY+$00)  ; Load #REGa with the referenced entity's entity type.
 $EF41 OR A           ; {Is the referenced entity's entity type zero? If so, jump to #R$EC2E
 $EF42 JP Z,$EC2E     ; to run the next script instruction.}
 $EF45 SET 7,(IY+$01) ; Set bit #N$07 of the referenced entity's flags byte 1.
; This entry point is used by the routine at #R$EF28.
; .
; Raise bit #N$00 of the game event flags at #R$72B3, then continue the
; script.
@label=Script_Shared_SetEventBit
*$EF49 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $EF4C SET 0,A        ; Set bit #N$00 of #REGa.
 $EF4E LD ($72B3),A   ; Set the game event flags (#R$72B3).
 $EF51 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0A) Reset entity direction flags
;
; Clear the entity's facing / direction flags.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_ResetDirectionFlags
c$EF54 LD (IX+$09),$00 ; Write #N$00 to the current entity's direction / state.
 $EF58 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0B) Set entity facing right
;
; Face the entity right for the next script beats.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceRight
c$EF5B LD (IX+$09),$02 ; Write #N$02 to the current entity's direction / state.
 $EF5F JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0C) Set entity facing left
;
; Face the entity left for the next script beats.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceLeft
c$EF62 LD (IX+$09),$01 ; Write #N$01 to the current entity's direction / state.
 $EF66 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0D) Set entity facing up
;
; Face the entity up for the next script beats.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceUp
c$EF69 LD (IX+$09),$08 ; Write #N$08 to the current entity's direction / state.
 $EF6D JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0E) Set entity facing down
;
; Face the entity down for the next script beats.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceDown
c$EF70 LD (IX+$09),$04 ; Write #N$04 to the current entity's direction / state.
 $EF74 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script: Jump If Carrying
;
; If bit #N$04 of flags byte 3 is set, jump to the script address that
; follows; otherwise skip it.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_JumpIfCarrying
c$EF77 INC HL         ; {Advance #REGhl past the current script instruction.
 $EF78 INC HL         ; }
 $EF79 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $EF7D JR NZ,$EF84    ; #R$EF84.}
 $EF7F JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script: Load Script Pointer
;
; Replace the entity's script cursor with the absolute address that
; follows, so it continues from that fragment.
@label=ScriptRoutine_JumpToAddress
c$EF82 INC HL        ; {Advance #REGhl past the current script instruction.
 $EF83 INC HL        ; }
; This entry point is used by the routine at #R$EF77.
; .
; Redirect the script pointer to the operand address and execute it at
; #R$EC30.
@label=ScriptRoutine_JumpToAddress_FetchAddress
*$EF84 LD C,(HL)     ; Fetch the low byte of the new script address.
 $EF85 INC HL        ; Advance the script pointer by one byte.
 $EF86 LD B,(HL)     ; Fetch the high byte of the new script address.
 $EF87 PUSH BC       ; {Load #REGhl with the new script address (using the
 $EF88 POP HL        ; stack).}
 $EF89 JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9E51 }
; LIST#

; Script Routine: (#N$02) Move entity left one character
;
; Shift the current entity one character left.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveLeft
c$EF8C DEC (IX+$07)   ; {Move this entity one character left.
 $EF8F DEC (IX+$08)   ; }
 $EF92 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $EF96 JR Z,$EFA5     ; #R$EFA5.}
 $EF98 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $EF9C DEC (IY+$07)   ; {Move the referenced entity one character left.
 $EF9F DEC (IY+$08)   ; }
 $EFA2 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; If the entity is locked to a linked partner (bit #N$03), scan collisions
; with code #N$82.
@label=Script_MoveLeft_TestBit3
*$EFA5 BIT 3,(IX+$03) ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $EFA9 JP Z,$EC2E     ; #R$EC2E.}
 $EFAC LD A,$82       ; Load #REGa with #N$82.
 $EFAE JR $EFD3       ; Jump to #R$EFD3 to continue this routine.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9EB8 }
; LIST#

; Script Push Direction Flag
;
; Direction / state scratch byte for script push helpers. Written by
; #R$EFD3 and read by #R$EFED.
@label=Flag_ScriptPushDirection
b$EFB0 DEFB $00

; Script Routine: (#N$03) Move entity right one character
;
; Shift the current entity one character right.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveRight
c$EFB1 INC (IX+$07)    ; {Move this entity one character right.
 $EFB4 INC (IX+$08)    ; }
 $EFB7 BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $EFBB JR Z,$EFCA      ; #R$EFCA.}
 $EFBD LD IY,($72AC)   ; Load #REGiy with the current-entity pointer (#R$72AC).
 $EFC1 INC (IY+$07)    ; {Move the referenced entity one character right.
 $EFC4 INC (IY+$08)    ; }
 $EFC7 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; If the entity is locked to a linked partner (bit #N$03), scan collisions
; with code #N$81.
@label=Script_MoveRight_TestBit3
*$EFCA BIT 3,(IX+$03)  ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $EFCE JP Z,$EC2E      ; #R$EC2E.}
 $EFD1 LD A,$81        ; Load #REGa with #N$81.
; This entry point is used by the routine at #R$EF8C.
; .
; Remember the push direction in #R$EFB0 and walk complex entities for a
; type-#N$32 hitch.
@label=Script_MoveHorizontal_ScanCollisions
*$EFD3 LD ($EFB0),A    ; Set #R$EFB0.
 $EFD6 PUSH IX         ; {Stash #REGix and #REGde on the stack.
 $EFD8 PUSH DE         ; }
 $EFD9 LD DE,$000E     ; Load #REGde with #N($000E,$04,$04).
 $EFDC LD IX,$8EE9     ; Point #REGix at Boney's complex entity state
                       ; (#R$8EE9).
; Scan complex entities; stop when type #N$32 is reached.
@label=Script_PushHitch_ScanSceneryBlock
*$EFE0 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $EFE3 CP $32          ; {Is #REGa equal to #N$32? If not, jump to #R$EFED.
 $EFE5 JR NZ,$EFED     ; }
 $EFE7 POP DE          ; {Restore #REGde and #REGix from the stack.
 $EFE8 POP IX          ; }
 $EFEA JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; On a matching push-direction hitch, shove it left or right and play the
; movement click.
@label=Script_PushHitch_Shove
*$EFED LD A,($EFB0)    ; Load #REGa from #R$EFB0.
 $EFF0 CP (IX+$09)     ; {Does #REGa match this entity's direction/state? If not, jump to
 $EFF3 JR NZ,$F010     ; #R$F010.}
 $EFF5 LD (IX+$09),$00 ; Write #N$00 to the current entity's direction / state.
 $EFF9 CP $82          ; {Is #REGa equal to #N$82? If so, jump to #R$F005.
 $EFFB JR Z,$F005      ; }
 $EFFD INC (IX+$07)    ; {Move this entity one character right.
 $F000 INC (IX+$08)    ; }
 $F003 JR $F00B        ; Jump to #R$F00B to continue this routine.
; Shove the hitch one character left (push-left path).
@label=Script_PushHitch_ShoveLeft
*$F005 DEC (IX+$07)    ; {Move this entity one character left.
 $F008 DEC (IX+$08)    ; }
; #HTML(#AUDIO0(movement.wav)(#INCLUDE(Movement)))
@label=Script_PushHitch_Click
*$F00B LD A,$10        ; Load #REGa with #N$10.
 $F00D CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
; Advance to the next complex entity in the horizontal-push scan.
@label=Script_PushHitch_NextEntity
*$F010 ADD IX,DE       ; #REGix+=#REGde.
 $F012 JR $EFE0        ; Jump to #R$EFE0 to continue this routine.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9ED2 }
; LIST#

; Script Routine: (#N$04) Move entity up one character
;
; Shift the current entity one character up.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveUp
c$F014 LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $F017 CP $1B         ; {Is #REGa equal to #N$1B? If not, jump to #R$F021.
 $F019 JR NZ,$F021    ; }
 $F01B LD HL,$B9CD    ; Point #REGhl at Berk's left-facing idle script
                      ; (#R$B9A5(#N$B9CD)).
 $F01E JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Past the ceiling band: optionally step back one room, then move up.
@label=ScriptRoutine_MoveUp_AfterCeilingExit
*$F021 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $F024 CP $00         ; {Is #REGa equal to #N$00? If so, jump to #R$F02B.
 $F026 JR Z,$F02B     ; }
 $F028 DEC (IX+$04)   ; Move this entity back one room.
; Move the entity (and any carried partner) one character up.
@label=ScriptRoutine_MoveUp_DecY
*$F02B DEC (IX+$05)   ; {Move this entity one character up.
 $F02E DEC (IX+$06)   ; }
 $F031 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F035 JR Z,$F04B     ; #R$F04B.}
 $F037 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F03B CP $00         ; {Is #REGa equal to #N$00? If so, jump to #R$F042.
 $F03D JR Z,$F042     ; }
 $F03F DEC (IY+$04)   ; Decrease the referenced entity's room index.
; Move the carried entity one character up to match Berk.
@label=ScriptRoutine_MoveUp_DecHeldY
*$F042 DEC (IY+$05)   ; {Move the referenced entity one character up.
 $F045 DEC (IY+$06)   ; }
 $F048 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; If a linked camera-follow partner is locked (bit #N$03), clear the lock
; and lift it too.
@label=ScriptRoutine_MoveUp_CheckHoldingLock
*$F04B BIT 3,(IX+$03) ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F04F JP Z,$EC2E     ; #R$EC2E.}
 $F052 RES 3,(IX+$03) ; Reset bit #N$03 of the current entity's flags byte 3.
 $F056 LD IY,($90A7)  ; Load #REGiy from the camera-follow entity's extra-state pointer
                      ; (#R$8EF3(#N$90A7) = #R$909B+#N$0C).
 $F05A CP $00         ; {Is #REGa equal to #N$00? If so, jump to #R$F061.
 $F05C JR Z,$F061     ; }
 $F05E DEC (IY+$04)   ; Decrease the referenced entity's room index.
; Move the linked partner one character up, then clear its pointer and
; thud.
@label=ScriptRoutine_MoveUp_DecLinkedY
*$F061 DEC (IY+$05)   ; {Move the referenced entity one character up.
 $F064 DEC (IY+$06)   ; }
 $F067 JR $F0B8       ; Jump to #R$F0B8 to continue this routine.

; Script Routine: (#N$05) Move entity down one character
;
; Shift the current entity one character down.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveDown
c$F069 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $F06C CP $04         ; {Is #REGa equal to #N$04? If not, jump to #R$F076.
 $F06E JR NZ,$F076    ; }
 $F070 LD HL,$B9AD    ; Point #REGhl at Berk's right-facing idle script
                      ; (#R$B9AD).
 $F073 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Past the floor band: optionally advance one room, then move down.
@label=ScriptRoutine_MoveDown_AfterFloorExit
*$F076 LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $F079 CP $23         ; {Is #REGa less than #N$23? If so, jump to #R$F080.
 $F07B JR C,$F080     ; }
 $F07D INC (IX+$04)   ; Advance this entity into the next room.
; Move the entity (and any carried partner) one character down.
@label=ScriptRoutine_MoveDown_IncY
*$F080 INC (IX+$05)   ; {Move this entity one character down.
 $F083 INC (IX+$06)   ; }
 $F086 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F08A JR Z,$F0A0     ; #R$F0A0.}
 $F08C LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F090 CP $23         ; {Is #REGa less than #N$23? If so, jump to #R$F097.
 $F092 JR C,$F097     ; }
 $F094 INC (IY+$04)   ; Increment the referenced entity's room index.
; Move the carried entity one character down to match Berk.
@label=ScriptRoutine_MoveDown_IncHeldY
*$F097 INC (IY+$05)   ; {Move the referenced entity one character down.
 $F09A INC (IY+$06)   ; }
 $F09D JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; If a linked camera-follow partner is locked (bit #N$03), clear the lock
; and drop it too.
@label=ScriptRoutine_MoveDown_CheckHoldingLock
*$F0A0 BIT 3,(IX+$03) ; {Is bit #N$03 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F0A4 JP Z,$EC2E     ; #R$EC2E.}
 $F0A7 RES 3,(IX+$03) ; Reset bit #N$03 of the current entity's flags byte 3.
 $F0AB LD IY,($90A7)  ; Load #REGiy from the camera-follow entity's extra-state pointer
                      ; (#R$8EF3(#N$90A7) = #R$909B+#N$0C).
 $F0AF INC (IY+$05)   ; {Move the referenced entity one character down.
 $F0B2 INC (IY+$06)   ; }
 $F0B5 INC (IY+$04)   ; Increment the referenced entity's room index.
; This entry point is used by the routine at #R$F014.
; .
; Clear the linked-entity pointer at #R$8EF3(#N$90A7) and queue movement
; sound #N$10.
@label=ScriptRoutine_Move_ClearLinkedAndThud
*$F0B8 LD BC,$0000    ; Clear #REGbc ready to wipe the linked-entity pointer.
 $F0BB LD ($90A7),BC  ; Clear the camera-follow entity's extra-state pointer at
                      ; #R$8EF3(#N$90A7).
; #HTML(#AUDIO0(movement.wav)(#INCLUDE(Movement)))
 $F0BF LD A,$10       ; Load #REGa with #N$10.
 $F0C1 CALL $F8F9     ; Call #R$F8F9 to queue a sound effect.
 $F0C4 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$06) Move entity left two characters
;
; Shift the current entity two characters left.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveLeftTwo
c$F0C7 SET 1,(IX+$03) ; Set bit #N$01 of the current entity's flags byte 3.
 $F0CB JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$07) Move entity right two characters
;
; Shift the current entity two characters right.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveRightTwo
c$F0CE RES 1,(IX+$03) ; Reset bit #N$01 of the current entity's flags byte 3.
 $F0D2 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$09) Move entity down two characters
;
; Shift the current entity two characters down.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveDownTwo
c$F0D5 RES 0,(IX+$03) ; Reset bit #N$00 of the current entity's flags byte 3.
 $F0D9 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$08) Move entity up two characters
;
; Shift the current entity two characters up.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_MoveUpTwo
c$F0DC SET 0,(IX+$03) ; Set bit #N$00 of the current entity's flags byte 3.
 $F0E0 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$0F) Have entity put down carried entity
;
; Make the entity put down whatever it is carrying.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_PutDownCarried
c$F0E3 CALL $F0F2     ; Call #R$F0F2 to script Put Down Set Carrying Flag.
 $F0E6 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; This entry point is used by the routine at #R$B440.
; .
; Place the held entity using Berk's Y as the put-down baseline.
@label=ScriptRoutine_PutDownCarried_PlaceHeldFromBerk
*$F0E9 LD C,(IX+$05)  ; Load #REGc with the current entity's y-coordinate.
 $F0EC LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F0F0 JR $F11C       ; Jump to #R$F11C to continue this routine.
; Set bit #N$04 of flags byte 3 and prepare the held entity for
; put-down.
@label=Script_PutDown_SetCarryingFlag
*$F0F2 SET 4,(IX+$03) ; Set bit #N$04 of the current entity's flags byte 3.
 $F0F6 LD C,(IX+$05)  ; Load #REGc with the current entity's y-coordinate.
 $F0F9 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F0FD LD A,(IY+$00)  ; Load #REGa with the referenced entity's entity type.
 $F100 CP $01         ; {Is #REGa equal to #N$01? If not, jump to #R$F108.
 $F102 JR NZ,$F108    ; }
 $F104 XOR A          ; Clear #REGa to #N$00.
 $F105 LD ($72C7),A   ; Set the Bad Tempered Thing state (#R$72C7).
; Reactivate the held entity; if it is type #N($09), set Slimies in
; #R$72B6.
@label=Script_PutDown_Apply
*$F108 RES 7,(IY+$00) ; Reset bit #N$07 of the referenced entity's entity type.
 $F10C CP $09         ; {Is #REGa equal to #N$09? If not, jump to #R$F118.
 $F10E JR NZ,$F118    ; }
 $F110 LD A,($72B6)   ; Load #REGa with the task-three flags (#R$72B6).
 $F113 SET 1,A        ; Set Slimies (bit #N$01 of #REGa. put-down of type
                      ; #N$09).
 $F115 LD ($72B6),A   ; Set the task-three flags (#R$72B6).
; Set bit #N$05 on the held entity before writing its grounded Y.
@label=ScriptRoutine_PutDownCarried_SetHeldBit5
*$F118 SET 5,(IY+$01) ; Set bit #N$05 of the referenced entity's flags byte 1.
; Save held width/height into #R$72ED/#R$72EE and park the entity at the
; put-down Y.
@label=ScriptRoutine_PutDownCarried_SaveSizeAndPlaceY
*$F11C LD A,(IY+$08)  ; Load #REGa with the referenced entity's x-extent.
 $F11F SUB (IY+$07)   ; Subtract the referenced entity's x-coordinate from
                      ; #REGa.
 $F122 LD ($72ED),A   ; Store the held entity's width (x-extent − x) in
                      ; #R$72ED.
 $F125 LD A,(IY+$06)  ; Load #REGa with the referenced entity's y-extent.
 $F128 SUB (IY+$05)   ; Subtract the referenced entity's y-coordinate from
                      ; #REGa.
 $F12B LD ($72EE),A   ; Store the held entity's height (y-extent − y) in
                      ; #R$72EE.
 $F12E LD B,A         ; Keep a copy of #REGa in #REGb.
 $F12F SRL A          ; Shift #REGa right logical.
 $F131 NEG            ; Negate #REGa (flip a delta/direction).
 $F133 ADD A,C        ; #REGa+=#REGc.
 $F134 ADD A,$02      ; #REGa+=#N$02.
 $F136 LD (IY+$05),A  ; Set the referenced entity's y-coordinate.
 $F139 ADD A,B        ; #REGa+=#REGb.
 $F13A LD (IY+$06),A  ; Set the referenced entity's y-extent.
 $F13D RET            ; Return.

; Script Routine: (#N$14) Have entity pick up / restore held entity state
;
; Make the entity pick up / restore the held-entity state.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_PickUpHeld
c$F13E RES 4,(IX+$03) ; Reset bit #N$04 of the current entity's flags byte 3.
 $F142 LD A,($72EE)   ; Load #REGa with the saved held-entity height from
                      ; #R$72EE.
 $F145 LD C,A         ; Keep the camera origin X in #REGc.
 $F146 LD A,($72E9)   ; Load #REGa with the held-entity y-extent (#R$72E9).
 $F149 OR A           ; {Is the held-entity y-extent (#R$72E9) zero? If not,
 $F14A JR NZ,$F150    ; jump to #R$F150.}
 $F14C LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $F14F DEC A          ; Decrease #REGa by one.
; Snap the held entity back under Berk using height #R$72EE and clear bit
; #N$05.
@label=ScriptRoutine_PickUpHeld_ApplyHeldY
*$F150 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F154 RES 5,(IY+$01) ; Reset bit #N$05 of the referenced entity's flags byte
                      ; 1.
 $F158 LD (IY+$06),A  ; Set the referenced entity's y-extent.
 $F15B SUB C          ; Subtract #REGc from #REGa.
 $F15C LD (IY+$05),A  ; Set the referenced entity's y-coordinate.
 $F15F XOR A          ; Clear #REGa to #N$00.
 $F160 LD ($72E9),A   ; Set the held-entity y-extent (#R$72E9).
 $F163 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$10) Have entity face left after putting down
;
; After a put-down, face the entity left.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceLeftAfterPutDown
c$F166 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F16A JP Z,$EC2E     ; #R$EC2E.}
 $F16D CALL $F183     ; Call #R$F183 to script Face After Put Down Apply.
 $F170 INC A          ; Step the facing / put-down index on by one.
 $F171 JR $F17D       ; Jump to #R$F17D to script Routine 10 Apply Facing.

; Script Routine: (#N$11) Have entity face right after putting down
;
; After a put-down, face the entity right.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_FaceRightAfterPutDown
c$F173 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F177 JP Z,$EC2E     ; #R$EC2E.}
 $F17A CALL $F183     ; Call #R$F183 to script Face After Put Down Apply.
; This entry point is used by the routine at #R$F166.
; .
; Write the held entity's room after facing, then continue the script.
@label=ScriptRoutine_FaceLeftAfterPutDown_ApplyFacing
*$F17D LD (IY+$04),A  ; Set the referenced entity's room index.
 $F180 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; This entry point is used by the routine at #R$F166.
; .
; Aim the held entity's X at Berk's #R$7303 using the saved width in
; #R$72ED.
@label=Script_FaceAfterPutDown_Apply
*$F183 LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F187 LD A,($72ED)   ; Load #REGa with the saved held-entity width from
                      ; #R$72ED.
 $F18A LD E,$01       ; Load #REGe with #N$01.
 $F18C LD D,A         ; Copy #REGa into #REGd as a saved coordinate / value.
 $F18D SRL A          ; Shift #REGa right logical.
 $F18F JR NZ,$F192    ; Jump to #R$F192 to continue if the comparison did not
                      ; match.
 $F191 INC E          ; Advance the low byte of the pointer/offset in #REGde.
; Write the held entity's X and X-extent beside Berk after put-down
; facing.
@label=ScriptRoutine_FaceRightAfterPutDown_WriteHeldX
*$F192 LD A,($7303)   ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $F195 ADD A,E        ; Add #REGe to #REGa.
 $F196 LD (IY+$07),A  ; Set the referenced entity's x-coordinate.
 $F199 ADD A,D        ; Add #REGd into #REGa while building a 16-bit
                      ; entity/screen address.
 $F19A LD (IY+$08),A  ; Set the referenced entity's x-extent.
 $F19D LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $F1A0 RET            ; Return.

; Script Routine: (#N$12) Position put-down entity to the left
;
; Place the put-down entity to the carrier's left.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_PlacePutDownLeft
c$F1A1 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F1A5 JP Z,$EC2E     ; #R$EC2E.}
 $F1A8 LD A,($72ED)   ; Load #REGa with the saved held-entity width from
                      ; #R$72ED.
 $F1AB LD D,A         ; Copy #REGa into #REGd as a saved coordinate / value.
 $F1AC INC A          ; Step the put-down placement index on by one.
 $F1AD SRL A          ; Shift #REGa right logical.
 $F1AF LD E,A         ; Copy #REGa into #REGe as a saved coordinate / value.
 $F1B0 XOR A          ; Clear #REGa to #N$00.
 $F1B1 SUB E          ; Subtract #REGe from #REGa.
 $F1B2 ADD A,(IX+$07) ; Add the entity byte at offset #N$07 to #REGa.
 $F1B5 JR $F1CB       ; Jump to #R$F1CB to script Routine 12 Write Put Down.

; Script Routine: (#N$13) Position put-down entity to the right
;
; Place the put-down entity to the carrier's right.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_PlacePutDownRight
c$F1B7 BIT 4,(IX+$03) ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $F1BB JP Z,$EC2E     ; #R$EC2E.}
 $F1BE LD A,($72ED)   ; Load #REGa with the saved held-entity width from
                      ; #R$72ED.
 $F1C1 LD D,A         ; Copy #REGa into #REGd as a saved coordinate / value.
 $F1C2 SRL A          ; Shift #REGa right logical.
 $F1C4 LD E,A         ; Copy #REGa into #REGe as a saved coordinate / value.
 $F1C5 LD A,$04       ; Load #REGa with #N$04.
 $F1C7 SUB E          ; Subtract #REGe from #REGa.
 $F1C8 ADD A,(IX+$07) ; Add the entity byte at offset #N$07 to #REGa.
; This entry point is used by the routine at #R$F1A1.
; .
; Write the put-down entity's X, X-extent and room, then continue the
; script.
@label=ScriptRoutine_PlacePutDownLeft_WritePutDown
*$F1CB LD IY,($72AC)  ; Load #REGiy with the current-entity pointer (#R$72AC).
 $F1CF LD (IY+$07),A  ; Set the referenced entity's x-coordinate.
 $F1D2 ADD A,D        ; Add #REGd into #REGa while building a 16-bit
                      ; entity/screen address.
 $F1D3 LD (IY+$08),A  ; Set the referenced entity's x-extent.
 $F1D6 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $F1D9 LD (IY+$04),A  ; Set the referenced entity's room index.
 $F1DC JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$16) Start Drutt script
;
; Hand control to Drutt's script for the trap door sequence.
@label=ScriptRoutine_StartDruttScript
c$F1DF LD IY,$8D8B     ; Point #REGiy at the lever scenery entity (#R$8D8B).
 $F1E3 LD (IY+$0A),$18 ; {Point the referenced entity's graphic layout at
 $F1E7 LD (IY+$0B),$A8 ; #R$A818.}
 $F1EB LD A,$01        ; {Set the timed event latch.
 $F1ED LD ($72CE),A    ; }
 $F1F0 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Update Camera Follow
;
; Used by the routine at #R$AAB3.
; .
; Adjust the camera window at #R$72FB to follow the target entity.
;
; .
;
; If the camera-follow delay is non-zero, tick it down; otherwise scroll
; the window toward the target.
@label=Update_CameraFollow
c$F1F3 LD A,($730A)  ; Load #REGa with the camera-follow delay (#R$730A).
 $F1F6 OR A          ; {Is the camera-follow delay (#R$730A) zero? If so, jump
 $F1F7 JR Z,$F1FE    ; to #R$F1FE.}
 $F1F9 DEC A         ; Decrease #REGa by one.
 $F1FA LD ($730A),A  ; Set the camera-follow delay (#R$730A).
 $F1FD RET           ; Return.
; Camera delay expired: point at the follow entity (#R$909B) and track it
; against #R$72FB.
@label=Update_CameraFollow_Active
*$F1FE LD IX,$909B   ; Point #REGix at the camera-follow entity (#R$909B).
 $F202 LD DE,($72FB) ; Load #REGde with the camera room-origin pointer
                     ; (#R$72FB).
 $F206 LD B,$20      ; Load #REGb with loop count #N$20.
; Probe whether the follow entity sits inside the camera X window.
@label=Update_CameraFollow_ProbeX
*$F208 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $F20B ADD A,$02     ; #REGa+=#N$02.
 $F20D CP E          ; {Is #REGa less than #REGe? If so, jump to #R$F230.
 $F20E JR C,$F230    ; }
 $F210 LD C,A        ; Keep #REGa in #REGc for the next calculation.
 $F211 LD A,D        ; Copy #REGd into #REGa for later use.
 $F212 CP C          ; {Is #REGa less than #REGc? If so, jump to #R$F216.
 $F213 JR C,$F216    ; }
 $F215 RET           ; Return.
; Scroll the camera origin right by #N$20 until the follow entity is
; centred.
@label=Update_CameraFollow_ScrollRight
*$F216 LD A,E        ; Copy the saved low byte from #REGe into #REGa.
 $F217 CP $A0        ; {Is #REGa equal to #N$A0? If so, jump to #R$F226.
 $F219 JR Z,$F226    ; }
 $F21B ADD A,B       ; #REGa+=#REGb.
 $F21C LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $F21D LD D,A        ; Copy #REGa into #REGd as a saved coordinate / value.
 $F21E ADD A,B       ; #REGa+=#REGb.
 $F21F LD D,A        ; Copy #REGa into #REGd as a saved coordinate / value.
 $F220 LD ($72FB),DE ; Store #REGde in Pointer: Camera Room Origin (#R$72FB).
 $F224 JR $F208      ; Jump to #R$F208 to continue the loop.
; Wrap the follow entity left by #N$A0 when the camera hits the right
; edge.
@label=Update_CameraFollow_WrapLeft
*$F226 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $F229 SUB $A0       ; #REGa-=#N$A0.
 $F22B LD (IX+$07),A ; Set the current entity's x-coordinate.
 $F22E JR $F248      ; Jump to #R$F248 to refresh the follow entity's x-extent.
; Scroll the camera origin left by #N$20 until the follow entity is
; centred.
@label=Update_CameraFollow_ScrollLeft
*$F230 LD A,E        ; Copy the saved low byte from #REGe into #REGa.
 $F231 CP $20        ; {Is #REGa equal to #N$20? If so, jump to #R$F240.
 $F233 JR Z,$F240    ; }
 $F235 SUB B         ; Subtract #REGb from #REGa.
 $F236 LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $F237 LD A,D        ; Copy #REGd into #REGa for later use.
 $F238 SUB B         ; Subtract #REGb from #REGa.
 $F239 LD D,A        ; Copy #REGa into #REGd as a saved coordinate / value.
 $F23A LD ($72FB),DE ; Store #REGde in Pointer: Camera Room Origin (#R$72FB).
 $F23E JR $F208      ; Jump to #R$F208 to continue the loop.
; Wrap the follow entity right by #N$A0 when the camera hits the left
; edge.
@label=Update_CameraFollow_WrapRight
*$F240 LD A,(IX+$07) ; Load #REGa with the current entity's x-coordinate.
 $F243 ADD A,$A0     ; #REGa+=#N$A0.
 $F245 LD (IX+$07),A ; Set the current entity's x-coordinate.
; Refresh the follow entity's X-extent after a wrap and keep probing.
@label=Update_CameraFollow_AdjustXExtent
*$F248 ADD A,$05     ; #REGa+=#N$05.
 $F24A LD (IX+$08),A ; Set the current entity's x-extent.
 $F24D JR $F208      ; Jump to #R$F208 to continue the loop.

; Script Routine: (#N$19) Continue To Next Instruction
;
; No-op handler: advance the script pointer and execute the next
; instruction.
@label=ScriptRoutine_ContinueToNextInstruction
c$F24F JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Clamp Camera Position
;
; Used by the routines at #R$B440 and #R$C443.
; .
; Clamp the camera position.
@label=Clamp_CameraPosition
c$F252 LD C,$00      ; Load #REGc with #N$00.
 $F254 PUSH HL       ; {Stash #REGhl and #REGde on the stack.
 $F255 PUSH DE       ; }
 $F256 LD HL,$90A9   ; Point #REGhl at the task-three helper entity (#R$90A9).
 $F259 JR $F266      ; Jump to #R$F266 to continue scanning.

; Adjust Camera X
;
; Used by the routines at #R$B440, #R$D153 and #R$D639.
; .
; Adjust the camera x-coordinate.
@label=Adjust_CameraX
c$F25B LD C,$01      ; Load #REGc with #N$01.
 $F25D JR $F261      ; Jump to #R$F261 to adjust Camera Common.

; Adjust Camera Y
;
; Used by the routines at #R$B440 and #R$D153.
; .
; Adjust the camera y-coordinate.
@label=Adjust_CameraY
c$F25F LD C,$00      ; Load #REGc with #N$00.
; This entry point is used by the routine at #R$F25B.
; .
; Shared camera adjust: scan entities backward from the weight-chain
; slot.
@label=Adjust_Camera_Common
*$F261 PUSH HL       ; {Stash #REGhl and #REGde on the stack.
 $F262 PUSH DE       ; }
 $F263 LD HL,$908D   ; Point #REGhl at the weight-chain entity (#R$908D).
; This entry point is used by the routine at #R$F252.
; .
; Walk entity records with stride $FFF2 looking for a camera blocker.
@label=Adjust_Camera_ScanEntities
*$F266 LD DE,$FFF2   ; Load #REGde with $FFF2.
; Stop with carry set when the entity-table terminator (#N$FF) is reached.
@label=Adjust_Camera_ScanLoop
*$F269 LD A,(HL)     ; Fetch this entity's type.
 $F26A CP $FF        ; {Is #REGa equal to #N$FF? If not, jump to #R$F272.
 $F26C JR NZ,$F272   ; }
 $F26E POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F26F POP HL        ; }
 $F270 SCF           ; Signal success.
 $F271 RET           ; Return.
; Test whether this solid, same-room entity overlaps the camera subject.
@label=Adjust_Camera_CheckEntity
*$F272 LD A,(HL)     ; Re-fetch this entity's type.
 $F273 OR A          ; {Is the next script byte zero? If so, jump to #R$F2BA.
 $F274 JR Z,$F2BA    ; }
 $F276 BIT 7,A       ; {Is bit #N$07 of #REGa set? If so, jump to #R$F2BA.
 $F278 JR NZ,$F2BA   ; }
 $F27A CP (IX+$00)   ; {Does #REGa match this entity's type? If so, jump to
 $F27D JR Z,$F2BA    ; #R$F2BA.}
 $F27F PUSH HL       ; Stash #REGhl on the stack.
 $F280 INC HL        ; Advance the camera-table pointer in #REGhl by one byte.
 $F281 LD A,(HL)     ; Fetch this entity's flags byte.
 $F282 AND %00000010 ; Keep only bit #N$01 of those flags.
 $F284 JR Z,$F2B9    ; If it was clear, skip this entity at #R$F2B9.
 $F286 BIT 5,(HL)    ; {Is bit #N$05 of the byte at #REGhl set? If so, jump to
 $F288 JR NZ,$F2B9   ; #R$F2B9.}
 $F28A INC HL        ; {Advance #REGhl past three entity fields onto the room
 $F28B INC HL        ; byte.
 $F28C INC HL        ; }
 $F28D LD A,(HL)     ; Fetch this entity's room.
 $F28E ADD A,C       ; #REGa+=#REGc.
 $F28F CP (IX+$04)   ; {Does #REGa match this entity's room? If not, jump to
 $F292 JR NZ,$F2B9   ; #R$F2B9.}
 $F294 INC HL        ; Advance the camera-table pointer in #REGhl by one byte.
 $F295 LD A,(IX+$06) ; Load #REGa with the current entity's y-extent.
 $F298 CP (HL)       ; {Is #REGa less than the byte at #REGhl? If so, jump to
 $F299 JR C,$F2B9    ; #R$F2B9.}
 $F29B INC HL        ; Advance the camera-table pointer in #REGhl by one byte.
 $F29C LD A,(HL)     ; Fetch the next script byte.
 $F29D CP (IX+$05)   ; {Is #REGa less than this entity's y-coordinate? If so, jump to
 $F2A0 JR C,$F2B9    ; #R$F2B9.}
 $F2A2 INC HL        ; Advance the camera-table pointer in #REGhl by one byte.
 $F2A3 LD A,(IX+$08) ; Load #REGa with the current entity's x-extent.
 $F2A6 CP (HL)       ; {Is #REGa less than the byte at #REGhl? If so, jump to
 $F2A7 JR C,$F2B9    ; #R$F2B9.}
 $F2A9 INC HL        ; Advance the camera-table pointer in #REGhl by one byte.
 $F2AA LD A,(HL)     ; Fetch the next script byte.
 $F2AB CP (IX+$07)   ; {Is #REGa less than this entity's x-coordinate? If so, jump to
 $F2AE JR C,$F2B9    ; #R$F2B9.}
 $F2B0 POP HL        ; Restore #REGhl from the stack.
 $F2B1 XOR A         ; Clear #REGa to #N$00.
 $F2B2 LD ($72AA),HL ; Store #REGhl in the last-collided entity pointer
                     ; (#R$72AA).
 $F2B5 LD A,(HL)     ; Fetch the next script byte.
 $F2B6 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F2B7 POP HL        ; }
 $F2B8 RET           ; Return.
; Skip a non-blocking camera entity and keep scanning.
@label=Adjust_Camera_SkipEntity
*$F2B9 POP HL        ; Restore #REGhl from the stack.
; Step to the previous entity record and continue the camera scan.
@label=Adjust_Camera_NextEntity
*$F2BA ADD HL,DE     ; #REGhl+=#REGde.
 $F2BB JR $F269      ; Jump to #R$F269 to continue the loop.

; Test Entity Overlap (Allow Special)
;
; Used by the routine at #R$B2AA.
; .
; Find a simple entity at #R$8B69 whose bounds overlap #REGix, allowing
; entities with bit #N$05 set. On a hit, clear the miss marker, store the
; entity pointer at #R$72AA and return its type in #REGa; on a miss, set carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityOverlap_AllowSpecial
c$F2BD LD BC,$0100   ; Load #REGbc with #N($0100,$04,$04) (allow bit #N($05), then same
                     ; room).
 $F2C0 JR $F2CA      ; Jump to #R$F2CA to scan with the allow-special mask.

; Test Entity Overlap
;
; Used by the routines at #R$B1E3, #R$B440 and #R$D153.
; .
; Find a simple entity at #R$8B69 whose bounds overlap #REGix, ignoring
; entities with bit #N$05 set. Used for trap offers, put-downs and falls. On a
; hit, clear carry and store the entity at #R$72AA; on a miss, set carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityOverlap
c$F2C2 LD BC,$0000   ; Load #REGbc with #N($0000,$04,$04) (reject bit #N($05), then same
                     ; room).
 $F2C5 JR $F2CA      ; Jump to #R$F2CA to scan with the standard mask.

; Test Entity Overlap At Depth
;
; Used by the routines at #R$B440, #R$C3DF, #R$D153 and #R$D65B.
; .
; As #R$F2C2, but match entities whose room is one deeper than #REGix
; (room−#N$01). Used when Berk moves forward into the next depth band.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityOverlap_AtDepth
c$F2C7 LD BC,$0001   ; Load #REGbc with #N($0001,$04,$04) (reject bit #N($05), then
                     ; room−#N$01).
; This entry point is used by the routines at #R$F2BD and #R$F2C2.
; .
; Walk the simple-entity table for a collidable overlap with #REGix.
@label=Test_EntityOverlap_Scan
*$F2CA PUSH HL       ; {Stash #REGhl and #REGde on the stack.
 $F2CB PUSH DE       ; }
 $F2CC LD DE,$000E   ; Each entity record is #N($000E,$04,$04) bytes, then load that into
                     ; #REGde.
 $F2CF LD HL,$8B69   ; Point #REGhl at the simple entity table (#R$8B69).
; Next simple-entity slot for the overlap test (or miss on #N$FF).
@label=Test_EntityOverlap_ScanSlot
*$F2D2 LD A,(HL)     ; {Fetch this entity's type. Is it the table terminator (#N$FF)? If
 $F2D3 CP $FF        ; not, test the slot at #R$F2DB.
 $F2D5 JR NZ,$F2DB   ; }
; Simple-entity scan miss: restore registers and return carry set.
 $F2D7 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F2D8 POP HL        ; }
 $F2D9 SCF           ; Signal a miss.
 $F2DA RET           ; Return.
; Reject empty/inactive/same-type slots; require collidable bit #N$00 (and
; optional bit #N$05).
@label=Test_EntityOverlap_CheckSlot
*$F2DB LD A,(HL)     ; {Re-fetch the type. Is the slot empty (type #N$00)? If so, skip to
 $F2DC OR A          ; #R$F327.
 $F2DD JR Z,$F327    ; }
 $F2DF BIT 7,A       ; {Is the high bit set (inactive)? If so, skip to #R$F327.
 $F2E1 JR NZ,$F327   ; }
 $F2E3 CP (IX+$00)   ; {Is it the same type as the subject? If so, skip to
 $F2E6 JR Z,$F327    ; #R$F327.}
 $F2E8 PUSH HL       ; Stash #REGhl on the stack.
 $F2E9 INC HL        ; Advance onto flags byte 1.
 $F2EA LD A,(HL)     ; Fetch flags byte 1.
 $F2EB AND %00000001 ; Keep only the collidable bit (bit #N$00).
 $F2ED JR Z,$F326    ; If it was clear, reject at #R$F326.
 $F2EF BIT 0,B       ; {Has the caller allowed bit-#N$05 entities (#REGb bit #N$00)? If so,
 $F2F1 JR NZ,$F2F7   ; skip the bit-#N$05 reject at #R$F2F7.}
 $F2F3 BIT 5,(HL)    ; {Is bit #N$05 set on this entity? If so, reject at
 $F2F5 JR NZ,$F326   ; #R$F326.}
; Require matching room (minus #REGc) and overlapping y/x extents with
; #REGix.
@label=Test_EntityOverlap_CheckBounds
*$F2F7 INC HL        ; {Advance #REGhl past the unused entity fields onto the
 $F2F8 INC HL        ; room byte.
 $F2F9 INC HL        ; }
 $F2FA LD A,(HL)     ; Fetch the entity's room.
 $F2FB SUB C         ; Subtract the caller's room bias in #REGc.
 $F2FC CP (IX+$04)   ; {Does it match the subject's room (#REGix+#N$04)? If not, jump to
 $F2FF JR NZ,$F326   ; #R$F326.}
 $F301 INC HL        ; Advance onto the entity's y-coordinate.
 $F302 LD A,(IX+$06) ; {Does the subject's y-extent (#REGix+#N$06) reach this candidate y?
 $F305 CP (HL)       ; If not, reject at #R$F326.
 $F306 JR C,$F326    ; }
 $F308 INC HL        ; Advance onto the entity's y-extent.
 $F309 LD A,(HL)     ; {Does this candidate y-extent reach the subject's y (#REGix+#N$05)?
 $F30A CP (IX+$05)   ; If not, reject at #R$F326.
 $F30D JR C,$F326    ; }
 $F30F INC HL        ; Advance onto the entity's x-coordinate.
 $F310 LD A,(IX+$08) ; {Does the subject's x-extent (#REGix+#N$08) reach this candidate x?
 $F313 CP (HL)       ; If not, reject at #R$F326.
 $F314 JR C,$F326    ; }
 $F316 INC HL        ; Advance onto the entity's x-extent.
 $F317 LD A,(HL)     ; {Does this candidate x-extent reach the subject's x (#REGix+#N$07)?
 $F318 CP (IX+$07)   ; If not, reject at #R$F326.
 $F31B JR C,$F326    ; }
; Hit: remember the entity and return its type with carry clear.
 $F31D POP HL        ; Restore #REGhl from the stack.
 $F31E XOR A         ; Clear #REGa / carry.
 $F31F LD ($72AA),HL ; Store the entity pointer at #R$72AA.
 $F322 LD A,(HL)     ; Fetch the entity's type into #REGa.
 $F323 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F324 POP HL        ; }
 $F325 RET           ; Return.
; Reject this overlap candidate and continue the simple-entity walk.
@label=Test_EntityOverlap_Reject
*$F326 POP HL        ; Restore #REGhl from the stack.
; Advance to the next simple-entity record in the overlap scan.
@label=Test_EntityOverlap_AdvanceSlot
*$F327 ADD HL,DE     ; Advance #REGhl by one entity record.
 $F328 JR $F2D2      ; Jump to #R$F2D2 to test the next simple entity.

; Test Entity On Left
;
; Used by the routines at #R$B87C, #R$D1BD, #R$D1E6 and #R$D61D.
; .
; Find a solid simple entity immediately to the left of #REGix (for a
; leftward step). On a hit, store it at #R$72AA and clear carry; on a miss, set
; carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityOnLeft
c$F32A LD C,$00      ; Load #REGc with #N$00 (same-room / left bias).
 $F32C JR $F330      ; Jump to #R$F330 to scan for a solid entity on the left.

; Test Entity On Right
;
; Used by the routines at #R$B7F3 and #R$C443.
; .
; Find a solid simple entity immediately to the right of #REGix (for a
; rightward step). On a hit, store it at #R$72AA and clear carry; on a miss, set
; carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityOnRight
c$F32E LD C,$01      ; Load #REGc with #N$01 (room−#N$01 / right bias).
; This entry point is used by the routine at #R$F32A.
; .
; Walk #R$8B69 for a solid (bit #N$02) entity abutting #REGix
; horizontally.
@label=Test_EntityHorizontal_Scan
*$F330 PUSH HL       ; {Stash #REGhl and #REGde on the stack.
 $F331 PUSH DE       ; }
 $F332 LD DE,$000E   ; Each entity record is #N($000E,$04,$04) bytes, then load that into
                     ; #REGde.
 $F335 LD HL,$8B69   ; Point #REGhl at the simple entity table (#R$8B69).
; Next simple-entity slot for the horizontal abut test (or miss on #N$FF).
@label=Test_EntityHorizontal_ScanSlot
*$F338 LD A,(HL)     ; {Fetch this entity's type. Is it the table terminator (#N$FF)? If
 $F339 CP $FF        ; not, test the slot at #R$F341.
 $F33B JR NZ,$F341   ; }
 $F33D POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F33E POP HL        ; }
 $F33F SCF           ; Signal a miss.
 $F340 RET           ; Return.
; Require a solid (bit #N$02) neighbour; skip room check for type #N$33.
@label=Test_EntityHorizontal_CheckSlot
*$F341 LD A,(HL)     ; {Re-fetch the type. Is the slot empty? If so, skip to
 $F342 OR A          ; #R$F38A.
 $F343 JR Z,$F38A    ; }
 $F345 BIT 7,A       ; {Is the high bit set (inactive)? If so, skip to #R$F38A.
 $F347 JR NZ,$F38A   ; }
 $F349 CP (IX+$00)   ; {Is it the same type as the subject? If so, skip to
 $F34C JR Z,$F38A    ; #R$F38A.}
 $F34E LD B,A        ; Keep the type in #REGb.
 $F34F PUSH HL       ; Stash #REGhl on the stack.
 $F350 INC HL        ; Advance onto flags byte 1.
 $F351 LD A,(HL)     ; Fetch the flags.
 $F352 AND %00000100 ; Keep only the solid/platform bit (bit #N$02).
 $F354 JR Z,$F389    ; If it was clear, reject at #R$F389.
 $F356 BIT 5,(HL)    ; {Is bit #N$05 set? If so, reject at #R$F389.
 $F358 JR NZ,$F389   ; }
 $F35A INC HL        ; {Advance past the room/y/y-extent fields onto the
 $F35B INC HL        ; room-check byte.
 $F35C INC HL        ; }
 $F35D LD A,B        ; {Keep the candidate type in #REGa. Is it type #N$33 (skip room
 $F35E CP $33        ; check)?.}
 $F360 JR Z,$F369    ; If so, take the bounds check at #R$F369.
 $F362 LD A,(HL)     ; {Fetch the entity's room. Subtract the caller's room bias in #REGc.
 $F363 SUB C         ; Does it match the subject's room? If not, reject at #R$F389.
 $F364 CP (IX+$04)   ;
 $F367 JR NZ,$F389   ; }
; Confirm vertical overlap and X-extent abutment with the subject.
@label=Test_EntityHorizontal_CheckBounds
*$F369 INC HL        ; Advance onto the entity's y-coordinate.
 $F36A LD A,(IX+$06) ; {Does the subject's y-extent (#REGix+#N$06) reach this candidate y?
 $F36D CP (HL)       ; If not, reject at #R$F389.
 $F36E JR C,$F389    ; }
 $F370 INC HL        ; Advance onto the entity's y-extent.
 $F371 LD A,(HL)     ; {Does this candidate y-extent reach the subject's y (#REGix+#N$05)?
 $F372 CP (IX+$05)   ; If not, reject at #R$F389.
 $F375 JR C,$F389    ; }
 $F377 INC HL        ; {Advance #REGhl past the x-coordinate onto the entity's
 $F378 INC HL        ; x-extent.}
 $F379 LD A,(IX+$07) ; Fetch the subject's x (#REGix+#N$07).
 $F37C DEC A         ; Step it left by one.
 $F37D CP (HL)       ; {Does it equal this entity's x-extent (abutting on the left/right)?
 $F37E JR NZ,$F389   ; If not, jump to #R$F389.}
; Horizontal neighbour hits: store the entity at #R$72AA and return its
; type.
 $F380 POP HL        ; Restore #REGhl from the stack.
 $F381 LD ($72AA),HL ; Store it at #R$72AA.
 $F384 XOR A         ; Clear carry.
 $F385 LD A,(HL)     ; Fetch the entity's type into #REGa.
 $F386 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F387 POP HL        ; }
 $F388 RET           ; Return.
; Reject this horizontal neighbour and continue the simple-entity walk.
@label=Test_EntityHorizontal_Reject
*$F389 POP HL        ; Restore #REGhl from the stack.
; Advance to the next simple-entity record in the horizontal scan.
@label=Test_EntityHorizontal_AdvanceSlot
*$F38A ADD HL,DE     ; Advance #REGhl by one entity record.
 $F38B JR $F338      ; Jump to #R$F338 to test the next horizontal neighbour.

; Test Entity Above
;
; Used by the routines at #R$B92C, #R$D1AC, #R$D1D5 and #R$D601.
; .
; Find a solid simple entity immediately above #REGix (for an upward
; step). On a hit, store it at #R$72AA and clear carry; on a miss, set carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityAbove
c$F38D LD C,$00      ; Load #REGc with #N$00 (same-room / up bias).
 $F38F JR $F393      ; Jump to #R$F393 to scan for a solid entity above.

; Test Entity Below
;
; Used by the routines at #R$B87C and #R$C443.
; .
; Find a solid simple entity immediately below #REGix (for a downward
; step). On a hit, store it at #R$72AA and clear carry; on a miss, set carry.
;
; IX Address of complex state data for the subject entity
@label=Test_EntityBelow
c$F391 LD C,$01      ; Load #REGc with #N$01 (room−#N$01 / down bias).
; This entry point is used by the routine at #R$F38D.
; .
; Walk #R$8B69 for a solid entity abutting #REGix vertically.
@label=Test_EntityVertical_Scan
*$F393 PUSH HL       ; {Stash #REGhl and #REGde on the stack.
 $F394 PUSH DE       ; }
 $F395 LD DE,$000E   ; Each entity record is #N($000E,$04,$04) bytes, then load that into
                     ; #REGde.
 $F398 LD HL,$8B69   ; Point #REGhl at the simple entity table (#R$8B69).
; Next simple-entity slot for the vertical abut test (or miss on #N$FF).
@label=Test_EntityVertical_ScanSlot
*$F39B LD A,(HL)     ; {Fetch this entity's type. Is it the table terminator (#N$FF)? If
 $F39C CP $FF        ; not, test the slot at #R$F3A4.
 $F39E JR NZ,$F3A4   ; }
 $F3A0 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F3A1 POP HL        ; }
 $F3A2 SCF           ; Signal a miss.
 $F3A3 RET           ; Return.
; Require a solid (bit #N$02) neighbour; skip room check for type #N$33.
@label=Test_EntityVertical_CheckSlot
*$F3A4 LD A,(HL)     ; {Re-fetch the type. Is the slot empty? If so, skip to
 $F3A5 OR A          ; #R$F3EC.
 $F3A6 JR Z,$F3EC    ; }
 $F3A8 BIT 7,A       ; {Is the high bit set (inactive)? If so, skip to #R$F3EC.
 $F3AA JR NZ,$F3EC   ; }
 $F3AC CP (IX+$00)   ; {Is it the same type as the subject? If so, skip to
 $F3AF JR Z,$F3EC    ; #R$F3EC.}
 $F3B1 LD B,A        ; Keep the type in #REGb.
 $F3B2 PUSH HL       ; Stash #REGhl on the stack.
 $F3B3 INC HL        ; Advance onto flags byte 1.
 $F3B4 LD A,(HL)     ; Fetch the flags.
 $F3B5 AND %00000100 ; Keep only the solid/platform bit (bit #N$02).
 $F3B7 JR Z,$F3EB    ; If it was clear, reject at #R$F3EB.
 $F3B9 BIT 5,(HL)    ; {Is bit #N$05 set? If so, reject at #R$F3EB.
 $F3BB JR NZ,$F3EB   ; }
 $F3BD INC HL        ; {Advance past the room/y/y-extent fields onto the
 $F3BE INC HL        ; room-check byte.
 $F3BF INC HL        ; }
 $F3C0 LD A,B        ; {Keep the candidate type in #REGa. Is it type #N$33 (skip room
 $F3C1 CP $33        ; check)?.}
 $F3C3 JR Z,$F3CC    ; If so, take the bounds check at #R$F3CC.
 $F3C5 LD A,(HL)     ; {Fetch the entity's room. Subtract the caller's room bias in #REGc.
 $F3C6 SUB C         ; Does it match the subject's room? If not, reject at #R$F3EB.
 $F3C7 CP (IX+$04)   ;
 $F3CA JR NZ,$F3EB   ; }
; Confirm horizontal overlap and Y abutment with the subject.
@label=Test_EntityVertical_CheckBounds
*$F3CC INC HL        ; Advance onto the entity's y-coordinate.
 $F3CD LD A,(IX+$06) ; {Does the subject's y-extent (#REGix+#N$06) reach this candidate y?
 $F3D0 CP (HL)       ; If not, reject at #R$F3EB.
 $F3D1 JR C,$F3EB    ; }
 $F3D3 INC HL        ; Advance onto the entity's y-extent.
 $F3D4 LD A,(HL)     ; {Does this candidate y-extent reach the subject's y (#REGix+#N$05)?
 $F3D5 CP (IX+$05)   ; If not, reject at #R$F3EB.
 $F3D8 JR C,$F3EB    ; }
 $F3DA INC HL        ; Advance onto the entity's x-coordinate.
 $F3DB LD A,(IX+$08) ; {Fetch the subject's x-extent (#REGix+#N$08). Step it right by one.
 $F3DE INC A         ; Does it equal this entity's x (abutting above/below)? If not, reject at
 $F3DF CP (HL)       ; #R$F3EB.
 $F3E0 JR NZ,$F3EB   ; }
; Vertical neighbour hits: store the entity at #R$72AA and return its
; type.
 $F3E2 POP HL        ; Restore #REGhl from the stack.
 $F3E3 LD ($72AA),HL ; Store it at #R$72AA.
 $F3E6 XOR A         ; Clear carry.
 $F3E7 LD A,(HL)     ; Fetch the entity's type into #REGa.
 $F3E8 POP DE        ; {Restore #REGde and #REGhl from the stack.
 $F3E9 POP HL        ; }
 $F3EA RET           ; Return.
; Reject this vertical neighbour and continue the simple-entity walk.
@label=Test_EntityVertical_Reject
*$F3EB POP HL        ; Restore #REGhl from the stack.
; Advance to the next simple-entity record in the vertical scan.
@label=Test_EntityVertical_AdvanceSlot
*$F3EC ADD HL,DE     ; Advance #REGhl by one entity record.
 $F3ED JR $F39B      ; Jump to #R$F39B to test the next vertical neighbour.

; Display And Handle Main Menu
;
; Used by the routine at #R$AAB3.
; .
; Draw the title logo, print the controls/score stream via #R$F46B (which
; resumes at #R$F51D). When CONTINUE returns, clear again, colour-cycle the
; logo, print #R$F407 ("CHOOSE to be / LEARNER BERK / SUPER BERK"), then
; continue on to #R$F43D.
;
; .
;
; #PUSHS #POKES$4000,$00,$1B00 #SIM(start=$F454,stop=$F46A)
; #SIM(start=$F6D6,stop=$F73F) #SIM(start=$F46B,stop=$F51D)
; #UDGTABLE { #SCR$02,$00,$00,$20,$18(main-menu) } UDGTABLE# #POPS
; .
; First pass: logo + controls menu (returns via #R$F51D / CONTINUE).
@label=MainMenu
c$F3EF CALL $F454    ; Call #R$F454 to clear the menu attribute block.
 $F3F2 CALL $F6D6    ; Call #R$F6D6 to draw the main-menu logo.
 $F3F5 CALL $F46B    ; Call #R$F46B to print the controls/score stream and
                     ; handle options.
; Second pass (after CONTINUE): refresh, colour-cycle, print the
; Learner/Super chooser.
@label=MainMenu_ChoosePass
 $F3F8 CALL $F454    ; Call #R$F454 to clear the menu attribute block again.
 $F3FB CALL $F70A    ; Call #R$F70A to colour-cycle the logo.
 $F3FE LD HL,$3C00   ; {Point #REGhl at #SKOOLKID$3D00(CHARSET)-#N$0100, then store it as
 $F401 LD ($72F9),HL ; the current character set.}
 $F404 CALL $AD6F    ; Call #R$AD6F to print the inline chooser stream at
                     ; #R$F407.
; Continue on to #R$F43D.

; Messaging: Main Menu
;
; Menu printer stream for #R$AD6F. Fragment headers are three bytes
; (address low/high, attribute); #CHR$26 starts a new positioned fragment, and
; #CHR$5D terminates the stream. Renders as "CHOOSE to be / LEARNER BERK / SUPER
; BERK".
@label=Messaging_MainMenu
t$F407 DEFB $AA            ; Attribute-file address low byte (#N$AA).
 $F408 DEFB $58            ; Attribute-file address high byte (#N$58).
 $F409 DEFB $47            ; Text attribute (#N$47).
 $F40A DEFM "CHOOSE to be" ; "#STR(#PC,$04,$0C)".
 $F416 DEFB $26            ; Join marker (#CHR$26).
 $F417 DEFB $4A            ; Attribute-file address low byte (#N$4A).
 $F418 DEFB $59            ; Attribute-file address high byte (#N$59).
 $F419 DEFB $7A            ; Text attribute (#N$7A).
 $F41A DEFM "L"            ; "#STR(#PC,$04,$01)".
 $F41B DEFB $26            ; Join marker (#CHR$26).
 $F41C DEFB $4B            ; Attribute-file address low byte (#N$4B).
 $F41D DEFB $59            ; Attribute-file address high byte (#N$59).
 $F41E DEFB $47            ; Text attribute (#N$47).
 $F41F DEFM "EARNER BERK"  ; "#STR(#PC,$04,$0B)".
 $F42A DEFB $26            ; Join marker (#CHR$26).
 $F42B DEFB $AB            ; Attribute-file address low byte (#N$AB).
 $F42C DEFB $59            ; Attribute-file address high byte (#N$59).
 $F42D DEFB $78            ; Text attribute (#N$78).
 $F42E DEFM "S"            ; "#STR(#PC,$04,$01)".
 $F42F DEFB $26            ; Join marker (#CHR$26).
 $F430 DEFB $AC            ; Attribute-file address low byte (#N$AC).
 $F431 DEFB $59            ; Attribute-file address high byte (#N$59).
 $F432 DEFB $47            ; Text attribute (#N$47).
 $F433 DEFM "UPER BERK"    ; "#STR(#PC,$04,$09)".
 $F43C DEFB $5D            ; Terminator (#CHR$5D).

; Main Menu: Choose Learner Or Super Berk
;
; Wait for #CHR$53 (Super Berk, flag #N$00) or #CHR$4C (Learner Berk,
; flag #N$01) and store the choice at #R$72A9.
;
; .
;
; Default to Super Berk (flag clear), then sample the keyboard.
@label=MainMenu_ChooseLearnerOrSuper
c$F43D XOR A         ; Clear #REGa ready to select Super Berk.
 $F43E LD ($72A9),A  ; Write #N$00 to the Learner Berk mode flag.
; Wait for S (Super Berk) or L (Learner Berk) and store the choice in
; #R$72A9.
@label=MainMenu_ChooseLearnerOrSuper_KeyWait
*$F441 CALL $FC78    ; Call #R$FC78 for one menu-music wait tick.
 $F444 CALL $F640    ; Call #R$F640 to read a key code.
 $F447 CP $53        ; {Was #CHR$53 pressed? If so, keep Super Berk (flag
 $F449 RET Z         ; #N$00) and return.}
 $F44A CP $4C        ; {Was #CHR$4C pressed? If not, keep waiting at #R$F441.
 $F44C JR NZ,$F441   ; }
 $F44E LD A,$01      ; Load #N$01 for Learner Berk.
 $F450 LD ($72A9),A  ; Write it to the Learner Berk mode flag.
 $F453 RET           ; Return.

; Draw Menu Background
;
; Used by the routine at #R$F3EF.
; .
; Black out the whole attribute file, then clear a #N$0E×#N$18 character
; window starting at #N$5809 (attribute buffer) for the main-menu / controls
; layout.
;
; .
;
; Fill the attribute file, then clear the menu window.
@label=Draw_MenuBackground
c$F454 XOR A         ; {Clear #REGa (black ink/paper), then call #R$EA6D to fill the
 $F455 CALL $EA6D    ; attribute file.}
 $F458 LD HL,$5809   ; Point #REGhl at the menu window top-left
                     ; (#N$5809 (attribute buffer)).
 $F45B LD DE,$0012   ; Load #REGde with the per-row skip (#N($0012,$04,$04)
                     ; bytes).
 $F45E LD C,$18      ; Load #REGc with #N$18 row counter.
; Clear one attribute row of the #N$0E×#N$18 menu window.
@label=Draw_MenuBackground_RowLoop
*$F460 LD B,$0E      ; Load #REGb with #N$0E column counter.
; Black out one attribute cell inside the menu window.
@label=Draw_MenuBackground_ColLoop
*$F462 LD (HL),A     ; {Write black at #REGhl. Advance one character. Loop
 $F463 INC HL        ; across the row.
 $F464 DJNZ $F462    ; }
 $F466 ADD HL,DE     ; Step #REGhl by the row skip in #REGde.
 $F467 DEC C         ; Decrease the row counter.
 $F468 JR NZ,$F460   ; Jump to #R$F460 if more rows remain.
 $F46A RET           ; Return.

; Print Controls Menu
;
; Used by the routine at #R$F3EF.
; .
; Point the character set at #SKOOLKID$3D00(CHARSET)-#N$0100 and call
; #R$AD6F. The controls + score printer stream is inline at
; #R$F474–#R$F51C (ends with #CHR$5D) #R$AD6F resumes at #R$F51D.
@label=Print_ControlsMenu
c$F46B LD HL,$3C00   ; {Point #REGhl at #SKOOLKID$3D00(CHARSET)-#N$0100, then store it as
 $F46E LD ($72F9),HL ; the current character set.}
 $F471 CALL $AD6F    ; Call #R$AD6F to print the inline stream at #R$F474 (returns to
                     ; #R$F51D).

; Messaging: Controls Menu
;
; Controls / redefine-keys printer stream for #R$AD6F. Fragment headers
; are three bytes (attribute-file address low/high, then attribute); #CHR$26
; starts the next fragment. Options: KEYS, JOYSTICK, REDEFINE, CONTINUE;
; directions RIGHT / LEFT / DOWN / UP; actions DROP / TIP / HOLD. Score stream
; continues at #R$F4F8.
@label=Messaging_ControlsMenu
t$F474 DEFB $0B          ; Attribute-file address low byte (#N$0B).
 $F475 DEFB $58          ; Attribute-file address high byte (#N$58).
 $F476 DEFB $70          ; Text attribute (#N$70).
 $F477 DEFM "K KEYS    " ; "#STR(#PC,$04,$0A)".
 $F481 DEFB $26          ; Join marker (#CHR$26).
 $F482 DEFB $4B          ; Attribute-file address low byte (#N$4B).
 $F483 DEFB $58          ; Attribute-file address high byte (#N$58).
 $F484 DEFB $70          ; Text attribute (#N$70).
 $F485 DEFM "J JOYSTICK" ; "#STR(#PC,$04,$0A)".
 $F48F DEFB $26          ; Join marker (#CHR$26).
 $F490 DEFB $8B          ; Attribute-file address low byte (#N$8B).
 $F491 DEFB $58          ; Attribute-file address high byte (#N$58).
 $F492 DEFB $70          ; Text attribute (#N$70).
 $F493 DEFM "R REDEFINE" ; "#STR(#PC,$04,$0A)".
 $F49D DEFB $26          ; Join marker (#CHR$26).
 $F49E DEFB $CB          ; Attribute-file address low byte (#N$CB).
 $F49F DEFB $58          ; Attribute-file address high byte (#N$58).
 $F4A0 DEFB $70          ; Text attribute (#N$70).
 $F4A1 DEFM "C CONTINUE" ; "#STR(#PC,$04,$0A)".
 $F4AB DEFB $26          ; Join marker (#CHR$26).
 $F4AC DEFB $0D          ; Attribute-file address low byte (#N$0D).
 $F4AD DEFB $59          ; Attribute-file address high byte (#N$59).
 $F4AE DEFB $70          ; Text attribute (#N$70).
 $F4AF DEFM " RIGHT "    ; "#STR(#PC,$04,$07)".
 $F4B6 DEFB $26          ; Join marker (#CHR$26).
 $F4B7 DEFB $4D          ; Attribute-file address low byte (#N$4D).
 $F4B8 DEFB $59          ; Attribute-file address high byte (#N$59).
 $F4B9 DEFB $70          ; Text attribute (#N$70).
 $F4BA DEFM " LEFT  "    ; "#STR(#PC,$04,$07)".
 $F4C1 DEFB $26          ; Join marker (#CHR$26).
 $F4C2 DEFB $8D          ; Attribute-file address low byte (#N$8D).
 $F4C3 DEFB $59          ; Attribute-file address high byte (#N$59).
 $F4C4 DEFB $70          ; Text attribute (#N$70).
 $F4C5 DEFM " DOWN  "    ; "#STR(#PC,$04,$07)".
 $F4CC DEFB $26          ; Join marker (#CHR$26).
 $F4CD DEFB $CD          ; Attribute-file address low byte (#N$CD).
 $F4CE DEFB $59          ; Attribute-file address high byte (#N$59).
 $F4CF DEFB $70          ; Text attribute (#N$70).
 $F4D0 DEFM "  UP   "    ; "#STR(#PC,$04,$07)".
 $F4D7 DEFB $26          ; Join marker (#CHR$26).
 $F4D8 DEFB $0D          ; Attribute-file address low byte (#N$0D).
 $F4D9 DEFB $5A          ; Attribute-file address high byte (#N$5A).
 $F4DA DEFB $70          ; Text attribute (#N$70).
 $F4DB DEFM " DROP  "    ; "#STR(#PC,$04,$07)".
 $F4E2 DEFB $26          ; Join marker (#CHR$26).
 $F4E3 DEFB $4D          ; Attribute-file address low byte (#N$4D).
 $F4E4 DEFB $5A          ; Attribute-file address high byte (#N$5A).
 $F4E5 DEFB $70          ; Text attribute (#N$70).
 $F4E6 DEFM "  TIP  "    ; "#STR(#PC,$04,$07)".
 $F4ED DEFB $26          ; Join marker (#CHR$26).
 $F4EE DEFB $8D          ; Attribute-file address low byte (#N$8D).
 $F4EF DEFB $5A          ; Attribute-file address high byte (#N$5A).
 $F4F0 DEFB $70          ; Text attribute (#N$70).
 $F4F1 DEFM " HOLD  "    ; "#STR(#PC,$04,$07)".

; Messaging: Score / HiScore
;
; Score / Hi-score printer stream. Opens with #CHR$26 joining from the
; controls stream (at #R$F4F8), then SCORE / HiSCORE fragments; ends with
; #CHR$5D.
@label=Messaging_ScoreHiScore
t$F4F8 DEFB $26              ; Join marker (#CHR$26).
 $F4F9 DEFB $C9              ; Attribute-file address low byte (#N$C9).
 $F4FA DEFB $5A              ; Attribute-file address high byte (#N$5A).
 $F4FB DEFB $47              ; Text attribute (#N$47).
 $F4FC DEFM "SCORE      000" ; "#STR(#PC,$04,$0E)".
 $F50A DEFB $26              ; Join marker (#CHR$26).
 $F50B DEFB $E9              ; Attribute-file address low byte (#N$E9).
 $F50C DEFB $5A              ; Attribute-file address high byte (#N$5A).
 $F50D DEFB $47              ; Text attribute (#N$47).
 $F50E DEFM "HiSCORE    000" ; "#STR(#PC,$04,$0E)".
 $F51C DEFB $5D              ; Terminator (#CHR$5D).

; Main Menu Select Options
;
; Handle KEYS / JOYSTICK / REDEFINE / CONTINUE on the controls menu.
; Returns to the caller of #R$F46B (the Learner/Super pass at #R$F3F8) when
; CONTINUE (#CHR$43) is chosen.
;
; .
;
; If keyboard mode is selected, highlight the KEYS option first.
@label=MainMenu_SelectOptions
c$F51D LD A,($F602)  ; {If Kempston is already selected (#R$F602), skip the KEYS highlight
 $F520 OR A          ; at #R$F52B.
 $F521 JR NZ,$F52B   ; }
 $F523 LD A,$68      ; {Highlight the KEYS option (#N$68) and pulse the menu
 $F525 CALL $F5CA    ; timing.
 $F528 CALL $F5EA    ; }
; Poll the controls menu for KEYS, JOYSTICK, REDEFINE or CONTINUE.
@label=MainMenu_SelectOptions_KeyLoop
*$F52B CALL $FC78    ; Call #R$FC78 for one menu-music wait tick.
 $F52E CALL $F640    ; Call #R$F640 to read a key code.
 $F531 CP $4B        ; {Was #CHR$4B (KEYS) pressed? If so, select keyboard at
 $F533 JR Z,$F542    ; #R$F542.}
 $F535 CP $4A        ; {Was #CHR$4A (JOYSTICK) pressed? If so, select Kempston
 $F537 JR Z,$F548    ; at #R$F548.}
 $F539 CP $52        ; {Was #CHR$52 (REDEFINE) pressed? If so, redefine keys at
 $F53B JR Z,$F553    ; #R$F553.}
 $F53D CP $43        ; {Was #CHR$43 (CONTINUE) pressed? If so, return to
 $F53F RET Z         ; #R$F3F8.}
 $F540 JR $F52B      ; Jump to #R$F52B to keep waiting.
; Select keyboard controls and refresh the highlights.
@label=MainMenu_SelectOptions_Keys
*$F542 XOR A         ; {Select keyboard controls (clear #R$F602) and refresh the menu
 $F543 LD ($F602),A  ; highlights at #R$F5B5.
 $F546 JR $F5B5      ; }
; Select Kempston and click the menu.
@label=MainMenu_SelectOptions_Joystick
*$F548 LD A,$01      ; {Select Kempston (#N$01 at #R$F602) and clear the KEYS
 $F54A LD ($F602),A  ; column labels.
 $F54D XOR A         ;
 $F54E CALL $F5C5    ;
 $F551 JR $F52B      ; }
; Clear the key table to #CHR$3F, prompt for seven new keys, and print
; each choice.
@label=MainMenu_SelectOptions_Redefine
*$F553 XOR A         ; {Select keyboard mode (clear #R$F602) before redefine.
 $F554 LD ($F602),A  ; }
 $F557 LD A,$3F      ; {Fill all seven control-key slots at #R$F5FB with #CHR$3F
 $F559 LD HL,$F5FB   ; placeholders.
 $F55C LD B,$07      ; }
; Fill the seven control-key slots at #R$F5FB with #CHR$3F placeholders.
@label=MainMenu_SelectOptions_ClearKeys
*$F55E LD (HL),A     ; {Write the placeholder into this slot and step #REGhl onto the next
 $F55F INC HL        ; key slot until all seven are cleared.
 $F560 DJNZ $F55E    ; }
 $F562 LD A,$C7      ; {Print the redefine placeholders in attribute #N$C7 and pulse the
 $F564 CALL $F5CA    ; menu timing.
 $F567 CALL $F5EA    ; }
 $F56A LD A,$4F      ; {Set the text attribute to #N$4F for newly typed key
 $F56C LD ($7307),A  ; labels.}
 $F56F LD IX,$F5FB   ; Point #REGix at #R$F5FB.
 $F573 LD HL,$590C   ; {Point #REGhl at the first key's attribute cell
 $F576 LD ($F5F9),HL ; (#N$590C (attribute buffer)), then remember it in #R$F5F9.
                     ; }
 $F579 LD B,$07      ; Load #REGb with #N$07 keys to redefine.
; Prompt for the next of seven redefine-key presses.
@label=MainMenu_SelectOptions_RedefineLoop
*$F57B PUSH BC       ; Stash #REGbc and #REGix on the stack.
; Wait until a fresh key is pressed during redefine.
@label=MainMenu_SelectOptions_WaitUniqueKey
*$F57C PUSH IX       ;
 $F57E CALL $FC78    ; Call #R$FC78 for one menu-music wait tick.
 $F581 POP IX        ; Restore #REGix from the stack.
 $F583 CALL $F640    ; Call #R$F640 to read a key code.
 $F586 OR A          ; {Was a key pressed? If not, keep waiting at #R$F57C.
 $F587 JR Z,$F57C    ; }
 $F589 LD HL,$F5FB   ; Point #REGhl at #R$F5FB.
 $F58C LD B,$07      ; Load #REGb with #N$07 to scan for duplicates.
; Reject the key if it already appears in #R$F5FB; otherwise store and
; print it.
@label=MainMenu_SelectOptions_CheckDuplicate
*$F58E CP (HL)       ; {Does this code already appear in the table? If so, reject it and
 $F58F JR Z,$F57C    ; wait again at #R$F57C.}
 $F591 INC HL        ; Advance to the next slot.
 $F592 DJNZ $F58E    ; Loop until all slots are checked.
 $F594 LD (IX+$00),A ; Store the new key code at #REGix.
 $F597 INC IX        ; Advance #REGix onto the next slot.
 $F599 PUSH IX       ; {Stash #REGix and #REGaf on the stack.
 $F59B PUSH AF       ; }
 $F59C CALL $F70A    ; Call #R$F70A to colour-cycle the logo (menu
                     ; acknowledge).
 $F59F POP AF        ; {Restore #REGaf and #REGix from the stack.
 $F5A0 POP IX        ; }
 $F5A2 LD HL,($F5F9) ; {Fetch the current label attribute address (#R$F5F9). Keep the key
 $F5A5 LD E,A        ; code in #REGe. Clear #REGd. Call #R$EB67 to print that character.
 $F5A6 LD D,$00      ;
 $F5A8 CALL $EB67    ; }
 $F5AB LD BC,$0040   ; {Advance the key-label attribute address by one menu row
 $F5AE ADD HL,BC     ; (#N($0040,$04,$04)) and store it in #R$F5F9.
 $F5AF LD ($F5F9),HL ; }
 $F5B2 POP BC        ; Restore #REGbc from the stack.
 $F5B3 DJNZ $F57B    ; Loop until all seven keys are redefined.
; Refresh both highlight attributes and return to the key loop.
@label=MainMenu_SelectOptions_Refresh
*$F5B5 LD A,$C7      ; {Reprint all seven key labels in attribute #N$C7.
 $F5B7 CALL $F5CA    ; }
 $F5BA LD A,$68      ; {Reprint the KEYS column highlight in attribute #N$68.
 $F5BC CALL $F5CA    ; }
 $F5BF CALL $F5EA    ; Call #R$F5EA to pulse the menu timing.
 $F5C2 JP $F52B      ; Jump to #R$F52B to wait for the next KEYS / JOYSTICK / REDEFINE /
                     ; CONTINUE choice.

; Print Control Key Labels (Short)
;
; Used by the routine at #R$F51D.
; .
; Entry that reprints the first #N$05 control-key labels using attribute
; #REGa (used when JOYSTICK is chosen to clear the KEYS column). Jumps into
; #R$F5CA at #R$F5CC with a five-label count.
@label=Print_ControlKeyLabels_Short
c$F5C5 LD B,$05      ; Load #REGb with #N$05 label count.
 $F5C7 XOR A         ; Clear #REGa (blank / black attribute).
 $F5C8 JR $F5CC      ; Jump to #R$F5CC to print with a blank attribute and five
                     ; labels.

; Print Control Key Labels
;
; Used by the routine at #R$F51D.
; .
; Print the control-key characters from #R$F5FB into the menu column at
; #N$590C (attribute buffer) using attribute #REGa. #REGb holds how many slots
; to print (#N$07 for a full refresh, #N$05 via #R$F5C5).
;
; A Attribute value for the labels
@label=Print_ControlKeyLabels
c$F5CA LD B,$07      ; Load #REGb with #N$07 label count.
; This entry point is used by the routine at #R$F5C5.
; .
; Walk #R$F5FB and print each defined key code.
@label=Print_ControlKeyLabels_WalkTable
*$F5CC LD ($7307),A  ; Store #REGa as the current text attribute.
 $F5CF LD HL,$590C   ; Point #REGhl at the first key's attribute cell
                     ; (#N$590C (attribute buffer)).
 $F5D2 LD IX,$F5FB   ; Point #REGix at #R$F5FB.
; Print one control-key label and step down one menu row.
@label=Print_ControlKeyLabels_NextKey
*$F5D6 LD E,(IX+$00) ; {Fetch this slot's key code into #REGe. Clear #REGd. Call #R$EB67 to
 $F5D9 LD D,$00      ; print that character.
 $F5DB CALL $EB67    ; }
 $F5DE INC IX        ; Advance #REGix onto the next slot.
 $F5E0 LD DE,$0040   ; {Step #REGhl down one menu key-label row
 $F5E3 ADD HL,DE     ; (#N($0040,$04,$04)).}
 $F5E4 DJNZ $F5D6    ; Loop until #REGb labels are printed.
 $F5E6 CALL $F70A    ; Call #R$F70A to colour-cycle the logo (menu
                     ; acknowledge).
 $F5E9 RET           ; Return.

; Pulse Menu Timing
;
; Used by the routine at #R$F51D.
; .
; Pulse the menu by briefly inverting the key-scan wait at #R$FC80
; The normal opcode there is #HTML(<code>JR Z</code>) (#N$28), which loops
; at #R$FC79 while #SKOOLKID$028E(KEY_SCAN) reports no key; writing
; #HTML(<code>JR NZ</code>) (#N$20) inverts that sense for one #R$FC78 tick so
; the highlight flashes, then #N$28 is restored.
;
; .
;
; Patch #R$FC80 to #HTML(<code>JR NZ</code>), wait one tick, then restore
; #HTML(<code>JR Z</code>).
@label=Pulse_MenuTiming
c$F5EA LD A,$20      ; {Write #N$20 (#HTML(<code>JR NZ</code>)) over the opcode
 $F5EC LD ($FC80),A  ; at #R$FC80.}
 $F5EF CALL $FC78    ; Call #R$FC78 for one inverted wait tick.
 $F5F2 LD A,$28      ; {Write #N$28 (#HTML(<code>JR Z</code>)) back to #R$FC80.
 $F5F4 LD ($FC80),A  ; }
 $F5F7 RET           ; Return.

; Control Input Bitmap
;
; Player control bits, written by #R$F603.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Right }
; { #N$01 | Left }
; { #N$02 | Down (forward) }
; { #N$03 | Up (back) }
; { #N$04 | Fire (pick up / put down / interact) }
; { #N$05 | Secondary fire / alternate action (keyboard #CHR$54 by default) }
; { #N$06 | Pause (keyboard #CHR$48 by default; special-cased in #R$F603) }
; { #N$07 | Unused }
; TABLE#
@label=ControlInputBitmap
g$F5F8 DEFB $00

; Pointer: Control Key Definition Cursor
;
; Pointer into #R$F5FB used while redefine-keys walks the control table.
@label=Pointer_ControlKeyDefinitionCursor
g$F5F9 DEFW $0000

; Table: Control Key Codes
;
; Default key codes for bits #N$00–#N$06 of #R$F5F8
; (#CHR$58, #CHR$5A, #CHR$41, #CHR$51, #CHR$43, #CHR$54, #CHR$48).
@label=Table_ControlKeyCodes
b$F5FB DEFB $58,$5A,$41,$51,$43,$54,$48

; Flag: Kempston Joystick Enabled
;
; Non-zero to read Kempston (#N$1F) in #R$F603; zero to use the keyboard
; table at #R$F5FB.
@label=Flag_KempstonJoystickEnabled
g$F602 DEFB $00

; Read Player Controls
;
; Used by the routine at #R$AAB3.
; .
; Sample Kempston (#N$1F) or the keyboard table at #R$F5FB into the
; control input bitmap. Pause (#CHR$48 / bit #N$06) waits for the key
; to be released and pressed again before returning.
;
; .
;
; Clear the bitmap, then try Kempston if enabled.
@label=Read_PlayerControls
c$F603 XOR A         ; {Clear #REGa, then clear the control input bitmap.
 $F604 LD ($F5F8),A  ; }
 $F607 LD A,($F602)  ; {Fetch the Kempston-enabled flag. Is Kempston selected? If not, read
 $F60A OR A          ; the keyboard at #R$F613.
 $F60B JR Z,$F613    ; }
 $F60D IN A,($1F)    ; Read Kempston port #N$1F.
 $F60F AND %00011111 ; Keep bits #N$00–#N$04.
 $F611 JR NZ,$F62F   ; If any direction/fire is pressed, store it at #R$F62F.
; Match the pressed key against #R$F5FB and set the corresponding bit.
@label=Read_PlayerControls_Keyboard
*$F613 CALL $F640    ; Call #R$F640 to read a key code.
 $F616 OR A          ; {Was a key pressed? If not, return with the bitmap
 $F617 RET Z         ; clear.}
 $F618 LD E,$01      ; Start the bit mask at #N$01 (bit #N$00 = Right).
 $F61A LD B,$07      ; Load #REGb with #N$07 table entries.
 $F61C LD HL,$F5FB   ; Point #REGhl at #R$F5FB.
; Scan #R$F5FB for the pressed key and build the matching bit of #R$F5F8.
@label=Read_PlayerControls_ScanTable
*$F61F CP (HL)       ; {Does this table slot match the pressed key? If so, handle it at
 $F620 JR Z,$F62A    ; #R$F62A.}
 $F622 INC HL        ; Advance to the next slot.
 $F623 SLA E         ; Shift the bit mask left by one.
 $F625 DJNZ $F61F    ; Loop until the table is exhausted.
 $F627 XOR A         ; {Clear #REGa (unrecognised key), then store a clear bitmap at
 $F628 JR $F62F      ; #R$F62F.}
; Matched a control key: handle pause specially, otherwise write the
; bitmap.
@label=Read_PlayerControls_Matched
*$F62A LD A,E        ; Keep the matched bit mask in #REGa.
 $F62B BIT 6,A       ; {Is it the pause key (bit #N$06)? If so, debounce pause
 $F62D JR NZ,$F633   ; at #R$F633.}
; Store the assembled control bits into #R$F5F8.
@label=Read_PlayerControls_WriteBitmap
*$F62F LD ($F5F8),A  ; Write the control input bitmap to #R$F5F8.
 $F632 RET           ; Return.
; Wait for pause to be released, then for any key to resume.
@label=Read_PlayerControls_PauseRelease
*$F633 CALL $F640    ; {Call #R$F640. Is a key still held? If so, keep waiting
 $F636 OR A          ; at #R$F633.
 $F637 JR NZ,$F633   ; }
; After pause release, wait for any key before resuming play.
@label=Read_PlayerControls_PauseResume
*$F639 CALL $F640    ; {Call #R$F640. Has a key been pressed to resume? If not, keep waiting
 $F63C OR A          ; at #R$F639.
 $F63D JR Z,$F639    ; }
 $F63F RET           ; Return.

; Read Keyboard Controls
;
; Used by the routines at #R$F43D, #R$F51D and #R$F603.
; .
; Scan the keyboard half-rows via #R$F67E and return the matching ASCII
; key code in #REGa, or #N$00 if nothing is pressed.
;
; .
;
; Probe port #N$FEFE first (caps/shift row with bit #N$00 forced).
@label=Read_KeyboardControls
c$F640 LD BC,$FEFE   ; Load #REGbc with keyboard port #N$FEFE.
 $F643 LD HL,$F67E   ; Point #REGhl at #R$F67E.
 $F646 IN A,(C)      ; Read the half-row.
 $F648 SET 0,A       ; Force bit #N$00 set (ignore caps-shift alone).
 $F64A AND %00011111 ; Keep the five key bits.
 $F64C XOR %00011111 ; Invert so pressed keys are set.
 $F64E JR NZ,$F675   ; If any are pressed, decode at #R$F675.
 $F650 LD DE,$0005   ; {Load #REGde with #N($0005,$04,$04), then advance #REGhl onto the
 $F653 ADD HL,DE     ; next half-row's key codes.}
 $F654 LD E,$06      ; Load #REGe with #N$06 remaining half-rows.
; Scan the remaining keyboard half-rows for a pressed key.
@label=Read_KeyboardControls_HalfRowLoop
*$F656 RLC B         ; Rotate the port select in #REGb left (next half-row).
 $F658 IN A,(C)      ; Read that half-row.
 $F65A AND %00011111 ; Keep the five key bits.
 $F65C XOR %00011111 ; Invert so pressed keys are set.
 $F65E JR NZ,$F675   ; If any are pressed, decode at #R$F675.
 $F660 INC HL        ; {Advance #REGhl onto the next half-row's key codes.
 $F661 INC HL        ;
 $F662 INC HL        ;
 $F663 INC HL        ;
 $F664 INC HL        ; }
 $F665 DEC E         ; Decrease the half-row counter.
 $F666 JR NZ,$F656   ; Loop at #R$F656 if more half-rows remain.
; Final half-row: force bit #N$01 set before testing.
 $F668 RLC B         ; Rotate onto the last half-row port.
 $F66A IN A,(C)      ; Read it.
 $F66C SET 1,A       ; Force bit #N$01 set.
 $F66E AND %00011111 ; Keep / invert the key bits.
 $F670 XOR %00011111 ; Invert so pressed keys are set.
 $F672 JR NZ,$F675   ; If any are pressed, decode at #R$F675.
 $F674 RET           ; Return with #REGa = #N$00 (no key).
; Shift through the pressed-bit positions to pick the ASCII code at
; #REGhl.
@label=Read_KeyboardControls_Decode
*$F675 SRL A         ; {Shift the pressed-bit mask right, then if that key is pressed, take
 $F677 JR C,$F67C    ; its code at #R$F67C.}
 $F679 INC HL        ; Advance #REGhl onto the next key's code.
 $F67A JR $F675      ; Jump to #R$F675 to keep decoding.
; Return the ASCII code for the pressed bit position from the port map.
@label=Read_KeyboardControls_Found
*$F67C LD A,(HL)     ; Fetch the ASCII key code at #REGhl.
 $F67D RET           ; Return.

; Table: Keyboard Port Map
@label=Table_KeyboardPortMap
b$F67E DEFB $63,$5A,$58,$43,$56,$41,$53,$44
 $F686 DEFB $46,$47,$51,$57,$45,$52,$54,$31
 $F68E DEFB $32,$33,$34,$35,$30,$39,$38,$37
 $F696 DEFB $36,$50,$4F,$49,$55,$59,$65,$4C
 $F69E DEFB $4B,$4A,$48,$20,$79,$4D,$4E,$42

; Update High Score Display
;
; Used by the routine at #R$AAAB.
; .
; Print the current score into the menu score stream at #R$F4F8(#N$F504),
; and if it beats the high score at #R$72F3 update that too (printed at
; #R$F4F8(#N$F516)).
;
; .
;
; Print score; promote it to high score when larger.
@label=Update_HighScoreDisplay
c$F6A6 LD IX,$F504   ; Point #REGix at #R$F4F8(#N$F504).
 $F6AA LD HL,($72DD) ; Fetch the current score.
; Keep the current score while the high-score digits are printed.
 $F6AD PUSH HL       ; Stash #REGhl on the stack.
 $F6AE CALL $EB20    ; Call #R$EB20 to print the score digits.
 $F6B1 POP HL        ; Restore #REGhl from the stack.
 $F6B2 LD DE,($72F3) ; {Fetch the high score. Clear the success marker. Is the
 $F6B6 AND A         ; current score below the high score? If so, return.
 $F6B7 SBC HL,DE     ;
 $F6B9 RET C         ; }
 $F6BA ADD HL,DE     ; Restore the current score (add back the high score).
 $F6BB LD ($72F3),HL ; Store it as the new high score.
 $F6BE LD IX,$F516   ; Point #REGix at #R$F4F8(#N$F516).
 $F6C2 CALL $EB20    ; Call #R$EB20 to print the high-score digits.
 $F6C5 RET           ; Return.

; Table: Main Menu Logo Attribute Addresses
;
; Eight attribute-file addresses for the main-menu logo cells drawn by
; #R$F6D6 / colour-cycled by #R$F70A.
@label=Table_MainMenuLogoAttributes
w$F6C6 DEFW $5800
 $F6C8 DEFW $58C0
 $F6CA DEFW $5980
 $F6CC DEFW $5A40
 $F6CE DEFW $5817
 $F6D0 DEFW $58D7
 $F6D2 DEFW $5997
 $F6D4 DEFW $5A57

; Draw Main Menu Logo
;
; Used by the routine at #R$F3EF.
; .
; Draw the eight-cell main-menu logo using the UDG font at #R$F740 and the
; attribute-address table at #R$F6C6 #PUSHS #POKES$4000,$00,$1B00
; #SIM(start=$F6D6,stop=$F73F)
; #UDGTABLE { #SCR$02,$00,$00,$20,$18(main-menu-logo) } UDGTABLE# #POPS
;
; .
;
; Point the character set at the logo font and walk eight attribute cells.
@label=Draw_MainMenuLogo
c$F6D6 LD HL,$F741   ; {Point #REGhl at the logo font + #N$01 (#R$F740 + #N$01), then store
 $F6D9 LD ($72F9),HL ; it as the current character set.}
 $F6DC XOR A         ; {Clear the current text attribute.
 $F6DD LD ($7307),A  ; }
 $F6E0 LD D,A        ; Clear #REGd.
 $F6E1 LD IX,$F6C6   ; Point #REGix at #R$F6C6.
 $F6E5 LD B,$08      ; There are #N$08 logo cells to draw.
; Draw one of the eight main-menu logo cells from the UDG font at #R$F740.
@label=Draw_MainMenuLogo_CellLoop
*$F6E7 PUSH BC       ; Stash #REGbc on the stack.
 $F6E8 LD L,(IX+$00) ; {Fetch this cell's attribute address into #REGhl.
 $F6EB LD H,(IX+$01) ; }
 $F6EE LD E,$01      ; Start the glyph index at #N$01.
 $F6F0 LD C,$06      ; There are #N$06 rows in each logo cell.
; Draw one #N$09-character row inside the current logo cell.
@label=Draw_MainMenuLogo_RowLoop
*$F6F2 LD B,$09      ; There are #N$09 characters in each logo row.
; Print one logo glyph via #R$EB67 and advance along the row.
@label=Draw_MainMenuLogo_CharLoop
*$F6F4 CALL $EB67    ; Call #R$EB67 to print glyph #REGe at #REGhl.
 $F6F7 INC HL        ; Move to the next character cell on screen.
 $F6F8 INC E         ; Move on to the next logo glyph.
 $F6F9 DJNZ $F6F4    ; Decrease the column counter and jump to #R$F6F4 while columns
                     ; remain.
 $F6FB PUSH DE       ; Stash #REGde on the stack.
 $F6FC LD E,$17      ; Load #REGe with #N$17 (bytes from row end to the next
                     ; logo row).
 $F6FE ADD HL,DE     ; Step #REGhl onto the next logo row.
 $F6FF POP DE        ; Restore #REGde from the stack.
 $F700 DEC C         ; Decrease the row counter.
 $F701 JR NZ,$F6F2   ; Jump to #R$F6F2 while rows remain.
 $F703 INC IX        ; {Move #REGix to the next attribute address in the table.
 $F705 INC IX        ; }
 $F707 POP BC        ; Restore #REGbc from the stack.
 $F708 DJNZ $F6E7    ; Decrease the cell counter and jump to #R$F6E7 while
                     ; cells remain.
; Continue on to #R$F70A.

; Colour-Cycle Main Menu Logo
;
; Used by the routines at #R$F3EF, #R$F51D and #R$F5CA.
; .
; Cycle attributes across the eight logo cells at #R$F6C6. Picks a
; fresh paper value via #R$EAE5 (avoiding a repeat of the scratch byte at
; #R$F740), then paints a #N$06×#N$09 attribute block at each cell. Used
; after #R$F6D6 and as a menu acknowledge flash from #R$F51D.
;
; .
;
; #PUSHS #POKES$4000,$00,$1B00 #SIM(start=$F6D6,stop=$F70A)
; #POKES$EAE2,$13 #POKES$EAE3,$2B #POKES$F740,$FF #SIM(start=$F70A,stop=$F73F)
; #SCR$02,$00,$00,$20,$18(*lcc1) #POKES$EAE2,$26
; #POKES$EAE3,$56 #POKES$F740,$FF #SIM(start=$F70A,stop=$F73F)
; #SCR$02,$00,$00,$20,$18(*lcc2) #POKES$EAE2,$39
; #POKES$EAE3,$81 #POKES$F740,$FF #SIM(start=$F70A,stop=$F73F)
; #SCR$02,$00,$00,$20,$18(*lcc3) #POKES$EAE2,$4C
; #POKES$EAE3,$AC #POKES$F740,$FF #SIM(start=$F70A,stop=$F73F)
; #SCR$02,$00,$00,$20,$18(*lcc4) #POKES$EAE2,$5F
; #POKES$EAE3,$D7 #POKES$F740,$FF #SIM(start=$F70A,stop=$F73F)
; #SCR$02,$00,$00,$20,$18(*lcc5)
; #UDGTABLE { #FRAMES(lcc1,12;lcc2;lcc3;lcc4;lcc5)(logo-cycle) } UDGTABLE# #POPS
; .
; Walk all eight logo cells with a new random attribute.
@label=ColourCycle_MainMenuLogo
c$F70A LD IX,$F6C6   ; Point #REGix at #R$F6C6.
 $F70E LD D,$00      ; Clear #REGd (row-step high byte stays #N$00).
 $F710 LD B,$08      ; There are #N$08 logo cells to recolour.
; Recolour one of the eight logo cells with a fresh random paper
; attribute.
@label=ColourCycle_MainMenuLogo_CellLoop
*$F712 PUSH BC       ; Stash #REGbc on the stack.
 $F713 LD HL,$F740   ; Point #REGhl at the logo-font scratch byte.
 $F716 LD A,$05      ; Load #REGa with #N$05 (random range for the attribute
                     ; pick).
; Pick a paper value that differs from the previous pick at #R$F740.
@label=ColourCycle_MainMenuLogo_PickAttr
*$F718 CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $F71B CP (HL)       ; {Does it match the previous pick at #R$F740? If so, jump to #R$F718
 $F71C JR Z,$F718    ; to pick again.}
 $F71E LD (HL),A     ; Store the new pick at #R$F740.
 $F71F ADD A,$02     ; #REGa+=#N$02.
 $F721 ADD A,A       ; {Multiply by #N$08 to form a paper attribute.
 $F722 ADD A,A       ;
 $F723 ADD A,A       ; }
 $F724 LD L,(IX+$00) ; {Fetch this cell's attribute address into #REGhl.
 $F727 LD H,(IX+$01) ; }
 $F72A LD C,$06      ; There are #N$06 attribute rows to paint.
; Paint one attribute row of the #N$06×#N$09 logo cell.
@label=ColourCycle_MainMenuLogo_RowLoop
*$F72C LD B,$09      ; There are #N$09 attribute cells in a logo row.
; Write one attribute cell of the colour-cycled logo row.
@label=ColourCycle_MainMenuLogo_ColLoop
*$F72E LD (HL),A     ; Write the attribute at #REGhl.
 $F72F INC HL        ; Advance along the attribute row.
 $F730 DJNZ $F72E    ; Decrease the column counter and jump to #R$F72E while columns
                     ; remain.
 $F732 LD E,$17      ; Load #REGe with #N$17 (bytes from row end to the next
                     ; logo row).
 $F734 ADD HL,DE     ; Step #REGhl onto the next attribute row.
 $F735 DEC C         ; Decrease the row counter.
 $F736 JR NZ,$F72C   ; Jump to #R$F72C while rows remain.
 $F738 INC IX        ; {Move #REGix to the next attribute address in the table.
 $F73A INC IX        ; }
 $F73C POP BC        ; Restore #REGbc from the stack.
 $F73D DJNZ $F712    ; Decrease the cell counter and jump to #R$F712 while
                     ; cells remain.
 $F73F RET           ; Return.

