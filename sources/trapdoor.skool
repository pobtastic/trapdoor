; Print Too-Late Task Feedback
;
; Used by the routine at #R$AB95.
; .
; When the player runs out of time / fails the current brief, clear task
; phase if this is task #N($01), then print "TOO LATE+I'VE CHANGED MY MIND" from
; #R$DDB4 via #R$E286.
;
; .
;
; Reset task #N$01's phase, then print the too-late line.
@label=Print_TooLateTaskFeedback
c$DDA3 LD A,($72AE)  ; {Fetch the current task index (#R$72AE). Is it task #N$01? If not,
 $DDA6 CP $01        ; skip the phase clear at #R$DDAE.
 $DDA8 JR NZ,$DDAE   ; }
 $DDAA XOR A         ; {Clear #REGa, then write #N$00 to the current task phase
 $DDAB LD ($72AF),A  ; (#R$72AF).}
; Print the too-late feedback at #R$DDB4 via #R$E286.
@label=Print_TooLateTaskFeedback_Print
*$DDAE LD HL,$DDB4   ; Point #REGhl at Messaging: Task Feedback (#R$DDB4).
 $DDB1 JP $E286      ; Jump to #R$E286 to print that encoded message.

; Messaging: Too Late I've Changed My Mind
;
; Encoded feedback line. Opens with #CHR$5B, print-controls #CHR$5F /
; #CHR$60, #CHR$2B starts a new row, ends with #CHR$5D.
@label=Messaging_TooLateIveChangedMyMind
t$DDB4 DEFM "[_",$60,"TOO LATE+I'VE CHANGED MY MIND" ; "#STR(#PC,$04,$20)".
 $DDD4 DEFB $5D                                      ; Terminator (#CHR$5D);
                                                     ; ends this encoded
                                                     ; message.

; Messaging: As A Learner I Think You Are..
;
; Encoded feedback line. Opens with #CHR$5B, print-controls #CHR$5F /
; #CHR$60, #CHR$2B starts a new row, ends with #CHR$5D.
@label=Messaging_AsALearnerIThinkYouAre
t$DDD5 DEFM "[_",$60,"AS A LEARNER+I THINK YOU ARE.." ; "#STR(#PC,$04,$21)".
 $DDF6 DEFB $5D                                       ; Terminator (#CHR$5D);
                                                      ; ends this encoded
                                                      ; message.

; Messaging: As A Superberk I Rate You As..
;
; Encoded feedback line. Opens with #CHR$5B, print-controls #CHR$5F /
; #CHR$60, #CHR$2B starts a new row, ends with #CHR$5D.
@label=Messaging_AsASuperberkIRateYouAs
t$DDF7 DEFM "[_",$60,"AS A SUPERBERK+I RATE YOU AS.." ; "#STR(#PC,$04,$21)".
 $DE18 DEFB $5D                                       ; Terminator (#CHR$5D);
                                                      ; ends this encoded
                                                      ; message.

; Print Status Messages
;
; Used by the routines at #R$AAB3 and #R$AB95.
; .
; Print the Learner/Super rating line from #R$DDB4, then a task-progress
; line chosen from the task status flags (#R$72B4).
;
; .
;
; Choose the rating message from the Learner Berk mode flag (#R$72A9).
@label=Print_StatusMessages
c$DE19 LD A,($72A9)  ; Load #REGa with the Learner Berk mode flag (#R$72A9).
 $DE1C OR A          ; {Is Learner mode selected? If so, use the Learner rating
 $DE1D JR NZ,$DE24   ; at #R$DDD5.}
 $DE1F LD HL,$DDF7   ; Point #REGhl at the Super Berk rating message (#R$DDF7).
 $DE22 JR $DE27      ; Skip to print it at #R$DE27.
; Use the Learner Berk rating message at #R$DDD5.
@label=Print_StatusMessages_Learner
*$DE24 LD HL,$DDD5   ; Point #REGhl at the Learner rating message (#R$DDD5).
; Print the chosen Learner / Super rating line via #R$E286.
@label=Print_StatusMessages_PrintRating
*$DE27 CALL $E286    ; Call #R$E286 to print the encoded rating message.
; Choose a task-progress message index from #R$72B4 / #R$72B0.
 $DE2A LD HL,$DF0D   ; Point #REGhl at the task briefing/progress table
                     ; (#R$DF0D).
 $DE2D LD A,($72B4)  ; Load the task status flags (#R$72B4).
 $DE30 OR A          ; {Any task-status bits set? If not, use the dialogue line index at
 $DE31 JR NZ,$DE39   ; #R$DE33.}
; Fall back to dialogue-line index #R$72B0 when no task-status bits are
; set.
@label=Print_StatusMessages_UseDialogueIndex
*$DE33 LD A,($72B0)  ; Load the dialogue line index (#R$72B0).
 $DE36 INC A         ; Advance it by one for the table walk.
 $DE37 JR $DE4A      ; Jump to #R$DE4A to print that indexed string.
; Derive the progress message from task-status flags (#R$72B4), including
; Drutt's type-#N$18 catch.
@label=Print_StatusMessages_FromTaskFlags
*$DE39 LD A,($72B4)  ; Reload the task status flags (#R$72B4).
 $DE3C BIT 4,A       ; {Did Drutt collect a type-#N$18 object (bit #N$04)? If so, use index
 $DE3E JR Z,$DE44    ; #N$06.}
 $DE40 LD A,$06      ; Load message index #N$06.
 $DE42 JR $DE4A      ; Jump to #R$DE4A to print the indexed status string.
; If Drutt caught a type-#N$1C object (bit #N$05), use progress message
; index #N$07.
@label=Print_StatusMessages_SafeLootBit
*$DE44 BIT 5,A       ; {Did Drutt collect a type-#N$1C object (bit #N$05)? If not, fall back
 $DE46 JR Z,$DE33    ; to #R$DE33.}
 $DE48 LD A,$07      ; Load message index #N$07.
; Print the indexed progress string via #R$DE57, then seed menu music and
; wait for a key via #R$FC6C.
@label=Print_StatusMessages_PrintIndexed
*$DE4A CALL $DE57    ; Call #R$DE57 to print the indexed string at #REGhl.
 $DE4D CALL $FC6C    ; Call #R$FC6C to seed the menu music and wait for a key.
 $DE50 RET           ; Return.

; Print Message By Index
;
; Used by the routine at #R$AB95.
; .
; Print briefing message number #REGa from the table at #R$DE63.
@label=Print_MessageByIndex
c$DE51 LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $DE54 LD HL,$DE63   ; Point #REGhl at Messaging: Berk ! Get Me A Can Of Worms (#R$DE63)
                     ; (task briefing table).

; Print Message String
;
; Used by the routine at #R$DE19.
; .
; Skip #REGa encoded messages at #REGhl (each ends with #CHR$5D), then
; print the selected one via #R$E286.
@label=Print_MessageString
c$DE57 LD B,A        ; Keep the message index in #REGb.
; Skip one encoded message at #REGhl (via #R$E2F9) until the selected
; index remains.
@label=Print_MessageString_SkipOneMessage
*$DE58 CALL $E2F9    ; {Call #R$E2F9 to advance #REGhl past one encoded message. Step on by
 $DE5B INC HL        ; one byte. Loop until #REGb messages have been skipped.
 $DE5C DJNZ $DE58    ; }
 $DE5E DEC HL        ; Step back onto the chosen message's terminator.
 $DE5F CALL $E286    ; Call #R$E286 to print that encoded message.
 $DE62 RET           ; Return.

