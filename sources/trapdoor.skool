; Update Task Four Entities
;
; Used by the routine at #R$AAB3.
; .
; Update Task Four Entities for the current Thing Upstairs task.
;
; .
;
; Runs task-four entity scripts while the task phase is #N$04.
@label=Update_Task_Four_Entities
c$CAA7 CALL $CE4B    ; Call #R$CE4B to update Ghosts.
 $CAAA LD A,($72AF)  ; Load #REGa with the current task phase (#R$72AF).
 $CAAD CP $04        ; {Is current task phase equal to #N$04? If not, return.
 $CAAF RET NZ        ; }
 $CAB0 LD HL,($72D7) ; Load #REGhl with the task-four script-position pointer
                     ; (#R$72D7).
 $CAB3 LD ($72CF),HL ; Store #REGhl in the active script cursor (#R$72CF).
 $CAB6 LD IX,$8FF3   ; Point #REGix at the task-three/four entity at #R$8FF3.
 $CABA CALL $CAC4    ; Call #R$CAC4 to update Task Four Entity State.
 $CABD LD HL,($72CF) ; Load #REGhl with the active script cursor (#R$72CF).
 $CAC0 LD ($72D7),HL ; Store #REGhl in the task-four script-position pointer
                     ; (#R$72D7).
 $CAC3 RET           ; Return.

; Update Task Four Entity State
;
; Used by the routine at #R$CAA7.
; .
; Advance task-four entity scripts and start/stop the entity when game
; event flags at #R$72B3 change.
@label=Update_TaskFourEntityState
c$CAC4 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $CAC7 BIT 7,A        ; {Is bit #N$07 of game event flags set? If so, jump to
 $CAC9 JP NZ,$EC2E    ; #R$EC2E.}
 $CACC BIT 7,(IX+$00) ; {Is bit #N$07 of the current entity's entity type set? If so, jump to
 $CAD0 JR NZ,$CAE6    ; #R$CAE6.}
 $CAD2 BIT 1,A        ; {Is bit #N$01 of game event flags set? If so, jump to
 $CAD4 JP NZ,$EC2E    ; #R$EC2E.}
; This entry point is used by the routine at #R$CAF0.
; .
; Shared entry used by script routine #R$CAF0 to start the task-four
; entity script.
@label=Update_TaskFour_StartEntity
*$CAD7 SET 7,(IX+$00) ; Set bit #N$07 of the current entity's entity type.
 $CADB XOR A          ; Clear the current task phase (idle).
 $CADC LD ($72AF),A   ; Set the current task phase (#R$72AF).
 $CADF LD HL,$CA23    ; Point #REGhl at task-four script #R$CA23.
 $CAE2 LD ($72CF),HL  ; Store #REGhl in the active script cursor (#R$72CF).
 $CAE5 RET            ; Return.
; Stop the task-four entity when game-event bit #N$01 is set: clear type
; bit #N$07 and continue the script.
@label=Update_TaskFour_StopEntity
*$CAE6 BIT 1,A        ; {Is bit #N$01 of game event flags set? If not, return.
 $CAE8 RET Z          ; }
 $CAE9 RES 7,(IX+$00) ; Reset bit #N$07 of the current entity's entity type.
 $CAED JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$50) Task-four entity action
;
; Clear the task-four script flags so the next task-four beat can start
; cleanly.
@label=ScriptRoutine_TaskFourClearScriptFlags
c$CAF0 LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $CAF3 RES 7,(HL)    ; Clear bit #N$07 of #R$72B3 (task entity script active).
 $CAF5 RES 4,(HL)    ; Clear bit #N$04 of #R$72B3 (upstairs event latch).
 $CAF7 LD A,$28      ; Load #REGa with #N$28.
 $CAF9 LD ($72F2),A  ; Set the game tick counter (#R$72F2).
 $CAFC JR $CAD7      ; Jump to #R$CAD7 to start the entity.

; Script Routine: (#N$48) Task-four entity action
;
; Snap the task-four creature onto its target position.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourAlignCreature
c$CAFE LD IY,$9071    ; Point #REGiy at the vat entity at #R$9071.
 $CB02 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $CB05 CP (IY+$07)    ; {Does this entity's x match the referenced entity's x (#REGiy+#N$07)?
 $CB08 JP NZ,$EC2E    ; If not, jump to #R$EC2E.}
 $CB0B LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $CB0E CP (IY+$04)    ; {Does this entity share the referenced entity's room (#REGiy+#N$04)?
 $CB11 JP NZ,$EC2E    ; If not, jump to #R$EC2E.}
 $CB14 SET 2,(IX+$0D) ; Set bit #N$02 of the current entity's extra state.
 $CB18 LD HL,$CA79    ; Point #REGhl at task-four script entry #R$CA79.
 $CB1B JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Script Routine: (#N$4F) Task-four entity action
;
; Pick a new extra-state value for the task-four creature's next beat.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourRandomiseExtra
c$CB1E LD (IX+$0C),$04 ; Write #N$04 to the current entity's extra state.
 $CB22 LD A,$05        ; Load #REGa with #N$05.
 $CB24 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $CB27 ADD A,$06       ; Add #N$06 to #REGa (adjust a task-four index/counter).
 $CB29 LD C,A          ; Keep the index in #REGc.
 $CB2A LD A,$02        ; Load #REGa with #N$02.
 $CB2C CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $CB2F OR A            ; {Is #REGa zero? If so, jump to #R$CB36.
 $CB30 JR Z,$CB36      ; }
 $CB32 LD A,C          ; Copy the saved count/flag from #REGc into #REGa.
 $CB33 NEG             ; Negate #REGa (flip a delta/direction).
 $CB35 LD C,A          ; Keep the delta in #REGc.
; Keep the signed step delta, drop the upstairs latch on #R$72B3, and
; continue the script.
@label=ScriptRoutine_TaskFourRandomiseExtra_StoreDeltaClearBit4
*$CB36 LD (IX+$09),C   ; Store #REGc in the current entity's direction / state.
 $CB39 LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $CB3C RES 4,A         ; Clear bit #N$04 of the flag byte in #REGa.
 $CB3E LD ($72B3),A    ; Set the game event flags (#R$72B3).
 $CB41 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$4B) Task-four entity action
;
; Nudge the task-four creature one character toward its target.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourStepToward
c$CB44 LD A,(IX+$0D)  ; Load #REGa with the current entity's extra state.
 $CB47 BIT 4,A        ; {Is bit #N$04 of the current entity's extra state set? If not, jump
 $CB49 JR Z,$CB52     ; to #R$CB52.}
 $CB4B RES 4,A        ; Clear bit #N$04 of the flag byte in #REGa.
 $CB4D LD (IX+$0D),A  ; Set the current entity's extra state.
 $CB50 JR $CB57       ; Jump to #R$CB57 to continue this routine.
; Require extra-state bit #N$02 before stepping; otherwise bail to the
; next script.
@label=ScriptRoutine_TaskFourStepToward_RequireExtraBit2
*$CB52 BIT 2,A        ; {Is bit #N$02 of the current entity's extra state set? If so, jump to
 $CB54 JP NZ,$EC2E    ; #R$EC2E.}
; At extra-state ends (#N$0B or #N$00), reverse the signed step via
; #R$CBB8.
@label=ScriptRoutine_TaskFourStepToward_MaybeNegateDelta
*$CB57 LD A,(IX+$0C)  ; Load #REGa with the current entity's extra state.
 $CB5A CP $0B         ; {Is the current entity's extra state equal to #N$0B? If so, call
 $CB5C CALL Z,$CBB8   ; #R$CBB8.}
 $CB5F OR A           ; {Is #REGa zero? If so, call #R$CBB8.
 $CB60 CALL Z,$CBB8   ; }
; Apply the signed step: grow or shrink extra state, then rewrite X /
; X-extent.
@label=ScriptRoutine_TaskFourStepToward_ApplySignedStep
*$CB63 LD C,(IX+$09)  ; Load #REGc with the current entity's direction / state.
 $CB66 BIT 7,C        ; {Is bit #N$07 of the direction/state in #REGc set (negative delta)?
 $CB68 JR NZ,$CB6D    ; If so, jump to #R$CB6D.}
 $CB6A INC A          ; Advance the current entity's extra state by one.
 $CB6B JR $CB6E       ; Jump to #R$CB6E to continue this routine.
; Negative delta path: shrink extra state before rewriting coordinates.
@label=ScriptRoutine_TaskFourStepToward_DecExtraState
*$CB6D DEC A          ; Step the current entity's extra state back by one.
; Commit the stepped X band, clear latch bit #N($04), and at X=#N$6C raise
; it and maybe reverse.
@label=ScriptRoutine_TaskFourStepToward_WriteCoordsAndFlags
*$CB6E LD (IX+$0C),A  ; Set the current entity's extra state.
 $CB71 LD A,C         ; Copy the saved count/flag from #REGc into #REGa.
 $CB72 ADD A,(IX+$07) ; Add the current entity's x-coordinate to #REGa.
 $CB75 LD (IX+$07),A  ; Set the current entity's x-coordinate.
 $CB78 LD A,C         ; Copy the saved count/flag from #REGc into #REGa.
 $CB79 ADD A,(IX+$08) ; Add the current entity's x-extent to #REGa.
 $CB7C LD (IX+$08),A  ; Set the current entity's x-extent.
 $CB7F LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $CB82 RES 4,A        ; Clear bit #N$04 of the flag byte in #REGa.
 $CB84 LD ($72B3),A   ; Set the game event flags (#R$72B3).
 $CB87 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $CB8A CP $6C         ; {Is the current entity's x-coordinate equal to #N$6C? If not, jump to
 $CB8C JP NZ,$EC2E    ; #R$EC2E.}
 $CB8F LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $CB92 SET 4,A        ; Set bit #N$04 of game event flags.
 $CB94 LD ($72B3),A   ; Set the game event flags (#R$72B3).
 $CB97 BIT 1,A        ; {Is bit #N$01 of game event flags set? If not, jump to
 $CB99 JR Z,$CBA1     ; #R$CBA1.}
 $CB9B LD HL,$CA9B    ; Point #REGhl at task-four script entry #R$CA9B.
 $CB9E JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; At the turnaround X, retrace only when aligned with the vat
; (#R$9071) in room #N$03.
@label=ScriptRoutine_TaskFourStepToward_MatchCreatureThenRetrace
*$CBA1 LD IY,$9071    ; Point #REGiy at the vat entity at #R$9071.
 $CBA5 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $CBA8 CP (IY+$07)    ; {Does this entity's x match the referenced entity's x (#REGiy+#N$07)?
 $CBAB JP NZ,$EC2E    ; If not, jump to #R$EC2E.}
 $CBAE LD A,(IY+$04)  ; Load #REGa with the referenced entity's room index.
 $CBB1 CP $03         ; {Is referenced entity's room index equal to #N$03? If not, jump to
 $CBB3 JP NZ,$EC2E    ; #R$EC2E.}
 $CBB6 JR $CB63       ; Jump to #R$CB63 to continue this routine.
; Negate the stored direction / step delta so the entity walks the other
; way.
@label=ScriptRoutine_TaskFourStepToward_NegateDirection
*$CBB8 PUSH AF        ; Stash #REGaf on the stack.
 $CBB9 LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $CBBC NEG            ; Negate #REGa (flip a delta/direction).
 $CBBE LD (IX+$09),A  ; Set the current entity's direction / state.
 $CBC1 POP AF         ; Restore #REGaf from the stack.
 $CBC2 RET            ; Return.

; Script Routine: (#N$4E) Task-four entity action
;
; Arm the task-four script-active flags for the following beats.
@label=ScriptRoutine_TaskFourArmScriptFlags
c$CBC3 LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $CBC6 OR %10010000  ; Set bits #N$07 and #N$04 of #R$72B3 (task entity script active
                     ; + upstairs event latch).
 $CBC8 LD ($72B3),A  ; Set the game event flags (#R$72B3).
 $CBCB JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$4D) Task-four entity action
;
; Tick the task-four offer-item timer that gates its dialogue.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourTickOfferItem
c$CBCE LD A,($72C2)    ; Load the shared tick (#R$72C2) into #REGa.
 $CBD1 OR A            ; {Is the shared tick (#R$72C2) zero? If not, jump to
 $CBD2 JR NZ,$CBDB     ; #R$CBDB.}
 $CBD4 RES 2,(IX+$0D)  ; Reset bit #N$02 of the current entity's extra state.
 $CBD8 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; Tick #R$72C2, flash layout #R$A166 on the creature, and test whether the
; offered item is hit.
@label=ScriptRoutine_TaskFourTickOfferItem_TickAndOfferItem
*$CBDB DEC A           ; Step the shared tick back by one.
 $CBDC LD ($72C2),A    ; Store the shared tick (#R$72C2).
 $CBDF LD IY,$9071     ; Point #REGiy at the vat entity at #R$9071.
 $CBE3 LD BC,$A166     ; Point #REGbc at graphic layout #R$A166.
 $CBE6 LD ($907B),BC   ; Store #REGbc in the inactive complex-entity slot fields at
                       ; #R$8EF3(#N$907B).
 $CBEA SET 3,(IX+$0D)  ; Set bit #N$03 of the current entity's extra state.
 $CBEE LD A,(IY+$08)   ; Load #REGa with the referenced entity's x-extent.
 $CBF1 INC A           ; Advance referenced entity's x-extent by one.
 $CBF2 LD C,(IY+$04)   ; Load #REGc with the referenced entity's room index.
 $CBF5 LD IY,$900F     ; Point #REGiy at the task-item entity (#R$900F).
 $CBF9 CP (IY+$07)     ; {Does this entity's x match the referenced entity's x (#REGiy+#N$07)?
 $CBFC JP Z,$CC12      ; If so, jump to #R$CC12.}
; Missed the offered item: set interaction bit #N$02 of #R$72B9 and clear
; the offer latch.
@label=ScriptRoutine_TaskFourTickOfferItem_MissItemSetFlags
*$CBFF LD A,($72B9)    ; Load #REGa with the entity interaction flag (#R$72B9).
 $CC02 SET 2,A         ; Set bit #N$02 of #R$72B9.
 $CC04 LD ($72B9),A    ; Set the entity interaction flag (#R$72B9).
 $CC07 SET 4,(IX+$0D)  ; Set bit #N$04 of the current entity's extra state.
 $CC0B RES 2,(IX+$0D)  ; Reset bit #N$02 of the current entity's extra state.
 $CC0F JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; Hit the offered item: play the vat cue, clear the miss flag, and advance
; its layout animation.
@label=ScriptRoutine_TaskFourTickOfferItem_HitItemAdvanceAnim
*$CC12 LD A,C          ; Copy the saved count/flag from #REGc into #REGa.
 $CC13 CP (IY+$04)     ; {Does this entity share the referenced entity's room (#REGiy+#N$04)?
 $CC16 JR NZ,$CBFF     ; If not, jump to #R$CBFF.}
; #HTML(#AUDIO0(vat.wav)(#INCLUDE(Vat)))
 $CC18 LD A,$91        ; Load #REGa with #N$91.
 $CC1A CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
 $CC1D LD (IY+$02),$80 ; Write #N$80 to the referenced entity's flags byte 2.
 $CC21 LD A,($72B9)    ; Load #REGa with the entity interaction flag (#R$72B9).
 $CC24 RES 2,A         ; Clear bit #N$02 of the flag byte in #REGa.
 $CC26 LD ($72B9),A    ; Set the entity interaction flag (#R$72B9).
 $CC29 LD A,($72C1)    ; Load #REGa with the animation frame counter (#R$72C1).
 $CC2C INC A           ; Advance animation frame counter by one.
 $CC2D LD ($72C1),A    ; Set the animation frame counter (#R$72C1).
 $CC30 LD A,(IY+$09)   ; Load #REGa with the referenced entity's direction /
                       ; state.
 $CC33 INC A           ; Advance referenced entity's direction / state by one.
 $CC34 LD (IY+$09),A   ; Set the referenced entity's direction / state.
 $CC37 PUSH HL         ; Stash #REGhl on the stack.
 $CC38 LD HL,$CC4B     ; Point #REGhl at task-four script data #R$CC4B.
 $CC3B ADD A,A         ; Double #REGa to form a word index into the
                       ; script/handler table.
 $CC3C LD C,A          ; Keep the index in #REGc.
 $CC3D LD B,$00        ; Clear #REGb so #REGbc is the word index into #R$CC4B.
 $CC3F ADD HL,BC       ; Add the length/offset in #REGbc to the pointer in
                       ; #REGhl.
 $CC40 LD C,(HL)       ; {Fetch the new script address into #REGbc.
 $CC41 INC HL          ;
 $CC42 LD B,(HL)       ; }
 $CC43 POP HL          ; Restore #REGhl from the stack.
 $CC44 LD ($9019),BC   ; Store #REGbc in the task-item entity's layout field
                       ; (#R$8EF3(#N$9019)).
 $CC48 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
 $CC4B LD D,C          ; Copy referenced entity's direction / state into #REGd.
 $CC4C AND B           ; Mask referenced entity's direction / state with #REGb.
 $CC4D LD C,E          ; Copy the low byte from #REGe into #REGc (build a
                       ; count/address).
 $CC4E AND B           ; Mask referenced entity's direction / state with #REGb.
 $CC4F LD B,L          ; Copy the low byte from #REGl into #REGb (build a
                       ; count/address).
 $CC50 AND B           ; Mask referenced entity's direction / state with #REGb.
 $CC51 CCF             ; Invert the success marker.
 $CC52 AND B           ; Mask referenced entity's direction / state with #REGb.

; Script Routine: (#N$49) Task-four entity action
;
; Raise the task-four creature one character.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourRaiseY
c$CC53 LD A,(IX+$05)  ; Load #REGa with the current entity's y-coordinate.
 $CC56 SUB $04        ; Subtract #N$04 from #REGa.
 $CC58 LD (IX+$05),A  ; Set the current entity's y-coordinate.
 $CC5B LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $CC5E SUB $04        ; Subtract #N$04 from #REGa.
 $CC60 LD (IX+$06),A  ; Set the current entity's y-extent.
 $CC63 BIT 3,(IX+$0D) ; {Is bit #N$03 of the current entity's extra state set? If not, jump
 $CC67 JP Z,$EC2E     ; to #R$EC2E.}
 $CC6A RES 3,(IX+$0D) ; Reset bit #N$03 of the current entity's extra state.
 $CC6E LD BC,$A18B    ; Point #REGbc at the vat layout (#R$A18B).
 $CC71 LD ($907B),BC  ; Store #REGbc in the inactive complex-entity slot fields at
                      ; #R$8EF3(#N$907B).
 $CC75 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$4A) Task-four entity action
;
; Lower the task-four creature one character.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskFourLowerY
c$CC78 LD A,(IX+$05) ; Load #REGa with the current entity's y-coordinate.
 $CC7B ADD A,$04     ; Add #N$04 to #REGa (step a coordinate/index).
 $CC7D LD (IX+$05),A ; Set the current entity's y-coordinate.
 $CC80 LD A,(IX+$06) ; Load #REGa with the current entity's y-extent.
 $CC83 ADD A,$04     ; Add #N$04 to #REGa (step a coordinate/index).
 $CC85 LD (IX+$06),A ; Set the current entity's y-extent.
 $CC88 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$4C) Task-four entity action
;
; Test whether the task-four creature currently overlaps Berk.
;
; IX Address of complex state data for an entity
;
; #HTML(#AUDIO0(thump.wav)(#INCLUDE(Thump)))
@label=ScriptRoutine_TaskFourBerkOverlap
c$CC8B LD A,$8E      ; Load #REGa with #N$8E.
 $CC8D CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $CC90 LD A,($7305)  ; Load #REGa with Berk's room-index copy (#R$7305).
 $CC93 CP (IX+$04)   ; {Is Berk in the same room as this entity (#REGix+#N$04)? If so, jump
 $CC96 JR Z,$CC9F    ; to #R$CC9F.}
 $CC98 INC A         ; Advance Berk's room-index copy by one.
 $CC99 CP (IX+$04)   ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $CC9C JP NZ,$EC2E   ; to #R$EC2E.}
; Same-room Berk overlap: if X bands intersect, treat it as a door /
; interaction hit via #R$EA73.
@label=ScriptRoutine_TaskFourBerkOverlap_TestBerkOverlap
*$CC9F LD A,($7304)  ; Load #REGa with Berk's X-extent copy (#R$7304).
 $CCA2 CP (IX+$07)   ; {Is Berk's X-extent copy left of this entity's x (#REGix+#N$07)? If
 $CCA5 JP C,$EC2E    ; so, no overlap, jump to #R$EC2E.}
 $CCA8 LD A,($7303)  ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $CCAB LD C,A        ; Keep Berk's X coordinate in #REGc.
 $CCAC LD A,(IX+$08) ; Load #REGa with the current entity's x-extent.
 $CCAF CP C          ; {Is this entity's x-extent left of Berk's X-coordinate copy
 $CCB0 JP C,$EC2E    ; (#R$7303)? If so, no overlap, jump to #R$EC2E.}
 $CCB3 CALL $EA73    ; Call #R$EA73 to handle the door / interaction hit.
; Advance to the next script instruction after the Berk-overlap hit.
@label=ScriptRoutine_TaskFourBerkOverlap_NextScript
 $CCB6 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

