 $CA5F DEFW $0022    ; Script opcode #N$22 (end script loop).
 $CA61 DEFW $0048    ; Script opcode #N$48 (snap the creature onto its target).
 $CA63 DEFW $0021    ; Script opcode #N$21 (start counted script loop).
 $CA65 DEFB $02,$00  ; Loop count #N$02 (#R$EC53 reads only the low byte).
 $CA67 DEFW $CCE6    ; Graphic-layout pointer #R$CCE6.
 $CA69 DEFW $004A    ; Script opcode #N$4A (lower the task-four creature).
