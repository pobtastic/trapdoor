; Graphic Layout Routine: (#N$FB) Process Nested Graphic Layout Data
;
; Recurse into a nested graphic-layout fragment, then return here.
@label=GraphicLayoutRoutine_ProcessNestedLayout
c$E88B LD C,(IX+$00) ; Load #REGc with the current entity's entity type.
 $E88E LD B,(IX+$01) ; Load #REGb with the current entity's flags byte 1.
 $E891 PUSH IX       ; Stash #REGix on the stack.
 $E893 PUSH BC       ; {Copy #REGbc into #REGix (using the stack).
 $E894 POP IX        ; }
 $E896 CALL $E73F    ; Call #R$E73F to process graphic layout data.
 $E899 POP IX        ; Restore #REGix from the stack.
 $E89B JP $E73B      ; Jump to #R$E73B to advance the graphic layout pointer
                     ; and continue.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9B1A }
; LIST#

