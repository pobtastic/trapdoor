                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
 $E7E9 DEFW $E89E    ; Address of the handler for graphic-layout opcode
                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
 $E7EB DEFW $E8AA    ; Address of the handler for graphic-layout opcode
                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
 $E7ED DEFW $E86E    ; Address of the handler for graphic-layout opcode
                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
