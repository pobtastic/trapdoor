 $7369 DEFB %00001010,%10001010,%01001010,%11001010,%00101010,%10101010,%01101010,%11101010
 $7371 DEFB %00011010,%10011010,%01011010,%11011010,%00111010,%10111010,%01111010,%11111010
 $7379 DEFB %00000110,%10000110,%01000110,%11000110,%00100110,%10100110,%01100110,%11100110
 $7381 DEFB %00010110,%10010110,%01010110,%11010110,%00110110,%10110110,%01110110,%11110110
