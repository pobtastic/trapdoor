; Leftover: @Music.en
;
; Nine bytes <code>@Music.en</code> left at the end of the #R$6F04.
; #R$AAB3 copies these bytes to #R$FFF6 along with the rest of the
; block; they are never used as a message.
@label=Leftover_MusicEn
t$728E DEFM "@Music.en" ; "#STR(#PC,$04,$09)".

; Secondary Display Buffer (Tail)
;
; Final bytes of the secondary display buffer after the menu-music source.
@label=SecondaryDisplayBuffer_Tail
u$7297 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $729F DEFB $00

; Game Start Alias
;
; Jump to #R$AAB3.
@label=Alias_GameStart
c$72A0 JP $AAB3      ; Jump to #R$AAB3 to restart the game.

; Copy Length: Entity State Data
;
; Byte count used when copying entity state data during initialisation /
; room changes.
@label=CopyLength_EntityStateData
g$72A3 DEFW $0000

; Copy Length: Game State
;
; Byte count used when copying game-state data during initialisation /
; room changes.
@label=CopyLength_GameState
g$72A5 DEFW $0000

; Pointer: Entity State Backup End
;
; End pointer for the entity-state backup region used by copy routines.
@label=Pointer_EntityStateBackupEnd
g$72A7 DEFW $0000

; Flag: Learner Berk Mode
;
; Set by the main menu (#R$F43D): #N$00 = Super Berk, #N$01 = Learner
; Berk. #R$DE19 uses this to choose the rating message at #R$DDB4.
@label=Flag_LearnerBerkMode
g$72A9 DEFB $00

; Pointer: Last Collided Entity
;
; Address of the complex state data for the entity involved in the
; last collision / interaction check. Written by the collision helpers at
; #R$F2B2, #R$F31F, #R$F381 and #R$F3E3; read as #REGix / #REGiy / #REGbc
; throughout Berk's movement and pick-up / put-down logic.
@label=Pointer_LastCollidedEntity
g$72AA DEFW $0000

; Pointer: Current Entity
;
; Address of the complex state data for the entity currently being
; processed (usually Berk). Often the entity Berk is holding when bit #N$04
; of Berk's flags byte 3 (#REGix+#N$03) is set.
@label=Pointer_CurrentEntity
g$72AC DEFW $0000

; Current Task Index
;
; Index of the current Bad Tempered Thing task (meal request).
@label=CurrentTaskIndex
g$72AE DEFB $00

; Current Task Phase
;
; Phase / sub-step within the current task.
@label=CurrentTaskPhase
g$72AF DEFB $00

; Dialogue Line Index
;
; Index of the current dialogue / message line.
@label=DialogueLineIndex
g$72B0 DEFB $00

; Pointer: Berk Script Position
;
; Pointer into Berk's current script data stream.
@label=Pointer_BerkScriptPosition
g$72B1 DEFW $B9AD

; Game Event Flags
;
; Cross-cutting event bits for trap door and task state.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Room / script event raised (set by helpers such as #R$EF49) }
; { #N$01 | Trap door is open / trap door event armed }
; { #N$02 | Falling-entity latch (cleared/set by #R$B1A9) }
; { #N$03 | Object has been offered to the trap (Bad Tempered Thing path) }
; { #N$04 | Task-two / upstairs event latch }
; { #N$05 | Reserved / unused in the observed call sites }
; { #N$06 | Special put-down / room-transition event }
; { #N$07 | Task entity script is active }
; TABLE#
@label=GameEventFlags
g$72B3 DEFB $00

; Task Status Flags
;
; Per-task status bits (Drutt / collectible progress and dialogue gates).
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$00 | Task progress / dialogue gate }
; { #N$01 | Timed Berk event pending }
; { #N$04 | Drutt collected a type-#N$18 object }
; { #N$05 | Drutt collected a type-#N$1C object }
; { #N$06 | Berk action / eat latch }
; { #N$07 | Berk script / dialogue busy }
; TABLE#
@label=TaskStatusFlags
g$72B4 DEFB $00

; Task Two Flags
;
; Flags for the "Thing Upstairs" (task two) state machine.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$01 | Task-two script should advance }
; { #N$02 | Spawn / random-walk latch for the upstairs helper }
; { #N$03 | Helper entity needs its layout restoring }
; { #N$04 | Task-two helper busy }
; { #N$05 | Task-two helper secondary latch }
; { #N$06 | Task-two room-transition latch }
; { #N$07 | Task-two entity script active }
; TABLE#
@label=TaskTwoFlags
g$72B5 DEFB $00

; Task Three Flags
;
; Flags for the task-three (boiled slimies / feeding) state machine.
; Bit names below are taken from the Bad Tempered Thing dialogue gates and
; the stove / put-down writers that set or clear them.
; #TABLE(default,centre,centre,centre)
; { =h Bit | =h Name | =h Set / clear }
; { #N$00 | MobileHeater | no SET/RES site found }
; { #N$01 | Slimies | set by #R$F110; tested by #R$D901 }
; { #N$02 | SlimyLoose | set by #R$B401 / #R$C6FC; cleared by #R$C63B }
; { #N$04 | BoilEmUp | set by #R$C5D2; cleared by #R$C63B; tested by #R$D927 }
; { #N$05 | BoilEmUpLatch | set by #R$C5D2; cleared by #R$C63B / #R$C397 }
; { #N$06 | StoveReady | set by #R$C63B when #R$72BE reaches #N$04 }
; { #N$07 | StoveUpdated | set by #R$C63B; tested by #R$C5D2 }
; TABLE#
;
; .
;
; Bit #N$00 (MobileHeater) gates #R$DC08 ("Mobile Heater") / #R$DC18
; ("The Stove's No Help", #R$D921); no SET/RES site found.
; .
; Bit #N$01 (Slimies) gates #R$DBC4 ("Slimies"); set by #R$F110 on
; put-down of type #N$09; tested by #R$D901.
; .
; Bit #N$02 (SlimyLoose) gates #R$DBCD ("Slimy Loose !"); set by
; #R$B401 / #R$C6FC; cleared by #R$C63B; if set, #R$D907 skips the line.
; .
; Bit #N$04 (BoilEmUp) gates #R$DC2C ("Boil'Em Up !") / #R$DC3B
; ("Flame ?"); set by #R$C5D2 with #N$05; cleared by #R$C63B; tested by
; #R$D927.
; .
; Bit #N$05 (BoilEmUpLatch) is the companion set with BoilEmUp by
; #R$C5D2; cleared by #R$C63B / #R$C397; no BIT reader found.
; .
; Bit #N$06 (StoveReady) gates #R$DBDE ("Too Soon ?") / #R$DBEB ("Hot
; Stuff", #R$D915) and #R$DBF5 ("Got All Slimies ?", #R$D91B); set by #R$C63B
; when #R$72BE reaches #N$04.
; .
; Bit #N$07 (StoveUpdated) is set by #R$C63B; tested by #R$C5D2 before
; it sets BoilEmUp / BoilEmUpLatch and swaps the cauldron layout.
@label=TaskThreeFlags
g$72B6 DEFB $00

; Unused
u$72B7 DEFB $00

; Task One / Collision Flags
;
; Flag byte for task-one progress messages (#R$E24E) and the type-#N$08 /
; type-#N$0B collision latch at #R$D446.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$06 | Third consecutive #R$D446 collision (cleared by #R$EDB8) }
; { #N$07 | Collision seen this check (#R$D446) }
; TABLE#
@label=TaskOneCollisionFlags
g$72B8 DEFB $00

; Entity Interaction Flag
;
; Cross-cutting interaction bits for crushers, ghosts and hazards.
; Meanings below are from observed writers/readers only.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$01 | Set by #R$B34B; tested by #R$D93E }
; { #N$02 | Set/cleared by #R$CBCE; tested by #R$D95C to gate dialogue }
; { #N$03 | Set by #R$CEBD; tested and cleared by #R$CE4B }
; { #N$04 | Set by #R$CF1E; tested by #R$D944 to gate dialogue }
; { #N$06 | Set by #R$CF1E when #R$72C2 reaches #N$03; no BIT reader found }
; { #N$07 | Set by #R$CF1E on every crusher update; no BIT reader found }
; TABLE#
;
; .
;
; Bit #N$01 is set by #R$B34B; tested by #R$D93E to gate Bad Tempered
; Thing dialogue.
@label=EntityInteractionFlag
g$72B9 DEFB $00

; Trap Door Flags
;
; Animation and interaction bits for the trap door itself.
; #TABLE(default,centre,centre)
; { =h Bit | =h Meaning }
; { #N$01 | Weight-chain layout swap pending }
; { #N$02 | Drutt is mid trap door animation }
; { #N$03 | Trap door is open for Berk's put-down check }
; TABLE#
@label=TrapDoorFlags
g$72BA DEFB $00

; Drutt Animation Counter
;
; Frame counter driving Drutt's animation.
@label=DruttAnimationCounter
g$72BB DEFB $00

; Collectible Counter
;
; Count of collectible eyeballs gathered so far.
@label=CollectibleCounter
g$72BC DEFB $00

; Collision Scratch Byte
;
; Byte used by collision / collectible helpers (#R$D446,
; #R$D7D3) to remember a room index or entity field across a call.
@label=CollisionScratchByte
g$72BD DEFB $00

; Stove Tick
;
; How many times #R$C63B Update Stove has run this boil cycle. On the
; fourth call that routine sets StoveReady (bit #N$06 of #R$72B6).
@label=StoveTick
g$72BE DEFB $00

; Room Transition Flag
;
; Non-zero while a room transition is in progress.
@label=RoomTransitionFlag
g$72BF DEFB $00

; Entity Spawn Timer
;
; Countdown / tick used when spawning transient entities.
@label=EntitySpawnTimer
g$72C0 DEFB $00

; Animation Frame Counter
;
; Shared animation frame counter for scripted entities.
@label=AnimationFrameCounter
g$72C1 DEFB $00

; Shared Tick
;
; One-byte counter shared by #R$CF1E (increments on each crusher update)
; and script routine #R$CBCE (decrements toward zero). Not a pure frame
; counter: #R$CF1E advances it once per crusher call, and when the value
; reaches #N$03 that routine also sets bits #N$06 and #N$07 of #R$72B9.
@label=SharedTick
g$72C2 DEFB $00

; Task Three Timer
;
; Countdown timer for task-three creature behaviour.
@label=TaskThreeTimer
g$72C3 DEFB $00

; Stove / Heater State
;
; State of the stove / heater prop.
@label=StoveHeaterState
g$72C4 DEFB $00

; Message Trigger
;
; Latch that triggers the next on-screen message.
@label=MessageTrigger
g$72C5 DEFB $00

; Frame Counter
;
; Global frame counter advanced by the main loop.
@label=FrameCounter
g$72C6 DEFB $32

; Bad Tempered Thing State
;
; State flags for the Bad Tempered Thing.
@label=BadTemperedThingState
g$72C7 DEFB $00

; Berk Action Lock
;
; Lock that prevents Berk starting a new action until cleared.
@label=BerkActionLock
g$72C8 DEFB $00

; Task Selection Table
;
; Bit #N$07 marks a task slot as used. Task #N$05 is chosen separately at
; #R$AC10.
@label=TaskSelectionTable
g$72C9 DEFB $00      ; Task 01 (value not read; bit #N$07 set once used).
 $72CA DEFB $02      ; Task 02.
 $72CB DEFB $03      ; Task 03.
 $72CC DEFB $04      ; Task 04.
 $72CD DEFB $40      ; Wrap marker (bit #N$06 set).

; Timed Event Latch
;
; Non-zero while a timed Drutt / trap door script is armed. Set to #N$01
; by #R$F1DF, written from an entity type at #R$ADED,
; cleared by #R$ADA1, and tested by #R$AC48 / #R$B973 before those paths run.
@label=TimedEventLatch
g$72CE DEFB $00

; Pointer: Active Script Cursor
;
; Live script-data cursor while a task / entity script runs. Task updaters
; copy their dedicated script position (#R$72D1 / #R$72D3 / #R$72D5 / #R$72D7 /
; #R$72D9 / #R$72B1) here, call the shared runner, then write the (possibly
; advanced) cursor back.
@label=Pointer_ActiveScriptCursor
g$72CF DEFW $0000

; Pointer: Task Three Script Position
;
; Pointer into task-three script data.
@label=Pointer_TaskThreeScriptPosition
g$72D1 DEFW $C2E8

; Pointer: Drutt Script Position
;
; Pointer into Drutt script data.
@label=Pointer_DruttScriptPosition
g$72D3 DEFW $CF46

; Pointer: Task Two Script Position
;
; Pointer into task-two script data.
@label=Pointer_TaskTwoScriptPosition
g$72D5 DEFW $BE6D

; Pointer: Task Four Script Position
;
; Pointer into task-four script data.
@label=Pointer_TaskFourScriptPosition
g$72D7 DEFW $CA23

; Pointer: Thing Upstairs Script Position
;
; Script cursor for complex entity slot #N$20 when its type is
; #N$22. Written by #R$BDBA / #R$BC2B; read by #R$BC1F.
@label=Pointer_ThingUpstairsScriptPosition
g$72D9 DEFW $0000

; Pointer: Berk Held Entity
;
; Pointer to the entity Berk is currently holding.
@label=Pointer_BerkHeldEntity
g$72DB DEFW $0000

; Score
;
; Current score.
@label=Score
g$72DD DEFW $0000

; Collectible Slot State
;
; Three 3-byte records used by #R$D45B Update Collectibles. Each record is
; a script-position word plus a per-slot counter; #R$D45B walks the table,
; copies a record through #R$72CF / #R$72BC, calls #R$D48E, then writes the
; updated values back.
@label=CollectibleSlotState
g$72DF DEFB $00,$00,$00
 $72E2 DEFB $00,$00,$00
 $72E5 DEFB $00,$00,$00

; Saved Room Index
;
; Room index remembered by #R$ED36 while Berk opens a door behind him.
; Also used by #R$AFC5 as the exclusive end address when measuring the
; #R$72AE…#R$72DF(#N$72E7) game-state backup length into #R$72A5.
@label=SavedRoomIndex
g$72E8 DEFB $00

; Held Entity Y-Extent
;
; Y-extent to restore onto a held entity. Written by #R$B6D8 as the
; collision partner's y−#N$01 during Berk's put-down / pick-up probe; read and
; cleared by #R$F13E when applying the held entity's new y / y-extent.
@label=HeldEntityYExtent
g$72E9 DEFB $00

; Display Buffer Select Flag
;
; Selects which display buffer is active when swapping primary /
; secondary.
@label=DisplayBufferSelectFlag
g$72EA DEFB $00

; Message Colour
;
; Attribute used when printing messages.
@label=MessageColour
g$72EB DEFB $00

; Door Interaction Delay
;
; Short countdown used by #R$ECDB. Set to #N$01–#N$02 at #R$ED9B after a
; room change; while non-zero #R$ED19 decrements it and skips the rest of that
; interaction pass.
@label=DoorInteractionDelay
g$72EC DEFB $00

; Camera Y Coordinate
;
; Camera Y coordinate.
@label=CameraYCoordinate
g$72ED DEFB $00

; Camera X Coordinate
;
; Camera X coordinate.
@label=CameraXCoordinate
g$72EE DEFB $00

; Unused
u$72EF DEFB $00

; Task Timer
;
; Task timer. Incremented at #R$AC65. #R$AC69 compares it with #N$A0
; for the timeout path. #R$ACA2 also reads it for the status attribute strip.
; Reset to #N$00 at #R$AD48. Not the pseudo-random seed at #R$EAE2.
@label=TaskTimer
g$72F0 DEFB $00

; Task Progress Repeat Count
;
; Cleared at #R$E2A4 and loaded at #R$E2C6 from the byte at the address
; the message stream names. #R$AE6A returns if it is zero. Otherwise each
; pass of the loop at #R$AEAF sets the bonus at #R$72DB, reprints it and
; calls #R$AECC.
@label=TaskProgressRepeatCount
g$72F1 DEFB $00

; Game Tick Counter
;
; Game tick counter.
@label=GameTickCounter
g$72F2 DEFB $00

; High Score
;
; High score.
@label=HighScore
g$72F3 DEFW $0000

; Pointer: Current Display Buffer
;
; Pointer to the current display-buffer base used while drawing layouts.
@label=Pointer_CurrentDisplayBuffer
g$72F5 DEFW $0000

; Stored Drawing Coordinates
;
; Base x/y character coordinates used while processing graphic layout data
; (#REGh = x, #REGl = y).
@label=StoredDrawingCoordinates
g$72F7 DEFW $0000

; Pointer: Current Character Set
;
; Pointer to the character set currently used for text output.
@label=Pointer_CurrentCharacterSet
g$72F9 DEFW $0000

; Pointer: Camera Room Origin
;
; Pointer to the camera room origin used while drawing.
@label=Pointer_CameraRoomOrigin
g$72FB DEFW $0000

; Pointer: Script Loop Restart
;
; Script-data address saved by #R$EC53 so #R$EC61 (End Script Loop) can
; reload #REGhl and repeat the body while #R$7301 remains non-zero.
@label=Pointer_ScriptLoopRestart
g$72FD DEFW $0000

; Pointer: Graphic Layout Loop Start
;
; Saved position in graphic layout data at the start of a loop (opcodes
; #N$EE / #N$EF).
@label=Pointer_GraphicLayoutLoopStart
g$72FF DEFW $0000

; Script Loop Counter
;
; Remaining iterations for a script-level loop. Loaded from the operand of
; #R$EC53; decremented by #R$EC61 until it hits zero.
@label=ScriptLoopCounter
g$7301 DEFB $00

; Graphic Layout Loop Counter
;
; Remaining iterations for the current graphic layout loop (opcodes
; #N$EE / #N$EF).
@label=GraphicLayoutLoopCounter
g$7302 DEFB $00

; Berk X Coordinate Copy
;
; Copy of Berk's X coordinate used by camera-follow logic.
@label=BerkXCoordinateCopy
g$7303 DEFB $00

; Berk X-Extent Copy
;
; Copy of the camera-follow entity's x-extent (#REGix+#N$08), written by
; #R$B41A alongside #R$7303. Not a Y coordinate.
@label=BerkXExtentCopy
g$7304 DEFB $00

; Berk Room Index Copy
;
; Copy of Berk's room index used by camera-follow logic.
@label=BerkRoomIndexCopy
g$7305 DEFB $00

; Current Graphic Set Index
;
; Index of the graphic set currently selected by graphic layout opcode
; #N$F4. Written into the display buffer with each tile; #R$E9EF looks up the
; set base in #R$730B.
@label=CurrentGraphicSetIndex
g$7306 DEFB $00

; Current Text Attribute
;
; Attribute applied when printing menu / HUD text.
@label=CurrentTextAttribute
g$7307 DEFB $00

; Current Attribute
;
; Attribute byte currently selected by graphic layout opcode #N$F2.
; Written into the display buffer with each tile; #N$00 means "use the
; attribute from the graphic data".
@label=CurrentAttribute
g$7308 DEFB $00

; Pending Sound Index
;
; Sound index queued by #R$F8F9 for #R$F9AF (#N$00 = idle). Bit #N$07
; marks a force-queue from #R$F8F9.
@label=PendingSoundIndex
g$7309 DEFB $00

; Camera Follow Delay
;
; Camera-follow delay countdown.
@label=CameraFollowDelay
g$730A DEFB $00

; Table: Addresses of Graphic Sets
;
; Base addresses for graphic sets #N$00–#N$06. #R$E9EF indexes this table
; with (set × #N$02) when blitting a display-buffer tile. Layout opcode
; #N$F4 writes the set index to #R$7306. Index #N$00 is a never-selected
; placeholder so the live sets stay on #N$01–#N$06 matching the #N$F4
; operands. #N$F4 never selects set #N$00.
; #TABLE(default,centre,centre,centre,centre)
; { =h Set | =h Base | =h Tiles | =h Notes }
; { #N$00 | #N($0000,$04,$04) | — | Placeholder }
; { #N$01 | #R$7C51 | #N$B3 | Room scenery / props }
; { #N$02 | #R$81E9 | #N$8F | Shared scenery tiles }
; { #N$03 | #R$7419 | #N$A8 | Berk, Drutt, doors, most entities }
; { #N$04 | #R$7959 | #N$5F | Additional scenery }
; { #N$05 | #R$8661 | #N$65 | Trap door / scenery variants }
; { #N$06 | #R$8989 | #N$3C | Extra tiles }
; TABLE#
@label=Table_GraphicSetAddresses
w$730B DEFW $0000    ; Graphics set #N$00: placeholder (never selected by #N$F4; base
                     ; #N($0000,$04,$04)).
 $730D DEFW $7C51    ; Graphics set #N$01: room scenery / props; see #R$7C51.
 $730F DEFW $81E9    ; Graphics set #N$02: shared scenery tiles; see #R$81E9.
 $7311 DEFW $7419    ; Graphics set #N$03: Berk, Drutt, doors, most entities;
                     ; see #R$7419.
 $7313 DEFW $7959    ; Graphics set #N$04: additional scenery; see #R$7959.
 $7315 DEFW $8661    ; Graphics set #N$05: trap door / scenery variants, see
                     ; #R$8661.
 $7317 DEFW $8989    ; Graphics set #N$06: extra tiles; see #R$8989.

; Bitmap Mirror Image Lookup Table
;
; Entry n holds n with its eight bits in reverse order, so bit #N$07
; swaps with bit #N($00), bit #N$06 with bit #N($01), and so on. #R$EA23
; passes each of a tile's eight bitmap bytes through it when the tile's
; attribute bit #N$07 is set, which draws the tile mirrored left to right, so
; one copy of the graphics serves both facing directions.
@label=BitmapMirrorLookup
