                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C710 DEFB $FB,$9D,$C7                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C713 DEFB $F8,$D1,$C8                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C716 DEFB $F4,$05                                                                     ; Set the
                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C718 DEFB $FB,$D7,$C7                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C71B DEFB $F8,$D1,$C8                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C71E DEFB $F0,$13                                                                     ; Queue
                                                                                        ; sound
                                                                                        ; #N(#PEEK(#PC+$01)).
 $C720 DEFB $F4,$05                                                                     ; Set the
                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C722 DEFB $FB,$D1,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C725 DEFB $F3,$00,$05,$9D,$C7,$FD,$C7,$D7,$C7,$32,$C8,$9D,$C7                         ; Increment the index and jump to one of #R$C79D, #R$C7FD,
                                                                                        ; #R$C7D7, #R$C832, #R$C79D.
 $C732 DEFB $F0,$13                                                                     ; Queue
                                                                                        ; sound
                                                                                        ; #N(#PEEK(#PC+$01)).
 $C734 DEFB $F4,$05                                                                     ; Set the
                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C736 DEFB $FB,$D1,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C739 DEFB $F3,$00,$05,$9D,$C7,$32,$C8,$D7,$C7,$FD,$C7,$9D,$C7                         ; Increment the index and jump to one of #R$C79D, #R$C832,
                                                                                        ; #R$C7D7, #R$C7FD, #R$C79D.
 $C746 DEFB $FB,$FD,$C7                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C749 DEFB $F8,$96,$C7                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C74C DEFB $FB,$FD,$C7                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C74F DEFB $F8,$ED,$C8                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C752 DEFB $FB,$32,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C755 DEFB $F8,$96,$C7                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C758 DEFB $FB,$32,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C75B DEFB $F8,$ED,$C8                                                                 ; Jump to
                                                                                        ; the layout
                                                                                        ; at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
 $C75E DEFB $F4,$05                                                                     ; Set the
                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C760 DEFB $FE,$01,$00                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically, and store as the base coordinates.
 $C763 DEFB $FB,$32,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C766 DEFB $FE,$FF,$00                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically, and store as the base coordinates.
 $C769 DEFB $FB,$ED,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C76C DEFB $FA,$02,$FA                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically.
 $C76F DEFB $F3,$00,$04,$A7,$C9,$E5,$C9,$C6,$C9,$04,$CA                                 ; Increment the index and jump to one of #R$C9A7, #R$C9E5,
                                                                                        ; #R$C9C6, #R$CA04.
 $C77A DEFB $F4,$05                                                                     ; Set the
                                                                                        ; graphic
                                                                                        ; set to
                                                                                        ; #GRAPHICSET(#PEEK(#PC+$01)).
 $C77C DEFB $FE,$01,$00                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically, and store as the base coordinates.
 $C77F DEFB $FB,$FD,$C7                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C782 DEFB $FE,$FF,$00                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically, and store as the base coordinates.
 $C785 DEFB $FB,$ED,$C8                                                                 ; Process the nested layout at
                                                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $C788 DEFB $FA,$02,$09                                                                 ; Move the cursor by
                                                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                        ; horizontally and
                                                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                        ; vertically.
 $C78B DEFB $F3,$00,$04,$2B,$C9,$69,$C9,$4A,$C9,$88,$C9                                 ; Increment the index and jump to one of #R$C92B, #R$C969,
                                                                                        ; #R$C94A, #R$C988.
