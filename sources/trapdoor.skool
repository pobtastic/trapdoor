 $7399 DEFB %00000001,%10000001,%01000001,%11000001,%00100001,%10100001,%01100001,%11100001
 $73A1 DEFB %00010001,%10010001,%01010001,%11010001,%00110001,%10110001,%01110001,%11110001
 $73A9 DEFB %00001001,%10001001,%01001001,%11001001,%00101001,%10101001,%01101001,%11101001
