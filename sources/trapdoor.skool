 $E873 LD A,(IX+$01) ; Load #REGa with the current entity's flags byte 1.
 $E876 ADD A,H       ; #REGa+=#REGh.
 $E877 LD H,A        ; Copy #REGa into #REGh.
 $E878 JP $E73B      ; Jump to #R$E73B to advance the graphic layout pointer
                     ; and continue.
; View the equivalent code in;
; #LIST
; { #FLUNKY$9AF9 }
; LIST#

; Graphic Layout Routine: (#N$FE) Adjust Coordinates And Store
;
