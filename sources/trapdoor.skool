; Update Vat
;
; Used by the routine at #R$CF37.
; .
; Animate the vat entity for the current room: bubble state, contained
; objects and whether Berk can interact.
@label=Update_Vat
c$D012 LD HL,($72D3)  ; Load #REGhl with the Drutt script-position pointer
                      ; (#R$72D3).
 $D015 LD ($72CF),HL  ; Store #REGhl in the active script cursor (#R$72CF).
 $D018 LD IX,$8FC9    ; Point #REGix at the crusher entity (#R$8FC9).
 $D01C LD A,(IX+$00)  ; Fetch the current entity's type for the type test.
 $D01F CP $0C         ; {Is the current entity's entity type equal to #N$0C? If not, jump to
 $D021 JR NZ,$D040    ; #R$D040.}
 $D023 BIT 7,(IX+$01) ; {Is bit #N$07 of the current entity's flags byte 1 set? If so, jump
 $D027 JR NZ,$D030    ; to #R$D030.}
 $D029 BIT 0,(IX+$02) ; {Is bit #N$00 of the current entity's flags byte 2 set? If not,
 $D02D JP Z,$EC2E     ; jump to #R$EC2E.}
; Run the Drutt script at #R$CF44 for an active type-#N$0C entity.
@label=Update_Drutt_RunScript
*$D030 LD HL,$CF44    ; Point #REGhl at the Drutt script (#R$CF44).
 $D033 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Crusher Entity Template
;
; Ten-byte entity template copied into the crusher slot by #R$D040.
@label=Data_CrusherEntityTemplate
b$D036 DEFB $0C,$03,$00,$00,$04,$26,$26,$6E ; {Bytes: #N($0C), #N($03), #N($00), #N($00), #N($04), #N($26),
 $D03E DEFB $6E,$00                         ; #N($26), #N($6E), #N($6E), #N$00.
                                            ; }

; Update Vat: Event And Direction
;
; Used by the routine at #R$D012.
; .
; When the vat entity is not type #N($0C), test game-event / direction
; bits and either copy the #R$D036 template into the crusher slot or randomly
; set direction bit #N$00.
;
; .
;
; Load game-event flags and test direction bit #N$00.
@label=Update_Vat_TestEventAndDirBit0
c$D040 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D043 BIT 0,(IX+$09) ; Is bit #N$00 of the current entity's direction / state
                      ; set?.
 $D047 JR Z,$D05D     ; If not, jump to #R$D05D.
 $D049 BIT 1,A        ; Is bit #N$01 of #REGa set?.
 $D04B RET Z          ; If not, return.
 $D04C LD DE,$8FC9    ; Point #REGde at the crusher entity (#R$8FC9).
 $D04F LD HL,$D036    ; Point #REGhl at the vat template (#R$D036).
 $D052 LD BC,$000A    ; Load #REGbc with length #N($000A,$04,$04).
 $D055 LDIR           ; Copy the template into the crusher entity slot.
 $D057 LD HL,$CF88    ; Point #REGhl at #R$CF88.
 $D05A JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Randomly set direction bit #N$00 when bit #N$01 of #REGa is clear.
@label=Update_Vat_RandomSetDirBit0
*$D05D BIT 1,A        ; Is bit #N$01 of #REGa set?.
 $D05F RET NZ         ; If so, return.
 $D060 LD A,$3C       ; Load #REGa with #N$3C.
 $D062 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $D065 OR A           ; Is #REGa zero?.
 $D066 RET NZ         ; If not, return.
 $D067 SET 0,(IX+$09) ; Set bit #N$00 of the current entity's direction /
                      ; state.
 $D06B RET            ; Return.

; Script Routine: (#N$47) Vat action
;
; Play the vat's action sound, then continue its script.
;
; .
;
; #HTML(#AUDIO0(vat.wav)(#INCLUDE(Vat)))
@label=ScriptRoutine_VatQueueSound
c$D06C LD A,$11      ; Load #REGa with sound index #N$11.
 $D06E CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $D071 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$3E) Vat action
;
; Scan nearby entity slots for something the vat can interact with.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatScanNearbySlots
c$D074 LD E,$FF        ; Load #REGe with #N$FF.
 $D076 LD IY,$8F9F     ; Point #REGiy at an inactive complex-entity slot
                       ; (#R$8F9F).
 $D07A LD B,$03        ; Load #REGb with #N$03 as a loop counter.
; Scan nearby type-#N$0B slots for the closest X neighbour within #N$28 of
; the vat.
@label=ScriptRoutine_VatScanNearbySlots_ScanEntitySlot
*$D07C PUSH BC         ; Stash #REGbc on the stack.
 $D07D LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $D080 CP $0B          ; {Is referenced entity's entity type equal to #N$0B? If not, jump to
 $D082 JR NZ,$D0A8     ; #R$D0A8.}
 $D084 BIT 7,(IY+$01)  ; {Is bit #N$07 of the referenced entity's flags byte 1 set? If so,
 $D088 JR NZ,$D0A8     ; jump to #R$D0A8.}
 $D08A LD A,(IY+$05)   ; Load #REGa with the referenced entity's y-coordinate.
 $D08D CP $1D          ; {Is referenced entity's y-coordinate less than #N$1D? If so, jump to
 $D08F JR C,$D0A8      ; #R$D0A8.}
 $D091 LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $D094 SUB (IY+$07)    ; Subtract the referenced entity's x-coordinate from
                       ; #REGa.
 $D097 LD D,A          ; Copy the signed x-delta into #REGd (bit #N$07 = sign).
 $D098 JR NC,$D09C     ; Jump to #R$D09C if the subtraction did not underflow.
 $D09A NEG             ; Negate #REGa to get abs(x-delta).
; Keep the nearest in-range candidate in #REGe / #R$CF35.
@label=ScriptRoutine_VatScanNearbySlots_TrackBestAbsDeltaX
*$D09C CP $28          ; {Is abs(x-delta) less than #N$28? If not, jump to
 $D09E JR NC,$D0A8     ; #R$D0A8.}
 $D0A0 CP E            ; {Is abs(x-delta) greater than or equal to the best-so-far in #REGe?
 $D0A1 JR NC,$D0A8     ; If so, jump to #R$D0A8.}
 $D0A3 LD E,A          ; Store this abs(x-delta) as the new best in #REGe.
 $D0A4 LD ($CF35),IY   ; Store #REGiy in the miscellaneous-entity temp pointer
                       ; (#R$CF35).
; Advance to the next candidate slot and finish the scan when #REGb hits
; zero.
@label=ScriptRoutine_VatScanNearbySlots_AdvanceEntitySlot
*$D0A8 LD BC,$000E     ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                       ; length into #REGbc.
 $D0AB ADD IY,BC       ; Add the offset in #REGbc to the entity pointer in
                       ; #REGiy.
 $D0AD POP BC          ; Restore #REGbc from the stack.
 $D0AE DJNZ $D07C      ; Decrease the loop counter in #REGb and jump to #R$D07C if more
                       ; iterations remain.
 $D0B0 LD A,$28        ; Load #REGa with #N$28 (no-candidate sentinel matching the initial
                       ; #REGe).
 $D0B2 CP E            ; {Was no nearer entity found (#REGe still #N$28)? If carry set, jump
 $D0B3 JP C,$D124      ; to #R$D124.}
 $D0B6 LD IY,($CF35)   ; Load #REGiy from #R$CF35.
 $D0BA LD A,(IX+$04)   ; Load #REGa with the current entity's room index.
 $D0BD CP (IY+$04)     ; {Does the candidate share this entity's room (#REGiy+#N$04)? If so,
 $D0C0 JR Z,$D0D0      ; jump to #R$D0D0.}
 $D0C2 JR C,$D0CA      ; Jump to #R$D0CA if the result underflowed.
 $D0C4 SET 3,(IX+$09)  ; Set bit #N$03 of the current entity's direction /
                       ; state.
 $D0C8 JR $D0F0        ; Jump to #R$D0F0 to continue this routine.
; Candidate is in a lower room: set direction bit #N$02 before choosing a
; chase script.
@label=ScriptRoutine_VatScanNearbySlots_SetDirBit2
*$D0CA SET 2,(IX+$09)  ; Set bit #N$02 of the current entity's direction /
                       ; state.
 $D0CE JR $D0F0        ; Jump to #R$D0F0 to continue this routine.
; Same-room and aligned in X: clear the candidate type and run the capture
; script; else check Y.
@label=ScriptRoutine_VatScanNearbySlots_SameRoomCheckY
*$D0D0 LD A,E          ; Copy the best abs(x-delta) from #REGe into #REGa.
 $D0D1 OR A            ; {Is the best abs(x-delta) zero? If not, jump to
 $D0D2 JR NZ,$D0F0     ; #R$D0F0.}
 $D0D4 LD A,(IX+$05)   ; Load #REGa with the current entity's y-coordinate.
 $D0D7 CP (IY+$05)     ; {Does this entity's y match the candidate's y (#REGiy+#N$05)? If not,
 $D0DA JR NZ,$D0E6     ; jump to #R$D0E6.}
 $D0DC LD (IY+$00),$00 ; Write #N$00 to the referenced entity's entity type.
 $D0E0 LD HL,$CFFE     ; Point #REGhl at Drutt script data #R$CFFE.
 $D0E3 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Same-room Y mismatch: set direction bit #N$06 and run the lift/absorb
; script.
@label=ScriptRoutine_VatScanNearbySlots_YMismatchSetBit6
*$D0E6 SET 6,(IX+$09)  ; Set bit #N$06 of the current entity's direction /
                       ; state.
 $D0EA LD HL,$CFBC     ; Point #REGhl at Drutt script data #R$CFBC.
 $D0ED JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Positive X-delta: randomly pick the copy script (#R$CF88) or the scan
; script (#R$CFAA).
@label=ScriptRoutine_VatScanNearbySlots_DeltaSignPlus
*$D0F0 BIT 7,D         ; {Is bit #N$07 of the signed x-delta in #REGd set? If so, jump to
 $D0F2 JR NZ,$D108     ; #R$D108.}
 $D0F4 LD A,$02        ; Load #REGa with #N$02 as the #R$EAE5 random maximum.
 $D0F6 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D0F9 OR A            ; {Is #REGa zero? If so, jump to #R$D102.
 $D0FA JR Z,$D102      ; }
 $D0FC LD HL,$CF88     ; Point #REGhl at Drutt script data #R$CF88.
 $D0FF JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run the vat-scan candidate script at #R$CFAA.
@label=ScriptRoutine_VatScanNearbySlots_RunScanScript
*$D102 LD HL,$CFAA     ; Point #REGhl at Drutt script data #R$CFAA.
 $D105 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Negative X-delta: randomly pick the near script (#R$CF54) or the
; alternate (#R$CF76).
@label=ScriptRoutine_VatScanNearbySlots_DeltaSignMinus
*$D108 LD A,$02        ; Load #REGa with #N$02 as the #R$EAE5 random maximum.
 $D10A CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D10D OR A            ; {Is #REGa zero? If so, jump to #R$D116.
 $D10E JR Z,$D116      ; }
 $D110 LD HL,$CF54     ; Point #REGhl at Drutt script data #R$CF54.
 $D113 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run the alternate near-range Drutt script at #R$CF76.
@label=ScriptRoutine_VatScanNearbySlots_RunAltScript
*$D116 LD HL,$CF76     ; Point #REGhl at Drutt script data #R$CF76.
 $D119 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
 $D11C LD D,H          ; Copy the high byte of the pointer into #REGd.
 $D11D RST $08         ; Call the restart routine.
 $D11E ADC A,B         ; Add #REGb into #REGa, including the previous success
                       ; marker.
 $D11F RST $08         ; Call the restart routine.
 $D120 JP C,$46CF      ; Jump to #N$46CF (screen buffer) if the result
                       ; underflowed.
 $D123 RST $08         ; Call the restart routine.
; No nearby candidate: rarely run a positional script, else index the
; random vat table.
@label=ScriptRoutine_VatScanNearbySlots_NoCandidateNearby
*$D124 LD A,$05        ; Load #REGa with #N$05 as the #R$EAE5 random maximum.
 $D126 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D129 OR A            ; {Is #REGa zero? If not, jump to #R$D13F.
 $D12A JR NZ,$D13F     ; }
 $D12C LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $D12F CP $70          ; {Is the current entity's x-coordinate less than #N$70? If so, jump to
 $D131 JR C,$D139      ; #R$D139.}
 $D133 LD HL,$CFAA     ; Point #REGhl at Drutt script data #R$CFAA.
 $D136 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Run the near-range Drutt script at #R$CF54 when the vat sits left of
; #N$70.
@label=ScriptRoutine_VatScanNearbySlots_RunNearScript
*$D139 LD HL,$CF54     ; Point #REGhl at Drutt script data #R$CF54.
 $D13C JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Pick a random word from the Drutt script table at #R$D11C and
; execute it.
@label=ScriptRoutine_VatScanNearbySlots_IndexTable
*$D13F LD A,$04        ; Load #REGa with #N$04 as the #R$EAE5 random maximum.
 $D141 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D144 ADD A,A         ; Double #REGa to form a word index into the table at
                       ; #R$D11C.
 $D145 LD E,A          ; Copy that word index into #REGe.
 $D146 LD D,$00        ; Clear #REGd (high byte of a pointer/offset).
 $D148 LD HL,$D11C     ; Point #REGhl at Drutt routine data #R$D11C.
 $D14B ADD HL,DE       ; Add the offset in #REGde to the pointer in #REGhl.
 $D14C LD E,(HL)       ; {Fetch the word at #REGhl into #REGde.
 $D14D INC HL          ;
 $D14E LD D,(HL)       ; }
 $D14F EX DE,HL        ; Swap the destination and source pointers in
                       ; #REGde/#REGhl.
 $D150 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

; Script Routine: (#N$43) Vat action
;
; Run the vat's room-transition sequence when its direction bit asks for
; it.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatRoomTransition
c$D153 BIT 2,(IX+$09) ; {Is bit #N$02 of the current entity's direction / state set? If so,
 $D157 JR NZ,$D186    ; jump to #R$D186.}
 $D159 BIT 3,(IX+$09) ; {Is bit #N$03 of the current entity's direction / state set? If not,
 $D15D JP Z,$EC2E     ; jump to #R$EC2E.}
 $D160 RES 3,(IX+$09) ; Reset bit #N$03 of the current entity's direction /
                      ; state.
 $D164 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $D167 CP $01         ; {Is the current entity's room index equal to #N$01? If so, jump to
 $D169 JP Z,$EC2E     ; #R$EC2E.}
 $D16C CALL $F25F     ; Call #R$F25F to adjust the camera Y coordinate.
 $D16F JP NC,$EC2E    ; If #R$F25F cleared carry, jump to #R$EC2E to run the next script
                      ; instruction.
 $D172 CALL $F25B     ; Call #R$F25B to adjust the camera X coordinate.
 $D175 JR C,$D17C     ; Jump to #R$D17C if the result underflowed.
 $D177 CP $1F         ; {Is the current entity's room index equal to #N$1F? If so, jump to
 $D179 JP Z,$EC2E     ; #R$EC2E.}
; Complete a downward room transition: move the vat back one room.
@label=ScriptRoutine_VatRoomTransition_DecRoom
*$D17C LD DE,$0004    ; Load #REGde with entity-field offset #N($0004,$04,$04).
 $D17F ADD HL,DE      ; Add the offset in #REGde to the pointer in #REGhl.
 $D180 DEC (IX+$04)   ; Move this entity back one room.
 $D183 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Clear direction bit #N$02 and try an upward room transition when not
; already in room #N$05.
@label=ScriptRoutine_VatRoomTransition_ClearDirBit2
*$D186 RES 2,(IX+$09) ; Reset bit #N$02 of the current entity's direction /
                      ; state.
 $D18A LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $D18D CP $05         ; {Is the current entity's room index equal to #N$05? If so, jump to
 $D18F JP Z,$EC2E     ; #R$EC2E.}
 $D192 CALL $F2C7     ; Call #R$F2C7 to test collectible / room collision.
 $D195 JP NC,$EC2E    ; If #R$F2C7 cleared carry, jump to #R$EC2E to run the next script
                      ; instruction.
 $D198 CALL $F2C2     ; Call #R$F2C2 to set Entity Attribute Byte.
 $D19B JR C,$D1A2     ; Jump to #R$D1A2 if the result underflowed.
 $D19D CP $1F         ; {Is the current entity's room index equal to #N$1F? If so, jump to
 $D19F JP Z,$EC2E     ; #R$EC2E.}
; Complete an upward room transition: advance the vat into the next room.
@label=ScriptRoutine_VatRoomTransition_IncRoom
*$D1A2 LD DE,$0008    ; Load #REGde with #N($0008,$04,$04) as a field offset within an
                      ; entity.
 $D1A5 ADD HL,DE      ; Add the offset in #REGde to the pointer in #REGhl.
 $D1A6 INC (IX+$04)   ; Advance this entity into the next room.
 $D1A9 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$40) Vat shift right when clear above
;
; Probe above with #R$F38D. On a clear miss (carry set) jump to #R$D1B5 to
; shift the vat right, then drop Y at #R$D1CC. On a hit, if the distance in
; #REGa is still under #N$32 continue into that same nudge; otherwise jump
; straight to #R$D1CC to drop Y only.
;
; IX Address of complex state data for an entity
;
; Probe above; carry set = miss (path clear).
@label=ScriptRoutine_VatIncXIfClearAbove
c$D1AC CALL $F38D    ; Call #R$F38D to test whether a solid entity sits above
                     ; this vat.
 $D1AF JR C,$D1B5    ; Was the space above clear (carry set)? If so, jump to #R$D1B5 to
                     ; shift right.
 $D1B1 CP $32        ; {On a hit: is the distance in #REGa still under #N$32? If not, jump
 $D1B3 JR NC,$D1CC   ; to #R$D1CC to drop Y only (skip the nudge).}
; Shift right (reached by jump on miss, or when A<#N$32 on a hit), then
; drop Y.
@label=ScriptRoutine_VatIncXIfClearAbove_IncX
*$D1B5 INC (IX+$07)  ; {Move the vat one character right.
 $D1B8 INC (IX+$08)  ; }
 $D1BB JR $D1CC      ; Jump to #R$D1CC to decrease y / y-extent.

; Script Routine: (#N$3F) Vat action
;
; Slide the vat one character left when the left side is clear.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatDecXIfClearLeft
c$D1BD CALL $F32A    ; Call #R$F32A to test whether a solid entity sits on the
                     ; left.
 $D1C0 JR C,$D1C6    ; Is the space on the left clear (carry set)? If so, jump to #R$D1C6
                     ; to shift left.
 $D1C2 CP $32        ; {Is #REGa less than #N$32? If not, jump to #R$D1CC.
 $D1C4 JR NC,$D1CC   ; }
; Shift the vat one character left when the left side is clear (or close).
@label=ScriptRoutine_VatDecXIfClearLeft_DecX
*$D1C6 DEC (IX+$07)  ; {Move this entity one character left.
 $D1C9 DEC (IX+$08)  ; }

; Script Routine: (#N$45) Vat action
;
; Used by the routines at #R$D1AC and #R$D1BD.
; .
; Lower the vat one character.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatDecY
c$D1CC DEC (IX+$05)  ; {Move this entity one character up.
 $D1CF DEC (IX+$06)  ; }
 $D1D2 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$42) Vat action
;
; Slide the vat right when the space above is clear, then raise it.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatIncXIfClearAboveThenRise
c$D1D5 CALL $F38D    ; Call #R$F38D to test whether a solid entity sits above.
 $D1D8 JR C,$D1DE    ; Is the space above clear (carry set)? If so, jump to #R$D1DE to
                     ; shift right.
 $D1DA CP $32        ; {Is #REGa less than #N$32? If not, jump to #R$D1F5.
 $D1DC JR NC,$D1F5   ; }
; Shift the vat one character right when the space above is clear (or
; close), then rise.
@label=ScriptRoutine_VatIncXIfClearAboveThenRise_IncX
*$D1DE INC (IX+$07)  ; {Move this entity one character right.
 $D1E1 INC (IX+$08)  ; }
 $D1E4 JR $D1F5      ; Jump to #R$D1F5 to increase y / y-extent.

; Script Routine: (#N$41) Vat action
;
; Slide the vat left when the left side is clear, then raise it.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatDecXIfClearLeftThenRise
c$D1E6 CALL $F32A    ; Call #R$F32A to test whether a solid entity sits on the
                     ; left.
 $D1E9 JR C,$D1EF    ; Is the space on the left clear (carry set)? If so, jump to #R$D1EF
                     ; to shift left.
 $D1EB CP $32        ; {Is #REGa less than #N$32? If not, jump to #R$D1F5.
 $D1ED JR NC,$D1F5   ; }
; Shift the vat one character left when the left side is clear (or close),
; then rise.
@label=ScriptRoutine_VatDecXIfClearLeftThenRise_DecX
*$D1EF DEC (IX+$07)  ; {Move this entity one character left.
 $D1F2 DEC (IX+$08)  ; }

; Script Routine: (#N$44) Vat action
;
; Used by the routines at #R$D1D5 and #R$D1E6.
; .
; Raise the vat one character.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatIncY
c$D1F5 INC (IX+$05)  ; {Move this entity one character down.
 $D1F8 INC (IX+$06)  ; }
 $D1FB JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$46) Vat action
;
; Clear the vat's busy bit and reset it onto the post-reset script at
; #R$CFF4.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_VatClearBit6AndReset
c$D1FE BIT 6,(IX+$09)  ; {Is bit #N$06 of the current entity's direction / state set? If not,
 $D202 JP Z,$EC2E      ; jump to #R$EC2E.}
 $D205 RES 6,(IX+$09)  ; Reset bit #N$06 of the current entity's direction /
                       ; state.
 $D209 PUSH IX         ; Stash #REGix on the stack.
 $D20B LD IX,($CF35)   ; Load #REGix from #R$CF35.
 $D20F LD (IX+$00),$00 ; Write #N$00 to the current entity's entity type.
 $D213 BIT 5,(IX+$01)  ; {Is bit #N$05 of the current entity's flags byte 1 set? If not,
 $D217 JR Z,$D227      ; jump to #R$D227.}
 $D219 LD IX,$909B     ; Point #REGix at the camera-follow entity (#R$909B).
 $D21D SET 0,(IX+$03)  ; Set bit #N$00 of the current entity's flags byte 3.
 $D221 LD HL,$BA35     ; Point #REGhl at Berk script data #R$BA35.
 $D224 LD ($72B1),HL   ; Store #REGhl in Berk's script position pointer
                       ; (#R$72B1).
; Restore #REGix, queue the vat sound, and run the post-reset script at
; #R$CFF4.
@label=ScriptRoutine_VatClearBit6AndReset_RestoreQueueSound
*$D227 POP IX          ; Restore #REGix from the stack.
; #HTML(#AUDIO0(vat.wav)(#INCLUDE(Vat)))
 $D229 LD A,$11        ; Load #REGa with sound index #N$11.
 $D22B CALL $F8F9      ; Call #R$F8F9 to queue a sound effect.
 $D22E LD HL,$CFF4     ; Point #REGhl at Drutt script data #R$CFF4.
 $D231 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

; Data: Drutt Script / Animation
;
; Drutt's script and animation data. Referenced from Drutt's script
; animation table and the code that drives those frames.
;
; .
;
; #UDGTABLE
; { #SCRIPTANIM$D234(script-d234) }
; UDGTABLE#
@label=Data_DruttScriptAnim
b$D234 DEFB $F0,$0D                                     ; Queue sound
                                                        ; #N(#PEEK(#PC+$01)).
 $D236 DEFB $FB,$45,$D3                                 ; Process the nested layout at
                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $D239 DEFB $FA,$00,$FF                                 ; Move the cursor by
                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                        ; horizontally and
                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                        ; vertically.
 $D23C DEFB $2D,$06,$22                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D23F DEFB $2D,$86,$21                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D242 DEFB $FF                                         ; Load the stored
                                                        ; coordinates and
                                                        ; return.
; #UDGTABLE
; { #LAYOUT$43,$D2(layout-d243) }
; UDGTABLE#
 $D243 DEFB $FE,$FF,$00                                 ; Move the cursor by
                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                        ; horizontally and
                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                        ; vertically, and store as the base coordinates.
 $D246 DEFB $FB,$45,$D3                                 ; Process the nested layout at
                                                        ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $D249 DEFB $FA,$00,$FF                                 ; Move the cursor by
                                                        ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                        ; horizontally and
                                                        ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                        ; vertically.
 $D24C DEFB $26,$06,$22                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D24F DEFB $26,$86,$1E                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D252 DEFB $2E,$06,$21                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D255 DEFB $2F,$06,$21                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D258 DEFB $2E,$86,$21                                 ; Draw tile #N(#PEEK(#PC)) with
                                                        ; #COLOUR(#PEEK(#PC+$01)) (#N(#PEEK(#PC+$01))) and move
                                                        ; #TILESTEP(#PEEK(#PC+$02),#PEEK(#PC+$01)).
 $D25B DEFB $FF                                         ; Load the stored
                                                        ; coordinates and
                                                        ; return.
; #UDGTABLE
; { #LAYOUT$5C,$D2(layout-d25c) }
; UDGTABLE#
