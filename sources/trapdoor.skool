; Check Entity Collision
;
; Used by the routine at #R$B2AA.
; .
; Check Entity Collision against the complex entity table at #R$8EE9.
;
; .
;
; Called from #R$B380 on a type-#N$08 / type-#N$0B pair: set bit #N$07 of
; #R$72B8, bump #R$72BD, and on the third bump set bit #N$06 of #R$72B8
; (cleared by #R$EDB8).
@label=Check_Entity_Collision
c$D446 PUSH HL       ; Stash #REGhl on the stack.
 $D447 LD HL,$72B8   ; Point #REGhl at task-one / collision flags (#R$72B8).
 $D44A SET 7,(HL)    ; Set bit #N$07 of #R$72B8.
 $D44C LD A,($72BD)  ; Load the collision scratch byte (#R$72BD) into #REGa.
 $D44F INC A         ; Advance that counter by one.
 $D450 LD ($72BD),A  ; Store the counter back to #R$72BD.
 $D453 CP $03        ; {Has #R$72BD reached #N$03? If not, jump to #R$D459.
 $D455 JR NZ,$D459   ; }
 $D457 SET 6,(HL)    ; Set bit #N$06 of #R$72B8.
; Restore #REGhl and return after recording the type-#N$08 / #N$0B
; collision.
@label=Check_Entity_Collision_RestoreReturn
*$D459 POP HL        ; Restore #REGhl from the stack.
 $D45A RET           ; Return.

; Update Collectibles
;
; Used by the routine at #R$CF37.
; .
; Update Collectibles against the complex entity table at #R$8EE9.
@label=Update_Collectibles
c$D45B LD HL,$72DF   ; Point #REGhl at collectible slot state (#R$72DF).
 $D45E LD IX,$8F9F   ; Point #REGix at an inactive complex-entity slot
                     ; (#R$8F9F).
 $D462 LD B,$03      ; Load #REGb with #N$03 as a loop counter.
; For each collectible slot: reload its script cursor / counter, run
; #R$D48E, then save them back.
@label=Update_Collectibles_Scan
*$D464 PUSH BC       ; Stash #REGbc on the stack.
 $D465 LD C,(HL)     ; {Fetch the word at #REGhl into #REGbc.
 $D466 INC HL        ;
 $D467 LD B,(HL)     ; }
 $D468 INC HL        ; Advance #R$72DF by one byte.
 $D469 LD A,(HL)     ; Fetch the next byte from #R$72DF.
 $D46A LD ($72BC),A  ; Set the collectible counter (#R$72BC).
 $D46D LD ($72CF),BC ; Store #REGbc in the active script cursor (#R$72CF).
 $D471 PUSH HL       ; Stash #REGhl on the stack.
 $D472 CALL $D48E    ; Call #R$D48E to collect Entity.
 $D475 POP HL        ; Restore #REGhl from the stack.
 $D476 LD A,($72BC)  ; Load #REGa with the collectible counter (#R$72BC).
 $D479 LD (HL),A     ; Write collectible counter through #R$72DF.
 $D47A DEC HL        ; Step #R$72DF back by one byte.
 $D47B LD BC,($72CF) ; Load #REGbc with the active script cursor (#R$72CF).
 $D47F LD (HL),B     ; Write the loop counter through the pointer in #REGhl.
 $D480 DEC HL        ; Step #R$72DF back by one byte.
 $D481 LD (HL),C     ; Write the saved count in #REGc through the pointer in
                     ; #REGhl.
 $D482 INC HL        ; {Advance #REGhl onto the next collectible slot record.
 $D483 INC HL        ;
 $D484 INC HL        ; }
 $D485 LD BC,$000E   ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                     ; length into #REGbc.
 $D488 ADD IX,BC     ; Advance #REGix to the next entity record.
 $D48A POP BC        ; Restore #REGbc from the stack.
 $D48B DJNZ $D464    ; Decrease the loop counter in #REGb and jump to #R$D464 if more
                     ; iterations remain.
 $D48D RET           ; Return.

; Collect Entity
;
; Used by the routine at #R$D45B.
; .
; Collect Entity against the complex entity table at #R$8EE9.
;
; IX Address of complex state data for an entity
;
; Awards score and clears a collectible when Berk touches it.
@label=Collect_Entity
c$D48E LD DE,($72FB)   ; Load #REGde with the camera room-origin pointer
                       ; (#R$72FB).
 $D492 LD L,C          ; Copy the low byte from #REGc into #REGl (build
                       ; #REGhl).
 $D493 LD H,B          ; Copy the high byte from #REGb into #REGh (build
                       ; #REGhl).
 $D494 LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $D497 LD B,A          ; Keep game event flags in #REGb for later.
 $D498 LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $D49B BIT 7,A         ; {Is bit #N$07 of the current entity's entity type set?
 $D49D RET NZ          ; If so, return.}
 $D49E OR A            ; {Is the current entity's entity type zero? If so, jump
 $D49F JR Z,$D4AF      ; to #R$D4AF.}
 $D4A1 CP $0B          ; {Is the current entity's entity type equal to #N$0B? If so, jump to
 $D4A3 JR Z,$D4C2      ; #R$D4C2.}
 $D4A5 BIT 1,B         ; {Is bit #N$01 of the loop/flags byte in #REGb set? If so, jump to
 $D4A7 JP NZ,$EC2E     ; #R$EC2E.}
 $D4AA LD (IX+$00),$00 ; Write #N$00 to the current entity's entity type.
 $D4AE RET             ; Return.
; Empty slot with bit #N$05 set: under the event latch, become type #N$0A
; and clear that bit.
@label=Collect_Entity_TypeZeroBit5
*$D4AF BIT 5,(IX+$03)  ; {Is bit #N$05 of flags byte 3 (#REGix+#N$03) set? If not, jump to
 $D4B3 JP Z,$D518      ; #R$D518.}
 $D4B6 BIT 1,B         ; {Is bit #N$01 of the loop/flags byte in #REGb set? If
 $D4B8 RET Z           ; not, return.}
 $D4B9 LD (IX+$00),$0A ; Write #N$0A to the current entity's entity type.
 $D4BD RES 5,(IX+$03)  ; Reset bit #N$05 of flags byte 3 (#REGix+#N$03).
 $D4C1 RET             ; Return.
; Type-#N$0B collectible: score it, branch on flags, or tick its counter /
; wander script.
@label=Collect_Entity_AsHeld
*$D4C2 LD A,(IX+$01)   ; Load #REGa with the current entity's flags byte 1.
 $D4C5 BIT 6,A         ; {Is bit #N$06 of the current entity's flags byte 1 set? If so, jump
 $D4C7 JR NZ,$D4D4     ; to #R$D4D4.}
 $D4C9 AND %10100000   ; Keep only bits #N$07 and #N$05 of that flags byte
                       ; (mask #N$A0).
 $D4CB JR NZ,$D4DA     ; If the result was non-zero, jump to #R$D4DA.
 $D4CD LD A,(IX+$06)   ; Load #REGa with the current entity's y-extent.
 $D4D0 CP $23          ; {Is the current entity's y-extent less than #N$23? If not, jump to
 $D4D2 JR NC,$D4E4     ; #R$D4E4.}
; Run the collectible score script at #R$D3C8.
@label=Collect_Entity_RunScoreScript
*$D4D4 LD HL,$D3C8     ; Point #REGhl at collectible/score table data
                       ; (#R$D3C8).
 $D4D7 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; Flagged type-#N$0B path: clear the counter and run the alternate score
; script at #R$D234(#N$D416).
@label=Collect_Entity_Branch
*$D4DA XOR A           ; Clear the collectible counter.
 $D4DB LD ($72BC),A    ; Set the collectible counter (#R$72BC).
 $D4DE LD HL,$D416     ; Point #REGhl at collectible/score table data
                       ; (#R$D234(#N$D416)).
 $D4E1 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
; High collectibles skip scripting while counter bit #N$07 is set.
@label=Collect_Entity_TestCounterBit7
*$D4E4 LD A,($72BC)    ; Load #REGa with the collectible counter (#R$72BC).
 $D4E7 BIT 7,A         ; {Is bit #N$07 of collectible counter set? If so, jump
 $D4E9 JP NZ,$EC2E     ; to #R$EC2E.}
; Tick the collectible counter down, or reseed it and launch a wander
; script when it hits zero.
@label=Collect_Entity_DecCounterOrScript
*$D4EC OR A            ; {Is collectible counter zero? If so, jump to #R$D4F6.
 $D4ED JR Z,$D4F6      ; }
 $D4EF DEC A           ; Step collectible counter back by one.
 $D4F0 LD ($72BC),A    ; Set the collectible counter (#R$72BC).
 $D4F3 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.
; Reseed the counter to #N$84 plus a random and run the wander script at
; #R$D234(#N$D3CE).
@label=Collect_Entity_RandomiseCounterScript
*$D4F6 LD A,$06        ; Load #REGa with #N$06 as the #R$EAE5 random maximum.
 $D4F8 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D4FB ADD A,$84       ; Add #N$84 to #REGa (build a score/message digit
                       ; address).
 $D4FD LD ($72BC),A    ; Set the collectible counter (#R$72BC).
 $D500 LD HL,$D3CE     ; Point #REGhl at collectible/score table data
                       ; (#R$D234(#N$D3CE)).
 $D503 JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.
 $D506 INC B           ; Advance the collectible-slot counter in #REGb.
 $D507 LD L,L          ; Keep #REGl unchanged (alignment byte in the compiled
                       ; routine).
 $D508 INC H           ; Advance the high byte of the pointer in #REGhl.
 $D509 LD (BC),A       ; Write the computed score/digit byte through #REGbc.
 $D50A LD HL,($05D4)   ; Load #REGhl from #N$05D4.
 $D50D LD L,L          ; Keep #REGl unchanged (alignment byte in the compiled
                       ; routine).
 $D50E DAA             ; Decimal-adjust #REGa after adding to a score digit.
 $D50F INC BC          ; Advance the counter/pointer in #REGbc by one.
 $D510 INC E           ; Advance the low byte of the pointer/offset in #REGde.
 $D511 CALL NC,$6B00   ; If not below, call #R$6B00.
 $D514 DEC H           ; Step the high byte of the score/table pointer back by
                       ; one.
 $D515 INC BC          ; Advance the counter/pointer in #REGbc by one.
 $D516 JR C,$D4EC      ; If a hit/borrow was signaled, jump to #R$D4EC.
; Idle empty slot: rarely raise bit #N$05 and copy spawn coordinates from
; table #R$D506.
@label=Collect_Entity_MaybeSetBit5
*$D518 BIT 1,B         ; {Is bit #N$01 of the loop/flags byte in #REGb set? If
 $D51A RET NZ          ; so, return.}
 $D51B LD A,$0A        ; Load #REGa with #N$0A.
 $D51D CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D520 OR A            ; {Is #N$0A zero? If not, return.
 $D521 RET NZ          ; }
 $D522 SET 5,(IX+$03)  ; Set bit #N$05 of flags byte 3 (#REGix+#N$03).
 $D526 LD A,$03        ; Load #REGa with #N$03.
 $D528 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $D52B ADD A,A         ; Double #N$03 (word index).
 $D52C LD C,A          ; Keep #N$03 in #REGc for later.
 $D52D ADD A,A         ; Double #N$03 (word index).
 $D52E ADD A,C         ; Add the saved count in #REGc to #REGa.
 $D52F LD C,A          ; Keep #N$03 in #REGc for later.
 $D530 LD B,$00        ; Load #REGb with #N$00 as a loop counter.
 $D532 LD IY,$D506     ; Point #REGiy at collectible storage (#R$D506).
 $D536 ADD IY,BC       ; Add the offset in #REGbc to the entity pointer in
                       ; #REGiy.
 $D538 LD A,(IY+$00)   ; Load #REGa with the referenced entity's entity type.
 $D53B OR A            ; {Is referenced entity's entity type zero? If so, jump
 $D53C JR Z,$D541      ; to #R$D541.}
 $D53E CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
; Copy the chosen spawn coords / room from #REGiy into this slot and
; launch its script.
@label=Collect_Entity_CopyIYCoordsToIX
*$D541 ADD A,(IY+$01)  ; Add the referenced entity's flags byte 1 to #REGa.
 $D544 LD (IX+$07),A   ; Set the current entity's x-coordinate.
 $D547 LD (IX+$08),A   ; Set the current entity's x-extent.
 $D54A LD A,(IY+$02)   ; Load #REGa with the referenced entity's flags byte 2.
 $D54D LD (IX+$05),A   ; Set the current entity's y-coordinate.
 $D550 LD (IX+$06),A   ; Set the current entity's y-extent.
 $D553 LD A,(IY+$03)   ; Load #REGa with the referenced entity's flags byte 3.
 $D556 LD (IX+$04),A   ; Set the current entity's room index.
 $D559 LD L,(IY+$04)   ; Load #REGl with the referenced entity's room index.
 $D55C LD H,(IY+$05)   ; Load #REGh with the referenced entity's y-coordinate.
 $D55F JP $EC30        ; Jump to #R$EC30 to execute the script instruction at
                       ; #REGhl.

; Collectible Script Table Base
;
; Script / table base loaded into #REGhl by #R$D56A before #R$EC30.
@label=Data_CollectibleScriptTable
b$D562 DEFB $DE,$D3,$E8,$D3,$FC,$D3,$F2,$D3

; Script Routine: (#N$37) Collectible action
;
; Pick a random continuation from the collectible's script table.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleRandomScript
c$D56A LD A,$04      ; ..
 $D56C CALL $EAE5    ; {Call #R$EAE5 to pick a pseudo-random value and keep it
 $D56F LD B,A        ; in #REGb.}
 $D570 INC B         ; Advance the loop index in #REGb.
 $D571 ADD A,A       ; Double #REGa to form a word index into the
                     ; script/handler table.
 $D572 LD C,A        ; Keep the index in #REGc.
 $D573 LD A,$80      ; Load #REGa with #N$80.
; Rotate a bit mask until it differs from this collectible's direction /
; state.
@label=ScriptRoutine_CollectibleRandomScript_RotateMask
*$D575 RLC A         ; Rotate the collectible bitmask in #REGa left circular.
 $D577 DJNZ $D575    ; Decrease the loop counter in #REGb and jump to #R$D575 if more
                     ; iterations remain.
 $D579 CP (IX+$09)   ; {Does #REGa match this entity's direction/state (#REGix+#N$09)? If
 $D57C JR Z,$D56A    ; so, jump to #R$D56A.}
 $D57E LD (IX+$09),A ; Set the current entity's direction / state.
 $D581 AND %00000011 ; Keep only the low two direction bits of #REGa.
 $D583 JR NZ,$D589   ; Jump to #R$D589 to continue if the comparison did not
                     ; match.
 $D585 LD A,$02      ; Load #REGa with #N$02.
 $D587 JR $D58B      ; Jump to #R$D58B to continue this routine.
; Use random maximum #N$1E when the new mask is not in the low two
; direction bits.
@label=ScriptRoutine_CollectibleRandomScript_RandomMax1E
*$D589 LD A,$1E      ; Load #REGa with #N$1E.
; Reseed the collectible counter and launch the matching script word from
; #R$D562.
@label=ScriptRoutine_CollectibleRandomScript_SetCounterAndScript
*$D58B CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $D58E INC A         ; Advance #N$1E by one.
 $D58F LD ($72BC),A  ; Set the collectible counter (#R$72BC).
 $D592 LD HL,$D562   ; Point #REGhl at unused padding before the collectible script
                     ; (#R$D562).
 $D595 ADD HL,BC     ; Add the length/offset in #REGbc to the pointer in
                     ; #REGhl.
 $D596 LD C,(HL)     ; {Fetch the new script address into #REGbc.
 $D597 INC HL        ;
 $D598 LD B,(HL)     ; }
 $D599 LD L,C        ; {Copy the script address from #REGbc into #REGhl.
 $D59A LD H,B        ; }
 $D59B JP $EC30      ; Jump to #R$EC30 to execute the script instruction at
                     ; #REGhl.

; Script Routine: (#N$36) Collectible action
;
; Update the collectible counter for this entity's current state.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleScanCounter
c$D59E LD A,($72BC)   ; Load #REGa with the collectible counter (#R$72BC).
 $D5A1 CP $80         ; {Is collectible counter equal to #N$80? If not, jump to
 $D5A3 JR NZ,$D5AB    ; #R$D5AB.}
 $D5A5 LD HL,$D3D6    ; Point #REGhl at the dialogue/message table
                      ; (#R$D234(#N$D3D6)).
 $D5A8 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Tick the counter and, if the crusher (#R$8FC9) is live, measure its X
; delta.
@label=ScriptRoutine_CollectibleScanCounter_DecCounterScan
*$D5AB DEC A          ; Step collectible counter back by one.
 $D5AC LD ($72BC),A   ; Set the collectible counter (#R$72BC).
 $D5AF LD IY,$8FC9    ; Point #REGiy at the crusher entity (#R$8FC9).
 $D5B3 LD A,(IY+$00)  ; Load #REGa with the referenced entity's entity type.
 $D5B6 OR A           ; {Is the referenced entity's entity type zero? If so, jump to #R$EC2E
 $D5B7 JP Z,$EC2E     ; to run the next script instruction.}
 $D5BA BIT 5,(IY+$01) ; {Is bit #N$05 of the referenced entity's flags byte 1 set? If so,
 $D5BE JP NZ,$EC2E    ; jump to #R$EC2E.}
 $D5C1 LD A,(IY+$07)  ; Load #REGa with the referenced entity's x-coordinate.
 $D5C4 INC A          ; Advance referenced entity's x-coordinate by one.
 $D5C5 SUB (IX+$07)   ; Subtract the current entity's x-coordinate from #REGa.
 $D5C8 PUSH AF        ; Stash #REGaf on the stack.
 $D5C9 JR NC,$D5CD    ; Jump to #R$D5CD if the result did not underflow.
 $D5CB NEG            ; Negate #REGa (flip a delta/direction).
; Only react when the crusher is within #N$0A characters horizontally.
@label=ScriptRoutine_CollectibleScanCounter_TestAbsDeltaX
*$D5CD CP $0A         ; {Is referenced entity's x-coordinate less than #N$0A? If so, jump to
 $D5CF JR C,$D5D5     ; #R$D5D5.}
 $D5D1 POP AF         ; Restore #REGaf from the stack.
 $D5D2 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Pick the left or right reaction script from the sign of the crusher X
; delta.
@label=ScriptRoutine_CollectibleScanCounter_PickScriptBySign
*$D5D5 POP AF         ; Restore #REGaf from the stack.
 $D5D6 JR C,$D5DD     ; Jump to #R$D5DD if the result underflowed.
 $D5D8 LD HL,$D40E    ; Point #REGhl at collectible/score table data
                      ; #R$D234(#N$D40E).
 $D5DB JR $D5E0       ; Jump to #R$D5E0 to continue this routine.
; Use the leftward crusher-reaction script at #R$D234(#N$D406).
@label=ScriptRoutine_CollectibleScanCounter_RunScript
*$D5DD LD HL,$D406    ; Point #REGhl at collectible/score table data
                      ; #R$D234(#N$D406).
; Reseed the counter to #N$0A plus a random and run the chosen reaction
; script.
@label=ScriptRoutine_CollectibleScanCounter_RandomiseCounterAndRun
*$D5E0 LD A,$32       ; Load #REGa with #N$32 as the #R$EAE5 random maximum.
 $D5E2 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $D5E5 ADD A,$0A      ; Add #N$0A to #REGa (adjust a collectible/timer value).
 $D5E7 LD ($72BC),A   ; Set the collectible counter (#R$72BC).
 $D5EA JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Script Routine: (#N$3D) Collectible action
;
; Promote the collectible to entity type #N$0B.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleSetHeld
c$D5ED LD (IX+$00),$0B ; Write #N$0B to the current entity's entity type.
 $D5F1 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$3C) Collectible action
;
; Advance the collectible's room index twice to force a room change.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleIncRoomTwice
c$D5F4 SET 2,(IX+$09) ; Set bit #N$02 of the current entity's direction /
                      ; state.
 $D5F8 INC (IX+$04)   ; {Advance this entity two rooms ahead.
 $D5FB INC (IX+$04)   ; }
 $D5FE JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$38) Collectible action
;
; Slide the collectible right when the cell above is clear.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleIncXIfClearAbove
c$D601 CALL $F38D     ; Call #R$F38D to test whether a solid entity sits above.
 $D604 JR C,$D614     ; Is the space above clear (carry set)? If so, jump to
                      ; #R$D614.
 $D606 CP $32         ; {Is #REGa less than #N$32? If so, jump to #R$D614.
 $D608 JR C,$D614     ; }
 $D60A SET 0,(IX+$09) ; Set bit #N$00 of the current entity's direction /
                      ; state.
 $D60E LD HL,$D3D6    ; Point #REGhl at the dialogue/message table
                      ; (#R$D234(#N$D3D6)).
 $D611 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Nudge the collectible one character right when the space above is clear
; (or close).
@label=ScriptRoutine_CollectibleIncXIfClearAbove_IncX
*$D614 INC (IX+$07)   ; {Move this entity one character right.
 $D617 INC (IX+$08)   ; }
 $D61A JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$39) Collectible action
;
; Slide the collectible left when the cell to the left is clear.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleDecXIfClearLeft
c$D61D CALL $F32A     ; Call #R$F32A to test whether a solid entity sits on the
                      ; left.
 $D620 JR C,$D630     ; Is the space on the left clear (carry set)? If so, jump
                      ; to #R$D630.
 $D622 CP $32         ; {Is #REGa less than #N$32? If so, jump to #R$D630.
 $D624 JR C,$D630     ; }
 $D626 SET 1,(IX+$09) ; Set bit #N$01 of the current entity's direction /
                      ; state.
 $D62A LD HL,$D3D6    ; Point #REGhl at the dialogue/message table
                      ; (#R$D234(#N$D3D6)).
 $D62D JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Nudge the collectible one character left when the left side is clear (or
; close).
@label=ScriptRoutine_CollectibleDecXIfClearLeft_DecX
*$D630 DEC (IX+$07)   ; {Move this entity one character left.
 $D633 DEC (IX+$08)   ; }
 $D636 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$3A) Collectible action
;
; Send the collectible out of the room downward.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleLeaveRoomDown
c$D639 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $D63C CP $01         ; {Is the current entity's room index equal to #N$01? If so, jump to
 $D63E JR Z,$D645     ; #R$D645.}
 $D640 CALL $F25B     ; Call #R$F25B to adjust the camera X coordinate.
 $D643 JR C,$D64F     ; Jump to #R$D64F if the result underflowed.
; Blocked leaving downward: set direction bit #N$03 and run the stop
; script at #R$D234(#N$D3D6).
@label=ScriptRoutine_CollectibleLeaveRoomDown_SetDirBit3Script
*$D645 SET 3,(IX+$09) ; Set bit #N$03 of the current entity's direction /
                      ; state.
 $D649 LD HL,$D3D6    ; Point #REGhl at the dialogue/message table
                      ; (#R$D234(#N$D3D6)).
 $D64C JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Leave downward: move up one character and back one room.
@label=ScriptRoutine_CollectibleLeaveRoomDown_DecYAndRoom
*$D64F DEC (IX+$05)   ; {Move this entity one character up.
 $D652 DEC (IX+$06)   ; }
 $D655 DEC (IX+$04)   ; Move this entity back one room.
 $D658 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$3B) Collectible action
;
; Send the collectible out of the room upward.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_CollectibleLeaveRoomUp
c$D65B LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $D65E CP $05         ; {Is the current entity's room index equal to #N$05? If so, jump to
 $D660 JR Z,$D667     ; #R$D667.}
 $D662 CALL $F2C7     ; Call #R$F2C7 to test collectible / room collision.
 $D665 JR C,$D671     ; Jump to #R$D671 if the result underflowed.
; Blocked leaving upward: set direction bit #N$02 and run the stop script
; at #R$D234(#N$D3D6).
@label=ScriptRoutine_CollectibleLeaveRoomUp_SetDirBit2Script
*$D667 SET 2,(IX+$09) ; Set bit #N$02 of the current entity's direction /
                      ; state.
 $D66B LD HL,$D3D6    ; Point #REGhl at the dialogue/message table
                      ; (#R$D234(#N$D3D6)).
 $D66E JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Leave upward: move down one character and into the next room.
@label=ScriptRoutine_CollectibleLeaveRoomUp_IncYAndRoom
*$D671 INC (IX+$05)   ; {Move this entity one character down.
 $D674 INC (IX+$06)   ; }
 $D677 INC (IX+$04)   ; Advance this entity into the next room.
 $D67A JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.

