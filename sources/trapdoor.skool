@org=$FC6C
; Seed Menu Music And Wait For Key
;
; Used by the routines at #R$AAB3 and #R$DE19.
; .
; Live copy of the menu-music and key-wait code, relocated from
; #R$6F04 by #R$AAB3 (length #N($0393,$04,$04)). On game start this
; entry seeds the two music-stream cursors, then continues into #R$FC78.
; Menu code also enters at #R$FC78 for a single wait tick. #R$F5EA briefly
; patches #R$FC80 while pulsing the menu highlight.
@label=Seed_MenuMusicAndWaitForKey
c$FC6C LD HL,$FE3B   ; {Point #REGhl at #R$FE3B and seed the cursor word at
 $FC6F LD ($FC87),HL ; #R$FC87.}
 $FC72 LD HL,$FF19   ; {Point #REGhl at #R$FF19 and seed the cursor word at
 $FC75 LD ($FC8B),HL ; #R$FC8B.}
; Continue on to #R$FC78.

; Wait For Key With Menu Music
;
; Used by the routines at #R$F43D, #R$F51D and #R$F5EA.
; .
; Disable interrupts and wait until #SKOOLKID$028E(KEY_SCAN) reports a
; key, playing one #R$FCB3 music tick per loop. Game start falls through from
; #R$FC6C; the menu calls this entry for a single wait tick.
@label=Wait_KeyWithMenuMusic
c$FC78 DI            ; Disable interrupts.
; Key-scan wait loop with menu music.
@label=Wait_KeyWithMenuMusic_Loop
*$FC79 CALL $FCB3    ; Call #R$FCB3 to play one menu-music tick.
 $FC7C CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $FC7F INC E         ; Increment #REGe by one (#SKOOLKID$028E(KEY_SCAN) returns #N$FF in
                     ; #REGe when no key).
 $FC80 JR Z,$FC79    ; Jump to #R$FC79 if #REGe wrapped to #N$00 (no key yet).
 $FC82 NOP           ; No operation.
 $FC83 RET           ; Return.

; Menu Music Workspace
;
; Working bytes for the two-channel menu tune. #R$FC84 and #R$FC85 hold
; the latest stream bytes; #R$FC86 holds the border and speaker output value
; written to port #N$FE; #R$FC87/#R$FC89 are stream one's cursor and reload
; address; #R$FC8B/#R$FC8D are stream two's; #R$FC8F holds the shared delay
; phase.
@label=MenuMusic_Workspace
b$FC84 DEFB $F4      ; Latest byte from music stream one.
 $FC85 DEFB $13      ; Latest byte from music stream two.
 $FC86 DEFB $00      ; Border and speaker bits for port #N$FE.
 $FC87 DEFW $FE6C    ; Stream one cursor.
 $FC89 DEFW $FE4C    ; Stream one reload address.
 $FC8B DEFW $FF4A    ; Stream two cursor.
 $FC8D DEFW $FF2A    ; Stream two reload address.
 $FC8F DEFB $E8      ; Shared delay phase for both channels.

; Read Music Stream Byte
;
; Used by the routine at #R$FCB3.
; .
; Advance a word cursor at #REGhl, fetch the next stream byte, and treat
; #N$40 as an end marker (then jump to #R$FCAB to reload the cursor from the
; following word).
@label=Read_MusicStreamByte
c$FC90 LD E,(HL)     ; Fetch the low byte of the cursor word into #REGe.
 $FC91 INC HL        ; Advance #REGhl onto the high byte.
 $FC92 LD D,(HL)     ; Fetch the high byte of the cursor word into #REGd.
 $FC93 INC DE        ; Advance the cursor value in #REGde by one.
; This entry point is used by the routine at #R$FCAB.
; .
; Fetch the byte at the stream cursor.
@label=Read_MusicStreamByte_Fetch
*$FC94 LD A,(DE)     ; Fetch the byte at the cursor.
 $FC95 CP $40        ; Is it the end marker #N$40?
 $FC97 JR Z,$FCAB    ; If so, jump to #R$FCAB to reload the cursor from the
                     ; next word.
 $FC99 LD (HL),D     ; Write the updated high byte back.
 $FC9A DEC HL        ; Step #REGhl back to the low byte.
 $FC9B LD (HL),E     ; Write the updated low byte back.
 $FC9C RET           ; Return.

; Decode Music Delay
;
; Used by the routine at #R$FCB3.
; .
; Map a raw stream byte through the delay table at #R$FD40 into a tone and
; duration pair returned in #REGhl. The #R$FCAB entry reloads a cursor word and
; continues at #R$FC94.
@label=Decode_MusicDelay
c$FC9D LD A,(HL)     ; Load the raw stream byte from #REGhl.
 $FC9E ADD A,$0C     ; Bias it by #N$0C for the table index.
 $FCA0 LD E,A        ; Copy the index into #REGe.
 $FCA1 LD D,$00      ; Clear #REGd so #REGde holds the table offset.
 $FCA3 LD HL,$FD40   ; Point #REGhl at #R$FD40.
 $FCA6 ADD HL,DE     ; Index into the table.
 $FCA7 LD H,(HL)     ; Fetch the delay high byte into #REGh.
 $FCA8 LD L,$01      ; Load the delay low byte with #N$01.
 $FCAA RET           ; Return.

; Reload Music Stream Cursor
;
; Used by the routine at #R$FC90.
; .
; Reload the stream cursor from the word after an end marker, then
; continue fetching at #R$FC94.
@label=Reload_MusicStreamCursor
c$FCAB INC HL        ; Advance #REGhl onto the reload word.
 $FCAC LD E,(HL)     ; Fetch its low byte into #REGe.
 $FCAD INC HL        ; Advance onto the high byte.
 $FCAE LD D,(HL)     ; Fetch its high byte into #REGd.
 $FCAF DEC HL        ; {Step #REGhl back onto the cursor word.
 $FCB0 DEC HL        ; }
 $FCB1 JR $FC94      ; Jump to #R$FC94 to fetch from the reloaded cursor.

; Play Menu Music Tick
;
; Used by the routine at #R$FC78.
; .
; One tick of the two-channel menu tune while the key-scan waits.
; Reads both stream cursors, looks each byte up in #R$FD40, then either
; bit-bangs the speaker on port #N$FE (toggling bit #N$04 via #N$10) or
; takes the #R$FD76 continue path. Called every pass of #R$FC79.
@label=Play_MenuMusicTick
c$FCB3 LD HL,$FC87   ; Point #REGhl at music cursor one (#R$FC87).
 $FCB6 CALL $FC90    ; Call #R$FC90 to read the next stream-one byte.
 $FCB9 LD ($FC84),A  ; Store it at #R$FC84.
 $FCBC LD HL,$FC8B   ; Point #REGhl at music cursor two (#R$FC8B).
 $FCBF CALL $FC90    ; Call #R$FC90 to read the next stream-two byte.
 $FCC2 LD ($FC85),A  ; Store it at #R$FC85.
 $FCC5 LD HL,$FC84   ; Point #REGhl at stream-one's stored byte (#R$FC84).
 $FCC8 CALL $FC9D    ; Call #R$FC9D to decode its delay pair.
 $FCCB RL E          ; Rotate #REGe left through carry to test the channel
                     ; flag.
 $FCCD JP C,$FD76    ; If carry is set, jump to #R$FD76 for the continue path.
 $FCD0 PUSH HL       ; Stash the decoded delay on the stack.
 $FCD1 LD HL,$FC85   ; Point #REGhl at stream-two's stored byte (#R$FC85).
 $FCD4 CALL $FC9D    ; Call #R$FC9D to decode its delay pair.
 $FCD7 POP DE        ; Restore stream-one's delay into #REGde.
 $FCD8 LD A,H        ; {If stream-one's duration is not #N($01), jump to
 $FCD9 DEC A         ; #R$FCE0.
 $FCDA JR NZ,$FCE0   ; }
 $FCDC LD A,D        ; {If stream-two's duration is #N($01), jump to #R$FD22.
 $FCDD DEC A         ;
 $FCDE JR Z,$FD22    ; }
; Prepare the speaker output value and enter the tone pulse loop.
@label=Play_MenuMusic_PreparePulse
*$FCE0 LD A,($FC8F)  ; {Load the delay phase from #R$FC8F into #REGc and clear
 $FCE3 LD C,A        ; #REGb.
 $FCE4 LD B,$00      ; }
 $FCE6 LD A,($FC86)  ; Load the border and speaker bits from #R$FC86.
 $FCE9 EX AF,AF'     ; Switch to the alternate accumulator.
 $FCEA LD A,($FC86)  ; Reload the border and speaker bits from #R$FC86.
 $FCED LD IXh,D      ; Keep the inner delay count in #REGixh.
 $FCEF LD D,$10      ; Load #REGd with #N$10 (speaker bit mask).
; This entry point is used by the routine at #R$FD10.
; .
; Inner tone loop: burn delay, write port #N($FE), and toggle the speaker
; bit.
@label=Play_MenuMusic_PulseLoop
*$FCF1 NOP           ; {Timing pad before the port write.
 $FCF2 NOP           ; }
; This entry point is used by the routine at #R$FD10.
; .
; Write the speaker level and advance the dual delay counters.
@label=Play_MenuMusic_PulseWrite
*$FCF3 EX AF,AF'     ; Switch back to the primary accumulator.
 $FCF4 DEC E         ; Decrease the fine delay in #REGe.
 $FCF5 OUT ($FE),A   ; Write the border and speaker bits to port #N$FE.
 $FCF7 JR NZ,$FD10   ; If the fine delay remains, jump to #R$FD10.
 $FCF9 LD E,IXh      ; Reload the fine delay from #REGixh.
 $FCFB XOR D         ; Toggle the speaker bit (#N$10) in #REGa via #REGd.
 $FCFC EX AF,AF'     ; Switch to the alternate accumulator.
 $FCFD DEC L         ; Decrease the coarse delay in #REGl.
 $FCFE JP NZ,$FD17   ; If the coarse delay remains, jump to #R$FD17.
; This entry point is used by the routine at #R$FD10.
; .
; Reload the coarse delay from #REGh and keep pulsing.
@label=Play_MenuMusic_ReloadCoarse
*$FD01 OUT ($FE),A   ; Write the speaker level to port #N$FE.
 $FD03 LD L,H        ; Copy #REGh into #REGl to reload the coarse delay.
 $FD04 XOR D         ; Toggle the speaker bit (#N$10) in #REGa via #REGd.
 $FD05 DJNZ $FCF1    ; Decrease #REGb and loop to #R$FCF1 while the outer count
                     ; remains.
 $FD07 INC C         ; Advance the phase counter in #REGc.
 $FD08 JP NZ,$FCF3   ; If the phase remains, jump to #R$FCF3.
 $FD0B RET           ; Return.

; Data: Embedded "adam" Pad
;
; Four unreachable ASCII bytes ("adam") sitting after the #R$FD0B
; return. Never executed; the pulse loop re-enters at #R$FD10.
@label=Data_EmbeddedAdamPad
b$FD0C DEFB $61,$64,$61,$6D ; "#STR(#PC,$04,$04)".

; Play Menu Music Pulse Tail
;
; Used by the routine at #R$FCB3.
; .
; Continuation of the #R$FCF1 tone loop when the fine delay is still
; non-zero. The opening #HTML(<code>JR Z</code>) is a never-taken timing
; pad (entry always has the zero flag clear).
@label=Play_MenuMusic_PulseTail
c$FD10 JR Z,$FD10    ; Never-taken timing pad (#HTML(<code>JR Z</code>)). Fall through with
                     ; the zero flag clear.
; Finish the fine-delay tail and return to the main pulse loop.
@label=Play_MenuMusic_PulseTailBody
 $FD12 EX AF,AF'     ; Switch to the alternate accumulator.
 $FD13 DEC L         ; Decrease the coarse delay in #REGl.
 $FD14 JP Z,$FD01    ; If the coarse delay expired, jump to #R$FD01.
; This entry point is used by the routine at #R$FCB3.
; .
; Port write used when the coarse delay is still running.
@label=Play_MenuMusic_PulseTailWrite
*$FD17 OUT ($FE),A   ; Write the speaker level to port #N$FE.
 $FD19 NOP           ; {Timing pad before the outer count test.
 $FD1A NOP           ; }
 $FD1B DJNZ $FCF1    ; Decrease #REGb and loop to #R$FCF1 while the outer count
                     ; remains.
 $FD1D INC C         ; Advance the phase counter in #REGc.
 $FD1E JP NZ,$FCF3   ; If the phase remains, jump to #R$FCF3.
 $FD21 RET           ; Return.

; Hold Menu Music Silence
;
; Used by the routine at #R$FCB3.
; .
; Hold silence while both channel durations are zero, or when #R$FD76
; takes the clear-carry path into #R$FD27. Burns a delay derived from #R$FC8F,
; then returns.
@label=Hold_MenuMusicSilence
c$FD22 LD A,($FC8F)  ; Load the delay phase from #R$FC8F.
 $FD25 CPL           ; {Complement it into #REGc as a hold count.
 $FD26 LD C,A        ; }
; This entry point is used by the routine at #R$FD76.
; .
; Timed silent hold used by #R$FD76 and the expired-duration path.
@label=Hold_MenuMusicSilence_Loop
*$FD27 PUSH BC       ; {Stash #REGbc and #REGaf on the stack.
 $FD28 PUSH AF       ; }
 $FD29 LD B,$00      ; Clear #REGb for the inner burn count.
; Burn cycles for one silent-hold iteration.
@label=Hold_MenuMusicSilence_Burn
*$FD2B PUSH HL       ; Stash #REGhl on the stack.
 $FD2C LD HL,$0000   ; Point #REGhl at #N($0000,$04,$04).
 $FD2F SRA (HL)      ; {Burn cycles with three #HTML(<code>SRA (HL)</code>)
 $FD31 SRA (HL)      ; pads.
 $FD33 SRA (HL)      ; }
 $FD35 NOP           ; Timing pad.
 $FD36 POP HL        ; Restore #REGhl from the stack.
 $FD37 DJNZ $FD2B    ; Decrease #REGb and loop to #R$FD2B while the burn count
                     ; remains.
 $FD39 DEC C         ; Decrease the hold count in #REGc.
 $FD3A JP NZ,$FD2B   ; If the hold count remains, jump to #R$FD2B.
 $FD3D POP AF        ; {Restore #REGaf and #REGbc from the stack.
 $FD3E POP BC        ; }
 $FD3F RET           ; Return.

; Menu Music Delay Table
;
; Delay lookup used by #R$FC9D to turn each stream byte into a tone
; duration.
@label=Table_MenuMusicDelay
b$FD40 DEFB $FF,$F0,$E3,$D7,$CB,$C0,$B4,$AB
 $FD48 DEFB $A1,$97,$90,$88,$80,$79,$72,$6C
 $FD50 DEFB $66,$60,$5B,$56,$51,$4C,$48,$44
 $FD58 DEFB $40,$3D,$39,$36,$33,$30,$2D,$2B
 $FD60 DEFB $28,$26,$24,$22,$20,$1E,$1C,$1B
 $FD68 DEFB $19,$18,$17,$15,$14,$13,$12,$11
 $FD70 DEFB $10,$0F,$0E,$0D,$0C,$01

; Continue Menu Music Tick
;
; Used by the routine at #R$FCB3.
; .
; Continue a music tick when #R$FCB3 takes the carry path: build a delay
; via #R$FD99, then either pulse the speaker, play the table-driven coda, or
; return.
@label=Continue_MenuMusicTick
c$FD76 PUSH AF       ; {Stash #REGaf, load stream-two's byte from #R$FC85 into #REGd, then
 $FD77 LD A,($FC85)  ; restore #REGaf.
 $FD7A LD D,A        ; }
 $FD7B POP AF        ;
 $FD7C CALL $FD99    ; Call #R$FD99 to build the delay count.
 $FD7F CP $FF        ; {Jump to #R$FDAE if #REGa is #N$FF (pulse the speaker).
 $FD81 JR Z,$FDAE    ; }
 $FD83 CP $C0        ; {Jump to #R$FDEB if #REGa is #N$C0 (play the coda).
 $FD85 JP Z,$FDEB    ; }
 $FD88 LD B,$04      ; Load #REGb with #N$04 step bits.
 $FD8A LD C,E        ; Copy the delay into #REGc.
 $FD8B RLA           ; {Rotate #REGa left through carry four times to walk the
 $FD8C RLA           ; step mask.
 $FD8D RLA           ;
 $FD8E RLA           ; }
; Apply the current step bit: pulse, hold, then loop.
@label=Continue_MenuMusicTick_StepBit
*$FD8F RLA           ; Rotate #REGa left through carry once more for this step.
 $FD90 CALL C,$FDAE  ; If carry is set, call #R$FDAE to pulse the speaker.
 $FD93 CALL NC,$FD27 ; If carry is clear, call #R$FD27 for a silent hold.
 $FD96 DJNZ $FD8F    ; Decrease #REGb and loop to #R$FD8F while steps remain.
 $FD98 RET           ; Return.

; Build Music Delay Count
;
; Used by the routine at #R$FD76.
; .
; Build a delay count from the shared phase at #R$FC8F.
@label=Build_MusicDelayCount
c$FD99 PUSH AF       ; Stash #REGaf on the stack.
 $FD9A LD A,($FC8F)  ; {Load #R$FC8F, complement it, and copy the result into #REGb and
 $FD9D CPL           ; #REGc.
 $FD9E LD B,A        ; }
 $FD9F LD C,A        ;
 $FDA0 ADD A,$01     ; Add #N$01 so a zero phase still yields a positive count.
 $FDA2 SRA A         ; {Divide #REGa by #N$04 with two arithmetic shifts right.
 $FDA4 SRA A         ; }
 $FDA6 LD E,A        ; Copy the scaled count into #REGe.
 $FDA7 CP $00        ; {If the scaled count is zero, force #REGe to #N$01.
 $FDA9 JR NZ,$FDAC   ; }
 $FDAB INC E         ;
; Restore #REGaf and return the delay count.
@label=Build_MusicDelayCount_Return
*$FDAC POP AF        ; {Restore #REGaf from the stack and return.
 $FDAD RET           ; }

; Pulse Menu Music Speaker
;
; Used by the routine at #R$FD76.
; .
; Pulse the speaker bit on port #N$FE for the delay count built by
; #R$FD99. Walks the step mask in #REGd, writing high or low levels or burning
; timing for clear bits.
@label=Pulse_MenuMusicSpeaker
c$FDAE PUSH AF       ; {Stash #REGaf, #REGhl and #REGbc on the stack.
 $FDAF PUSH HL       ;
 $FDB0 PUSH BC       ; }
 $FDB1 LD A,($FC86)  ; {Load the border and speaker bits from #R$FC86 and clear
 $FDB4 LD B,$00      ; #REGb.}
 $FDB6 LD HL,$03E8   ; Point #REGhl at the pulse period base
                     ; (#N($03E8,$04,$04)).
; Walk the step mask in #REGd and either pulse or burn timing.
@label=Pulse_MenuMusicSpeaker_Step
*$FDB9 RRC D         ; Rotate #REGd right through carry.
 $FDBB JP NC,$FDDD   ; If carry is clear, jump to #R$FDDD for a timing burn.
 $FDBE INC HL        ; Advance the period pointer.
 $FDBF BIT 0,(HL)    ; {If the selected step bit is clear, jump to #R$FDD9 to force the
 $FDC1 JP Z,$FDD9    ; speaker low.}
 $FDC4 SET 4,A       ; Force the speaker bit high in #REGa.
 $FDC6 XOR %10000011 ; Toggle spare tone bits with #N$83.
 $FDC8 XOR %10000011 ; Toggle spare tone bits with #N$83 again.
; Write the speaker level and count down the pulse delay.
@label=Pulse_MenuMusicSpeaker_Write
*$FDCA OUT ($FE),A   ; Write the border and speaker bits to port #N$FE.
; Inner delay between speaker writes.
@label=Pulse_MenuMusicSpeaker_Delay
*$FDCC NOP           ; Timing pad.
 $FDCD DEC B         ; {Decrease #REGb and loop to #R$FDB9 while the fine count
 $FDCE JP NZ,$FDB9   ; remains.}
 $FDD1 DEC C         ; {Decrease #REGc and loop to #R$FDB9 while the coarse
 $FDD2 JP NZ,$FDB9   ; count remains.}
 $FDD5 POP BC        ; {Restore #REGbc, #REGhl and #REGaf from the stack.
 $FDD6 POP HL        ;
 $FDD7 POP AF        ; }
 $FDD8 RET           ; Return.
; Force the speaker bit low, then write it.
@label=Pulse_MenuMusicSpeaker_Low
*$FDD9 RES 4,A       ; Clear the speaker bit in #REGa.
 $FDDB JR $FDCA      ; Jump to #R$FDCA to write it.
; Timing burn for a clear step-mask bit.
@label=Pulse_MenuMusicSpeaker_Burn
*$FDDD SCF           ; Set the carry flag.
 $FDDE JP NC,$0000   ; Timing pad (#HTML(<code>JP NC</code>)).
 $FDE1 JP NC,$0000   ; Timing pad (#HTML(<code>JP NC</code>)).
 $FDE4 JP NC,$0000   ; {No operations.
 $FDE7 NOP           ;
 $FDE8 NOP           ; }
 $FDE9 JR $FDCC      ; Jump to #R$FDCC to resume the delay count.

; Play Menu Music Coda
;
; Used by the routine at #R$FD76.
; .
; Play coda notes from the table at #R$FE23 via the ROM beeper.
@label=Play_MenuMusicCoda
c$FDEB LD E,B        ; {Point #REGde at offset #REGb and #REGhl at #R$FE23.
 $FDEC LD D,$00      ;
 $FDEE LD HL,$FE23   ; }
 $FDF1 ADC HL,DE     ; Add the offset into #REGhl.
 $FDF3 LD A,(HL)     ; {Fetch the note length into #REGb.
 $FDF4 LD B,A        ; }
 $FDF5 LD HL,$0003   ; Point #REGhl at the starting pitch (#N($0003,$04,$04)).
; Sound each coda step through #R$FE0A.
@label=Play_MenuMusicCoda_Loop
*$FDF8 PUSH BC       ; Stash the remaining note count on the stack.
 $FDF9 LD DE,$0001   ; Load #REGde with pitch step #N($0001,$04,$04).
 $FDFC PUSH HL       ; Stash the current pitch on the stack.
 $FDFD CALL $FE0A    ; Call #R$FE0A to beep at this pitch.
 $FE00 POP HL        ; Restore the pitch into #REGhl.
 $FE01 LD DE,$00FF   ; {Raise the pitch by #N($00FF,$04,$04).
 $FE04 ADC HL,DE     ; }
 $FE06 POP BC        ; Restore the remaining note count.
 $FE07 DJNZ $FDF8    ; Decrease #REGb and loop to #R$FDF8 while notes remain.
 $FE09 RET           ; Return.

; Sound Coda Beep
;
; Used by the routine at #R$FDEB.
; .
; Finalise one coda step: scale the pitch, index the ROM beeper
; helper, then return with interrupts disabled.
@label=Sound_CodaBeep
c$FE0A LD A,L        ; Copy the pitch low byte into #REGa.
 $FE0B SRL L         ; {Divide #REGl by #N$04 with two logical shifts right.
 $FE0D SRL L         ; }
 $FE0F CPL           ; Complement #REGa.
 $FE10 AND %00000011 ; Keep only the bottom two bits of #REGa.
 $FE12 LD C,A        ; {Copy that index into #REGc and clear #REGb.
 $FE13 LD B,$00      ; }
 $FE15 LD IX,$03D1   ; {Point #REGix at #SKOOLKID$03D1(BEEPER) and index it by
 $FE19 ADD IX,BC     ; #REGbc.}
 $FE1B LD A,($FC86)  ; Load the border and speaker bits from #R$FC86.
 $FE1E CALL $03D4    ; Call #SKOOLKID$03D4(BEEPER).
 $FE21 DI            ; Disable interrupts.
 $FE22 RET           ; Return.

; Menu Music Coda Note Table
;
; Note-length bytes indexed by #R$FDEB when playing the menu-music coda.
; Each entry feeds one #R$FE0A beep.
@label=MenuMusic_CodaNoteTable
b$FE23 DEFB $0C,$0C,$0D,$0D,$0E,$0E,$0E,$0F
 $FE2B DEFB $0F,$0F,$10,$10,$11,$11,$12,$12
 $FE33 DEFB $13,$13,$14,$14,$15,$15,$15,$16

@org=$FE3B
