 $CFDA DEFB $34,$D2         ; Graphic-layout pointer #R$D234.
 $CFDC DEFW $0045           ; Script opcode #N$45 (Drutt action).
 $CFDE DEFW $0045           ; Script opcode #N$45 (Drutt action).
 $CFE0 DEFB $5C,$D2         ; Graphic-layout pointer #R$D25C.
 $CFE2 DEFW $0045           ; Script opcode #N$45 (Drutt action).
 $CFE4 DEFW $0045           ; Script opcode #N$45 (Drutt action).
 $CFE6 DEFB $5C,$D2         ; Graphic-layout pointer #R$D25C.
 $CFE8 DEFW $0044           ; Script opcode #N$44 (Drutt action).
 $CFEA DEFW $0044           ; Script opcode #N$44 (Drutt action).
 $CFEC DEFB $5C,$D2         ; Graphic-layout pointer #R$D25C.
