; Green scenery strip. Referenced from the type-#N$32 scenery entities
; after #R$91B1 (rooms #N$01 through #N$05). Drawn with graphic set #N$05.
;
; .
;
; #UDGTABLE
; { #LAYOUT$28,$AA(layout-aa28) }
; UDGTABLE#
@label=GraphicLayout_GreenSceneryStrip
b$AA28 DEFB $F4,$05     ; Set the graphic set to #GRAPHICSET(#PEEK(#PC+$01)).
 $AA2A DEFB $F1,$0A     ; Jump into the following layout data at a random
                        ; 3-byte entry (maximum index #N(#PEEK(#PC+$01))). Drawing then
                        ; carries on through every later tile to the #N$FF.
 $AA2C DEFB $01,$04,$A1 ; Draw tile #N(#PEEK(#PC)) with
