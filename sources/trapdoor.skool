; Task Three Runtime Workspace
;
; Scratch bytes for the task-three update at #R$C378: a state byte, a
; frame divider (reloaded with #N$04), a word, and a storage byte.
@label=TaskThree_Workspace
b$C2E4 DEFB $00      ; State byte (#R$C3E5).
 $C2E5 DEFB $04      ; Frame divider (#R$C381).
 $C2E6 DEFW $0000    ; Workspace word (#R$C4A7).
 $C2E8 DEFB $0E      ; Storage byte (#R$C616).

; Data: Task Three Tables (continued)
;
; Further task-three tables after the runtime workspace.
@label=Data_TaskThreeTables_Continued
b$C2E9 DEFB $C7,$21,$00,$0A,$00,$0E,$C7,$22 ; Bytes: #N($C7), #N($21), #N($00), #N($0A), #N($00), #N($0E),
                                            ; #N($C7), #N$22.
 $C2F1 DEFB $00,$2A,$00,$0E,$C7,$21,$00,$07 ; Bytes: #N($00), #N($2A), #N($00), #N($0E), #N($C7), #N($21),
                                            ; #N($00), #N$07.
 $C2F9 DEFB $00,$0E,$C7,$2C,$00,$22,$00,$2D ; Bytes: #N($00), #N($0E), #N($C7), #N($2C), #N($00), #N($22),
                                            ; #N($00), #N$2D.
 $C301 DEFB $00,$0A,$00,$21,$00,$0A,$00,$1E ; Bytes: #N($00), #N($0A), #N($00), #N($21), #N($00), #N($0A),
                                            ; #N($00), #N$1E.
 $C309 DEFB $C7,$22,$00,$21,$00,$0A,$00,$32 ; Bytes: #N($C7), #N($22), #N($00), #N($21), #N($00), #N($0A),
                                            ; #N($00), #N$32.
 $C311 DEFB $C7,$22,$00,$0E,$C7,$2B,$00,$01 ; Bytes: #N($C7), #N($22), #N($00), #N($0E), #N($C7), #N($2B),
                                            ; #N($00), #N$01.
 $C319 DEFB $00,$14,$C3,$0C,$00,$46,$C7,$2B ; Bytes: #N($00), #N($14), #N($C3), #N($0C), #N($00), #N($46),
                                            ; #N($C7), #N$2B.
 $C321 DEFB $00,$01,$00,$1C,$C3,$0B,$00,$52 ; Bytes: #N($00), #N($01), #N($00), #N($1C), #N($C3), #N($0B),
                                            ; #N($00), #N$52.
 $C329 DEFB $C7,$2B,$00,$01,$00,$26,$C3,$0E ; Bytes: #N($C7), #N($2B), #N($00), #N($01), #N($00), #N($26),
                                            ; #N($C3), #N$0E.
 $C331 DEFB $00,$0E,$C7,$2B,$00,$01,$00,$30 ; Bytes: #N($00), #N($0E), #N($C7), #N($2B), #N($00), #N($01),
                                            ; #N($00), #N$30.
 $C339 DEFB $C3,$0D,$00,$16,$C7,$2B,$00,$01 ; Bytes: #N($C3), #N($0D), #N($00), #N($16), #N($C7), #N($2B),
                                            ; #N($00), #N$01.
 $C341 DEFB $00,$3A,$C3,$21,$00,$06,$00,$58 ; Bytes: #N($00), #N($3A), #N($C3), #N($21), #N($00), #N($06),
                                            ; #N($00), #N$58.
 $C349 DEFB $C7,$22,$00,$30,$00,$5E,$C7,$2E ; Bytes: #N($C7), #N($22), #N($00), #N($30), #N($00), #N($5E),
                                            ; #N($C7), #N$2E.
 $C351 DEFB $00,$21,$00,$07,$00,$5E,$C7,$22 ; Bytes: #N($00), #N($21), #N($00), #N($07), #N($00), #N($5E),
                                            ; #N($C7), #N$22.
 $C359 DEFB $00,$01,$00,$02,$C3,$21,$00,$06 ; Bytes: #N($00), #N($01), #N($00), #N($02), #N($C3), #N($21),
                                            ; #N($00), #N$06.
 $C361 DEFB $00,$4C,$C7,$22,$00,$30,$00,$7A ; Bytes: #N($00), #N($4C), #N($C7), #N($22), #N($00), #N($30),
                                            ; #N($00), #N$7A.
 $C369 DEFB $C7,$2F,$00,$21,$00,$07,$00,$7A ; Bytes: #N($C7), #N($2F), #N($00), #N($21), #N($00), #N($07),
                                            ; #N($00), #N$7A.
 $C371 DEFB $C7,$22,$00,$01,$00,$02,$C3     ; Bytes: #N($C7), #N($22), #N($00), #N($01), #N($00), #N($02),
                                            ; #N$C3.

; Update Task Three Entities
;
; Used by the routine at #R$AAB3.
; .
; Once per frame while task three is active: tick the task-three
; timers, refresh the cauldron layout when the frame divider hits
; zero, and run the task-three entity state machine at #R$C3B2.
;
; .
;
; Tick the task-three frame divider and timer.
@label=Update_Task_Three_Entities
c$C378 CALL $C65C    ; Call #R$C65C to update the task-three helpers.
 $C37B LD A,($72C3)  ; Load #REGa with the task-three timer (#R$72C3).
 $C37E OR A          ; {Is the task-three timer zero? If so, skip the divider
 $C37F JR Z,$C39C    ; at #R$C39C.}
 $C381 LD HL,$C2E5   ; Point #REGhl at the task-three frame divider (#R$C2E5).
 $C384 DEC (HL)      ; {Decrease the frame divider. if it is still non-zero, skip to
 $C385 JR NZ,$C39C   ; #R$C39C.}
 $C387 LD (HL),$04   ; Reload the frame divider with #N$04.
 $C389 DEC A         ; {Step the task-three timer (#R$72C3) back by one.
 $C38A LD ($72C3),A  ; }
 $C38D CP $0A        ; {Is the task-three timer less than #N$0A? If not, skip
 $C38F JR NC,$C39C   ; to #R$C39C.}
; When the timer is in the low band, point the cauldron at layout
; #R$9F9D and clear bit #N$05 of the task-three flags.
 $C391 LD HL,$9F9D   ; Point #REGhl at the cauldron layout (#R$9F9D).
 $C394 LD ($906D),HL ; Write that layout into the graphic-layout field of #R$9063
                     ; (#R$8EF3(#N$906D)).
 $C397 LD HL,$72B6   ; Point #REGhl at the task-three flags (#R$72B6).
 $C39A RES 5,(HL)    ; Clear bit #N$05 of the task-three flags.
; Run the task-three entity state machine while the phase is #N$03.
@label=Update_Task_Three_Entities_RunStateMachine
*$C39C LD A,($72AF)  ; Load #REGa with the current task phase (#R$72AF).
 $C39F CP $03        ; {Is the current task phase equal to #N$03? If not,
 $C3A1 RET NZ        ; return.}
 $C3A2 LD HL,($72D1) ; {Copy the task-three script position (#R$72D1) into the temporary
 $C3A5 LD ($72CF),HL ; script-position pointer (#R$72CF).}
 $C3A8 CALL $C3B2    ; Call #R$C3B2 to update the task-three entity state.
 $C3AB LD HL,($72CF) ; {Write the active script cursor (#R$72CF) back to
 $C3AE LD ($72D1),HL ; #R$72D1.}
 $C3B1 RET           ; Return.

; Update Task Three Entity State
;
; Used by the routine at #R$C378.
; .
; Update Task Three Entity State for the current Thing Upstairs task.
@label=Update_Task_Three_Entity_State
c$C3B2 LD IX,$90A9     ; Point #REGix at the inactive complex slot (#R$90A9).
 $C3B6 LD A,($72B3)    ; Load #REGa with the game event flags (#R$72B3).
 $C3B9 LD C,A          ; Keep game event flags in #REGc for later.
 $C3BA BIT 7,C         ; {Is bit #N$07 of the saved game-event flags in #REGc set? If so, jump
 $C3BC JP NZ,$EC2E     ; to #R$EC2E.}
 $C3BF LD A,(IX+$00)   ; Fetch the current entity's type for the type test.
 $C3C2 OR A            ; {Is the current entity's entity type zero? If so, jump
 $C3C3 JR Z,$C3CD      ; to #R$C3CD.}
 $C3C5 BIT 1,C         ; {Is bit #N$01 of the saved game-event flags in #REGc set? If so, jump
 $C3C7 JP NZ,$EC2E     ; to #R$EC2E.}
 $C3CA JP $C60D        ; Jump to #R$C60D.
; Trap open and slot empty: mark the task-three entity type #N$20 and
; continue its script.
@label=Update_Task_Three_Entity_State_MarkHelper
*$C3CD BIT 1,C         ; {Is bit #N$01 of the saved game-event flags in #REGc set? If not,
 $C3CF RET Z           ; return.}
 $C3D0 LD (IX+$00),$20 ; Write #N$20 to the current entity's entity type.
 $C3D4 JP $EC2E        ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$30) Task-three entity action
;
; Queue sound #N$14 for the current task-three script beat.
;
; .
;
; #HTML(#AUDIO0(task-three.wav)(#INCLUDE(TaskThree)))
@label=ScriptRoutine_TaskThreeQueueSound
c$C3D7 LD A,$14      ; Load #REGa with #N$14.
 $C3D9 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $C3DC JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$2B) Task-three entity action
;
; Steer the task-three creature toward Berk while pursuit flags allow it.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskThreeSeekBerk
c$C3DF BIT 0,(IX+$03) ; {Is the current entity script-locked (bit #N$00 of #REGix+#N$03)?
 $C3E3 JR Z,$C404     ; If not, jump to #R$C404.}
 $C3E5 LD A,($C2E4)   ; Load #REGa with the task-three byte (#R$C2E4).
 $C3E8 OR A           ; {Is the task-three byte (#R$C2E4) zero? If so, jump to
 $C3E9 JR Z,$C404     ; #R$C404.}
 $C3EB DEC A          ; Step task-three byte back by one.
 $C3EC LD ($C2E4),A   ; Set the task-three byte (#R$C2E4).
 $C3EF LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $C3F2 BIT 0,A        ; {Is bit #N$00 of the current entity's direction / state set? If so,
 $C3F4 JP NZ,$C493    ; jump to #R$C493.}
 $C3F7 BIT 1,A        ; {Is bit #N$01 of the current entity's direction / state set? If so,
 $C3F9 JP NZ,$C4DE    ; jump to #R$C4DE.}
 $C3FC BIT 2,A        ; {Is bit #N$02 of the current entity's direction / state set? If so,
 $C3FE JR NZ,$C412    ; jump to #R$C412.}
 $C400 BIT 3,A        ; {Is bit #N$03 of the current entity's direction / state set? If so,
 $C402 JR NZ,$C44D    ; jump to #R$C44D.}
; Clear the seek latch and chase Berk by room: same room compares X; else
; move up or down toward him.
@label=ScriptRoutine_TaskThreeSeekBerk_ClearActiveAndSeekBerk
*$C404 RES 0,(IX+$03) ; Reset bit #N$00 of the current entity's flags byte 3.
 $C408 LD A,($7305)   ; Load #REGa with Berk's room-index copy (#R$7305).
 $C40B CP (IX+$04)    ; {Is Berk in the same room as this entity (#REGix+#N$04)? If so, jump
 $C40E JR Z,$C47E     ; to #R$C47E.}
 $C410 JR C,$C44D     ; Jump to #R$C44D if the result underflowed.
; Climb toward Berk: at room #N$04 arm Slimy (#R$C542); else rise when bit
; #N$02 is set, or run the climb script.
@label=ScriptRoutine_TaskThreeSeekBerk_MoveRoomUp
*$C412 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $C415 CP $04         ; {Is the current entity's room index equal to #N$04? If so, jump to
 $C417 JP Z,$C542     ; #R$C542.}
 $C41A LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $C41D BIT 2,A        ; {Is bit #N$02 of the current entity's direction / state set? If so,
 $C41F JR NZ,$C427    ; jump to #R$C427.}
 $C421 LD HL,$C330    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C330).
 $C424 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Probe the path above with #R$F2C7 before rising into the next room.
@label=ScriptRoutine_TaskThreeSeekBerk_TestOverlapThenRise
*$C427 CALL $F2C7     ; Call #R$F2C7 to test collectible / room collision.
 $C42A JR NC,$C43B    ; Jump to #R$C43B if the result did not underflow.
; This entry point is used by the routine at #R$C443.
; .
; Step down a room toward Berk, refresh the heater at #R$C635, and
; continue the script.
@label=ScriptRoutine_TaskThreeSeekBerk_IncRoomAndHeater
*$C42C INC (IX+$05)   ; {Move this entity one character down.
 $C42F INC (IX+$06)   ; }
 $C432 INC (IX+$04)   ; Advance this entity into the next room.
 $C435 CALL $C635     ; Call #R$C635 to update Heater.
 $C438 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Blocked rise: treat direction #N$1F as a door hit (#R$C59A), otherwise
; arm Slimy at #R$C542.
@label=ScriptRoutine_TaskThreeSeekBerk_MaybeArmSlimyFromRise
*$C43B CP $1F         ; {Is the current entity's direction / state equal to #N$1F? If so,
 $C43D JP Z,$C59A     ; jump to #R$C59A.}
 $C440 JP $C542       ; Jump to #R$C542 to continue this routine.

; Script Routine: (#N$2D) Task-three entity action
;
; Clear the upstairs event bit, then resume the task-three script.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskThreeClearUpstairs
c$C443 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $C446 RES 4,A        ; Clear bit #N$04 of the flag byte in #REGa.
 $C448 LD ($72B3),A   ; Set the game event flags (#R$72B3).
 $C44B JR $C42C       ; Jump to #R$C42C to continue this routine.
; This entry point is used by the routine at #R$C3DF.
; .
; Descend toward Berk: at room #N$02 arm Slimy (#R$C542); else fall when
; bit #N$03 is set, or run the descend script.
@label=ScriptRoutine_TaskThreeSeekBerk_MoveRoomDown
*$C44D LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $C450 CP $02         ; {Is the current entity's room index equal to #N$02? If so, jump to
 $C452 JP Z,$C542     ; #R$C542.}
 $C455 LD A,(IX+$09)  ; Load #REGa with the current entity's direction / state.
 $C458 BIT 3,A        ; {Is bit #N$03 of the current entity's direction / state set? If so,
 $C45A JR NZ,$C462    ; jump to #R$C462.}
 $C45C LD HL,$C33A    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C33A).
 $C45F JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Probe with #R$F252, then fall one room toward Berk and refresh the
; heater.
@label=ScriptRoutine_TaskThreeSeekBerk_TestCameraThenFall
*$C462 CALL $F252     ; Call #R$F252 to clamp the camera position.
 $C465 JR NC,$C476    ; Jump to #R$C476 if the result did not underflow.
 $C467 DEC (IX+$05)   ; {Move this entity one character up.
 $C46A DEC (IX+$06)   ; }
 $C46D DEC (IX+$04)   ; Move this entity back one room.
 $C470 CALL $C635     ; Call #R$C635 to update Heater.
 $C473 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Blocked fall: treat direction #N$1F as a door hit (#R$C59A), otherwise
; arm Slimy at #R$C542.
@label=ScriptRoutine_TaskThreeSeekBerk_MaybeArmSlimyFromFall
*$C476 CP $1F         ; {Is the current entity's direction / state equal to #N$1F? If so,
 $C478 JP Z,$C59A     ; jump to #R$C59A.}
 $C47B JP $C542       ; Jump to #R$C542 to continue this routine.
; This entry point is used by the routine at #R$C3DF.
; .
; Same-room chase: compare Berk's X band (#R$7303/#R$7304) and walk right,
; left, or stop.
@label=ScriptRoutine_TaskThreeSeekBerk_CompareBerkXEdges
*$C47E LD A,($7303)   ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $C481 LD C,A         ; Keep Berk's X coordinate in #REGc.
 $C482 LD A,(IX+$08)  ; Load #REGa with the current entity's x-extent.
 $C485 CP C           ; {Is this entity's x-extent left of Berk's X-coordinate copy
 $C486 JR C,$C493     ; (#R$7303)? If so, jump to #R$C493.}
 $C488 LD A,($7304)   ; Load #REGa with Berk's X-extent copy (#R$7304).
 $C48B CP (IX+$07)    ; {Is Berk's X-extent copy left of this entity's x (#REGix+#N$07)? If
 $C48E JR C,$C4DE     ; so, jump to #R$C4DE.}
 $C490 JP $C59A       ; Jump to #R$C59A to finish this handler.
; This entry point is used by the routine at #R$C3DF.
; .
; Build the right-side Berk window into #R$C2E6 and run the peek script
; when he sits in that band.
@label=ScriptRoutine_TaskThreeSeekBerk_BuildRightWindow
*$C493 LD A,($7305)   ; Load #REGa with Berk's room-index copy (#R$7305).
 $C496 CP (IX+$04)    ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $C499 JR NZ,$C4BA    ; to #R$C4BA.}
 $C49B OR A           ; {Is #REGa zero? If so, jump to #R$C4BA.
 $C49C JR Z,$C4BA     ; }
 $C49E LD A,(IX+$08)  ; Load #REGa with the current entity's x-extent.
 $C4A1 ADD A,$03      ; Add #N$03 to #REGa (adjust a task phase/index).
 $C4A3 LD C,A         ; Keep the index in #REGc.
 $C4A4 ADD A,$04      ; Add #N$04 to #REGa (step a coordinate/index).
 $C4A6 LD B,A         ; Keep a copy of #REGa in #REGb.
 $C4A7 LD ($C2E6),BC  ; Store #REGbc in the task-three word (#R$C2E6).
 $C4AB LD A,($7303)   ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $C4AE CP B           ; {Is Berk's X-coordinate copy (#R$7303) at or beyond this entity's
 $C4AF JR NC,$C4BA    ; x-extent? If so, jump to #R$C4BA.}
 $C4B1 CP C           ; {Is Berk's X-coordinate copy (#R$7303) left of this entity's
 $C4B2 JR C,$C4BA     ; x-extent? If so, jump to #R$C4BA.}
 $C4B4 LD HL,$C35E    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C35E).
 $C4B7 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Walk right toward Berk until the right edge (#N$B6), then arm Slimy or
; keep stepping.
@label=ScriptRoutine_TaskThreeSeekBerk_WalkRight
*$C4BA LD A,(IX+$08)  ; Load #REGa with the current entity's x-extent.
 $C4BD CP $B6         ; {Is the current entity's x-extent less than #N$B6? If not, jump to
 $C4BF JR NC,$C529    ; #R$C529.}
 $C4C1 BIT 0,(IX+$09) ; {Is bit #N$00 of the current entity's direction / state set? If so,
 $C4C5 JR NZ,$C4CD    ; jump to #R$C4CD.}
 $C4C7 LD HL,$C31C    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C31C).
 $C4CA JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; If the way below is clear (#R$F391), step right and refresh the heater.
@label=ScriptRoutine_TaskThreeSeekBerk_TestBelowThenIncX
*$C4CD CALL $F391     ; Call #R$F391 to test whether an entity is below.
 $C4D0 JR NC,$C529    ; Jump to #R$C529 if the result did not underflow.
 $C4D2 INC (IX+$07)   ; {Move this entity one character right.
 $C4D5 INC (IX+$08)   ; }
 $C4D8 CALL $C635     ; Call #R$C635 to update Heater.
 $C4DB JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; This entry point is used by the routine at #R$C3DF.
; .
; Build the left-side Berk window into #R$C2E6 and run the peek script
; when he sits in that band.
@label=ScriptRoutine_TaskThreeSeekBerk_BuildLeftWindow
*$C4DE LD A,($7305)   ; Load #REGa with Berk's room-index copy (#R$7305).
 $C4E1 CP (IX+$04)    ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $C4E4 JR NZ,$C505    ; to #R$C505.}
 $C4E6 OR A           ; {Is #REGa zero? If so, jump to #R$C505.
 $C4E7 JR Z,$C505     ; }
 $C4E9 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C4EC SUB $03        ; Subtract #N$03 from #REGa.
 $C4EE LD C,A         ; Keep the delta in #REGc.
 $C4EF SUB $03        ; Subtract #N$03 from #REGa.
 $C4F1 LD B,A         ; Keep a copy of #REGa in #REGb.
 $C4F2 LD ($C2E6),BC  ; Store #REGbc in the task-three word (#R$C2E6).
 $C4F6 LD A,($7304)   ; Load #REGa with Berk's X-extent copy (#R$7304).
 $C4F9 CP B           ; {Is Berk's X-extent copy (#R$7304) left of the entity's x
 $C4FA JR C,$C505     ; (#REGix+#N$07)? If so, jump to #R$C505.}
 $C4FC CP C           ; {Is Berk's X-extent copy (#R$7304) at or beyond the entity's x
 $C4FD JR NC,$C505    ; (#REGix+#N$07)? If so, jump to #R$C505.}
 $C4FF LD HL,$C344    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C344).
 $C502 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Walk left toward Berk until the left edge (#N$49), then arm Slimy or
; keep stepping.
@label=ScriptRoutine_TaskThreeSeekBerk_WalkLeft
*$C505 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C508 CP $49         ; {Is the current entity's x-coordinate less than #N$49? If so, jump to
 $C50A JR C,$C529     ; #R$C529.}
 $C50C BIT 1,(IX+$09) ; {Is bit #N$01 of the current entity's direction / state set? If so,
 $C510 JR NZ,$C518    ; jump to #R$C518.}
 $C512 LD HL,$C326    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C326).
 $C515 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; If the way on the right is clear (#R$F32E), step left and refresh the
; heater.
@label=ScriptRoutine_TaskThreeSeekBerk_TestRightThenDecX
*$C518 CALL $F32E     ; Call #R$F32E to test whether an entity is on the right.
 $C51B JR NC,$C529    ; Jump to #R$C529 if the result did not underflow.
 $C51D DEC (IX+$07)   ; {Move this entity one character left.
 $C520 DEC (IX+$08)   ; }
 $C523 CALL $C635     ; Call #R$C635 to update Heater.
 $C526 JP $EC2E       ; Jump to #R$EC2E to run the next script instruction.
; Edge / stuck path: arm Slimy with range #N$06 via #R$C556, then pick a
; seek or descend script.
@label=ScriptRoutine_TaskThreeSeekBerk_ArmSlimyRange06
*$C529 CP $1F         ; {Is the current entity's x-coordinate equal to #N$1F? If so, jump to
 $C52B JP Z,$C59A     ; #R$C59A.}
 $C52E LD A,$06       ; Load #REGa with #N$06.
 $C530 CALL $C556     ; Call #R$C556 to update Slimy Creature.
 $C533 OR A           ; {Is #REGa zero? If so, jump to #R$C53C.
 $C534 JR Z,$C53C     ; }
 $C536 LD HL,$C33A    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C33A).
 $C539 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Run the climb/seek script at table entry #R$C2E9(#N$C330).
@label=ScriptRoutine_TaskThreeSeekBerk_RunSeekScript
*$C53C LD HL,$C330    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C330).
 $C53F JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; This entry point is used by the routine at #R$C3DF.
; .
; Arm Slimy with range #N$10 via #R$C556, then pick an approach or
; walk-left script.
@label=ScriptRoutine_TaskThreeSeekBerk_ArmSlimyRange10
*$C542 LD A,$10       ; Load #REGa with #N$10.
 $C544 CALL $C556     ; Call #R$C556 to update the slimy creature.
 $C547 OR A           ; {Is the random result in #REGa zero? If so, jump to
 $C548 JR Z,$C550     ; #R$C550.}
 $C54A LD HL,$C326    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C326).
 $C54D JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.
; Run the walk-right approach script at table entry #R$C2E9(#N$C31C).
@label=ScriptRoutine_TaskThreeSeekBerk_RunApproachScript
*$C550 LD HL,$C31C    ; Point #REGhl at task-three table entry
                      ; #R$C2E9(#N$C31C).
 $C553 JP $EC30       ; Jump to #R$EC30 to execute the script instruction at
                      ; #REGhl.

; Update Slimy Creature
;
; Used by the routine at #R$C443.
; .
; Arm the slimy-creature timer at #R$C2E4, set bit #N$00 of the entity
; flags, and return a fresh random byte in #REGa.
;
; IX Address of complex state data for an entity
@label=Update_Slimy_Creature
c$C556 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $C559 ADD A,$02      ; Add #N$02 to #REGa (step a word index).
 $C55B LD ($C2E4),A   ; Set the task-three byte (#R$C2E4).
 $C55E SET 0,(IX+$03) ; Set bit #N$00 of the current entity's flags byte 3.
 $C562 LD A,$02       ; Load #REGa with #N$02.
 $C564 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $C567 RET            ; Return.

; Script Routine: (#N$2F) Task-three entity action
;
; Run the task-three left-window encounter when Berk is at that window.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskThreeBerkLeftWindow
c$C568 LD A,($7305)  ; Load #REGa with Berk's room-index copy (#R$7305).
 $C56B CP (IX+$04)   ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $C56E JR NZ,$C5BA   ; to #R$C5BA.}
 $C570 LD BC,($C2E6) ; Load #REGbc from #R$C2E6.
 $C574 LD A,($7303)  ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $C577 CP B          ; {Is Berk's X-coordinate copy (#R$7303) at or beyond #REGb? If so,
 $C578 JR NC,$C5BA   ; jump to #R$C5BA.}
 $C57A LD A,($7304)  ; Load #REGa with Berk's X-extent copy (#R$7304).
 $C57D CP C          ; {Is Berk's X-extent copy (#R$7304) left of #REGc? If so, jump to
 $C57E JR C,$C5BA    ; #R$C5BA.}
 $C580 JR $C59A      ; Jump to #R$C59A to finish this handler.

; Script Routine: (#N$2E) Task-three entity action
;
; Run the task-three right-window encounter when Berk is at that window.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_TaskThreeBerkRightWindow
c$C582 LD A,($7305)  ; Load #REGa with Berk's room-index copy (#R$7305).
 $C585 CP (IX+$04)   ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $C588 JR NZ,$C5A0   ; to #R$C5A0.}
 $C58A LD BC,($C2E6) ; Load #REGbc from #R$C2E6.
 $C58E LD A,($7304)  ; Load #REGa with Berk's X-extent copy (#R$7304).
 $C591 CP B          ; {Is Berk's X-extent copy (#R$7304) left of #REGb? If so, jump to
 $C592 JR C,$C5A0    ; #R$C5A0.}
 $C594 LD A,($7303)  ; Load #REGa with Berk's X-coordinate copy (#R$7303).
 $C597 CP C          ; {Is Berk's X-coordinate copy (#R$7303) at or beyond #REGc? If so,
 $C598 JR NC,$C5A0   ; jump to #R$C5A0.}
; This entry point is used by the routines at #R$C3DF, #R$C443 and #R$C568.
; .
; Resolve a door / interaction hit via #R$EA73, then advance the script.
@label=TaskThree_DoorHitThenNextScript
*$C59A CALL $EA73    ; Call #R$EA73 to handle the door / interaction hit.
 $C59D JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.
; Right-window miss: only continue if the cauldron (#R$9063) overlaps
; the stored X window.
@label=ScriptRoutine_TaskThreeBerkRightWindow_CheckCreatureXExtent
*$C5A0 LD IY,$9063   ; Point #REGiy at the cauldron entity at #R$9063.
 $C5A4 LD A,(IX+$04) ; Load #REGa with the current entity's room index.
 $C5A7 CP (IX+$04)   ; {Is Berk in the same room as this entity (#REGix+#N$04)? If not, jump
 $C5AA JP NZ,$EC2E   ; to #R$EC2E.}
 $C5AD LD A,(IY+$08) ; Load #REGa with the referenced entity's x-extent.
 $C5B0 CP B          ; {Is the referenced entity's x-extent less than #REGb? If so, jump to
 $C5B1 JP C,$EC2E    ; #R$EC2E.}
 $C5B4 CP C          ; {Is the referenced entity's x-extent at or beyond #REGc? If not, jump
 $C5B5 JP NC,$EC2E   ; to #R$EC2E.}
 $C5B8 JR $C5D2      ; Jump to #R$C5D2 to continue this routine.
; This entry point is used by the routine at #R$C568.
; .
; Left-window miss: only continue if the cauldron (#R$9063) overlaps
; the stored X window.
@label=ScriptRoutine_TaskThreeBerkLeftWindow_CheckCreatureX
*$C5BA LD IY,$9063   ; Point #REGiy at the cauldron entity at #R$9063.
 $C5BE LD A,(IX+$04) ; Load #REGa with the current entity's room index.
 $C5C1 CP (IY+$04)   ; {Does this entity share the referenced entity's room (#REGiy+#N$04)?
 $C5C4 JP NZ,$EC2E   ; If not, jump to #R$EC2E.}
 $C5C7 LD A,(IY+$07) ; Load #REGa with the referenced entity's x-coordinate.
 $C5CA CP B          ; {Is the referenced entity's x at or beyond #REGb? If not, jump to
 $C5CB JP NC,$EC2E   ; #R$EC2E.}
 $C5CE CP C          ; {Is the referenced entity's x less than #REGc? If so, jump to
 $C5CF JP C,$EC2E    ; #R$EC2E.}
; Raise BoilEmUp / BoilEmUpLatch on #R$72B6, swap in layout #R$9F75, and
; bump the task-three timer.
@label=ScriptRoutine_TaskThreeBerkRightWindow_SetFlagsAndLayout
*$C5D2 LD A,($72B6)  ; Load #REGa with the task-three flags (#R$72B6).
 $C5D5 BIT 7,A       ; {Is bit #N$07 of task-three flags set? If not, jump to
 $C5D7 JP Z,$EC2E    ; #R$EC2E.}
 $C5DA SET 4,A       ; Set BoilEmUp (bit #N$04 of #R$72B6. cleared by #R$C63B. tested by
                     ; #R$D927).
 $C5DC SET 5,A       ; Set BoilEmUpLatch (bit #N$05 of #R$72B6. cleared by #R$C63B /
                     ; #R$C39A).
 $C5DE LD ($72B6),A  ; Set the task-three flags (#R$72B6).
 $C5E1 LD BC,$9F75   ; Point #REGbc at the cauldron cooking layout (#R$9F75).
 $C5E4 LD ($906D),BC ; Write the layout address into the cauldron entity
                     ; (#R$8EF3(#N$906D)).
 $C5E8 LD A,($72C3)  ; Load #REGa with the task-three timer (#R$72C3).
 $C5EB ADD A,$32     ; Add #N$32 to the task-three timer in #REGa.
 $C5ED JP C,$EC2E    ; If that add overflowed (carry), jump to #R$EC2E without
                     ; storing.
 $C5F0 LD ($72C3),A  ; Set the task-three timer (#R$72C3).
 $C5F3 JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$2C) Slimy-creature action
;
; Drop the slimy creature and arm the heater-related game flags.
;
; IX Address of complex state data for an entity
@label=ScriptRoutine_SlimyDropAndHeat
c$C5F6 DEC (IX+$05)  ; {Move this entity one character up.
 $C5F9 DEC (IX+$06)  ; }
 $C5FC CALL $C635    ; Call #R$C635 to update Heater.
 $C5FF JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Script Routine: (#N$2A) Cauldron / heater action
;
; Arm the cauldron / heater event flags for the current script beat.
@label=ScriptRoutine_ArmCauldronFlags
c$C602 LD A,($72B3)  ; Load #REGa with the game event flags (#R$72B3).
 $C605 OR %10010000  ; Set bits #N$07 and #N$04 of #R$72B3 (task entity script active
                     ; + upstairs event latch).
 $C607 LD ($72B3),A  ; Set the game event flags (#R$72B3).
 $C60A JP $EC2E      ; Jump to #R$EC2E to run the next script instruction.

; Update Cauldron
;
; Used by the routines at #R$B034 and #R$C3B2.
; .
; Refresh the cauldron entity after Drutt drops something in, then idle
; the current task phase.
@label=Update_Cauldron
c$C60D XOR A         ; Clear the current task phase (idle).
 $C60E LD ($72AF),A  ; Set the current task phase (#R$72AF).
 $C611 LD HL,$72B3   ; Point #REGhl at the game event flags (#R$72B3).
 $C614 RES 7,(HL)    ; Clear "task entity script is active" (bit #N$07 of
                     ; #R$72B3).
 $C616 LD HL,$C2E8   ; Point #REGhl at task-three storage (#R$C2E8).
 $C619 LD ($72CF),HL ; Store #REGhl in the active script cursor (#R$72CF).
 $C61C LD ($72D1),HL ; Store #REGhl in the task-three script-position pointer
                     ; (#R$72D1).
 $C61F LD HL,$C62B   ; Point #REGhl at the #N$0A-byte init template at #R$C62B (copied into
                     ; #R$90A9).
 $C622 LD DE,$90A9   ; Point #REGde at the task-three helper entity slot
                     ; (#R$90A9).
 $C625 LD BC,$000A   ; Load #REGbc with #N($000A,$04,$04) (bytes to copy into the helper
                     ; entity slot).
 $C628 LDIR          ; Copy the block at #REGhl to #REGde.
 $C62A RET           ; Return.

; Cauldron Init Template
;
; Template bytes pointed by #REGhl at #R$C61F before #R$C635.
@label=Data_CauldronInitTemplate
b$C62B DEFB $00,$07,$00,$00,$03,$26,$2D,$6D
 $C633 DEFB $71,$00

; Update Heater
;
; Used by the routines at #R$C3DF, #R$C443 and #R$C5F6.
; .
; Queue heater sound effect #N$12 via #R$F8F9.
;
; .
;
; #HTML(#AUDIO0(heater.wav)(#INCLUDE(Heater)))
@label=Update_Heater
c$C635 LD A,$12      ; Load #REGa with #N$12.
 $C637 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $C63A RET           ; Return.

; Update Stove
;
; Used by the routine at #R$B2AA.
; .
; When the collided entity's type is #N$14 and the current entity's type
; is #N$09. Clears SlimyLoose, BoilEmUp and BoilEmUpLatch; raises
; StoveUpdated; advances #R$72BE (setting StoveReady on the fourth tick); and
; repoints the cauldron at idle layout #R$9F9D.
;
; .
;
; Clear SlimyLoose / BoilEmUp / BoilEmUpLatch; raise StoveUpdated.
@label=Update_Stove
c$C63B PUSH HL       ; Stash #REGhl on the stack.
 $C63C LD HL,$72B6   ; Point #REGhl at the task-three flags (#R$72B6).
 $C63F RES 2,(HL)    ; Clear SlimyLoose (bit #N$02 of #R$72B6. set by #R$B401 / #R$C6FC
                     ; tested by #R$D907).
 $C641 RES 4,(HL)    ; Clear BoilEmUp (bit #N$04 of #R$72B6. set by #R$C5D2. tested by
                     ; #R$D927).
 $C643 RES 5,(HL)    ; Clear BoilEmUpLatch (bit #N$05 of #R$72B6. set by #R$C5D2. also
                     ; cleared at #R$C39A).
 $C645 SET 7,(HL)    ; Set StoveUpdated (bit #N$07 of #R$72B6. tested by #R$C5D2 before it
                     ; sets BoilEmUp / BoilEmUpLatch).
; Count another stove tick (#R$72BE); has it reached #N$04?.
 $C647 LD A,($72BE)  ; Load the stove tick (#R$72BE) into #REGa.
 $C64A INC A         ; Advance the stove tick by one.
 $C64B LD ($72BE),A  ; Store the stove tick (#R$72BE).
 $C64E CP $04        ; {Has the stove tick reached #N$04? If not, skip to
 $C650 JR NZ,$C654   ; #R$C654.}
 $C652 SET 6,(HL)    ; Set StoveReady (bit #N$06 of #R$72B6. tested by #R$D915
                     ; / #R$D91B).
; Point the cauldron at its idle layout and return.
@label=Update_Stove_IdleLayout
*$C654 LD HL,$9F9D   ; Point #REGhl at the cauldron layout (#R$9F9D).
 $C657 LD ($906D),HL ; Write that layout into the graphic-layout field of #R$9063
                     ; (#R$8EF3(#N$906D)).
 $C65A POP HL        ; Restore #REGhl from the stack.
 $C65B RET           ; Return.

; Update Task Three Helpers
;
; Used by the routine at #R$C378.
; .
; Update Task Three Helpers for the current Thing Upstairs task.
@label=Update_Task_Three_Helpers
c$C65C LD IX,$8F13    ; Point #REGix at the first Slimies entity (#R$8F13).
 $C660 LD DE,$000E    ; Each entity record is #N($000E,$04,$04) bytes long, then load that
                      ; length into #REGde.
 $C663 LD B,$04       ; Load #REGb with #N$04 as a loop counter.
; Scan each upstairs helper: skip inactive / low slots, then randomly
; wander, climb, or drop a room.
@label=Update_Task_Three_Helpers_Scan
*$C665 PUSH BC        ; Stash #REGbc on the stack.
 $C666 LD A,(IX+$01)  ; Load #REGa with the current entity's flags byte 1.
 $C669 AND %11100000  ; Keep only the top bits #N$E0 of the flag/coordinate in
                      ; #REGa.
 $C66B JR NZ,$C6E3    ; If the result was non-zero, jump to #R$C6E3.
 $C66D LD A,(IX+$06)  ; Load #REGa with the current entity's y-extent.
 $C670 CP $22         ; {Is the current entity's y-extent less than #N$22? If so, jump to
 $C672 JR C,$C6E3     ; #R$C6E3.}
 $C674 BIT 7,(IX+$00) ; {Is bit #N$07 of the current entity's entity type set? If not, call
 $C678 CALL Z,$C6F1   ; #R$C6F1.}
 $C67B LD A,$15       ; Load #REGa with #N$15.
 $C67D CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $C680 OR A           ; {Is #N$15 zero? If so, jump to #R$C6EB.
 $C681 JR Z,$C6EB     ; }
 $C683 CP $06         ; {Is #N$15 less than #N$06? If so, jump to #R$C6B3.
 $C685 JR C,$C6B3     ; }
 $C687 CP $0B         ; {Is #N$15 less than #N$0B? If so, jump to #R$C6CC.
 $C689 JR C,$C6CC     ; }
 $C68B CP $10         ; {Is #N$15 less than #N$10? If so, jump to #R$C6A1.
 $C68D JR C,$C6A1     ; }
 $C68F LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $C692 CP $05         ; {Is the current entity's room index equal to #N$05? If so, jump to
 $C694 JR Z,$C6E3     ; #R$C6E3.}
 $C696 INC (IX+$05)   ; {Move this entity one character down.
 $C699 INC (IX+$06)   ; }
 $C69C INC (IX+$04)   ; Advance this entity into the next room.
 $C69F JR $C6E3       ; Jump to #R$C6E3 to advance to the next helper entity.
; Move this helper up one room (unless already in room #N$01).
@label=Update_Task_Three_Helpers_MoveRoomDown
*$C6A1 LD A,(IX+$04)  ; Load #REGa with the current entity's room index.
 $C6A4 CP $01         ; {Is the current entity's room index equal to #N$01? If so, jump to
 $C6A6 JR Z,$C6E3     ; #R$C6E3.}
 $C6A8 DEC (IX+$05)   ; {Move this entity one character up.
 $C6AB DEC (IX+$06)   ; }
 $C6AE DEC (IX+$04)   ; Move this entity back one room.
 $C6B1 JR $C6E3       ; Jump to #R$C6E3 to advance to the next helper entity.
; Try a left wander step, respecting the high-X and low-X bounds.
@label=Update_Task_Three_Helpers_TryMoveLeft
*$C6B3 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C6B6 CP $E0         ; {Is the current entity's x-coordinate less than #N$E0? If so, jump to
 $C6B8 JR C,$C6C0     ; #R$C6C0.}
 $C6BA CP $E4         ; {Is the current entity's x-coordinate less than #N$E4? If so, jump to
 $C6BC JR C,$C6E3     ; #R$C6E3.}
 $C6BE JR $C6C4       ; Jump to #R$C6C4 to decrease the helper's x-coordinate.
; Left-bound check: below #N$43 step right instead of left.
@label=Update_Task_Three_Helpers_LeftBoundCheck
*$C6C0 CP $43         ; {Is the current entity's x-coordinate less than #N$43? If so, jump to
 $C6C2 JR C,$C6DD     ; #R$C6DD.}
; Nudge the helper one character left.
@label=Update_Task_Three_Helpers_DecX
*$C6C4 DEC (IX+$07)   ; {Move this entity one character left.
 $C6C7 DEC (IX+$08)   ; }
 $C6CA JR $C6E3       ; Jump to #R$C6E3 to advance to the next helper entity.
; Try a right wander step, respecting the high-X and mid-X bounds.
@label=Update_Task_Three_Helpers_TryMoveRight
*$C6CC LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C6CF CP $E0         ; {Is the current entity's x-coordinate less than #N$E0? If so, jump to
 $C6D1 JR C,$C6D9     ; #R$C6D9.}
 $C6D3 CP $FB         ; {Is the current entity's x-coordinate less than #N$FB? If not, jump
 $C6D5 JR NC,$C6E3    ; to #R$C6E3.}
 $C6D7 JR $C6DD       ; Jump to #R$C6DD to increase the helper's x-coordinate.
; Right-bound check: at or beyond #N$BB step left instead of right.
@label=Update_Task_Three_Helpers_RightBoundCheck
*$C6D9 CP $BB         ; {Is the current entity's x-coordinate less than #N$BB? If not, jump
 $C6DB JR NC,$C6C4    ; to #R$C6C4.}
; Nudge the helper one character right.
@label=Update_Task_Three_Helpers_IncX
*$C6DD INC (IX+$07)   ; {Move this entity one character right.
 $C6E0 INC (IX+$08)   ; }
; Advance to the next helper slot and loop until all #N$04 are done.
@label=Update_Task_Three_Helpers_AdvanceSlot
*$C6E3 ADD IX,DE      ; Advance #REGix to the next entity record.
 $C6E5 POP BC         ; Restore #REGbc from the stack.
 $C6E6 DEC B          ; Step the loop counter in #REGb back by one.
 $C6E7 JP NZ,$C665    ; If the result was non-zero, jump to #R$C665.
 $C6EA RET            ; Return.
; Clear type bit #N$07 (end the 'loose' pose) and advance.
@label=Update_Task_Three_Helpers_ClearTypeBit7
*$C6EB RES 7,(IX+$00) ; Reset bit #N$07 of the current entity's entity type.
 $C6EF JR $C6E3       ; Jump to #R$C6E3 to advance to the next helper entity.
; When X is below #N($E0), clear type bit #N$07 and raise SlimyLoose on
; #R$72B6.
@label=Update_Task_Three_Helpers_MaybeSetFlagBit2
*$C6F1 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $C6F4 CP $E0         ; {Is the current entity's x-coordinate less than #N$E0? If not, jump
 $C6F6 JR NC,$C702    ; to #R$C702.}
 $C6F8 RES 7,(IX+$00) ; Reset bit #N$07 of the current entity's entity type.
 $C6FC LD HL,$72B6    ; Point #REGhl at the task-three flags (#R$72B6).
 $C6FF SET 2,(HL)     ; Set SlimyLoose (bit #N$02 of #R$72B6. #R$D907 skips that line while
                      ; set).
 $C701 RET            ; Return.
; Rarely set type bit #N$07 so this helper can enter the SlimyLoose path.
@label=Update_Task_Three_Helpers_MaybeSetTypeBit7
*$C702 LD A,$0A       ; Load #REGa with #N$0A.
 $C704 CALL $EAE5     ; Call #R$EAE5 to pick a pseudo-random value.
 $C707 OR A           ; {Is the random result in #REGa zero? If not, return.
 $C708 RET NZ         ; }
 $C709 SET 7,(IX+$00) ; Set bit #N$07 of the current entity's entity type.
 $C70D RET            ; Return.

