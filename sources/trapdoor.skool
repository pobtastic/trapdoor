 $C7A8 DEFB $F9,$04,$01,$08,$08,$BB,$C7,$04,$04,$C9,$C7,$04,$04,$C2,$C7,$02,$02,$D0,$C7 ; Jump to a time-weighted random layout address (#R$C7BB,
