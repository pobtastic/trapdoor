; Queue Sound
;
; Used by the routines at #R$AB95, #R$ADA1, #R$AECC, #R$AFDC, #R$B034, #R$B2AA,
; #R$BD72, #R$C3D7, #R$C635, #R$CBCE, #R$CC8B, #R$CE4B, #R$D06C, #R$D1FE,
; #R$E286, #R$E82C, #R$EA52, #R$EDDB, #R$EDF8, #R$EFB1 and #R$F069.
; .
; Queue a sound index in #R$7309 for #R$F9AF. If bit #N$07 of #REGa is
; set, force the queue (replace any pending sound). Otherwise keep the existing
; pending sound when one is already waiting #R$F9AF forms the parameter pointer
; as base #R$F8F9(#N$F907) plus index×#N$08. That base address
; #R$F8F9(#N$F907) is the operand byte of the busy-check #R$F906(JR NZ), and it
; is never read as a sound parameter because indexes start at #N$01 (so the
; first block is at #R$F90F).
;
; A Sound index (#N$01–#N$14), optionally with bit #N$07 set to force
@label=Queue_Sound
c$F8F9 BIT 7,A       ; {Is bit #N$07 set (force-queue)? If not, jump to #R$F901 to queue
 $F8FB JR Z,$F901    ; only when idle.}
 $F8FD LD ($7309),A  ; Write the sound index to #R$7309.
 $F900 RET           ; Return.
; Queue the sound index into #R$7309 only when the queue is idle.
@label=Queue_Sound_UnlessBusy
*$F901 PUSH AF       ; Stash #REGaf on the stack.
 $F902 LD A,($7309)  ; Fetch the pending sound index from #R$7309.
 $F905 OR A          ; {Is a sound already waiting? If so, jump to #R$F90D.
 $F906 JR NZ,$F90D   ; }
; Finish #R$F8F9: write the new index when the queue was idle, or discard
; it when busy.
@label=Queue_Sound_CommitOrDiscard
 $F908 POP AF        ; Restore the new index from the stack.
 $F909 LD ($7309),A  ; Write it to #R$7309.
 $F90C RET           ; Return.
; Leave the pending sound in #R$7309 unchanged when the queue is busy.
@label=Queue_Sound_Busy
*$F90D POP AF        ; Restore #REGaf from the stack (discard the new index).
 $F90E RET           ; Return.

; Table: Sound Parameters
;
; Eight-byte parameter blocks for sounds #N$01–#N$14. #R$F9AF forms
; #REGix=#R$F8F9(#N$F907)+(index×#N$08). The base #R$F8F9(#N$F907) is the
; operand byte of #R$F906(JR NZ) in #R$F8F9; it is never read as a parameter
; because indexes start at #N($01), so sound #N$01 begins here. Layout:
; #TABLE(default,centre,centre)
; { =h Offset | =h Meaning }
; { #N$00 | Outer repeat count (#REGc) }
; { #N$01 | Pulse count (#REGb) }
; { #N$02 | Speaker-off delay (#REGe) }
; { #N$03 | Speaker-on delay (#REGd) }
; { #N$04 | Per-pulse delta added to the on-delay }
; { #N$05 | Per-pulse delta added to the off-delay }
; { #N$06 | Flags / waveform high byte (bit #N$07 set = square wave only) }
; { #N$07 | Waveform low byte when bit #N$07 of #N$06 is clear }
; TABLE#
@label=Table_SoundParameters
b$F90F DEFB $01,$17,$70,$0E,$2E,$9E,$80,$00 ; Sound #N$01: score / room-init
                                            ; fanfare (#R$AEF7).
 $F917 DEFB $0F,$0E,$22,$29,$F1,$04,$80,$00 ; Sound #N$02: Berk-action fanfare
                                            ; (#R$AED6).
 $F91F DEFB $08,$FF,$11,$08,$FE,$FE,$80,$00 ; Sound #N$03.
 $F927 DEFB $01,$5A,$77,$46,$02,$04,$80,$00 ; Sound #N$04: entity-slot store
                                            ; (forced as #N$84 at #R$B3B7).
 $F92F DEFB $01,$78,$0A,$0A,$FA,$01,$80,$00 ; Sound #N$05: trap door opening
                                            ; (#R$EE0B).
 $F937 DEFB $01,$32,$EC,$96,$03,$03,$06,$00 ; Sound #N$06: trap door closing
                                            ; (#R$EDE8).
 $F93F DEFB $01,$12,$0A,$0A,$F7,$0B,$00,$00 ; Sound #N$07: entity-slot wait
                                            ; (forced as #N$87 at #R$B409).
 $F947 DEFB $01,$DC,$F4,$C8,$FF,$FF,$80,$00 ; Sound #N$08: random game-event
                                            ; sting (forced as #N$88 at
                                            ; #R$BDAD).
 $F94F DEFB $01,$5A,$DC,$E5,$FE,$FF,$0A,$00 ; Sound #N$09: clear-attributes
                                            ; sting (forced as #N$89 at
                                            ; #R$EA62).
 $F957 DEFB $03,$14,$7B,$45,$FC,$FC,$80,$00 ; Sound #N$0A: message-flash click
                                            ; (#R$E294).
 $F95F DEFB $04,$FF,$43,$C5,$02,$FF,$80,$00 ; Sound #N$0B: task fanfare /
                                            ; stinger (#R$AC6D).
 $F967 DEFB $06,$05,$52,$57,$03,$03,$80,$00 ; Sound #N$0C: timed-event / Drutt
                                            ; script (#R$ADF6 / #R$AFE3).
 $F96F DEFB $01,$2E,$29,$46,$01,$FF,$80,$00 ; Sound #N$0D.
 $F977 DEFB $01,$3C,$C5,$32,$01,$01,$0B,$00 ; Sound #N$0E: trap door / catch thump (also forced as #N$8E at
                                            ; #R$B062 / #R$B130).
 $F97F DEFB $01,$5C,$F6,$79,$FF,$FF,$80,$00 ; Sound #N$0F: ghost update
                                            ; (#R$CEB8).
 $F987 DEFB $01,$08,$90,$71,$FD,$19,$14,$00 ; Sound #N$10: scripted movement
                                            ; (#R$F00B / #R$F0BF).
 $F98F DEFB $01,$64,$38,$96,$FE,$FC,$80,$00 ; Sound #N$11: vat / script action
                                            ; (#R$D06C / #R$D229).
 $F997 DEFB $01,$0B,$21,$B5,$01,$01,$80,$00 ; Sound #N$12: heater (#R$C635).
 $F99F DEFB $07,$01,$60,$45,$00,$00,$01,$00 ; Sound #N$13.
 $F9A7 DEFB $01,$64,$F0,$9F,$F4,$04,$0A,$00 ; Sound #N$14: task-three script
                                            ; action (#R$C3D7).

; Play Queued Sound
;
; Used by the routines at #R$AAB3, #R$AB95, #R$AECC, #R$E286 and #R$EA52.
; .
; Play the sound queued at #R$7309 using the parameter block selected
; from base #R$F8F9(#N$F907) (sound #N$01 starts at #R$F90F), then clear the
; queue. The base #R$F8F9(#N$F907) is the operand byte of #R$F906(JR NZ) in
; #R$F8F9; it is never read as a parameter because indexes start at #N$01.
;
; .
;
; Fetch the pending sound and return if the queue is empty.
@label=Play_QueuedSound
c$F9AF LD A,($7309)   ; Fetch the pending sound index from #R$7309.
 $F9B2 AND %01111111  ; Keep only bits #N$00–#N$06 (mask #N$7F).
 $F9B4 RET Z          ; Return if the queue was empty.
 $F9B5 PUSH IX        ; Stash #REGix on the stack.
; Point #REGix at this sound's parameter block and clear the queue.
 $F9B7 ADD A,A        ; {Multiply the index by #N$08.
 $F9B8 ADD A,A        ;
 $F9B9 ADD A,A        ; }
 $F9BA LD C,A         ; Keep the table offset in #REGc.
 $F9BB XOR A          ; {Clear #R$7309.
 $F9BC LD ($7309),A   ; }
 $F9BF LD B,A         ; Clear #REGb (high byte of the offset).
 $F9C0 LD IX,$F907    ; {Point #REGix at #R$F8F9(#N$F907) (operand of #R$F906) plus the
 $F9C4 ADD IX,BC      ; offset.}
; Load the tone parameters and play.
 $F9C6 LD C,(IX+$00)  ; Load the outer repeat count from #REGix+#N$00 into
                      ; #REGc.
; Outer repeat: reload pulse count and on/off delays from the parameter
; block.
@label=Play_QueuedSound_RepeatLoop
*$F9C9 LD B,(IX+$01)  ; Load the pulse count from #REGix+#N$01 into #REGb.
 $F9CC LD E,(IX+$02)  ; Load the speaker-off delay from #REGix+#N$02 into
                      ; #REGe.
 $F9CF LD D,(IX+$03)  ; Load the speaker-on delay from #REGix+#N$03 into #REGd.
 $F9D2 LD H,(IX+$06)  ; Load the flags / waveform high byte from #REGix+#N$06
                      ; into #REGh.
; One speaker pulse: turn EAR on, delay, optional waveform, then EAR off.
@label=Play_QueuedSound_PulseLoop
*$F9D5 PUSH BC        ; Stash #REGbc on the stack.
 $F9D6 LD A,($EA6C)   ; Fetch the border / speaker state from #R$EA6C.
 $F9D9 SET 4,A        ; Set bit #N$04 (speaker on).
 $F9DB OUT ($FE),A    ; Send it to the speaker (port #N$FE).
 $F9DD LD B,D         ; Keep the on-delay in #REGb.
; Hold the speaker on for the on-delay in #REGd.
@label=Play_QueuedSound_OnDelay
*$F9DE NOP            ; {Hold for the on-delay. jump to #R$F9DE while it
 $F9DF DJNZ $F9DE     ; remains.}
 $F9E1 BIT 7,H        ; {Is the square-wave-only flag set? If so, jump to
 $F9E3 JR NZ,$F9F3    ; #R$F9F3.}
 $F9E5 LD B,(HL)      ; Fetch the next waveform delay into #REGb.
 $F9E6 INC HL         ; Advance the waveform pointer in #REGhl.
; Pad the non-square waveform delay from the stream at #REGhl.
@label=Play_QueuedSound_WaveDelay
*$F9E7 BIT 0,(IX+$00) ; {Timing pad for the waveform delay.
 $F9EB NOP            ;
 $F9EC NOP            ;
 $F9ED NOP            ;
 $F9EE NOP            ;
 $F9EF NOP            ;
 $F9F0 NOP            ; }
 $F9F1 DJNZ $F9E7     ; Decrease the waveform delay and jump to #R$F9E7 while
                      ; it remains.
; Turn the speaker off and hold for the off-delay in #REGe.
@label=Play_QueuedSound_SpeakerOff
*$F9F3 RES 4,A        ; Clear bit #N$04 (speaker off).
 $F9F5 OUT ($FE),A    ; Send it to the speaker (port #N$FE).
 $F9F7 LD B,E         ; Keep the off-delay in #REGb.
; Hold the speaker off for the off-delay, then apply the per-pulse deltas.
@label=Play_QueuedSound_OffDelay
*$F9F8 NOP            ; {Hold for the off-delay. jump to #R$F9F8 while it
 $F9F9 DJNZ $F9F8     ; remains.}
 $F9FB LD A,(IX+$04)  ; {Add the on-delay delta from #REGix+#N$04 to #REGd.
 $F9FE ADD A,D        ;
 $F9FF LD D,A         ; }
 $FA00 LD A,(IX+$05)  ; {Add the off-delay delta from #REGix+#N$05 to #REGe.
 $FA03 ADD A,E        ;
 $FA04 LD E,A         ; }
 $FA05 POP BC         ; Restore #REGbc from the stack.
 $FA06 DJNZ $F9D5     ; Decrease the pulse counter and jump to #R$F9D5 while
                      ; pulses remain.
 $FA08 DEC C          ; Decrease the repeat counter.
 $FA09 JR NZ,$F9C9    ; Jump to #R$F9C9 while repeats remain.
; Housekeeping; restore the registers stashed at the start of the routine.
 $FA0B POP IX         ; Restore #REGix from the stack.
 $FA0D RET            ; Return.

; Buffer: Entity State Backup
;
; Backup copy of complex entity state data, written by #R$AFA9.
@label=Buffer_EntityStateBackup
b$FA0E DEFB $3D,$AB,$5E,$DD,$84,$77,$00,$00
 $FA16 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA1E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA26 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA2E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA36 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA3E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA46 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA4E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA56 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA5E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA66 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA6E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA76 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA7E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA86 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA8E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA96 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FA9E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAA6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAAE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAB6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FABE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAC6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FACE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAD6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FADE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAE6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAEE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAF6 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FAFE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB06 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB0E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB16 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB1E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB26 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB2E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB36 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB3E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB46 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB4E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB56 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB5E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB66 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB6E DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $FB76 DEFB $00,$00,$00,$00,$00,$00,$00,$00
