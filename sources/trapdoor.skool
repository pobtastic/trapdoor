; Graphic Layout: Berk
;
; Berk's graphic layouts for walking right, plus the facing-out waving
; frames at #R$9245, #R$9251, #R$925D and #R$9269 (readers #R$BB13 through
; #R$BB49) and the lower-body parts from #R$9288 through #R$9457. The put-down
; script at #R$B9A9 loads #R$9208 and #R$9214. Walk-right faces also use
; #R$9226 from #R$BA77.
;
; .
;
; Berk walking right.
; .
; #UDGTABLE
; { #LAYOUT$08,$92(layout-9208) }
; UDGTABLE#
@label=GraphicLayout_Berk
b$9208 DEFB $FB,$88,$92                                                         ; Process the nested layout at
                                                                                ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $920B DEFB $FB,$75,$92                                                         ; Process the nested layout at
                                                                                ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $920E DEFB $FA,$04,$FE                                                         ; Move the cursor by
                                                                                ; #IF(#PEEK(#PC+$02)<$80)(#N(#PEEK(#PC+$02)),-#N($0100-#PEEK(#PC+$02)))
                                                                                ; horizontally and
                                                                                ; #IF(#PEEK(#PC+$01)<$80)(#N(#PEEK(#PC+$01)),-#N($0100-#PEEK(#PC+$01)))
                                                                                ; vertically.
 $9211 DEFB $F8,$1A,$93                                                         ; Jump to
                                                                                ; the layout
                                                                                ; at
                                                                                ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100).
; #UDGTABLE
; { #LAYOUT$14,$92(layout-9214) }
; UDGTABLE#
 $9214 DEFB $FB,$88,$92                                                         ; Process the nested layout at
                                                                                ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
 $9217 DEFB $FB,$75,$92                                                         ; Process the nested layout at
                                                                                ; #R(#PEEK(#PC+$01)+#PEEK(#PC+$02)*$0100), then return to the base coordinates.
