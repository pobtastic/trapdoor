; Update Bad Tempered Thing Dialogue
;
; Used by the routine at #R$AAB3.
@label=Update_Bad_Tempered_Thing_Dialogue
c$D7D3 LD A,($72C7)   ; Load #REGa with the Bad Tempered Thing state (#R$72C7).
 $D7D6 CP $FF         ; {Is Bad Tempered Thing state equal to #N$FF? If so,
 $D7D8 RET Z          ; return.}
 $D7D9 LD HL,$3C00    ; Point #REGhl at #SKOOLKID$3D00(CHARSET)-#N$0100.
 $D7DC LD ($72F9),HL  ; Write the pointer in #REGhl to the temporary screen pointer
                      ; (#R$72F9).
 $D7DF LD HL,$D7D2    ; Point #REGhl at Bad Tempered Thing dialogue state
                      ; (#R$D67D(#N$D7D2)).
 $D7E2 INC (HL)       ; Increment the Bad Tempered Thing dialogue counter at
                      ; #REGhl.
 $D7E3 LD HL,$D7CD    ; Point #REGhl at Bad Tempered Thing dialogue bytes
                      ; (#R$D7CD).
 $D7E6 LD A,($72C7)   ; Load #REGa with the Bad Tempered Thing state (#R$72C7).
 $D7E9 OR A           ; {Is Bad Tempered Thing state zero? If so, jump to
 $D7EA JR Z,$D810     ; #R$D810.}
 $D7EC LD E,A         ; Keep Bad Tempered Thing state in #REGe for later.
 $D7ED LD A,($D7D2)   ; Load #REGa from #R$D67D(#N$D7D2).
 $D7F0 CP $32         ; {Is Bad Tempered Thing state less than #N$32? If not, jump to
 $D7F2 JR NC,$D826    ; #R$D826.}
 $D7F4 BIT 0,(HL)     ; {Has this Bad Tempered Thing aside already been shown (bit #N$00 of
 $D7F6 JP NZ,$DA1A    ; #R$D7CD)? If so, jump to #R$DA1A.}
 $D7F9 LD A,($72C7)   ; Load #REGa with the Bad Tempered Thing state (#R$72C7).
 $D7FC CP $FE         ; {Is Bad Tempered Thing state equal to #N$FE? If so,
 $D7FE RET Z          ; return.}
 $D7FF SET 0,(HL)     ; Mark this Bad Tempered Thing aside as already shown (bit #N$00 of
                      ; #R$D7CD).
 $D801 CALL $DA5B     ; Call #R$DA5B to clear Dialogue Area.
 $D804 LD B,E         ; Copy the low byte from #REGe into #REGb (build a
                      ; dialogue index).
 $D805 LD HL,$DD54    ; Point #REGhl at dialogue string data (#R$DD54).
; Skip #REGb dialogue fragments via #R$DA23, then start printing at
; #R$D9C2.
@label=Update_Bad_Tempered_Thing_Dialogue_AdvanceChars
*$D808 CALL $DA23     ; Call #R$DA23 to advance Dialogue Character.
 $D80B DJNZ $D808     ; Decrease the loop counter in #REGb and jump to #R$D808 if more
                      ; iterations remain.
 $D80D JP $D9C2       ; Jump to #R$D9C2 to continue Bad Tempered Thing
                      ; dialogue.
; When Berk is held (flags bit #N$05), either resume a mid-line print or
; open the task branch.
@label=Update_Bad_Tempered_Thing_Dialogue_BerkHeldBit5
*$D810 LD IX,($8EE9)  ; Load #REGix with Boney's complex entity state
                      ; (#R$8EE9).
 $D814 BIT 5,(IX+$01) ; {Is bit #N$05 of the current entity's flags byte 1 set? If not,
 $D818 JR Z,$D826     ; jump to #R$D826.}
 $D81A BIT 0,(HL)     ; {Has this Bad Tempered Thing aside already been shown (bit #N$00 of
 $D81C JP NZ,$DA1A    ; #R$D7CD)? If so, jump to #R$DA1A.}
 $D81F LD A,($D7D2)   ; Load #REGa from #R$D67D(#N$D7D2).
 $D822 CP $32         ; {Is Bad Tempered Thing state less than #N$32? If so,
 $D824 JR C,$D838     ; jump to #R$D838.}
; Reset the dialogue tick, restore layout #R$9C9E (Boney), and clear the
; dialogue strip.
@label=Update_Bad_Tempered_Thing_Dialogue_ResetTickLayout
*$D826 XOR A          ; Clear the Bad Tempered Thing dialogue tick.
 $D827 LD ($D7D2),A   ; Set the Bad Tempered Thing dialogue state
                      ; (#R$D67D(#N$D7D2)).
 $D82A LD (HL),A      ; Write Bad Tempered Thing state through #R$DD54.
 $D82B DEC A          ; Step Bad Tempered Thing state back by one.
 $D82C LD ($72C7),A   ; Set the Bad Tempered Thing state (#R$72C7).
 $D82F LD HL,$9C9E    ; Point #REGhl at #R$9C9E.
 $D832 LD ($8EF3),HL  ; Write that layout pointer to Boney's graphic-layout field
                      ; (#R$8EF3).
 $D835 JP $DA5B       ; Jump to #R$DA5B.
; At dialogue state #N($06), clear the strip and pick task-#N$01..#N$04
; (or menu) gate logic.
@label=Update_Bad_Tempered_Thing_Dialogue_Branch
*$D838 CP $06         ; {Is Bad Tempered Thing state equal to #N$06? If not,
 $D83A RET NZ         ; return.}
 $D83B SET 0,(HL)     ; Set bit #N$00 of #R$9C9E.
 $D83D CALL $DA5B     ; Call #R$DA5B to clear Dialogue Area.
 $D840 LD A,($72AE)   ; Load #REGa with the current task index (#R$72AE).
 $D843 CP $01         ; {Is current task index equal to #N$01? If so, jump to
 $D845 JR Z,$D863     ; #R$D863.}
 $D847 CP $02         ; {Is current task index equal to #N$02? If so, jump to
 $D849 JR Z,$D891     ; #R$D891.}
 $D84B CP $03         ; {Is current task index equal to #N$03? If so, jump to
 $D84D JP Z,$D8DE     ; #R$D8DE.}
 $D850 CP $04         ; {Is current task index equal to #N$04? If so, jump to
 $D852 JP Z,$D930     ; #R$D930.}
 $D855 LD B,$01       ; Load #REGb with #N$01 as a loop counter.
 $D857 LD A,($72B4)   ; Load #REGa with the task status flags (#R$72B4).
 $D85A BIT 7,A        ; {Is bit #N$07 of task status flags set? If not, jump to
 $D85C JP Z,$D971     ; #R$D971.}
 $D85F INC B          ; Advance the dialogue-check counter in #REGb.
 $D860 JP $D971       ; Jump to #R$D971.
; Task #N$01 gates: empty slot #R$9001, collision count #R$72BD, and door
; X choose the line index.
@label=Update_Bad_Tempered_Thing_Dialogue_Task1Gates
*$D863 LD B,$01       ; Load #REGb with #N$01 as a loop counter.
 $D865 LD A,($9001)   ; Load #REGa with the type of complex entity slot #N$20
                      ; (#R$9001).
 $D868 OR A           ; {Is the type at #R$9001 non-zero? If so, jump to
 $D869 JP NZ,$D971    ; #R$D971.}
 $D86C INC B          ; Advance the dialogue-check counter in #REGb.
 $D86D LD A,($72BD)   ; Load #REGa with the collision scratch byte (#R$72BD).
 $D870 OR A           ; {Is #R$72BD non-zero? If so, jump to #R$D882.
 $D871 JR NZ,$D882    ; }
 $D873 LD IX,$902B    ; Point #REGix at the worm-can entity (#R$902B).
 $D877 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $D87A CP $5E         ; {Is the current entity's x-coordinate less than #N$5E? If so, jump to
 $D87C JP C,$D971     ; #R$D971.}
 $D87F LD A,($72BD)   ; Load #REGa with the collision scratch byte (#R$72BD).
; Refine the task-#N$01 line from how far #R$72BD has progressed (zero /
; mid / #N$03).
@label=Update_Bad_Tempered_Thing_Dialogue_Task1CounterGates
*$D882 INC B          ; Advance the dialogue-line index in #REGb.
 $D883 OR A           ; {Is #R$72BD zero? If so, jump to #R$D971.
 $D884 JP Z,$D971     ; }
 $D887 INC B          ; Advance the dialogue-line index in #REGb.
 $D888 CP $03         ; {Is #R$72BD equal to #N$03? If not, jump to #R$D971.
 $D88A JP NZ,$D971    ; }
 $D88D INC B          ; Advance the dialogue-check counter in #REGb.
 $D88E JP $D971       ; Jump to #R$D971.
; Task #N$02 gates: require the script-active flag and phase #N$02 before
; deeper checks.
@label=Update_Bad_Tempered_Thing_Dialogue_Task2Gates
*$D891 LD B,$01       ; Load #REGb with #N$01 as a loop counter.
 $D893 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D896 BIT 7,A        ; {Is bit #N$07 of game event flags set? If not, jump to
 $D898 JR Z,$D8A2     ; #R$D8A2.}
 $D89A LD A,($72AF)   ; Load #REGa with the current task phase (#R$72AF).
 $D89D CP $02         ; {Is current task phase equal to #N$02? If not, jump to
 $D89F JP NZ,$D971    ; #R$D971.}
; Task-#N$02 pan X checks before looking at the spawn timer.
@label=Update_Bad_Tempered_Thing_Dialogue_Task2Creature
*$D8A2 INC B          ; Advance the dialogue-check counter in #REGb.
 $D8A3 LD A,($9055)   ; Load #REGa with the pan entity's type (#R$9055).
 $D8A6 OR A           ; {Is the type at #R$9055 zero? If so, jump to #R$D8B1.
 $D8A7 JR Z,$D8B1     ; }
 $D8A9 LD A,($905C)   ; Load #REGa from #R$8EF3(#N$905C).
 $D8AC CP $5E         ; {Is the byte at #R$8EF3(#N$905C) less than #N$5E? If so, jump to
 $D8AE JP C,$D971     ; #R$D971.}
; Task-#N$02 spawn-timer zero path: only continue while the script-active
; flag is set.
@label=Update_Bad_Tempered_Thing_Dialogue_Task2SpawnZero
*$D8B1 INC B          ; Advance the dialogue-check counter in #REGb.
 $D8B2 LD A,($72C0)   ; Load #REGa with the entity spawn timer (#R$72C0).
 $D8B5 OR A           ; {Is entity spawn timer zero? If not, jump to #R$D8C0.
 $D8B6 JR NZ,$D8C0    ; }
 $D8B8 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D8BB BIT 7,A        ; {Is bit #N$07 of game event flags set? If not, jump to
 $D8BD JP Z,$D971     ; #R$D971.}
; Task-#N$02 spawn-timer path: match #R$72BF and require timer #N$04 for
; the final line.
@label=Update_Bad_Tempered_Thing_Dialogue_Task2SpawnMatch
*$D8C0 INC B          ; Advance the dialogue-check counter in #REGb.
 $D8C1 LD A,($72C0)   ; Load #REGa with the entity spawn timer (#R$72C0).
 $D8C4 OR A           ; {Is entity spawn timer zero? If so, jump to #R$D971.
 $D8C5 JP Z,$D971     ; }
 $D8C8 INC B          ; Advance the dialogue-check counter in #REGb.
 $D8C9 LD C,A         ; Keep entity spawn timer in #REGc for later.
 $D8CA LD A,($72BF)   ; Load #REGa with the room-transition flag (#R$72BF).
 $D8CD CP C           ; {Does the room-transition flag equal the spawn timer in #REGc? If
 $D8CE JP NZ,$D971    ; not, jump to #R$D971.}
 $D8D1 INC B          ; Advance the dialogue-check counter in #REGb.
 $D8D2 LD A,($72C0)   ; Load #REGa with the entity spawn timer (#R$72C0).
 $D8D5 CP $04         ; {Is entity spawn timer equal to #N$04? If not, jump to
 $D8D7 JP NZ,$D971    ; #R$D971.}
 $D8DA INC B          ; Advance the dialogue-check counter in #REGb.
 $D8DB JP $D971       ; Jump to #R$D971.
; Task #N$03 gates: require the script-active flag and phase #N$03 before
; Slimy / stove checks.
@label=Update_Bad_Tempered_Thing_Dialogue_Task3Gates
*$D8DE LD B,$01       ; Load #REGb with #N$01 as a loop counter.
 $D8E0 LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D8E3 BIT 7,A        ; {Is bit #N$07 of game event flags set? If not, jump to
 $D8E5 JR Z,$D8EF     ; #R$D8EF.}
 $D8E7 LD A,($72AF)   ; Load #REGa with the current task phase (#R$72AF).
 $D8EA CP $03         ; {Is current task phase equal to #N$03? If not, jump to
 $D8EC JP NZ,$D971    ; #R$D971.}
; Task-#N$03 creature X and Slimies / SlimyLoose / StoveReady flags choose
; the line index.
@label=Update_Bad_Tempered_Thing_Dialogue_Task3CreatureFlags
*$D8EF INC B          ; {Advance the dialogue-check counter in #REGb by two.
 $D8F0 INC B          ; }
 $D8F1 LD IX,$9063    ; Point #REGix at the cauldron entity (#R$9063).
 $D8F5 LD A,(IX+$07)  ; Load #REGa with the current entity's x-coordinate.
 $D8F8 CP $5E         ; {Is the current entity's x-coordinate less than #N$5E? If so, jump to
 $D8FA JP C,$D971     ; #R$D971.}
 $D8FD INC B          ; Advance the dialogue-check counter in #REGb.
 $D8FE LD HL,$72B6    ; Point #REGhl at the task-three flags (#R$72B6).
 $D901 BIT 1,(HL)     ; {Is Slimies (bit #N$01 of #R$72B6) set? If not, jump to
 $D903 JP Z,$D971     ; #R$D971.}
 $D906 INC B          ; Advance the dialogue-check counter in #REGb.
 $D907 BIT 2,(HL)     ; {Is SlimyLoose (bit #N$02 of #R$72B6) set? If so, jump
 $D909 JP NZ,$D971    ; to #R$D971.}
 $D90C INC B          ; {Advance the dialogue-check counter in #REGb by two.
 $D90D INC B          ; }
 $D90E LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D911 BIT 7,A        ; {Is bit #N$07 of game event flags set? If not, jump to
 $D913 JR Z,$D91A     ; #R$D91A.}
 $D915 BIT 6,(HL)     ; {Is StoveReady (bit #N$06 of #R$72B6) set? If not, jump
 $D917 JP Z,$D971     ; to #R$D971.}
; Final task-#N$03 gates: StoveReady, MobileHeater, and BoilEmUp must all
; be set.
@label=Update_Bad_Tempered_Thing_Dialogue_Task3FlagWalk
*$D91A INC B          ; Advance the dialogue-check counter in #REGb.
 $D91B BIT 6,(HL)     ; {Is StoveReady (bit #N$06 of #R$72B6) set? If not, jump
 $D91D JP Z,$D971     ; to #R$D971.}
 $D920 INC B          ; Advance the dialogue-check counter in #REGb.
 $D921 BIT 0,(HL)     ; {Is MobileHeater (bit #N$00 of #R$72B6) set? If not,
 $D923 JP Z,$D971     ; jump to #R$D971.}
 $D926 INC B          ; Advance the dialogue-check counter in #REGb.
 $D927 BIT 4,(HL)     ; {Is BoilEmUp (bit #N$04 of #R$72B6) set? If not, jump
 $D929 JP Z,$D971     ; to #R$D971.}
 $D92C INC B          ; Advance the dialogue-check counter in #REGb.
 $D92D JP $D971       ; Jump to #R$D971.
; Task #N$04 gates: animation frame, interaction bits on #R$72B9, and
; phase #N$04 choose the line.
@label=Update_Bad_Tempered_Thing_Dialogue_Task4Gates
*$D930 LD B,$01       ; Load #REGb with #N$01 as a loop counter.
 $D932 LD A,($72C1)   ; Load #REGa with the animation frame counter (#R$72C1).
 $D935 CP $03         ; {Is animation frame counter equal to #N$03? If so, jump
 $D937 JP Z,$D971     ; to #R$D971.}
 $D93A INC B          ; Advance the dialogue-check counter in #REGb.
 $D93B LD HL,$72B9    ; Point #REGhl at the entity interaction flag (#R$72B9).
 $D93E BIT 1,(HL)     ; {Is bit #N$01 of #R$72B9 set? If not, jump to #R$D971.
 $D940 JP Z,$D971     ; }
 $D943 INC B          ; Advance the dialogue-check counter in #REGb.
 $D944 BIT 4,(HL)     ; {Is bit #N$04 of #R$72B9 set? If not, jump to #R$D971.
 $D946 JP Z,$D971     ; }
 $D949 INC B          ; Advance the dialogue-check counter in #REGb.
 $D94A LD A,($72B3)   ; Load #REGa with the game event flags (#R$72B3).
 $D94D BIT 7,A        ; {Is bit #N$07 of game event flags set? If not, jump to
 $D94F JP Z,$D971     ; #R$D971.}
 $D952 INC B          ; Advance the dialogue-check counter in #REGb.
 $D953 LD A,($72AF)   ; Load #REGa with the current task phase (#R$72AF).
 $D956 CP $04         ; {Is current task phase equal to #N$04? If not, jump to
 $D958 JP NZ,$D971    ; #R$D971.}
 $D95B INC B          ; Advance the dialogue-check counter in #REGb.
 $D95C BIT 2,(HL)     ; {Is bit #N$02 of #R$72B9 set? If so, jump to #R$D971.
 $D95E JP NZ,$D971    ; }
 $D961 INC B          ; Advance the dialogue-check counter in #REGb.
 $D962 JP $D971       ; Jump to #R$D971.

; Table: Bad Tempered Thing Dialogue
;
; Per-task dialogue pointers indexed by #R$D983. Task #N$00 skips this
; table and uses #R$D7CD instead.
@label=Data_BadTemperedThingDialogue
g$D965 DEFW $0000    ; Task #N$00 (unused, #N($0000,$04,$04)).
 $D967 DEFW $DAC3    ; Task #N$01 dialogue at #R$DAC3.
 $D969 DEFW $DB22    ; Task #N$02 dialogue at #R$DB22.
 $D96B DEFW $DBA6    ; Task #N$03 dialogue at #R$DBA6.
 $D96D DEFW $DC56    ; Task #N$04 dialogue at #R$DC56.
 $D96F DEFW $DCE9    ; Task #N$05 dialogue at #R$DCE9.

; Continue Bad Tempered Thing Dialogue
;
; Used by the routine at #R$D7D3.
; .
; Continuation of #R$D7D3 after the dialogue table at #R$D965.
@label=Continue_Bad_Tempered_Thing_Dialogue
c$D971 LD A,($72AE)  ; Load #REGa with the current task index (#R$72AE).
 $D974 OR A          ; {Is #REGa zero? If not, jump to #R$D983.
 $D975 JR NZ,$D983   ; }
 $D977 LD HL,$D7CD   ; Point #REGhl at Bad Tempered Thing dialogue bytes
                     ; (#R$D7CD).
 $D97A SET 0,(HL)    ; Mark this Bad Tempered Thing aside as already shown (bit #N$00 of
                     ; #R$D7CD).
 $D97C LD HL,$DA66   ; Point #REGhl at Messaging: Task Menu Options (#R$DA66).
 $D97F LD A,$06      ; Load #REGa with #N$06.
 $D981 JR $D9AE      ; Jump to #R$D9AE to pick a random dialogue variant.
; Index the per-task dialogue table at #R$D965 by the current task.
@label=Update_Bad_Tempered_Thing_Dialogue_IndexTable
*$D983 ADD A,A       ; Double #REGa.
 $D984 LD E,A        ; Copy #REGa into #REGe for later use.
 $D985 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $D987 LD HL,$D965   ; Point #REGhl at the dialogue table (#R$D965).
 $D98A ADD HL,DE     ; Add the offset in #REGde to the pointer in #REGhl.
 $D98B LD E,(HL)     ; {Fetch the dialogue pointer into #REGde.
 $D98C INC HL        ;
 $D98D LD D,(HL)     ; }
 $D98E EX DE,HL      ; Swap the destination and source pointers in
                     ; #REGde/#REGhl.
; Skip join markers (#CHR$26) and walk #REGb fragments to the gated line.
@label=Update_Bad_Tempered_Thing_Dialogue_SkipJoinMarkers
*$D98F CALL $DA23    ; Call #R$DA23 to advance Dialogue Character.
 $D992 CP $26        ; {Is #REGa equal to #N$26? If so, jump to #R$D98F.
 $D994 JR Z,$D98F    ; }
 $D996 DJNZ $D98F    ; Decrease the loop counter in #REGb and jump to #R$D98F if more
                     ; iterations remain.
; If the gate byte is non-zero, decrement it and fall back to a random
; aside; else start Part A.
@label=Update_Bad_Tempered_Thing_Dialogue_GateByteOrAside
*$D998 LD A,(HL)     ; Fetch the byte at #REGhl.
 $D999 OR A          ; {Is #REGa zero? If so, jump to #R$D9BA.
 $D99A JR Z,$D9BA    ; }
 $D99C DEC (HL)      ; Decrease the counter/flag byte at #REGhl.
 $D99D CALL $DA23    ; Call #R$DA23 to advance Dialogue Character.
 $D9A0 CP $26        ; {Is #REGa equal to #N$26? If so, jump to #R$D998.
 $D9A2 JR Z,$D998    ; }
 $D9A4 LD HL,$D7CD   ; Point #REGhl at Bad Tempered Thing dialogue bytes
                     ; (#R$D7CD).
 $D9A7 SET 0,(HL)    ; Set bit #N$00 of #R$D7CD (aside-already-shown).
 $D9A9 LD HL,$DD1C   ; Point #REGhl at #R$DD1C.
 $D9AC LD A,$04      ; Load #REGa with #N$04.
; Pick a random aside variant and skip that many fragments before
; printing.
@label=Update_Bad_Tempered_Thing_Dialogue_Hit
*$D9AE CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $D9B1 INC A         ; Turn the random roll into a #N$01-based skip count.
 $D9B2 LD B,A        ; Copy #REGa into #REGb for later use.
; Consume the remaining skip count via #R$DA23, then enter the print setup
; at #R$D9C2.
@label=Update_Bad_Tempered_Thing_Dialogue_Exit
*$D9B3 CALL $DA23    ; Call #R$DA23 to advance Dialogue Character.
 $D9B6 DJNZ $D9B3    ; Decrease the loop counter in #REGb and jump to #R$D9B3 if more
                     ; iterations remain.
 $D9B8 JR $D9C2      ; Jump to #R$D9C2 to continue Bad Tempered Thing dialogue.
; Seed a fresh random gate byte (#N$01..#N$03) when the previous gate hit
; zero.
@label=Update_Bad_Tempered_Thing_Dialogue_PartA
*$D9BA LD A,$03      ; Load #REGa with #N$03.
 $D9BC CALL $EAE5    ; Call #R$EAE5 to pick a pseudo-random value.
 $D9BF INC A         ; Turn the random roll into a #N$01-based gate value.
 $D9C0 LD (HL),A     ; Set the byte at #REGhl.
 $D9C1 INC HL        ; Advance past the freshly written gate byte.
; This entry point is used by the routine at #R$D7D3.
; .
; Stash the dialogue string pointer and begin measuring the fragment
; length.
@label=Update_Bad_Tempered_Thing_Dialogue_PartB
*$D9C2 PUSH HL       ; Stash #REGhl on the stack.
 $D9C3 LD E,$00      ; Load #REGe with #N$00.
; Count characters until a fragment (#CHR$5B) or join (#CHR$26) marker.
@label=Update_Bad_Tempered_Thing_Dialogue_PartC
*$D9C5 LD A,(HL)     ; Fetch the byte at #REGhl.
 $D9C6 CP $5B        ; {Is #REGa equal to #N$5B? If so, jump to #R$D9D2.
 $D9C8 JR Z,$D9D2    ; }
 $D9CA CP $26        ; {Is #REGa equal to #N$26? If so, jump to #R$D9D2.
 $D9CC JR Z,$D9D2    ; }
 $D9CE INC E         ; Advance the low byte of the pointer/offset in #REGde.
 $D9CF INC HL        ; Advance through the dialogue fragment.
 $D9D0 JR $D9C5      ; Jump to #R$D9C5 to fetch the next dialogue byte.
; Compute left padding so the line centres within the #N$17-character
; dialogue strip.
@label=Update_Bad_Tempered_Thing_Dialogue_PartD
*$D9D2 LD A,$17      ; Load #REGa with #N$17.
 $D9D4 SUB E         ; Subtract #REGe from #REGa.
 $D9D5 JR NC,$D9D8   ; If no borrow/miss was signaled, jump to #R$D9D8.
 $D9D7 XOR A         ; Clear #REGa to #N$00.
; Halve that padding, restore the string pointer into #REGix, and aim
; #REGhl at #N$5AC1 (attribute buffer).
@label=Update_Bad_Tempered_Thing_Dialogue_PartE
*$D9D8 SRL A         ; Shift the flag/value in #REGa right one bit.
 $D9DA POP IX        ; Pop the dialogue string pointer into #REGix.
 $D9DC LD HL,$5AC1   ; Load #REGhl with #N$5AC1 (attribute buffer).
 $D9DF LD E,A        ; Copy #REGa into #REGe for later use.
 $D9E0 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $D9E2 ADD HL,DE     ; Add the offset in #REGde to the pointer in #REGhl.
; Draw each dialogue character via #R$DA2D, saving the cursor in
; #R$D67D(#N$D7CE) / #R$D67D(#N$D7D0).
@label=Update_Bad_Tempered_Thing_Dialogue_PartF
*$D9E3 LD E,(IX+$00) ; Load #REGe with the next dialogue character code from
                     ; *(#REGix).
 $D9E6 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $D9E8 CALL $DA2D    ; Call #R$DA2D to draw Dialogue Character.
 $D9EB INC IX        ; Advance the dialogue source pointer by one character.
 $D9ED INC HL        ; Advance the attribute-file destination by one column.
 $D9EE LD ($D7CE),IX ; Store #REGix in #R$D67D(#N$D7CE).
 $D9F2 LD ($D7D0),HL ; Store #REGhl in #R$D67D(#N$D7D0).
 $D9F5 LD A,(IX+$00) ; Fetch the next dialogue byte from *(#REGix).
 $D9F8 CP $5B        ; {Is #REGa equal to #N$5B? If so, jump to #R$D9FF.
 $D9FA JR Z,$D9FF    ; }
 $D9FC CP $26        ; {Is #REGa equal to #N$26? If not, return.
 $D9FE RET NZ        ; }
; End of line: clear the aside-shown bit, restore Berk's layout, and arm
; the #N$FE cooldown.
@label=Update_Bad_Tempered_Thing_Dialogue_PartG
*$D9FF LD HL,$D7CD   ; Point #REGhl at Bad Tempered Thing dialogue bytes
                     ; (#R$D7CD).
 $DA02 RES 0,(HL)    ; Clear bit #N$00 of #R$D7CD (aside-already-shown).
 $DA04 LD HL,$9C9E   ; Point #REGhl at #R$9C9E.
 $DA07 LD ($8EF3),HL ; Write that layout pointer to Boney's graphic-layout field
                     ; (#R$8EF3).
 $DA0A LD A,($72C7)  ; Load #REGa with the Bad Tempered Thing state (#R$72C7).
 $DA0D OR A          ; {Is #REGa zero? If so, return.
 $DA0E RET Z         ; }
 $DA0F LD A,$FE      ; Load #REGa with #N$FE.
 $DA11 LD ($72C7),A  ; Set the Bad Tempered Thing state (#R$72C7).
 $DA14 LD A,$2F      ; Load #REGa with #N$2F.
 $DA16 LD ($D7D2),A  ; Set the Bad Tempered Thing dialogue state
                     ; (#R$D67D(#N$D7D2)).
 $DA19 RET           ; Return.
; This entry point is used by the routine at #R$D7D3.
; .
; Resume a mid-line print from the saved #R$D67D(#N$D7CE) /
; #R$D67D(#N$D7D0) cursors.
@label=Update_Bad_Tempered_Thing_Dialogue_PartH
*$DA1A LD IX,($D7CE) ; Load #REGix from #R$D67D(#N$D7CE).
 $DA1E LD HL,($D7D0) ; Load #REGhl from #R$D67D(#N$D7D0).
 $DA21 JR $D9E3      ; Jump to #R$D9E3 to reload the entity type for dialogue.

; Advance Dialogue Character
;
; Used by the routines at #R$D7D3 and #R$D971.
; .
; Walk #REGhl forward through a dialogue printer string until the next
; fragment marker (#CHR$5B) or join marker (#CHR$26).
@label=Advance_DialogueCharacter
c$DA23 LD A,(HL)     ; {Fetch the next dialogue byte. Advance the dialogue pointer. Is it a
 $DA24 INC HL        ; fragment marker (#CHR$5B)? If so, return with #REGhl on that marker.
 $DA25 CP $5B        ;
 $DA27 RET Z         ; }
 $DA28 CP $26        ; {Is it a join marker (#CHR$26)? If so, return with #REGhl on that
 $DA2A RET Z         ; marker.}
 $DA2B JR $DA23      ; Jump to #R$DA23 to keep scanning.

; Draw Dialogue Character
;
; Used by the routine at #R$D971.
; .
; Draw one ROM/charset glyph for Bad Tempered Thing dialogue. #REGhl is
; the destination attribute-file address; #REGe holds the character code
; Thickens the bitmap (byte OR byte>>#N$01) and points Boney's graphic layout
; at #R$9C8A while the line is shown.
;
; HL Attribute-file address for the glyph
; E Character code to draw
;
; Stash callers' registers and paint the glyph attribute.
@label=Draw_DialogueCharacter
c$DA2D PUSH DE       ; {Stash #REGde, #REGhl and #REGbc on the stack.
 $DA2E PUSH HL       ;
 $DA2F PUSH BC       ; }
 $DA30 LD A,$47      ; {Set the dialogue glyph attribute to bright white on
 $DA32 LD (HL),A     ; black (#N$47).}
; Convert the attribute address into a screen-bitmap address and locate
; the glyph.
 $DA33 LD A,H        ; {Multiply the attribute address high byte by #N($08).
 $DA34 ADD A,A       ;
 $DA35 ADD A,A       ;
 $DA36 ADD A,A       ; }
 $DA37 AND %01011011 ; Keep only the screen-bitmap high bits (mask #N$5B).
 $DA39 LD H,A        ; Write the result back to #REGh.
 $DA3A PUSH HL       ; Stash #REGhl on the stack.
 $DA3B EX DE,HL      ; {Swap the character code into #REGhl, multiply it by #N($08), and add
 $DA3C ADD HL,HL     ; the character-set base at #R$72F9 to get the glyph address.
 $DA3D ADD HL,HL     ;
 $DA3E ADD HL,HL     ;
 $DA3F LD DE,($72F9) ;
 $DA43 ADD HL,DE     ; }
 $DA44 POP DE        ; Restore #REGde from the stack.
; Copy eight thickened glyph rows to the screen.
 $DA45 LD B,$08      ; There are #N$08 pixel rows in a character.
; Copy one thickened glyph row (byte OR byte>>#N$01) and point Berk at
; talking layout #R$9C8A.
@label=Draw_DialogueCharacter_CopyThickRow
*$DA47 LD A,(HL)     ; {Copy one thickened glyph row (byte OR byte>>#N$01) to the screen and
 $DA48 LD C,A        ; advance.
 $DA49 SRL C         ;
 $DA4B OR C          ;
 $DA4C LD (DE),A     ;
 $DA4D INC D         ;
 $DA4E INC HL        ;
 $DA4F DJNZ $DA47    ; }
 $DA51 LD HL,$9C8A   ; {Point Boney's graphic layout pointer (#R$8EF3) at
 $DA54 LD ($8EF3),HL ; #R$9C8A.}
 $DA57 POP BC        ; {Restore #REGbc, #REGhl and #REGde from the stack.
 $DA58 POP HL        ;
 $DA59 POP DE        ; }
 $DA5A RET           ; Return.

; Clear Dialogue Area
;
; Used by the routine at #R$D7D3.
; .
; Blank the Bad Tempered Thing dialogue attribute strip at
; #N$5AC1 (attribute buffer) (#N$17 characters).
@label=Clear_DialogueArea
c$DA5B LD HL,$5AC1   ; Point #REGhl at the dialogue attribute row
                     ; (#N$5AC1 (attribute buffer)).
 $DA5E LD B,$17      ; Load #REGb with #N$17 as a clear counter.
; Blank one attribute cell of the dialogue strip and loop for all #N$17
; columns.
@label=Clear_DialogueArea_WriteBlank
*$DA60 LD (HL),$00   ; {Write ink/paper #N$00 at #REGhl. Advance along the row. Loop until
 $DA62 INC HL        ; the strip is cleared.
 $DA63 DJNZ $DA60    ; }
 $DA65 RET           ; Return.

