 $E97F DEFB $80,$04
 $E981 DEFB $E0,$04
 $E983 DEFB $40,$05
 $E985 DEFB $A0,$05
 $E987 DEFB $00,$06
 $E989 DEFB $60,$06
 $E98B DEFB $C0,$06
 $E98D DEFB $20,$07
 $E98F DEFB $80,$07

; Blit Display Buffer To Screen
;
; Used by the routine at #R$AAB3.
; .
; Compare the primary and secondary display buffers and blit changed tiles
; to the Spectrum screen. Tiles with attribute bit #N$07 set are horizontally
; mirrored via #R$7319 (see #R$EA23).
;
; .
;
; Choose which display buffer is "live" versus "previous" from #R$72EA.
@label=Blit_DisplayBuffer
c$E991 LD IX,$5800   ; Point #REGix at the attribute file (#N$5800 (attribute
                     ; buffer)).
 $E995 LD HL,$63A0   ; Point #REGhl at Primary Display Buffer (#R$63A0).
 $E998 LD DE,$6B20   ; Point #REGde at Secondary Display Buffer (#R$6B20).
 $E99B LD A,($72EA)  ; Load #REGa with the display-buffer select flag
                     ; (#R$72EA).
 $E99E OR A          ; {Is the display-buffer select flag (#R$72EA) zero? If so, jump to
 $E99F JR Z,$E9A2    ; #R$E9A2.}
 $E9A1 EX DE,HL      ; Exchange #REGde and #REGhl.
; After selecting primary/secondary, walk #N$14 rows × #N$20 columns for
; dirty tiles.
@label=Blit_DisplayBuffer_AfterSelect
*$E9A2 PUSH DE       ; {Copy #REGde into #REGiy (using the stack).
 $E9A3 POP IY        ; }
 $E9A5 LD B,$14      ; Load #REGb with #N$14.
; Begin one display-buffer row of #N$20 tile comparisons.
@label=Blit_DisplayBufferLoop
*$E9A7 PUSH BC       ; Stash #REGbc on the stack.
 $E9A8 LD B,$20      ; Load #REGb with loop count #N$20.
; Compare one tile's graphic-set / type / attribute triple against the
; secondary buffer.
@label=Blit_DisplayBufferLoopB
*$E9AA PUSH BC       ; Stash #REGbc on the stack.
 $E9AB LD A,(HL)     ; Fetch the next primary-buffer graphic-set byte.
 $E9AC INC HL        ; Advance the display-buffer pointer in #REGhl by one
                     ; byte.
 $E9AD OR A          ; {Is #REGa zero? If so, jump to #R$E9E6.
 $E9AE JP Z,$E9E6    ; }
 $E9B1 LD C,A        ; Keep the remaining count in #REGc.
 $E9B2 LD E,$00      ; Load #REGe with #N$00.
 $E9B4 CP (IY+$00)   ; {Does #REGa match the referenced entity's type? If not, jump to
 $E9B7 JR NZ,$E9BA   ; #R$E9BA.}
 $E9B9 INC E         ; Advance the low byte of the pointer/offset in #REGde.
; Match the tile's entity-type byte; count matches in #REGe.
@label=Blit_DisplayBufferLoopB2
*$E9BA LD A,(HL)     ; Fetch the next script byte.
 $E9BB OR A          ; {Is the next script byte zero? If so, jump to #R$E9E6.
 $E9BC JR Z,$E9E6    ; }
 $E9BE LD B,A        ; Keep a copy of #REGa in #REGb.
 $E9BF CP (IY+$01)   ; {Does #REGa match the referenced entity's flags byte 1? If not, jump
 $E9C2 JR NZ,$E9C5   ; to #R$E9C5.}
 $E9C4 INC E         ; Advance the low byte of the pointer/offset in #REGde.
; Match the tile's attribute byte; blit via #R$E9EF unless both prior
; bytes already matched.
@label=Blit_DisplayBufferLoopB3
*$E9C5 INC HL        ; Advance the display-buffer pointer in #REGhl by one
                     ; byte.
 $E9C6 LD A,(HL)     ; Fetch the next script byte.
 $E9C7 CP (IY+$02)   ; {Does #REGa match the referenced entity's flags byte 2? If not, jump
 $E9CA JR NZ,$E9D0   ; to #R$E9D0.}
 $E9CC BIT 1,E       ; {Is bit #N$01 of #REGe set? If so, jump to #R$E9D5.
 $E9CE JR NZ,$E9D5   ; }
; Blit this changed tile to the Spectrum screen through #R$E9EF.
@label=Blit_DisplayBufferLoopB4
*$E9D0 PUSH HL       ; Stash #REGhl on the stack.
 $E9D1 CALL $E9EF    ; Call #R$E9EF to blit Display Buffer Row.
 $E9D4 POP HL        ; Restore #REGhl from the stack.
; Advance past this tile's triple and move to the next attribute column.
@label=Blit_DisplayBufferLoopB5
*$E9D5 INC HL        ; Advance the display-buffer pointer in #REGhl by one
                     ; byte.
 $E9D6 INC IX        ; Advance #REGix to the next attribute-file column.
 $E9D8 LD DE,$0003   ; Load #REGde with #N($0003,$04,$04).
 $E9DB ADD IY,DE     ; #REGiy+=#REGde.
 $E9DD POP BC        ; Restore #REGbc from the stack.
 $E9DE DJNZ $E9AA    ; Decrease the loop counter in #REGb and jump to #R$E9AA if more
                     ; iterations remain.
 $E9E0 POP BC        ; Restore #REGbc from the stack.
 $E9E1 DEC B         ; Decrease #REGb by one.
 $E9E2 JP NZ,$E9A7   ; Jump to #R$E9A7 to continue if the comparison did not
                     ; match.
 $E9E5 RET           ; Return.
; Treat a zero graphic-set as "blank": force bit #N$06 and skip the blit.
@label=Blit_DisplayBufferLoopB6
*$E9E6 INC HL        ; Advance the display-buffer pointer in #REGhl by one
                     ; byte.
 $E9E7 LD A,(HL)     ; Fetch the next script byte.
 $E9E8 SET 6,A       ; Set bit #N$06 of #REGa.
 $E9EA LD (IX+$00),A ; Set the current entity's entity type.
 $E9ED JR $E9D5      ; Jump to #R$E9D5 to continue the loop.

; Blit Display Buffer Row
;
; Used by the routine at #R$E991.
; .
; Blit one display-buffer tile to the screen. The graphic-set index
; selects a base from #R$730B; the tile index × #N$08 is added to that base
; Attribute bit #N$07 selects the mirrored blit at #R$EA23 (via #R$7319).
;
; .
;
; Write the attribute and resolve the graphic-set tile address.
@label=Blit_DisplayBufferRow
c$E9EF SET 6,A        ; {Force bright on the attribute in #REGa and write it
 $E9F1 LD (IX+$00),A  ; through #REGix.}
 $E9F4 LD L,B         ; {Keep the tile index in #REGhl (high byte cleared).
 $E9F5 XOR A          ;
 $E9F6 LD B,A         ;
 $E9F7 LD H,A         ; }
 $E9F8 ADD A,C        ; {Double the graphic-set index into #REGbc as a word
 $E9F9 ADD A,C        ; offset.
 $E9FA LD C,A         ;
 $E9FB PUSH HL        ; }
 $E9FC LD HL,$730B    ; {Point #REGhl at #R$730B, add the set offset, and fetch the set base
 $E9FF ADD HL,BC      ; into #REGbc.
 $EA00 LD C,(HL)      ;
 $EA01 INC HL         ;
 $EA02 LD B,(HL)      ; }
 $EA03 POP HL         ; {Restore the tile index, multiply it by #N($08), and add the set base
 $EA04 ADD HL,HL      ; to get the bitmap address.
 $EA05 ADD HL,HL      ;
 $EA06 ADD HL,HL      ;
 $EA07 ADD HL,BC      ; }
 $EA08 EX DE,HL       ; Keep the bitmap address in #REGde.
; Convert the attribute address into a screen-bitmap address and blit.
 $EA09 PUSH IX        ; Copy #REGix to #REGhl (using the stack).
 $EA0B POP HL         ;
 $EA0C LD A,H         ; {Multiply the attribute high byte by #N($08).
 $EA0D ADD A,A        ;
 $EA0E ADD A,A        ;
 $EA0F ADD A,A        ; }
 $EA10 AND %01011011  ; Keep only the screen-bitmap high bits (mask #N$5B).
 $EA12 LD H,A         ; {Write the result to #REGh and move the address into
 $EA13 EX DE,HL       ; #REGde.}
 $EA14 BIT 7,(IX+$00) ; {Is the mirror bit (bit #N$07) set on the attribute? If so, blit the
 $EA18 JR NZ,$EA23    ; mirrored tile at #R$EA23.}
 $EA1A LD B,$08       ; There are #N$08 pixel rows in a tile.
; Copy #N$08 pixel rows of an unmirrored tile into the screen bitmap.
@label=Blit_DisplayBufferRow_CopyRows
*$EA1C LD A,(HL)      ; {Copy one bitmap row to the screen and step to the next
 $EA1D LD (DE),A      ; pixel row.
 $EA1E INC D          ;
 $EA1F INC HL         ;
 $EA20 DJNZ $EA1C     ; }
 $EA22 RET            ; Return.
; Blit the tile with horizontal mirroring via #R$7319.
@label=Blit_DisplayBufferRowLoop
*$EA23 RES 7,(IX+$00) ; Clear the mirror bit on the attribute at #REGix.
 $EA27 LD B,$08       ; There are #N$08 pixel rows in a tile.
; Copy #N$08 pixel rows with horizontal mirroring via #R$7319.
@label=Blit_DisplayBufferRowLoopB
*$EA29 PUSH BC        ; {Fetch a bitmap byte, reverse it through #R$7319, write it to the
 $EA2A LD A,(HL)      ; screen, and step to the next pixel row.
 $EA2B PUSH HL        ;
 $EA2C LD HL,$7319    ;
 $EA2F LD C,A         ;
 $EA30 LD B,$00       ;
 $EA32 ADD HL,BC      ;
 $EA33 LD A,(HL)      ;
 $EA34 POP HL         ;
 $EA35 LD (DE),A      ;
 $EA36 INC D          ;
 $EA37 INC HL         ;
 $EA38 POP BC         ;
 $EA39 DJNZ $EA29     ; }
 $EA3B RET            ; Return.

; Clear Both Display Buffers
;
; Used by the routines at #R$AD6F, #R$AF3C, #R$E300 and #R$EA52.
; .
; Zero-fill #N$0F00 bytes from Primary Display Buffer (#R$63A0), covering
; both the primary and secondary buffers.
@label=Clear_BothDisplayBuffers
c$EA3C LD HL,$63A0   ; Point #REGhl at Primary Display Buffer (#R$63A0).
 $EA3F LD BC,$0F00   ; Load #REGbc with #N$0F00.
 $EA42 JR $EA4A      ; Jump to #R$EA4A to fill with #N$00.

; Clear Display Buffer
;
; Used by the routine at #R$AAB3.
; .
; Clear the current display buffer.
@label=Clear_DisplayBuffer
c$EA44 LD HL,($72F5) ; Load #REGhl with the current display-buffer pointer
                     ; (#R$72F5).
 $EA47 LD BC,$077F   ; Load #REGbc with #N$077F.
; This entry point is used by the routine at #R$EA3C.
; .
; Shared zero-fill used to clear one or both display buffers.
@label=Fill_MemoryWithZero
*$EA4A XOR A         ; Clear #REGa to #N$00.
 $EA4B LD (HL),A     ; Set the byte at #REGhl.
 $EA4C LD D,H        ; Copy #REGhl to #REGde.
 $EA4D LD E,L        ; Copy #REGhl to #REGde.
 $EA4E INC DE        ; Advance the clear-attributes destination by one.
 $EA4F LDIR          ; Copy bytes from *#REGhl to *#REGde until #REGbc is zero.
 $EA51 RET           ; Return.

; Clear Attribute File
;
; Used by the routines at #R$AD6F, #R$BC64 and #R$EA73.
; .
; Clear the attribute file.
;
; A Attribute fill value
@label=Clear_AttributeFile
c$EA52 EXX           ; Switch to the shadow registers.
 $EA53 LD HL,$5800   ; Load #REGhl with #N$5800 (attribute buffer).
 $EA56 LD D,H        ; Copy #REGhl to #REGde.
 $EA57 LD E,L        ; Copy #REGhl to #REGde.
 $EA58 INC DE        ; Advance the clear-attributes destination by one.
 $EA59 LD (HL),A     ; Write the fill value to the first attribute cell.
 $EA5A LD BC,$027F   ; {Copy #N$027F attribute bytes from *#REGhl to *#REGde.
 $EA5D LDIR          ; }
 $EA5F CALL $EA3C    ; Call #R$EA3C to clear both display buffers.
; #HTML(#AUDIO0(clear-attributes.wav)(#INCLUDE(ClearAttributes)))
 $EA62 LD A,$89      ; Load #REGa with sound index #N$89.
 $EA64 CALL $F8F9    ; Call #R$F8F9 to queue a sound effect.
 $EA67 CALL $F9AF    ; Call #R$F9AF to play the queued sound.
 $EA6A EXX           ; Switch to the shadow registers.
 $EA6B RET           ; Return.

; Border / Speaker State
;
; Current border colour and EAR bit. Written by #R$EA6D; read by #R$F9AF
; before each speaker toggle.
@label=BorderSpeakerState
g$EA6C DEFB $00

; Set Border And Speaker State
;
; Used by the routines at #R$AF3C and #R$F454.
; .
; Output #REGa to port #N$FE and remember it at #R$EA6C.
@label=Set_BorderSpeakerState
c$EA6D OUT ($FE),A   ; Send #REGa to the speaker (port #N$FE).
 $EA6F LD ($EA6C),A  ; Store it at #R$EA6C.
 $EA72 RET           ; Return.

; Reposition Camera-Follow Entity After Interaction
;
; Used by the routines at #R$B034, #R$B92C, #R$BC54, #R$C582 and #R$CC8B.
; .
; Clear the attribute file via #R$EA52, then randomly reposition the
; camera-follow entity (#R$909B) and store a Berk script pointer at #R$72B1.
@label=Reposition_CameraFollowEntity
c$EA73 LD A,$04        ; Load #REGa with #N$04.
 $EA75 LD ($730A),A    ; Set the camera-follow delay (#R$730A).
 $EA78 LD A,$7F        ; Load #REGa with #N$7F.
 $EA7A CALL $EA52      ; Call #R$EA52 to clear the attribute file (and play
                       ; sound).
 $EA7D EXX             ; Switch to the shadow registers.
 $EA7E PUSH IX         ; Stash #REGix on the stack.
 $EA80 LD IX,$909B     ; Point #REGix at the camera-follow entity (#R$909B).
 $EA84 LD A,(IX+$07)   ; Load #REGa with the current entity's x-coordinate.
 $EA87 LD B,$05        ; Load #REGb with #N$05.
; Divide the follow entity's X by #N$20 to pick a room-band seed.
@label=Reposition_CameraFollow_ShiftX
*$EA89 SRL A           ; Shift #REGa right logical.
 $EA8B DJNZ $EA89      ; Decrease the loop counter in #REGb and jump to #R$EA89 if more
                       ; iterations remain.
 $EA8D LD C,A          ; Keep the fill attribute in #REGc.
; Pick a random X band that differs from the previous one.
@label=Reposition_CameraFollow_WriteX
*$EA8E LD A,$05        ; Load #REGa with #N$05.
 $EA90 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $EA93 INC A           ; Step the fill-row counter on by one.
 $EA94 CP C            ; {Does #REGa match #REGc? If so, jump to #R$EA8E.
 $EA95 JR Z,$EA8E      ; }
 $EA97 PUSH AF         ; Stash #REGaf on the stack.
 $EA98 LD B,$05        ; Load #REGb with #N$05.
; Scale the band into a world X and add a random offset for the follow
; entity.
@label=Reposition_CameraFollow_RandomY
*$EA9A ADD A,A         ; Double #REGa to form a word index into the table.
 $EA9B DJNZ $EA9A      ; Decrease the loop counter in #REGb and jump to #R$EA9A if more
                       ; iterations remain.
 $EA9D LD B,A          ; Keep a copy of #REGa in #REGb.
 $EA9E LD A,$14        ; Load #REGa with #N$14.
 $EAA0 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $EAA3 ADD A,$02       ; #REGa+=#N$02.
 $EAA5 ADD A,B         ; #REGa+=#REGb.
 $EAA6 LD (IX+$07),A   ; Set the current entity's x-coordinate.
 $EAA9 ADD A,$05       ; #REGa+=#N$05.
 $EAAB LD (IX+$08),A   ; Set the current entity's x-extent.
 $EAAE POP AF          ; Restore #REGaf from the stack.
 $EAAF CP $03          ; {Is #REGa equal to #N$03? If so, jump to #R$EAB9.
 $EAB1 JR Z,$EAB9      ; }
 $EAB3 LD A,$03        ; Load #REGa with #N$03.
 $EAB5 CALL $EAE5      ; Call #R$EAE5 to pick a pseudo-random value.
 $EAB8 INC A           ; Step the fill-row counter on by two.
; Write the follow entity's room, Y, extents, and facing after the random
; place.
@label=Reposition_CameraFollow_WriteScript
*$EAB9 INC A           ;
 $EABA LD (IX+$04),A   ; Set the current entity's room index.
 $EABD ADD A,$1D       ; #REGa+=#N$1D.
 $EABF LD (IX+$05),A   ; Set the current entity's y-coordinate.
 $EAC2 ADD A,$06       ; #REGa+=#N$06.
 $EAC4 LD (IX+$06),A   ; Set the current entity's y-extent.
 $EAC7 LD (IX+$09),$00 ; Write #N$00 to the current entity's direction / state.
 $EACB SET 0,(IX+$03)  ; Set bit #N$00 of the current entity's flags byte 3.
 $EACF LD BC,$BBBD     ; Load #REGbc with #R$B9A5(#N$BBBD).
 $EAD2 BIT 4,(IX+$03)  ; {Is bit #N$04 of flags byte 3 (#REGix+#N$03) set? If so, jump to
 $EAD6 JR NZ,$EADA     ; #R$EADA.}
 $EAD8 INC BC          ; {Advance the script address in #REGbc by two bytes.
 $EAD9 INC BC          ; }
; Store the chosen Berk script pointer at #R$72B1 and return.
@label=Reposition_CameraFollow_PickScript
*$EADA LD ($72B1),BC   ; Store #REGbc in Pointer: Berk Script Position
                       ; (#R$72B1).
 $EADE POP IX          ; Restore #REGix from the stack.
 $EAE0 EXX             ; Switch to the shadow registers.
 $EAE1 RET             ; Return.

; Random Seed Scratch
;
; Three-byte scratch written by game start and read by the pseudo-random
; routine.
@label=RandomSeedScratch
g$EAE2 DEFB $00,$00  ; Seed word updated by #R$EAE5.
@label=RandomRangeMaximum
 $EAE4 DEFB $00      ; Random-range maximum for the current #R$EAE5 call.

; Generate Pseudo-Random Number
;
; Used by the routines at #R$AB95, #R$ACE4, #R$BC81, #R$BD3C, #R$BD72, #R$BEE6,
; #R$C556, #R$C65C, #R$CB1E, #R$CE4B, #R$D040, #R$D074, #R$D48E, #R$D56A,
; #R$D59E, #R$D971, #R$E286, #R$E376, #R$E819, #R$E847, #R$E8AA, #R$E909,
; #R$E943, #R$EA73, #R$ECDB, #R$EE30 and #R$F70A.
; .
; Return a pseudo-random number between #N$01 and max(#N($02), #REGa).
;
;   A Maximum value
; O:A Random number
@label=PseudoRandom
c$EAE5 CP $02        ; {Is #REGa less than #N$02? If not, jump to #R$EAEB.
 $EAE7 JR NC,$EAEB   ; }
 $EAE9 LD A,$02      ; Load #REGa with #N$02.
; Clamp the range to at least #N($02), mix the seed at #R$EAE2, and reduce
; into #N$01…max.
@label=PseudoRandom_Mix
*$EAEB LD ($EAE4),A  ; Store #REGa as the random-range maximum at #R$EAE4.
 $EAEE PUSH HL       ; {Stash #REGhl, #REGde and #REGbc on the stack.
 $EAEF PUSH DE       ;
 $EAF0 PUSH BC       ; }
 $EAF1 LD DE,($EAE2) ; Load #REGde from #R$EAE2.
 $EAF5 LD H,E        ; Copy #REGe into #REGh.
 $EAF6 LD L,$FD      ; Load #REGl with #N$FD.
 $EAF8 LD A,D        ; Copy #REGd into #REGa for later use.
 $EAF9 OR A          ; Is #REGa zero?.
 $EAFA SBC HL,DE     ; Subtract #REGde from #REGhl, including the previous
                     ; success marker.
 $EAFC SBC A,$00     ; Subtract the previous success marker from #REGa.
 $EAFE SBC HL,DE     ; Subtract #REGde from #REGhl, including the previous
                     ; success marker.
 $EB00 SBC A,$00     ; Subtract the previous success marker from #REGa.
 $EB02 LD E,A        ; Copy #REGa into #REGe as a saved coordinate / value.
 $EB03 LD D,$00      ; Clear #REGd (high byte of a pointer/offset).
 $EB05 SBC HL,DE     ; Subtract #REGde from #REGhl, including the previous
                     ; success marker.
 $EB07 JR NC,$EB0A   ; Jump to #R$EB0A if the result did not underflow.
 $EB09 INC HL        ; Advance the data pointer in #REGhl by one byte.
; Write the mixed seed back to #R$EAE2 and accumulate it against the
; range.
@label=PseudoRandomContinue
*$EB0A LD ($EAE2),HL ; Store #REGhl in #R$EAE2.
 $EB0D PUSH HL       ; {Copy #REGhl into #REGde (using the stack).
 $EB0E POP DE        ; }
 $EB0F LD A,($EAE4)  ; Load #REGa with the random-range maximum at #R$EAE4.
 $EB12 DEC A         ; Decrease #REGa by one.
 $EB13 LD B,A        ; Keep a copy of #REGa in #REGb.
 $EB14 XOR A         ; Clear #REGa to #N$00.
; Fold the seed word into the result by repeated addition.
@label=PseudoRandomContinueB
*$EB15 ADD HL,DE     ; #REGhl+=#REGde.
 $EB16 JR NC,$EB19   ; Jump to #R$EB19 if the result did not underflow.
 $EB18 INC A         ; Step the print-position / counter on by one.
; Finish the accumulate loop and restore the caller's registers.
@label=PseudoRandomContinueB2
*$EB19 DJNZ $EB15    ; Decrease the loop counter in #REGb and jump to #R$EB15 if more
                     ; iterations remain.
 $EB1B POP BC        ; {Restore #REGbc, #REGde and #REGhl from the stack.
 $EB1C POP DE        ;
 $EB1D POP HL        ; }
 $EB1E RET           ; Return.
; View the equivalent code in;
; #LIST
; { #FLUNKY$955A }
; LIST#

; Score Leading-Zero Suppress Flag
;
; Leading-zero suppress flag for #R$EB20 / #R$EB41. Cleared while
; leading zeros are blanked, then set when a non-zero digit is printed.
@label=Flag_ScoreLeadingZeroSuppress
b$EB1F DEFB $00

; Print Score Digits
;
; Used by the routines at #R$AF01 and #R$F6A6.
; .
; Print the score in #REGhl as four digits via #R$EB41, suppressing
; leading zeros until a non-zero digit (or the units) using #R$EB1F.
@label=Print_ScoreDigits
c$EB20 XOR A         ; Clear #REGa to #N$00.
 $EB21 JR $EB25      ; Jump to #R$EB25 to continue the loop.
 $EB23 LD A,$01      ; Load #REGa with #N$01.
; Remember the leading-zero suppress flag at #R$EB1F, then print
; thousands/hundreds/tens/units.
@label=Print_ScoreDigits_StoreSuppressFlag
*$EB25 LD ($EB1F),A  ; Set #R$EB1F.
 $EB28 LD DE,$03E8   ; Load #REGde with #N($03E8,$04,$04).
 $EB2B CALL $EB41    ; Call #R$EB41 to print Digit.
 $EB2E LD DE,$0064   ; Load #REGde with #N($0064,$04,$04).
 $EB31 CALL $EB41    ; Call #R$EB41 to print Digit.
 $EB34 LD DE,$000A   ; Load #REGde with #N($000A,$04,$04).
 $EB37 CALL $EB41    ; Call #R$EB41 to print Digit.
 $EB3A INC A         ; Step the print-position / counter on by one.
 $EB3B LD ($EB1F),A  ; Set #R$EB1F.
 $EB3E LD A,L        ; Copy #REGl into #REGa.
 $EB3F JR $EB4B      ; Jump to #R$EB4B to blit Next Row.

; Print Digit
;
; Used by the routine at #R$EB20.
; .
; Divide #REGhl by #REGde, print the quotient digit through #REGix, and
; leave the remainder in #REGhl. Uses #R$EB1F to suppress leading zeros.
@label=Print_Digit
c$EB41 AND A         ; Is #REGa zero?.
 $EB42 LD B,$FF      ; Load #REGb with #N$FF.
; Count how many times #REGde fits into #REGhl (digit quotient).
@label=Print_Digit_DivideLoop
*$EB44 INC B         ; Step the outer print loop counter on by one.
 $EB45 SBC HL,DE     ; Subtract #REGde from #REGhl, including the previous
                     ; success marker.
 $EB47 JR NC,$EB44   ; Jump to #R$EB44 if the result did not underflow.
 $EB49 ADD HL,DE     ; #REGhl+=#REGde.
 $EB4A LD A,B        ; Copy the loop counter from #REGb into #REGa.
; This entry point is used by the routine at #R$EB20.
; .
; Choose a digit glyph, a leading space, or a leading zero using #R$EB1F.
@label=Print_Digit_SelectGlyph
*$EB4B OR A          ; {Is #REGa zero? If not, jump to #R$EB5C.
 $EB4C JR NZ,$EB5C   ; }
 $EB4E LD A,($EB1F)  ; Load #REGa from #R$EB1F.
 $EB51 OR A          ; {Is #REGa zero? If not, jump to #R$EB58.
 $EB52 JR NZ,$EB58   ; }
 $EB54 LD A,$20      ; Load #REGa with #N$20.
 $EB56 JR $EB61      ; Jump to #R$EB61 to continue the loop.
; Print a leading zero (#CHR$30) while suppression is still armed.
@label=Print_Digit_LeadingZero
*$EB58 LD A,$30      ; Load #REGa with #N$30.
 $EB5A JR $EB61      ; Jump to #R$EB61 to continue the loop.
; Convert a non-zero quotient to ASCII and clear the leading-zero suppress
; flag.
@label=Print_DigitLoopB
*$EB5C ADD A,$30     ; #REGa+=#N$30.
 $EB5E LD ($EB1F),A  ; Set #R$EB1F.
; Write the chosen character through #REGix and advance one column.
@label=Print_DigitLoopB2
*$EB61 LD (IX+$00),A ; Write the character code through #REGix.
 $EB64 INC IX        ; Advance #REGix to the next character column.
 $EB66 RET           ; Return.

; Print Character
;
; Used by the routines at #R$AD47, #R$AD6F, #R$AF3C, #R$F51D, #R$F5CA and
; #R$F6D6.
; .
; Print the character code in #REGde at attribute address #REGhl using the
; character set at #R$72F9 and attribute #R$7307.
@label=Print_Character
c$EB67 PUSH DE       ; {Stash #REGde, #REGhl and #REGbc on the stack.
 $EB68 PUSH HL       ;
 $EB69 PUSH BC       ; }
 $EB6A LD A,($7307)  ; Load #REGa with the current text attribute (#R$7307).
 $EB6D LD (HL),A     ; Set the byte at #REGhl.
 $EB6E LD A,H        ; Copy #REGh into #REGa.
 $EB6F ADD A,A       ; {Multiply #REGa by #N$08 to form the screen-bitmap high
 $EB70 ADD A,A       ; byte.
 $EB71 ADD A,A       ; }
 $EB72 AND %01011011 ; #REGa&=#N$5B.
 $EB74 LD H,A        ; Copy #REGa into #REGh.
 $EB75 PUSH HL       ; Stash #REGhl on the stack.
 $EB76 EX DE,HL      ; Exchange #REGde and #REGhl.
 $EB77 ADD HL,HL     ; {Multiply #REGhl by #N$08 to index the character glyph.
 $EB78 ADD HL,HL     ;
 $EB79 ADD HL,HL     ; }
 $EB7A LD DE,($72F9) ; Load #REGde with the current character-set pointer
                     ; (#R$72F9).
 $EB7E ADD HL,DE     ; #REGhl+=#REGde.
 $EB7F POP DE        ; Restore #REGde from the stack.
 $EB80 LD B,$08      ; Load #REGb with loop count #N$08.
; Blit #N$08 pixel rows of the character glyph into the screen bitmap.
@label=Print_CharacterLoop
*$EB82 LD A,(HL)     ; Fetch the next script byte.
 $EB83 LD (DE),A     ; Set the byte at #REGde.
 $EB84 INC D         ; Advance the high byte of the screen address by one.
 $EB85 INC HL        ; Advance the data pointer in #REGhl by one byte.
 $EB86 DJNZ $EB82    ; Decrease the loop counter in #REGb and jump to #R$EB82 if more
                     ; iterations remain.
 $EB88 POP BC        ; {Restore #REGbc, #REGhl and #REGde from the stack.
 $EB89 POP HL        ;
 $EB8A POP DE        ; }
 $EB8B RET           ; Return.

; Table of Addresses of Script Handling Routines
