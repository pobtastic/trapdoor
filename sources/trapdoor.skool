                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
 $E7D9 DEFW $E82C    ; Address of the handler for graphic-layout opcode
                     ; #N(#EVAL($EE+(#PC-$E7D5)/$02)).
